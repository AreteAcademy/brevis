package pages

import (
	"fmt"

	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/layouts"
)

// Loads is what the workflows wrote: every SDK step that lands data, grouped
// by the workflow that runs it, each judged against its own schedule.
templ Loads(v LoadsView) {
	@layouts.Base(layouts.Page{Title: "Loads", Active: "loads"}) {
		<p class="mb-3 max-w-3xl text-sm text-ink-2">
			What the workflows wrote. Every SDK step that lands data, or prints a
			<code class="font-mono text-xs">landed</code> line, appears here under the workflow that runs it. Writes from outside Brevis do not appear.
		</p>
		if v.Total == 0 {
			@components.Empty("No load yet.",
				"One appears after an SDK pipeline's first load, or a step that prints a landed line. See docs/LANDINGS.md.")
		} else {
			<div class="mb-3 flex flex-wrap items-center gap-2 text-sm">
				<span class="font-medium text-ink tabular-nums">{ plural(v.Total, "destination") }</span>
				<span class="text-muted">written by</span>
				<span class="mr-1 font-medium text-ink tabular-nums">{ plural(v.Workflows, "workflow") }</span>
				for _, s := range statusOrder {
					if v.Counts[s] > 0 {
						<span class="inline-flex items-center gap-1.5">
							<span class="text-ink-2 tabular-nums">{ fmt.Sprint(v.Counts[s]) }</span>
							@components.Freshness(string(s))
						</span>
					}
				}
			</div>
			@loadsFilters(v)
			<div data-filter-scope class="overflow-hidden rounded-card border border-line bg-surface">
				<div data-filter-empty class="px-6 py-10 text-center text-sm text-muted" hidden?={ v.Shown() > 0 }>
					Nothing matches this filter.
					<a href="/ingest/loads" class="ml-1 text-accent-strong hover:underline">Show every load</a>
				</div>
				if len(v.Groups) > 0 {
					<div class="overflow-x-auto">
						<table id="load-rows" class="w-full min-w-[48rem] text-[0.82rem]">
							<thead>
								<tr class="border-b border-line bg-canvas-subtle text-left">
									@th("Step → destination", "pl-4")
									@th("Status", "")
									@th("Last load", "")
									@th("Rows", "text-right")
									@th("Last loads", "pr-4")
								</tr>
							</thead>
							for _, g := range v.Groups {
								@loadGroup(g)
							}
						</table>
					</div>
				}
				@components.TableFoot(v.Shown(), v.Total, "loads")
			</div>
		}
	}
}

// loadsFilters is the bar above the table, Catalog's filters on this page's
// URL: a search over workflow, step and destination, then status, kind and
// label.
templ loadsFilters(v LoadsView) {
	{{ f := v.Filter }}
	<div data-filter-keep class="mb-3 flex flex-wrap items-center gap-2">
		<form method="get" action="/ingest/loads" role="search" class="w-full sm:w-80">
			if f.Status != "" {
				<input type="hidden" name="status" value={ f.Status }/>
			}
			if f.Kind != "" {
				<input type="hidden" name="kind" value={ f.Kind }/>
			}
			if f.Legacy {
				<input type="hidden" name="legacy" value="1"/>
			}
			@components.SearchInput("q", f.Q, "Search workflows, steps or destinations", "load-rows")
		</form>
		<div class="flex flex-wrap items-center gap-2">
			<div class="max-w-full overflow-x-auto whitespace-nowrap">
				@components.Segmented("Status", loadStatusOptions(v))
			</div>
			if len(v.Kinds) > 1 {
				<div class="max-w-full overflow-x-auto whitespace-nowrap">
					@components.Segmented("Kind", loadKindOptions(v))
				</div>
			}
			if v.HasLegacy {
				@components.Segmented("Label", loadLegacyOptions(v))
			}
		</div>
	</div>
}

// loadGroup is one workflow: a header row -- its name, its schedule, how many
// destinations, and a collapse button ui.js drives (with no script every group
// stays open) -- then its loads.
templ loadGroup(g LoadGroupView) {
	<tbody data-filter-group={ g.Workflow } hidden?={ g.Hidden } class="border-b border-line-soft last:border-b-0">
		<tr class="bg-canvas-subtle/60">
			<td colspan="5" class="px-3 py-2 pl-4">
				<div class="flex items-center gap-2">
					<button
						type="button"
						data-group-toggle
						aria-expanded="true"
						aria-label={ "Collapse " + g.Workflow }
						data-js
						class="flex h-6 w-6 items-center justify-center rounded-card text-muted transition-colors hover:bg-surface-2 hover:text-ink aria-[expanded=false]:-rotate-90"
					>
						@components.Icon("chevron-down", "h-3.5 w-3.5")
					</button>
					@components.Icon("workflow", "h-3.5 w-3.5 text-muted")
					<a href={ templ.SafeURL("/workflows/" + g.Workflow) } class="font-mono text-[0.8rem] font-medium text-ink hover:underline">{ g.Workflow }</a>
					<span class="text-[0.75rem] text-muted">{ groupSchedule(g.LoadGroup) }</span>
					<span class="ml-auto text-[0.72rem] text-faint tabular-nums">{ plural(len(g.Targets), "destination") }</span>
				</div>
			</td>
		</tr>
		for _, r := range g.Rows {
			@loadRow(r)
		}
	</tbody>
}

// loadRow is one step landing on one destination: `step → URI`, the scheme
// and host faint and the object in full. The whole row goes to the load.
templ loadRow(r LoadRow) {
	<tr
		data-filter-row
		data-filter-text={ r.SearchText() }
		hidden?={ r.Hidden }
		data-href={ r.Href() }
		class="cursor-pointer align-top transition-colors hover:bg-surface-2"
	>
		<td class="min-w-[20rem] px-3 py-2.5 pl-10">
			<div class="flex items-start gap-2.5">
				<span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-card border border-line-soft text-muted">
					@components.Icon(kindIcon(r.Kind), "h-3.5 w-3.5")
				</span>
				<div class="min-w-0">
					{{ where, what := SplitTarget(r.URI) }}
					<a href={ templ.SafeURL(r.Href()) } class="font-mono text-[0.78rem] break-all hover:underline">
						<span class="text-ink">{ r.Step }</span>
						<span class="text-faint">→</span>
						<span class="text-faint">{ where }</span><span class="text-ink">{ what }</span>
					</a>
					<span class="mt-0.5 flex items-center gap-1.5 text-[0.72rem] text-muted">
						if r.Legacy {
							<span title="A label recovered from before steps named their target; it is never turned into one.">
								@components.Tag("legacy", "")
							</span>
							label
						} else {
							{ r.Kind }
						}
					</span>
				</div>
			</div>
		</td>
		<td class="px-3 py-2.5">
			@components.Freshness(string(r.Status))
			if run := r.Fixing(); run != nil {
				<a href={ templ.SafeURL("/runs/" + *run) } class="mt-1 block text-[0.72rem] text-state-running hover:underline">run in progress</a>
			}
		</td>
		<td class="px-3 py-2.5 text-[0.78rem] whitespace-nowrap text-muted">{ components.When(&r.LastLoaded) }</td>
		<td class="px-3 py-2.5 text-right text-[0.78rem] text-ink tabular-nums">{ rowsText(r.Rows) }</td>
		<td class="px-3 py-2.5 pr-4">
			@components.Spark(r.Recent)
		</td>
	</tr>
}
