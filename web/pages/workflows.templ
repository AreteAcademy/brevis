package pages

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	wf "github.com/AreteAcademy/brevis/internal/domain/workflow"
	"github.com/AreteAcademy/brevis/internal/infrastructure/postgres"
	"github.com/AreteAcademy/brevis/internal/branding"
	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/i18n"
	"github.com/AreteAcademy/brevis/web/layouts"
)

// ---------------------------------------------------------------------------
// Workflows: the list, the workflow and its run drawer
// ---------------------------------------------------------------------------

templ Workflows(v WorkflowsScreen) {
	@layouts.Base(layouts.Page{Title: i18n.T(ctx, "nav.workflows"), Active: "workflows", Actions: workflowsActions()}) {
		@howToCreate()
		<p class="-mt-2 mb-4 max-w-3xl text-[13.5px] text-muted">
			// One line: a line break between two pieces is a space, and the
			// sentence's colon would stand apart from its words.
			{ i18n.T(ctx, "workflows.lead.before") } <strong class="font-medium text-ink">{ i18n.T(ctx, "workflows.lead.strong") }</strong>{ i18n.T(ctx, "workflows.lead.after") } <a href="/runs" class="text-ink underline decoration-line-strong underline-offset-2 hover:decoration-ink">{ i18n.T(ctx, "workflows.lead.run") }</a>.
		</p>
		// THE BOX ANSWERS WHILE SOMEBODY TYPES, and the server still decides:
		// the list is paginated, so ui.js submits this form as a fetch
		// (`data-swap-typing`) and swaps the list the handler draws alone. With
		// no script it is the GET form it always was, and Enter submits it.
		// The other filters go along as hidden fields: searching must not erase
		// the state the operator had already chosen.
		<form method="get" action="/workflows" role="search" data-swap="workflows-list" data-swap-typing class="mb-3 w-full sm:w-96">
			for _, h := range v.Filter.hidden() {
				<input type="hidden" name={ h[0] } value={ h[1] }/>
			}
			@components.SearchInput("q", v.Filter.Search, i18n.T(ctx, "workflows.search"), "")
		</form>
		<div id="workflows-list">
			@WorkflowsList(v)
		</div>
	}
}

// workflowsActions are the list's two verbs. Both open the same drawer: a
// workflow is born in the repository and published by the CLI, and the
// console has no form to create one. With no script they are links to the
// documentation that says the same.
func workflowsActions() templ.Component { return workflowsActionsT() }

templ workflowsActionsT() {
	<div class="flex items-center gap-2">
		<a href={ templ.SafeURL(branding.DocsURL + "workflows/") } data-dialogo="how-to-create" class={ components.ButtonClass(components.ButtonSecondary, components.SizeRegular) }>
			@components.Icon("book-open", "h-3.5 w-3.5")
			{ i18n.T(ctx, "workflows.create.how") }
		</a>
		<a href={ templ.SafeURL(branding.DocsURL + "workflows/") } data-dialogo="how-to-create" class={ components.ButtonClass(components.ButtonPrimary, components.SizeRegular) }>
			@components.Icon("plus", "h-3.5 w-3.5")
			{ i18n.T(ctx, "workflows.create.publish") }
		</a>
	</div>
}

// howToCreate is the drawer both actions open: the file, the two commands,
// and where to read more.
templ howToCreate() {
	@components.Drawer("how-to-create", i18n.T(ctx, "workflows.create.title"), nil) {
		<div data-dialog-body class="space-y-4 px-5 py-4 text-[13px] text-ink-2">
			<p>{ i18n.T(ctx, "workflows.create.lead") }</p>
			<div>
				<p class="mb-1.5 font-medium text-ink">1. { i18n.T(ctx, "workflows.create.file") }</p>
				@components.CodeBlock("how-to-create-yaml", createExample, nil)
			</div>
			<div>
				<p class="mb-1.5 font-medium text-ink">2. { i18n.T(ctx, "workflows.create.validate") }</p>
				@components.CodeBlock("how-to-create-validate", "brevis validate workflows/", nil)
			</div>
			<div>
				<p class="mb-1.5 font-medium text-ink">3. { i18n.T(ctx, "workflows.create.publish_step") }</p>
				@components.CodeBlock("how-to-create-publish", "brevis publish --project <project> workflows/", nil)
				<p class="mt-1.5 text-xs text-muted">{ i18n.T(ctx, "workflows.create.publish_note") }</p>
			</div>
			<a href={ templ.SafeURL(branding.DocsURL + "workflows/") } class="inline-block text-ink underline decoration-line-strong underline-offset-2 hover:decoration-ink">{ i18n.T(ctx, "workflows.create.docs") }</a>
		</div>
	}
}

// WorkflowsList is everything under the search box: the filters, the count,
// the table and its pages. It is the page's fragment (X-Brevis-Fragment:
// answer), so the counts follow the search as somebody types.
templ WorkflowsList(v WorkflowsScreen) {
	{{ f := v.Filter }}
	<div class="mb-2 flex flex-wrap items-center gap-2">
		// Each control scrolls on its own when the screen is narrower than its
		// choices, rather than cutting the last one off.
		<div class="max-w-full overflow-x-auto whitespace-nowrap">
			@components.Segmented(i18n.T(ctx, "workflows.filter.state"), stateOptions(ctx, f, v.Counts))
		</div>
		for _, c := range legacyChips(ctx, f) {
			<a
				href={ templ.SafeURL(c[2]) }
				aria-label={ i18n.T(ctx, "workflows.chip.remove") }
				class="inline-flex h-8 items-center gap-1.5 rounded-card border border-line-strong bg-surface-2 px-2.5 text-[0.8rem] text-ink"
			>
				<span class="text-muted">{ c[0] }:</span>
				<span>{ c[1] }</span>
				<span class="text-muted">&times;</span>
			</a>
		}
		// The project chip appears only when one is selected. There is no
		// row of every project here on purpose: a project is a namespace,
		// not a category, and most installations have one -- a permanent
		// chip for a filter that is almost never on is noise.
		if f.Project != "" {
			<a
				href={ templ.SafeURL(f.With("project", "")) }
				aria-label={ i18n.T(ctx, "workflows.chip.remove") }
				class="inline-flex h-8 items-center gap-1.5 rounded-card border border-line-strong bg-surface-2 px-2.5 text-[0.8rem] text-ink"
			>
				<span class="text-muted">{ i18n.T(ctx, "workflows.chip.project") }:</span>
				<span class="font-mono">{ f.Project }</span>
				<span class="text-muted">&times;</span>
			</a>
		}
	</div>
	<div class="mb-3 flex flex-wrap items-center gap-2">
		if len(v.Tags) > 0 {
			@tagPopover(v.Tags, f)
			for _, t := range f.Tags {
				<a
					href={ templ.SafeURL(f.WithTag(t)) }
					aria-label={ i18n.T(ctx, "workflows.tags.remove", "tag", t) }
					class="inline-flex h-8 items-center gap-1.5 rounded-card border border-line-strong bg-surface-2 px-2.5 text-[0.8rem] text-ink"
				>
					{ t }
					<span class="text-muted">&times;</span>
				</a>
			}
		}
		if len(v.Langs) > 0 {
			@langFilter(v.Langs, f)
		}
	</div>
	<p class="mb-2 text-[13px] text-muted">
		<span class="font-semibold text-ink tabular-nums">{ i18n.Number(ctx, int64(v.Filtered)) }</span>
		{ i18n.N(ctx, "workflows.count", v.Total) }
		if f.Search != "" {
			{ i18n.T(ctx, "workflows.count.search", "q", f.Search) }
		}
		for _, t := range f.Tags {
			· { i18n.T(ctx, "workflows.count.tag", "tag", t) }
		}
		if f.Lang != "" {
			· { components.LogoTitle(ctx, f.Lang) }
		}
		if v.Filtered != v.Total {
			<a href="/workflows" class="ml-3 text-xs text-ink underline decoration-line-strong underline-offset-2 hover:decoration-ink">{ i18n.T(ctx, "workflows.clear") }</a>
		}
	</p>
	if len(v.Rows) == 0 {
		<div class="rounded-card border border-dashed border-line px-6 py-12 text-center">
			<p class="text-sm text-muted">{ i18n.T(ctx, "workflows.empty") }</p>
			<a href="/workflows" class="mt-2 inline-block text-xs text-ink underline decoration-line-strong underline-offset-2 hover:decoration-ink">{ i18n.T(ctx, "workflows.clear") }</a>
		</div>
	} else {
		<div class="overflow-x-auto rounded-card border border-line bg-surface shadow-warm-sm">
			// Narrower, the columns that answer "what is it made of" go first,
			// then the history: what stays is its name, when it runs and Run.
			<table class="ct w-full text-sm min-[860px]:min-w-[60rem]">
				<thead>
					<tr class="border-b border-line bg-parchment-soft/60 text-left">
						@th(i18n.T(ctx, "workflows.col.active"), "w-16 pl-5 max-[640px]:hidden")
						@sortableTh(i18n.T(ctx, "workflows.col.workflow"), "workflow", f, "max-[640px]:pl-4")
						@th(i18n.T(ctx, "workflows.col.lang"), "max-[640px]:hidden")
						@th(i18n.T(ctx, "workflows.col.connects"), "max-[1100px]:hidden")
						@sortableTh(i18n.T(ctx, "workflows.col.schedule"), "schedule", f, "")
						@sortableTh(i18n.T(ctx, "workflows.col.next"), "next", f, "max-[640px]:hidden")
						@sortableTh(i18n.T(ctx, "workflows.col.last"), "last", f, "max-[860px]:hidden")
						@th(i18n.T(ctx, "workflows.col.tags"), "max-[1100px]:hidden")
						@th("", "w-24 pr-5 text-right")
					</tr>
				</thead>
				<tbody class="divide-y divide-line-soft">
					for _, w := range v.Rows {
						@workflowRow(v, w)
					}
				</tbody>
			</table>
			// The Run dialogs live outside the table: a click inside one must
			// not reach the row's own click, which opens the workflow.
			for _, w := range v.Rows {
				if !v.Params[w.Slug] {
					@runNow(RunNow{Slug: w.Slug, Cron: w.Cron, Zone: w.Timezone, Back: f.WithPage(f.Page), Now: v.Now})
				}
			}
			@pagination(Pagination{
				Page: f.Page, PerPage: f.PerPage, Total: v.Filtered,
				PageLink: f.WithPage,
			})
		</div>
	}
}

// workflowRow is one workflow. The whole row opens it (`data-href`, ui.js);
// the name stays a real link, for the keyboard and a page with no script,
// and the switch, the tags and Run are controls of their own. A paused row's
// data fades; its switch, which is how it comes back, does not.
templ workflowRow(v WorkflowsScreen, w postgres.WorkflowSummary) {
	{{ paused := w.HasSchedule && !w.Active }}
	<tr data-href={ rowHref(w.Slug) } data-paused?={ paused } class="cursor-pointer align-top transition-colors hover:bg-hover">
		<td class="py-3 pl-5 max-[640px]:hidden">
			@interruptor(w)
		</td>
		<td class="py-3 pr-3 max-[640px]:pl-4" data-fade>
			<div class="flex flex-wrap items-center gap-1.5">
				<a href={ templ.SafeURL(rowHref(w.Slug)) } class="font-mono text-[13px] font-medium text-ink hover:underline">{ w.Slug }</a>
				if v.Failing[w.Slug] {
					<span data-pill-failing class="rounded-full bg-state-failed/15 px-2 py-px text-[0.7rem] text-state-failed">{ i18n.T(ctx, "workflows.pill.failing") }</span>
				} else if inFlight(w) {
					<span data-pill-running class="rounded-full bg-state-running/15 px-2 py-px text-[0.7rem] text-state-running">{ i18n.T(ctx, "workflows.pill.running") }</span>
				}
			</div>
			<p class="mt-0.5 text-xs text-muted">
				<a href={ templ.SafeURL("/workflows?project=" + url.QueryEscape(w.Project)) } class="hover:text-ink hover:underline">{ w.Project }</a>
				if n, ok := v.Steps[w.Slug]; ok {
					· { i18n.N(ctx, "workflows.steps", n) }
				}
			</p>
		</td>
		<td data-col-lang class="py-3 pr-3 max-[640px]:hidden" data-fade>
			if ks := v.RunsIn[w.Slug]; len(ks) > 0 {
				<div class="flex items-center gap-2">
					<span class="inline-flex items-center gap-1">
						for _, k := range firstLangs(ks) {
							@components.Logo(k, 18)
						}
					</span>
					<span class="whitespace-nowrap text-xs text-ink-2">{ langText(ctx, ks) }</span>
				</div>
			} else {
				<span class="text-muted">—</span>
			}
		</td>
		<td data-col-connects class="py-3 pr-3 max-[1100px]:hidden" data-fade>
			<span class="inline-flex flex-wrap items-center gap-1">
				for _, k := range v.Connects[w.Slug] {
					@components.Logo(k, 18)
				}
			</span>
		</td>
		<td data-col-schedule class="py-3 pr-3" data-fade>
			if w.Cron == "" {
				<span class="text-xs text-muted">{ i18n.T(ctx, "workflows.manual_only") }</span>
			} else {
				{{ words := CronTextIn(ctx, w.Cron) }}
				if paused {
					<p class="text-xs text-muted">
						{ i18n.T(ctx, "workflows.paused") }
						if words != "" {
							· { i18n.T(ctx, "workflows.was", "schedule", words) }
						}
					</p>
				} else if words != "" {
					<p data-cron-text class="text-xs text-ink">{ words }{ zoneSuffix(w.Timezone) }</p>
				}
				<p class="mt-0.5 font-mono text-[0.7rem] text-faint">
					{ w.Cron }
					if w.Catchup {
						<span class="ml-1.5 font-sans">catchup</span>
					}
				</p>
			}
		</td>
		<td data-col-next class="py-3 pr-3 text-xs tabular-nums max-[640px]:hidden" data-fade>
			if inFlight(w) {
				<span class="text-state-running">{ i18n.T(ctx, "workflows.in_flight") }</span>
			} else if w.NextRun != nil && !paused {
				<span class="text-ink" title={ components.UTCStamp(w.NextRun) }>{ i18n.Since(ctx, time.Now(), *w.NextRun) }</span>
			} else {
				<span class="text-muted">—</span>
			}
		</td>
		<td class="py-3 pr-3 max-[860px]:hidden" data-fade>
			if w.LastRunID != nil {
				@recentRuns(v.Recent[w.Slug])
				<a href={ templ.SafeURL("/runs?workflow=" + url.QueryEscape(w.Slug)) } class="mt-1 block text-[0.7rem] tabular-nums text-muted hover:underline">
					{ i18n.N(ctx, "workflows.runs", w.TotalRuns) }
				</a>
			} else {
				<span class="text-xs text-muted">{ i18n.T(ctx, "workflows.never_ran") }</span>
			}
		</td>
		<td class="py-3 pr-3 max-[1100px]:hidden" data-fade>
			<div class="flex flex-wrap gap-1">
				for _, t := range w.Tags {
					@components.Tag(t, v.Filter.WithTag(t))
				}
			</div>
		</td>
		<td class="py-3 pr-5 text-right">
			if v.Params[w.Slug] {
				// Parameters are asked for in the workflow's own drawer.
				<a
					href={ templ.SafeURL(rowHref(w.Slug) + "#run") }
					title={ i18n.T(ctx, "workflows.run.tip") }
					aria-label={ i18n.T(ctx, "workflows.run", "workflow", w.Slug) }
					class="inline-flex h-8 w-8 items-center justify-center rounded-card border border-line text-muted transition-colors hover:border-line-strong hover:bg-hover hover:text-ink"
				>
					@playGlyph()
				</a>
			} else {
				@disparar(w.Slug, runNowID(w.Slug))
			}
		</td>
	</tr>
}

// langFilter is the languages the workflows run, each with its logo and how
// many the rest of the filter keeps. Links, like every other filter, so it
// works with no script and the URL can be pasted.
templ langFilter(langs []LangChoice, f Filter) {
	<div data-lang-filter role="group" aria-label={ i18n.T(ctx, "workflows.filter.lang") } class="flex max-w-full items-center gap-1.5 overflow-x-auto whitespace-nowrap">
		<span class="text-[0.75rem] text-faint">{ i18n.T(ctx, "workflows.filter.lang") }</span>
		<div class="inline-flex h-8 shrink-0 items-center gap-0.5 rounded-card border border-line bg-surface p-0.5">
			@langOption(f.With("lang", ""), f.Lang == "") {
				{ i18n.T(ctx, "workflows.lang.all") }
			}
			for _, l := range langs {
				@langOption(f.With("lang", l.Key), f.Lang == l.Key) {
					@components.Logo(l.Key, 18)
					{ components.LogoTitle(ctx, l.Key) }
					<span class="text-[0.72rem] text-muted tabular-nums">{ i18n.Number(ctx, int64(l.Count)) }</span>
				}
			}
		</div>
	</div>
}

templ langOption(href string, current bool) {
	if current {
		<a href={ templ.SafeURL(href) } aria-current="true" class="inline-flex h-full shrink-0 items-center gap-1.5 rounded-[2px] bg-surface-2 px-2.5 text-[0.8rem] font-medium whitespace-nowrap text-ink">
			{ children... }
		</a>
	} else {
		<a href={ templ.SafeURL(href) } class="inline-flex h-full shrink-0 items-center gap-1.5 rounded-[2px] px-2.5 text-[0.8rem] whitespace-nowrap text-muted transition-colors hover:text-ink">
			{ children... }
		</a>
	}
}

// recentRuns is a workflow's last runs as a strip of squares, oldest to
// newest, each a link to its run whose title says its state and time, in the
// state's colour.
templ recentRuns(runs []postgres.RecentRun) {
	if len(runs) > 0 {
		<div data-recent-runs class="flex items-center gap-0.5">
			for _, r := range runs {
				<a
					href={ templ.SafeURL("/runs/" + r.ID) }
					title={ recentTitle(ctx, r) }
					aria-label={ recentTitle(ctx, r) }
					class={ "h-3 w-2 rounded-[1px] transition-opacity hover:opacity-70", components.StateFill(r.Status) }
				></a>
			}
		</div>
	}
}

// tagPopover chooses the tags. It is a <details> holding a GET form -- the
// rest of the filter as hidden fields, a box that filters the tag list, one
// checkbox per tag, Apply -- so with no script it opens, is checked and is
// submitted like any form. With ui.js a checked box submits at once
// (`data-submit-on-change`), and the box filters the list as you type.
templ tagPopover(tags []string, f Filter) {
	<details data-popover class="relative">
		<summary class="inline-flex h-8 cursor-pointer list-none items-center gap-1.5 rounded-card border border-line bg-surface px-2.5 text-[0.8rem] text-muted transition-colors duration-150 hover:text-ink [&::-webkit-details-marker]:hidden">
			@components.Icon("tag", "h-3.5 w-3.5")
			{ i18n.T(ctx, "workflows.col.tags") }
			if len(f.Tags) > 0 {
				<span class="text-[0.72rem] text-ink tabular-nums">{ fmt.Sprint(len(f.Tags)) }</span>
			}
		</summary>
		<div class="absolute left-0 z-20 mt-1 w-64 rounded-card border border-line bg-surface p-2 shadow-warm-sm">
			<form method="get" action="/workflows" data-submit-on-change>
				for _, h := range f.tagFormHidden() {
					<input type="hidden" name={ h[0] } value={ h[1] }/>
				}
				<input
					type="search"
					aria-label={ i18n.T(ctx, "workflows.tags.filter") }
					placeholder={ i18n.T(ctx, "workflows.tags.filter") }
					data-filter-for="workflow-tags"
					autocomplete="off"
					class="mb-2 h-8 w-full rounded-card border border-line bg-surface px-2.5 text-[0.82rem] text-ink placeholder:text-faint focus:border-accent-strong focus:outline-none"
				/>
				<ul id="workflow-tags" class="max-h-60 overflow-y-auto">
					for _, t := range tags {
						<li data-filter-row data-filter-text={ strings.ToLower(t) }>
							<label class="flex cursor-pointer items-center gap-2 rounded-[2px] px-1.5 py-1 text-[0.82rem] text-ink hover:bg-surface-2">
								<input type="checkbox" name="tag" value={ t } checked?={ f.HasTag(t) } class="accent-ink"/>
								{ t }
							</label>
						</li>
					}
				</ul>
				<p data-filter-empty hidden class="px-1.5 py-1 text-[0.8rem] text-muted">{ i18n.T(ctx, "workflows.tags.none") }</p>
				<button type="submit" class="mt-2 h-7 w-full rounded-card bg-ink text-xs font-medium text-surface">{ i18n.T(ctx, "workflows.tags.apply") }</button>
			</form>
		</div>
	</details>
}

// interruptor pauses and resumes the schedule. It is a form, and not a
// checkbox with JS: with no script the page stays operable, and a POST makes
// it clear there is an effect. With ui.js it posts in place
// (`form[data-toggle]`): the switch flips, the row fades, and the toast can
// undo it.
templ interruptor(w postgres.WorkflowSummary) {
	if w.HasSchedule {
		<form method="post" action={ templ.SafeURL("/workflows/" + w.Slug + "/toggle") } data-toggle>
			if w.Active {
				<button
					type="submit"
					role="switch"
					aria-checked="true"
					title={ i18n.T(ctx, "workflows.pause.tip") }
					aria-label={ i18n.T(ctx, "workflows.pause", "workflow", w.Slug) }
					class="switch"
					data-manual
				><span class="switch-knob" aria-hidden="true"></span></button>
			} else {
				<button
					type="submit"
					role="switch"
					aria-checked="false"
					title={ i18n.T(ctx, "workflows.resume.tip") }
					aria-label={ i18n.T(ctx, "workflows.resume", "workflow", w.Slug) }
					class="switch"
					data-manual
				><span class="switch-knob" aria-hidden="true"></span></button>
			}
		</form>
	} else {
		<span class="block w-[30px] text-center text-faint" title={ i18n.T(ctx, "workflows.no_schedule.tip") }>—</span>
	}
}

// disparar is the ▶ of a workflow with no parameters: a form that posts the
// trigger, which is all it is with no script. With ui.js the button opens the
// Run dialog instead (`data-dialogo`), which asks when.
templ disparar(slug, dialog string) {
	<form method="post" action={ templ.SafeURL("/workflows/" + slug + "/trigger") } class="inline">
		<button
			type="submit"
			data-dialogo={ dialog }
			aria-haspopup="dialog"
			title={ i18n.T(ctx, "workflows.run.tip") }
			aria-label={ i18n.T(ctx, "workflows.run", "workflow", slug) }
			class="inline-flex h-8 w-8 items-center justify-center rounded-card border border-line text-muted transition-colors hover:border-line-strong hover:bg-hover hover:text-ink"
		>
			@playGlyph()
		</button>
	</form>
}

templ playGlyph() {
	<svg class="h-3.5 w-3.5" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M2.5 1.6v8.8L10 6z"></path></svg>
}

// runNow is the Run dialog: now, or one of the schedule's past slots -- the
// last fourteen, each with the window it processes, or a time of one's own.
// It posts the same trigger, with its script, so a refused slot is said here
// and the dialog stays open. A workflow with no schedule has no slot to
// offer, and the dialog only confirms.
templ runNow(r RunNow) {
	{{ slots := RecentSlots(r.Cron, r.Zone, r.Now, recentSlotsShown) }}
	@components.Modal(runNowID(r.Slug), i18n.T(ctx, "workflows.run_now.title", "workflow", r.Slug), nil) {
		<form method="post" action={ templ.SafeURL("/workflows/" + r.Slug + "/trigger") } data-run-now data-dialog-body class="space-y-3 px-5 py-4 text-[13px]">
			if r.Back != "" {
				<input type="hidden" name="back" value={ r.Back }/>
			}
			if len(slots) > 0 {
				@slotPicker(r, slots)
			} else {
				<p class="text-muted">{ i18n.T(ctx, "workflows.run_now.manual") }</p>
			}
			<p data-run-error role="alert" hidden class="rounded-card border border-state-failed/40 bg-state-failed/10 px-3 py-2 text-[12.5px] text-state-failed"></p>
			<div class="flex justify-end pt-1">
				<button type="submit" class={ components.ButtonClass(components.ButtonPrimary, components.SizeRegular) }>
					@components.Icon("play", "h-3.5 w-3.5")
					{ i18n.T(ctx, "workflows.run_now.run") }
				</button>
			</div>
		</form>
	}
}

// Workflow shows the published definition. With no run state: it is the screen
// for "what this workflow is", and it has to serve a workflow that never ran
// too.
// WorkflowStats is one workflow's numbers, over workflowWindow.
//
// Every field degrades to its zero value on purpose: a definition has to stay
// readable with the database in trouble, and somebody looking at a broken
// installation is exactly who needs to read the graph.
type WorkflowStats struct {
	Window time.Duration
	Ind    postgres.Indicators
	Days   []postgres.Day

	// Load is what this workflow's SDK pipelines measured, per day. Empty for a
	// workflow whose steps are shell commands, which is why the panel checks
	// before drawing: four empty boxes would be four questions with no answer.
	Load []postgres.LoadDay
}

// workflowEyebrow is the line above the slug: the project, the schedule in
// words (or the expression, when the words are not sure), and whether the
// schedule is on. sum is nil when the summary could not be read, and the line
// then says only what the definition does.
// workflowMeta is the one line under the title (screen-workflow-v2 WV1):
// whether the schedule runs, the project, the cron with its words and zone,
// the size of the graph, the tags -- what an eyebrow above the title and a
// line below it said between them.
templ workflowMeta(p WorkflowPage) {
	{{ w, sum := p.Def, p.Sum }}
	<p data-workflow-meta class="mb-3 -mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-[12.5px] text-muted">
		if sum != nil && sum.HasSchedule {
			if sum.Active {
				<span class="inline-flex items-center gap-1.5 text-state-success"><span class="h-[7px] w-[7px] rounded-full bg-state-success"></span>{ i18n.T(ctx, "workflow.active") }</span>
			} else {
				<span class="inline-flex items-center gap-1.5 text-muted"><span class="h-[7px] w-[7px] rounded-full bg-state-pending"></span>{ i18n.T(ctx, "workflow.paused") }</span>
			}
			<span class="text-faint">·</span>
		}
		if sum != nil && sum.Project != "" {
			<span>{ i18n.T(ctx, "workflows.chip.project") } <a href={ templ.SafeURL("/workflows?project=" + url.QueryEscape(sum.Project)) } class="font-mono text-ink-2 hover:underline">{ sum.Project }</a></span>
			<span class="text-faint">·</span>
		}
		if w.Schedule == "" {
			<span>{ i18n.T(ctx, "workflows.manual_only") }</span>
		} else {
			if words := CronTextIn(ctx, w.Schedule); words != "" {
				<span class="text-ink">{ words }{ zoneSuffix(scheduleZone(sum)) }</span>
			}
			<span class="font-mono text-[12px] text-faint">{ w.Schedule }</span>
		}
		<span class="text-faint">·</span>
		<span>{ i18n.N(ctx, "workflows.steps", len(w.Nodes)) } · { i18n.N(ctx, "workflow.dependencies", len(w.Edges)) }</span>
		if len(p.Langs) > 0 {
			<span class="text-faint">·</span>
			for _, k := range p.Langs {
				<span class="inline-flex items-center gap-1 text-ink-2">
					@components.Logo(k, 18)
					{ components.LogoTitle(ctx, k) }
				</span>
			}
		}
		for _, t := range w.Tags {
			@components.Tag(t, "/workflows?tag="+url.QueryEscape(t))
		}
	</p>
}

// yearOfRuns is the workflow's calendar (screen-workflows T7): what the year
// was, in a line, then a square per day. A day that ran opens its runs in the
// Runs tab below, on this page.
templ yearOfRuns(p WorkflowPage) {
	{{ v := yearView(ctx, p) }}
	{{ s := v.Summary }}
	@components.Panel(i18n.T(ctx, "calendar.title"), "") {
		<div class="px-3.5 py-3">
			<p class="mb-2 text-[12.5px] text-muted">{ i18n.T(ctx, "calendar.lead") }</p>
			<p data-calendar-summary class="mb-3 flex flex-wrap items-baseline gap-x-5 gap-y-1 text-[12.5px] text-muted">
				<span><strong class="font-semibold text-ink tabular-nums">{ i18n.Number(ctx, int64(s.RanDays)) }</strong> { i18n.N(ctx, "calendar.ran_days", s.RanDays) }</span>
				<span><strong class="font-semibold text-ink tabular-nums">{ i18n.Number(ctx, int64(s.FailedDays)) }</strong> { i18n.T(ctx, "calendar.failed_days") }</span>
				if s.RanDays > 0 {
					<span><strong class="font-semibold text-ink tabular-nums">{ i18n.Number(ctx, int64(s.Streak)) }</strong> { i18n.N(ctx, "calendar.streak", s.Streak) }</span>
				}
				if s.LastFailure != nil {
					<span>
						{ i18n.T(ctx, "calendar.last_failure") } <strong class="font-medium text-ink">{ i18n.Date(ctx, *s.LastFailure, "day") }</strong>
						<a href={ templ.SafeURL(dayHref(p.Def.Slug, *s.LastFailure)) } class="ml-1 text-ink underline decoration-line-strong underline-offset-2 hover:decoration-ink">{ i18n.T(ctx, "calendar.see") }</a>
					</span>
				}
				if s.Since != nil {
					<span>{ i18n.T(ctx, "calendar.since") } <strong class="font-medium text-ink">{ i18n.Date(ctx, *s.Since, "day") }</strong></span>
				}
			</p>
			@components.Heatmap(v)
		</div>
	}
}

// workflowIsland is the graph's island for a workflow drawn as a graph; a
// one-step workflow's line needs no React.
func workflowIsland(p WorkflowPage) layouts.Island {
	if p.Step != nil {
		return layouts.Island{}
	}
	return dagAssets
}

// workflowActions are the page's verbs: Pause or Resume when there is a
// schedule, and Run (▶ or the drawer).
func workflowActions(p WorkflowPage) templ.Component {
	return workflowActionsT(p)
}

templ workflowActionsT(p WorkflowPage) {
	<div class="flex items-center gap-2">
		if p.Sum != nil && p.Sum.HasSchedule {
			@pauseAction(*p.Sum)
		}
		@runAction(p.Def)
	</div>
}

// pauseAction pauses or resumes the schedule from the workflow's own page:
// the toggle the list's switch posts to, as a button worded by what it will
// do. A form, so it works with no script and is never prefetched.
templ pauseAction(sum postgres.WorkflowSummary) {
	<form method="post" action={ templ.SafeURL("/workflows/" + sum.Slug + "/toggle") }>
		<button type="submit" class={ components.ButtonClass(components.ButtonSecondary, components.SizeRegular) }>
			if sum.Active {
				{ i18n.T(ctx, "workflow.pause") }
			} else {
				{ i18n.T(ctx, "workflow.resume") }
			}
		</button>
	</form>
}

// about is the question mark beside the name, or nothing.
func about(w wf.Workflow) templ.Component {
	if w.Description == "" {
		return nil
	}
	return components.AboutButton(w.Slug)
}

templ Workflow(p WorkflowPage) {
	{{ w, st, graph := p.Def, p.Stats, p.Graph }}
	@layouts.Base(layouts.Page{
		Title: w.Slug, Kicker: "Workflow", Active: "workflows", Mono: true,
		Island: workflowIsland(p), Actions: workflowActions(p),
		// The question mark only exists when there is something behind it: a
		// control that opens an empty dialog is a promise the page does not
		// keep.
		Aside: about(w),
	}) {
		if w.Description != "" {
			@components.AboutDialog(w.Slug, w.Description)
		}
		@workflowMeta(p)
		if len(w.Params) > 0 {
			@runDrawer(w, drawerOf(p))
		} else if p.Sum != nil {
			@runNow(RunNow{Slug: w.Slug, Cron: p.Sum.Cron, Zone: p.Sum.Timezone, Now: p.Now})
		} else {
			@runNow(RunNow{Slug: w.Slug, Now: p.Now})
		}
		// Five numbers over thirty days rather than one: a daily job has a
		// single run in twenty-four hours, and a rate over one sample is not a
		// rate.
		<div class="mb-3">
			@components.Stats(workflowPageStats(ctx, p))
		</div>
		// ONE STEP IS A LINE (screen-workflow-v2 WV3), two or more are the
		// graph; the calendar is under either, at its own width -- beside a
		// step it had half the page and hid this month behind a scroll.
		if p.Step != nil {
			@stepLine(*p.Step)
			<div class="mt-3">
				@yearOfRuns(p)
			</div>
		} else {
			@stepsCard(p, graph)
			<div class="mt-3">
				@yearOfRuns(p)
			</div>
		}
		@workflowTabs(p)
		if len(st.Load) > 0 {
			<section class="mt-3">
				@components.Panel(i18n.T(ctx, "workflow.load.title"), "") {
					<div class="px-3.5 py-3">
						<p class="mb-3 text-[12.5px] text-muted">
							{ components.TrendWindow(st.Load) }. { i18n.T(ctx, "workflow.load.lead") }
						</p>
						@components.LoadTrend(components.Trend(st.Load), components.TrendWindow(st.Load))
					</div>
				}
			</section>
		}
	}
}

// workflowTabs are the page's tabs (screen-workflows T5): its runs -- the
// last ten, or a day's -- and the parameters it accepts. Shown by the hash,
// and stacked with their headings where no script runs.
templ workflowTabs(p WorkflowPage) {
	{{ w := p.Def }}
	@templ.Raw("<style>" + workflowTabsCSS() + "</style>")
	<div id="workflow-tabs" data-hash-tabs class="mt-3">
		<div data-hash-tabs-bar data-js class="mb-3">
			@components.Tabs(i18n.T(ctx, "workflow.tabs"), []components.Tab{
				{Key: "runs", Label: i18n.T(ctx, "workflow.tab.runs"), Count: fmt.Sprint(len(p.Latest)), Selected: true},
				{Key: "params", Label: i18n.T(ctx, "workflow.tab.params"), Count: fmt.Sprint(len(w.Params))},
				{Key: "definition", Label: i18n.T(ctx, "workflow.tab.definition")},
			})
		</div>
		<section id="runs" data-tab-panel="runs" data-workflow-runs class="rounded-card border border-line bg-surface shadow-warm-sm">
			<h2 data-panel-heading class="px-4 pt-3 text-[13px] font-semibold text-ink">{ i18n.T(ctx, "workflow.tab.runs") }</h2>
			<div class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 text-[12.5px] text-muted">
				if p.Day != nil {
					<span data-day-filter class="inline-flex items-center gap-1.5 rounded-card border border-line-strong bg-surface-2 px-2.5 py-0.5 text-ink">
						{ i18n.Date(ctx, *p.Day, "day") }
						<a href={ templ.SafeURL("/workflows/" + url.PathEscape(w.Slug) + "#runs") } aria-label={ i18n.T(ctx, "workflow.runs.clear_day") } class="text-muted hover:text-ink">&times;</a>
					</span>
				} else {
					<span>{ i18n.T(ctx, "workflow.runs.lead") }</span>
				}
				<a href={ templ.SafeURL("/runs?workflow=" + url.QueryEscape(w.Slug)) } class="text-ink hover:underline">{ i18n.T(ctx, "workflow.runs.all") } &rarr;</a>
			</div>
			if len(p.Latest) == 0 {
				<p class="border-t border-line-soft px-4 py-6 text-center text-[12.5px] text-muted">{ i18n.T(ctx, "workflow.runs.none") }</p>
			} else {
				<div class="overflow-x-auto border-t border-line-soft">
					<table class="ct w-full text-sm">
						<thead>
							<tr class="border-b border-line bg-parchment-soft/60 text-left">
								@th(i18n.T(ctx, "runs.col.state"), "pl-4")
								@th(i18n.T(ctx, "runs.col.trigger"), "")
								@th(i18n.T(ctx, "runs.col.slot"), "")
								@th(i18n.T(ctx, "workflow.runs.params"), "")
								@th(i18n.T(ctx, "runs.col.duration"), "")
								@th(i18n.T(ctx, "workflow.runs.when"), "pr-4 text-right")
							</tr>
						</thead>
						<tbody class="divide-y divide-line-soft">
							for _, r := range p.Latest {
								<tr class="transition-colors hover:bg-hover">
									<td class="px-2.5 py-2.5 pl-4">
										<a href={ templ.SafeURL("/runs/" + r.ID) } class="hover:underline">
											@components.State(r.Status)
										</a>
									</td>
									<td class="px-2.5 py-2.5 text-xs text-muted">{ triggerOf(ctx, r) }</td>
									<td class="px-2.5 py-2.5 font-mono text-xs tabular-nums text-ink-2">@components.ShortStamp(r.LogicalDate)</td>
									<td class="px-2.5 py-2.5 font-mono text-xs text-ink-2">
										if given := givenParams(w, r.Params); len(given) > 0 {
											{ strings.Join(given, " ") }
										} else {
											<span class="font-sans text-muted">{ i18n.T(ctx, "workflow.runs.default") }</span>
										}
									</td>
									<td class="px-2.5 py-2.5 text-xs tabular-nums text-muted">{ components.Duration(r.Duration) }</td>
									<td class="px-2.5 py-2.5 pr-4 text-right text-xs text-muted">{ i18n.Since(ctx, p.Now, r.CreatedAt) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		<section id="params" data-tab-panel="params" class="rounded-card border border-line bg-surface shadow-warm-sm">
			<h2 data-panel-heading class="px-4 pt-3 text-[13px] font-semibold text-ink">{ i18n.T(ctx, "workflow.tab.params") }</h2>
			if len(w.Params) == 0 {
				<p class="px-4 py-6 text-center text-[12.5px] text-muted">
					{ i18n.T(ctx, "workflow.params.none") } <code class="font-mono text-ink-2">$BREVIS_AUTO_*</code>.
				</p>
			} else {
				<div class="overflow-x-auto">
					<table class="ct w-full text-sm">
						<thead>
							<tr class="border-b border-line bg-parchment-soft/60 text-left">
								@th(i18n.T(ctx, "workflow.params.name"), "pl-4")
								@th(i18n.T(ctx, "workflow.params.type"), "")
								@th(i18n.T(ctx, "workflow.params.default"), "")
								@th(i18n.T(ctx, "workflow.params.what"), "pr-4")
							</tr>
						</thead>
						<tbody class="divide-y divide-line-soft">
							for _, prm := range w.Params {
								<tr>
									<td class="px-2.5 py-2.5 pl-4 align-top">
										<span class="inline-flex items-center gap-1.5 font-mono text-[12.5px] text-ink">
											{ prm.Name }
											if prm.Uses != "" {
												@components.Logo(prm.Uses, 18)
											}
										</span>
										if prm.Group != "" {
											<p class="mt-0.5 text-[11.5px] text-faint">{ prm.Group }</p>
										}
									</td>
									<td class="px-2.5 py-2.5 align-top font-mono text-xs text-muted">{ string(prm.Type) }</td>
									<td class="px-2.5 py-2.5 align-top font-mono text-xs text-ink-2">
										if prm.Default != "" {
											{ prm.Default }
										} else {
											<span class="font-sans text-muted">{ i18n.T(ctx, "workflow.params.required") }</span>
										}
									</td>
									<td class="px-2.5 py-2.5 pr-4 align-top text-[12.5px] text-ink-2">
										if prm.Title != "" {
											<strong class="font-medium text-ink">{ prm.Title }.</strong>
										}
										{ prm.Description }
										if prm.Warn != "" {
											<p class="mt-0.5 text-[11.5px] text-warn">{ prm.Warn }</p>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		@definitionTab(p)
	</div>
}

// stepsCard is the workflow's steps (screen-workflows T8): the graph, or the
// list, by the segment in its heading. The graph's island gets the page's
// words and the logos it draws; under it, the step panel the island fills
// when a step is chosen. With no script the list is what shows -- the graph
// needs one -- and the segment is not drawn.
templ stepsCard(p WorkflowPage, graph string) {
	<section data-steps-view data-view="graph" class="rounded-card border border-line bg-surface shadow-warm-sm">
		<header class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-line-soft px-4 py-2.5">
			<h2 class="text-[13px] font-semibold text-ink">
				{ i18n.T(ctx, "graph.title") }
				<span class="ml-1 font-normal text-faint tabular-nums">{ i18n.N(ctx, "workflows.steps", len(p.Steps)) } · { i18n.N(ctx, "graph.stages", p.Stages) }</span>
			</h2>
			<p class="text-[12.5px] text-muted max-[860px]:hidden">{ i18n.T(ctx, "graph.hint") }</p>
			<div data-js role="group" aria-label={ i18n.T(ctx, "graph.view") } class="ml-auto inline-flex h-8 items-center gap-0.5 rounded-card border border-line bg-surface p-0.5">
				<button type="button" data-view-set="graph" aria-pressed="true" class="steps-view-btn">{ i18n.T(ctx, "graph.view.graph") }</button>
				<button type="button" data-view-set="list" aria-pressed="false" class="steps-view-btn">{ i18n.T(ctx, "graph.view.list") }</button>
			</div>
		</header>
		<div data-view-panel="graph" data-js>
			@templ.Raw(`<script type="application/json" data-dag-text>` + dagText(ctx) + `</script>`)
			<div data-dag-logos hidden>
				for _, k := range p.GraphLogos {
					<span data-logo-key={ k } data-logo-name={ components.LogoTitle(ctx, k) }>
						@components.Logo(k, 18)
					</span>
				}
			</div>
			<div class="p-3">
				@dag("/api/workflows/"+p.Def.Slug+"/graph", graph)
			</div>
			<div data-step-panel class="border-t border-line-soft px-4 py-3 text-[12.5px] text-muted">
				{ i18n.T(ctx, "graph.panel.none") }
			</div>
		</div>
		<div data-view-panel="list" class="overflow-x-auto">
			<table class="ct w-full text-sm">
				<thead>
					<tr class="border-b border-line bg-parchment-soft/60 text-left">
						@th("#", "w-10 pl-4")
						@th(i18n.T(ctx, "graph.list.step"), "")
						@th(i18n.T(ctx, "workflows.col.lang"), "")
						@th(i18n.T(ctx, "graph.list.uses"), "")
						@th(i18n.T(ctx, "graph.list.needs"), "")
						@th(i18n.T(ctx, "graph.list.command"), "")
						@th(i18n.T(ctx, "graph.list.last"), "pr-4 text-right")
					</tr>
				</thead>
				<tbody class="divide-y divide-line-soft">
					for i, r := range p.Steps {
						<tr data-select-step={ r.ID } class="cursor-pointer align-top transition-colors hover:bg-hover">
							<td class="px-2.5 py-2.5 pl-4 text-xs tabular-nums text-faint">{ fmt.Sprintf("%02d", i+1) }</td>
							<td class="px-2.5 py-2.5 font-mono text-[12.5px] text-ink">{ r.ID }</td>
							<td class="px-2.5 py-2.5">
								<span class="inline-flex items-center gap-1.5 text-xs text-ink-2">
									for _, k := range r.Langs {
										@components.Logo(k, 18)
									}
									if len(r.Langs) > 0 {
										{ components.LogoTitle(ctx, r.Langs[0]) }
									}
								</span>
							</td>
							<td class="px-2.5 py-2.5">
								<span class="inline-flex items-center gap-1">
									for _, k := range r.Uses {
										@components.Logo(k, 18)
									}
								</span>
							</td>
							<td class="px-2.5 py-2.5 font-mono text-xs text-muted">
								for j, n := range r.Needs {
									if j > 0 {
										{ ", " }
									}
									<span>{ n }</span>
								}
							</td>
							<td class="max-w-[22rem] truncate px-2.5 py-2.5 font-mono text-xs text-muted" title={ r.Command }>{ r.Command }</td>
							<td class="px-2.5 py-2.5 pr-4 text-right text-xs tabular-nums text-muted">{ lastDuration(r) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

// definitionTab is the workflow as a file: the published definition written
// back as YAML, to read and to copy. It says it is not the author's file --
// the engine keeps the workflow, not the file, so the comments and the
// order of the keys are gone -- and that publishing it publishes the same
// workflow.
templ definitionTab(p WorkflowPage) {
	<section id="definition" data-tab-panel="definition" class="rounded-card border border-line bg-surface shadow-warm-sm">
		<h2 data-panel-heading class="px-4 pt-3 text-[13px] font-semibold text-ink">{ i18n.T(ctx, "workflow.tab.definition") }</h2>
		<p class="px-4 py-2.5 text-[12.5px] text-muted">{ i18n.T(ctx, "workflow.definition.note") }</p>
		<div class="px-4 pb-4">
			if p.YAML != "" {
				@components.CodeBlock("workflow-yaml", p.YAML, nil)
			} else {
				<p class="text-[12.5px] text-muted">{ i18n.T(ctx, "workflow.definition.none") }</p>
			}
		</div>
	</section>
}

// runAction is the page's verb. With parameters it is "Run…", a link to the
// drawer: ui.js opens it as a dialog, and with no script `#run` shows the
// form in place. With none it is the one-click ▶, since there is nothing to
// ask.
func runAction(w wf.Workflow) templ.Component {
	if len(w.Params) == 0 {
		return runNowLink(w.Slug)
	}
	return runLink()
}

// runNowLink is the page's Run… for a workflow with no parameters: the
// trigger's form, and with ui.js the Run dialog.
templ runNowLink(slug string) {
	<form method="post" action={ templ.SafeURL("/workflows/" + slug + "/trigger") }>
		<button type="submit" data-dialogo={ runNowID(slug) } aria-haspopup="dialog" class={ components.ButtonClass(components.ButtonPrimary, components.SizeRegular) }>
			@components.Icon("play", "h-3.5 w-3.5")
			{ i18n.T(ctx, "workflows.run_now.open") }
		</button>
	</form>
}

templ runLink() {
	<a href="#run" data-dialogo="run" aria-haspopup="dialog" class={ components.ButtonClass(components.ButtonPrimary, components.SizeRegular) }>
		@components.Icon("play", "h-3.5 w-3.5")
		Run…
	</a>
}

// runDrawer asks for a run's parameters (screen-workflows T9): the slot, when
// there is a schedule to choose one of; the params by group, each with its own
// control; what will be sent, as JSON and by the CLI; and Run. A native
// <dialog>: Esc closes it and the focus goes back to Run…. It posts to the
// trigger the ▶ does, with its script (data-run-now), so a refused value or
// slot is said here and the drawer stays open; with none, the form posts.
//
// Every control works with no script. ui.js adds what a script can: which
// values changed, their checks -- the server's rules, which the fields carry
// as attributes -- the payload and the CLI line, Restore defaults and ⌘↵.
templ runDrawer(w wf.Workflow, t drawerText) {
	<dialog
		id="run"
		aria-labelledby="run-title"
		class="run-drawer fixed inset-y-0 right-0 left-auto m-0 h-full max-h-none w-[min(560px,100vw)] border-l border-line bg-surface p-0 text-ink backdrop:bg-ink/40"
	>
		<form
			method="post"
			action={ templ.SafeURL("/workflows/" + w.Slug + "/trigger") }
			data-run-form
			data-run-now
			data-slug={ w.Slug }
			data-project={ t.Project }
			data-msg-integer={ i18n.T(ctx, "drawer.check.integer") }
			data-msg-boolean={ i18n.T(ctx, "drawer.check.boolean") }
			data-msg-enum={ i18n.T(ctx, "drawer.check.enum") }
			data-msg-pattern={ i18n.T(ctx, "drawer.check.pattern") }
			data-msg-chars={ i18n.T(ctx, "drawer.check.chars") }
			data-msg-required={ i18n.T(ctx, "drawer.check.required") }
			data-say-defaults={ i18n.T(ctx, "drawer.status.defaults") }
			data-say-changed-one={ i18n.N(ctx, "drawer.status.changed", 1, "n", "{n}") }
			data-say-changed={ i18n.N(ctx, "drawer.status.changed", 2, "n", "{n}") }
			data-say-invalid-one={ i18n.N(ctx, "drawer.status.invalid", 1, "n", "{n}") }
			data-say-invalid={ i18n.N(ctx, "drawer.status.invalid", 2, "n", "{n}") }
			class="flex h-full flex-col"
		>
			<div class="flex items-start justify-between gap-4 border-b border-line px-5 py-4">
				<div class="min-w-0">
					<p class="text-[11px] font-medium tracking-[0.08em] text-muted uppercase">
						if t.Rerun {
							{ i18n.T(ctx, "drawer.title.rerun") }
						} else {
							{ i18n.T(ctx, "drawer.title.run") }
						}
					</p>
					<p id="run-title" class="mt-0.5 truncate font-mono text-[1rem] font-medium text-ink">{ w.Slug }</p>
					if !t.Rerun {
						<p class="mt-1 text-[12.5px] text-muted">{ i18n.T(ctx, "drawer.lead") }</p>
					}
				</div>
				<button type="submit" formmethod="dialog" formnovalidate aria-label={ i18n.T(ctx, "dialog.close") } class="flex h-8 w-8 items-center justify-center rounded-card text-muted transition-colors hover:bg-surface-2 hover:text-ink">
					@components.Icon("x", "h-4 w-4")
				</button>
			</div>
			<div class="flex-1 space-y-4 overflow-y-auto px-5 py-4">
				if t.Slot != nil && t.Slot.Cron != "" {
					@slotPicker(*t.Slot, RecentSlots(t.Slot.Cron, t.Slot.Zone, t.Slot.Now, recentSlotsShown))
					<p class="flex gap-2 rounded-card border border-line-soft bg-surface-2 px-3 py-2 text-[12px] text-muted">
						@components.Icon("info", "mt-0.5 h-3.5 w-3.5")
						{ i18n.T(ctx, "drawer.slot.note") }
					</p>
				}
				if t.NoteSlot != nil {
					<p data-rerun-note class="rounded-card border border-line-soft bg-surface-2 px-3 py-2 text-[12px] text-muted">{ i18n.T(ctx, "drawer.rerun.note", "slot", components.UTCStamp(t.NoteSlot)) }</p>
				}
				for _, g := range paramGroups(w.Params) {
					<div class="space-y-2.5">
						if g.Name != "" {
							<h3 data-param-group={ g.Name } class="pt-1 text-[13px] font-semibold text-ink">{ g.Name }</h3>
						}
						for _, p := range g.Params {
							@paramField(p)
						}
					</div>
				}
				for _, name := range t.Dropped {
					<p class="font-mono text-[0.8rem] text-faint">{ name } <span class="font-sans text-[0.72rem]">{ i18n.T(ctx, "drawer.dropped") }</span></p>
				}
				<details open data-run-preview hidden class="rounded-card border border-line-soft">
					<summary class="cursor-pointer px-3 py-2 text-[0.78rem] text-muted">{ i18n.T(ctx, "drawer.payload") }</summary>
					<div class="space-y-2 px-3 pb-3">
						<pre class="overflow-x-auto rounded-card border border-line-soft bg-canvas px-3 py-2 font-mono text-[0.75rem] text-ink-2"><code></code></pre>
						<p class="text-[0.75rem] text-muted">{ i18n.T(ctx, "drawer.cli") }</p>
						<pre data-run-cli class="overflow-x-auto rounded-card border border-line-soft bg-canvas px-3 py-2 font-mono text-[0.75rem] text-ink-2"></pre>
					</div>
				</details>
				<p data-run-error role="alert" hidden class="rounded-card border border-state-failed/40 bg-state-failed/10 px-3 py-2 text-[12.5px] text-state-failed"></p>
			</div>
			<div class="flex items-center gap-3 border-t border-line px-5 py-3">
				<p data-run-status aria-live="polite" class="min-w-0 flex-1 truncate text-[12.5px] text-muted"></p>
				<button type="button" data-run-reset data-js class="text-[12.5px] text-ink hover:underline">{ i18n.T(ctx, "drawer.reset") }</button>
				<button type="submit" class={ components.ButtonClass(components.ButtonPrimary, components.SizeRegular) }>
					@components.Icon("play", "h-3.5 w-3.5")
					if t.Rerun {
						{ i18n.T(ctx, "drawer.button.rerun") }
					} else {
						{ i18n.T(ctx, "drawer.button.run") }
					}
					<kbd data-js class="ml-1 rounded border border-current/30 px-1 font-sans text-[10px] opacity-70">⌘↵</kbd>
				</button>
			</div>
		</form>
	</dialog>
}

// slotPicker is "Now" or "Another slot": the schedule's last slots, each
// with the window it processes, or a date and time of one's own. The Run
// dialog and the drawer share it, and ui.js shows what was asked for.
templ slotPicker(r RunNow, slots []Slot) {
			<fieldset class="space-y-2">
				<legend class="mb-1.5 font-medium text-ink">{ i18n.T(ctx, "workflows.run_now.slot") }</legend>
				<div class="inline-flex h-8 items-center gap-0.5 rounded-card border border-line bg-surface p-0.5">
					<label class="run-when">
						<input type="radio" name="when" value="now" checked class="sr-only"/>
						{ i18n.T(ctx, "workflows.run_now.now") }
					</label>
					<label class="run-when">
						<input type="radio" name="when" value="slot" class="sr-only"/>
						{ i18n.T(ctx, "workflows.run_now.other") }
					</label>
				</div>
				<div data-slot-pick hidden class="space-y-2">
					<select name="slot" aria-label={ i18n.T(ctx, "workflows.run_now.slot") } class="h-8 w-full rounded-card border border-line bg-surface px-2.5 text-[0.82rem] text-ink">
						for _, sl := range slots {
							<option value={ sl.At.Format(time.RFC3339) }>{ slotLabel(ctx, sl, r.Zone) }</option>
						}
						<option value="other">{ i18n.T(ctx, "workflows.run_now.another") }</option>
					</select>
					<input type="datetime-local" name="slot_at" step="60" data-slot-other hidden aria-label={ i18n.T(ctx, "workflows.run_now.another") } class="h-8 w-full rounded-card border border-line bg-surface px-2.5 text-[0.82rem] text-ink"/>
					<p class="text-xs text-muted">{ i18n.T(ctx, "workflows.run_now.zone", "zone", zoneName(r.Zone)) }</p>
				</div>
			</fieldset>
}

// paramField is one parameter (screen-workflows T9): its name, a mark that
// lights when it differs from its default, the connector it bills and its
// default; its title and description; its control; and, under it, its
// error and its warning. The card carries the server's rules for its value
// as attributes -- type, enum, pattern -- which is what ui.js checks against,
// so the browser refuses what the server would refuse again, and no rule is
// written twice by hand.
//
// The `name` carries a `param.` prefix so it does not collide with the
// form's own fields. Every control posts with no script: a boolean is a
// select (a switch drives it with one), an integer a number, an enum a
// select, a list its boxes or its comma-separated text.
templ paramField(p wf.Param) {
	<div
		data-param={ p.Name }
		data-field={ "param." + p.Name }
		data-default={ p.Default }
		data-type={ string(p.Type) }
		data-enum={ strings.Join(p.Enum, ",") }
		data-pattern={ p.Pattern }
		class="rounded-card border border-line bg-surface px-3.5 py-3"
	>
		<div class="flex flex-wrap items-center gap-2">
			<span class="font-mono text-[13px] font-medium text-ink">{ p.Name }</span>
			<span data-param-changed hidden title={ i18n.T(ctx, "drawer.changed") } class="h-2 w-2 rounded-full bg-warn"></span>
			if p.Uses != "" {
				<span class="inline-flex items-center gap-1 text-[12.5px] text-ink">
					@components.Logo(p.Uses, 18)
					{ components.LogoTitle(ctx, p.Uses) }
				</span>
			}
			<span class="ml-auto text-xs text-muted">
				if p.Default != "" {
					{ i18n.T(ctx, "drawer.default", "value", p.Default) }
				} else {
					{ i18n.T(ctx, "workflow.params.required") }
				}
			</span>
		</div>
		if p.Title != "" || p.Description != "" {
			<p class="mt-1 text-[12.5px] text-muted">
				if p.Title != "" {
					<strong class="font-medium text-ink">{ p.Title }.</strong>
				}
				{ p.Description }
			</p>
		}
		<div class="mt-2">
			switch {
				case p.Type == wf.ParamBool:
					<select name={ "param." + p.Name } data-no-js class="h-8 rounded-card border border-line bg-surface px-2.5 text-[0.82rem] text-ink">
						@option("false", p.Default)
						@option("true", p.Default)
					</select>
					<span data-js class="inline-flex items-center gap-2">
						<button type="button" role="switch" aria-checked={ boolText(p.Default == "true") } aria-label={ p.Name } data-bool-for={ "param." + p.Name } data-manual class="switch"><span class="switch-knob" aria-hidden="true"></span></button>
						<code data-bool-value class="font-mono text-[12px] text-ink-2">{ boolValue(p.Default) }</code>
					</span>
				case p.Type == wf.ParamInteger:
					<span class="inline-flex items-stretch">
						<button type="button" data-step="-1" data-js aria-label="−" class="w-8 rounded-l-card border border-line text-muted hover:bg-hover hover:text-ink">−</button>
						<input type="number" name={ "param." + p.Name } value={ p.Default } step="1" inputmode="numeric" class="h-8 w-28 border-y border-line bg-surface px-2.5 text-center font-mono text-[0.82rem] text-ink focus:border-accent-strong focus:outline-none max-[0px]:border-x"/>
						<button type="button" data-step="1" data-js aria-label="+" class="w-8 rounded-r-card border border-line text-muted hover:bg-hover hover:text-ink">+</button>
					</span>
				case p.Type.IsList() && len(p.Enum) > 0:
					@listaComEnum(p)
				case p.Type.IsList():
					@listaLivre(p)
				case len(p.Enum) > 0:
					<select name={ "param." + p.Name } class="h-8 rounded-card border border-line bg-surface px-2.5 text-[0.82rem] text-ink">
						for _, v := range p.Enum {
							@option(v, p.Default)
						}
					</select>
				default:
					<input
						type="text"
						name={ "param." + p.Name }
						value={ p.Default }
						class="h-8 w-full rounded-card border border-line bg-surface px-2.5 font-mono text-[0.82rem] text-ink placeholder:text-faint focus:border-accent-strong focus:outline-none"
					/>
			}
		</div>
		if p.Pattern != "" {
			<p class="mt-1 text-xs text-faint">{ i18n.T(ctx, "drawer.pattern") } <code class="font-mono text-ink-2">{ p.Pattern }</code></p>
		}
		<p data-param-error role="alert" hidden class="mt-1 text-xs text-state-failed"></p>
		if p.Warn != "" {
			<p data-param-warn class="mt-1 text-xs text-warn">{ p.Warn }</p>
		}
	</div>
}

// A list with an enum is a multi-select, and checkboxes are what a browser
// already does well: they need no JavaScript, they are reachable by keyboard,
// and the browser sends one value per box ticked -- which the handler joins
// with commas, the same shape the value has everywhere else.
//
// The hidden empty value is what makes "none of them" different from "the
// operator did not touch this": with every box unticked the key would otherwise
// be absent from the form, and the resolver would fall back to the default.
templ listaComEnum(p wf.Param) {
	<input type="hidden" name={ "param." + p.Name } value=""/>
	<div class="flex flex-wrap gap-x-3 gap-y-1 rounded-xl border border-line bg-parchment-soft px-3 py-2">
		for _, v := range p.Enum {
			<label class="flex items-center gap-1.5 text-sm text-ink">
				if marcado(v, p.Default) {
					<input type="checkbox" name={ "param." + p.Name } value={ v } checked class="accent-ink"/>
				} else {
					<input type="checkbox" name={ "param." + p.Name } value={ v } class="accent-ink"/>
				}
				<span class="font-mono text-xs">{ v }</span>
			</label>
		}
	</div>
}

// A list with no enum is free text, and the separator is the comma the value
// already uses. `data-lista` is the hook for the chips: with JavaScript the
// items become removable pills, and without it this stays a text field that
// works -- which is the rule the rest of this interface follows.
templ listaLivre(p wf.Param) {
	<input
		type="text"
		name={ "param." + p.Name }
		value={ p.Default }
		data-lista={ string(p.Type.ElementType()) }
		placeholder={ i18n.T(ctx, "drawer.list.placeholder") }
		class="rounded-xl border border-line bg-parchment-soft px-3 py-2 font-mono text-sm text-ink placeholder:text-muted/60"
	/>
}

templ option(value, fallback string) {
	if value == fallback {
		<option value={ value } selected>{ value }</option>
	} else {
		<option value={ value }>{ value }</option>
	}
}

// marcado answers whether this enum value is in the param's default, which for
// a list is a comma-separated set rather than a single value.
func marcado(value, deflt string) bool {
	for _, item := range strings.Split(deflt, ",") {
		if strings.TrimSpace(item) == value {
			return true
		}
	}
	return false
}

