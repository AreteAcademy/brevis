package pages

import (
	"github.com/AreteAcademy/brevis/web/assets"
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/AreteAcademy/brevis/internal/domain/run"
	wf "github.com/AreteAcademy/brevis/internal/domain/workflow"
	"github.com/AreteAcademy/brevis/internal/alerts"
	"github.com/AreteAcademy/brevis/internal/infrastructure/postgres"
	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/layouts"
)

// ---------------------------------------------------------------------------
// Overview
// ---------------------------------------------------------------------------

// OverviewData is everything the landing screen shows. A struct rather than
// seven parameters: the signature was already illegible with four.
type OverviewData struct {
	Window    time.Duration
	Ind       postgres.Indicators
	Buckets    []postgres.Bucket
	EmCurso   []postgres.RunSummary
	Proximas  []NextRun
	Recentes  []postgres.RunSummary
	Pending int
}

// ProximaExecucao is a future trigger, already computed from the cron.
type NextRun struct {
	Workflow string
	Cron     string
	Timezone string
	When   time.Time
}

templ Overview(d OverviewData) {
	@layouts.Base(layouts.Page{Title: "Overview", Kicker: "Dashboard", Active: "overview"}) {
		<div class="grid grid-cols-2 gap-5 lg:grid-cols-4">
			@components.Metric("Success rate", pct(d.Ind.Ratio(d.Ind.Succeeded)),
				fmt.Sprintf("%d of %d finished", d.Ind.Succeeded, d.Ind.Succeeded+d.Ind.Failed), "text-state-success")
			@components.Metric("Failure rate", pct(d.Ind.Ratio(d.Ind.Failed)),
				failureNote(d.Ind.Failed), failureHue(d.Ind.Failed))
			@components.Metric("Running", fmt.Sprint(d.Ind.Running),
				meanDuration(d.Ind.MeanDuration), "text-state-running")
			@components.Metric("Queued", fmt.Sprint(d.Ind.Pending),
				fmt.Sprintf("%d items queued", d.Pending), "text-state-queued")
		</div>
		<div class="mt-6 grid grid-cols-1 gap-5 xl:grid-cols-[1fr_320px]">
			@components.Card("Runs per hour") {
				<p class="-mt-2 mb-5 text-sm text-muted">
					Count and average duration over the last { fmt.Sprint(int(d.Window.Hours())) } hours.
				</p>
				@components.RunsChart(d.Buckets)
			}
			@components.Card("Distribution") {
				@components.Rosca(d.Ind)
				<dl class="mt-4 space-y-1.5 text-sm">
					@distLine("Success", d.Ind.Succeeded, "bg-state-success")
					@distLine("Failure", d.Ind.Failed, "bg-state-failed")
					@distLine("Running", d.Ind.Running, "bg-state-running")
					@distLine("Queued", d.Ind.Pending, "bg-state-queued")
				</dl>
			}
		</div>
		<div class="mt-6 grid grid-cols-1 gap-5 xl:grid-cols-2">
			@components.Card("In progress") {
				if len(d.EmCurso) == 0 {
					@components.Empty("Nothing running right now.", "")
				} else {
					<table class="w-full text-sm">
						<thead>
							<tr class="border-b border-line text-left">
								@th("Workflow", "")
								@th("Trigger", "")
								@th("Started", "")
								@th("State", "text-right")
							</tr>
						</thead>
						<tbody class="divide-y divide-line-soft">
							for _, r := range d.EmCurso {
								<tr>
									<td class="py-2.5 pr-3">
										<a href={ templ.SafeURL("/runs/" + r.ID) } class="font-medium text-ink hover:text-gold-strong">
											{ r.WorkflowSlug }
										</a>
									</td>
									<td class="py-2.5 pr-3 text-xs text-muted">{ r.TriggerType }</td>
									<td class="py-2.5 pr-3 text-xs text-muted tabular-nums">
										{ components.When(startOrCreated(r)) }
									</td>
									<td class="py-2.5 text-right">
										@components.State(r.Status)
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			}
			@components.Card("Upcoming runs") {
				if len(d.Proximas) == 0 {
					@components.Empty("No active schedule.", "brevis publish file.yaml")
				} else {
					<table class="w-full text-sm">
						<thead>
							<tr class="border-b border-line text-left">
								@th("Workflow", "")
								@th("Schedule", "")
								@th("Next trigger", "text-right")
							</tr>
						</thead>
						<tbody class="divide-y divide-line-soft">
							for _, p := range d.Proximas {
								<tr>
									<td class="py-2.5 pr-3">
										<a href={ templ.SafeURL("/workflows/" + p.Workflow) } class="font-medium text-ink hover:text-gold-strong">
											{ p.Workflow }
										</a>
									</td>
									<td class="py-2.5 pr-3 font-mono text-xs text-muted">{ p.Cron }</td>
									<td class="py-2.5 text-right text-xs tabular-nums text-muted">
										<span class="text-ink">{ components.Timestamp(&p.When) }</span>
										<span class="ml-2 text-gold-strong">{ components.When(&p.When) }</span>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			}
		</div>
		<section class="mt-6">
			<div class="mb-3 flex items-baseline justify-between">
				<h2 class="kicker">Recent runs</h2>
				<a href="/runs" class="text-xs text-gold-strong hover:underline">see all</a>
			</div>
			@runsTable(d.Recentes, Pagination{})
		</section>
	}
}

templ distLine(label string, value int, matiz string) {
	<div class="flex items-center gap-2">
		<span class={ "h-2 w-2 shrink-0 rounded-full", matiz }></span>
		<dt class="flex-1 text-muted">{ label }</dt>
		<dd class="font-medium tabular-nums text-ink">{ fmt.Sprint(value) }</dd>
	</div>
}

// th is a column header. The vertical breathing room (py-4) is deliberate:
// pressed against the title, the header competed with the first row instead of
// separating from it.
templ th(text, extra string) {
	<th class={ "px-3 py-4 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-muted", extra }>{ text }</th>
}

// sortableTh is the same column, clickable. The arrow appears only on the
// active column — one in every header becomes noise.
templ sortableTh(text, field string, f Filter, extra string) {
	<th class={ "px-3 py-4 text-[0.7rem] font-semibold uppercase tracking-[0.12em]", extra, columnColour(f, field) }>
		<a href={ templ.SafeURL(f.WithSort(field)) } class="inline-flex items-center gap-1 hover:text-gold-strong">
			{ text }
			if s := f.Arrow(field); s != "" {
				<span class="text-gold">{ s }</span>
			} else {
				<span class="text-line">↕</span>
			}
		</a>
	</th>
}

func columnColour(f Filter, field string) string {
	if f.Sort == field {
		return "text-ink"
	}
	return "text-muted"
}

// paginacao is the lists' footer.
templ pagination(p Pagination) {
	if p.Total > 0 {
		<div class="flex flex-wrap items-center justify-between gap-4 border-t border-line px-6 py-4 text-xs text-muted">
			<span>
				{ fmt.Sprintf("%d–%d of %d", p.First(), p.Last(), p.Total) }
			</span>
			if p.Pages() > 1 {
				<nav class="flex items-center gap-1">
					if p.Page > 1 {
						<a href={ templ.SafeURL(p.PageLink(p.Page - 1)) } class="rounded-card border border-line px-3 py-1 transition-colors hover:border-gold hover:text-ink">previous</a>
					} else {
						<span class="rounded-card border border-line-soft px-3 py-1 text-line">previous</span>
					}
					for _, n := range p.Window() {
						if n == p.Page {
							<span class="rounded-card border border-ink bg-ink px-3 py-1 font-medium text-surface">{ fmt.Sprint(n) }</span>
						} else {
							<a href={ templ.SafeURL(p.PageLink(n)) } class="rounded-card border border-line px-3 py-1 transition-colors hover:border-gold hover:text-ink">{ fmt.Sprint(n) }</a>
						}
					}
					if p.Page < p.Pages() {
						<a href={ templ.SafeURL(p.PageLink(p.Page + 1)) } class="rounded-card border border-line px-3 py-1 transition-colors hover:border-gold hover:text-ink">next</a>
					} else {
						<span class="rounded-card border border-line-soft px-3 py-1 text-line">next</span>
					}
				</nav>
			}
		</div>
	}
}

// ---------------------------------------------------------------------------
// Workflows — a lista de DAGs
// ---------------------------------------------------------------------------

// Filter holds the search bar's state. It lives in the URL, not in memory: that
// way an applied filter can be pasted into the on-call chat and opens the same
// on the other
// lado.
type Filter struct {
	Search  string
	State string // ultimo estado: failed, queued, running, success
	Active  string // active | paused

	// Tags is a set: a workflow must carry ALL of them. One `tag=` each in the
	// URL, in the order they were chosen.
	Tags []string

	// Project scopes the list to one project's workflows. It is what makes a
	// project more than a row on a screen: the slug is unique WITHIN a project,
	// so two of them can each have a `daily_ingest`, and until this existed
	// there was no way to look at one project's half of that.
	Project string

	// Sort is the sort field; Desc inverts it. They live in the URL for the same
	// reason the filters do: a sorted screen has to be pasteable to somebody
	// else.
	Sort string
	Desc  bool

	Page    int
	PerPage int
}

// With returns the same URL with one field swapped — since every chip becomes a
// link, the rest of the filter has to survive the click.
//
// Changing a filter always returns to the first page: staying on page 7 of a
// result that now has two would be an empty screen with no explanation.
func (f Filter) With(field, value string) string {
	return f.url(field, value, true)
}

// WithTag toggles one tag in the set: a tag not chosen joins it, a chosen one
// leaves it and the others stay.
func (f Filter) WithTag(tag string) string {
	g := f
	g.Tags = nil
	found := false
	for _, t := range f.Tags {
		if t == tag {
			found = true
			continue
		}
		g.Tags = append(g.Tags, t)
	}
	if !found {
		g.Tags = append(g.Tags, tag)
	}
	return g.url("page", "", true)
}

// HasTag says whether the tag is chosen.
func (f Filter) HasTag(tag string) bool {
	for _, t := range f.Tags {
		if t == tag {
			return true
		}
	}
	return false
}

// WithPage navigates without touching anything else.
func (f Filter) WithPage(n int) string {
	return f.url("page", fmt.Sprint(n), false)
}

// WithSort flips the direction when the field is already the sorted one, and
// starts ascending when it is another — the behaviour any table teaches.
func (f Filter) WithSort(field string) string {
	if f.Sort == field && !f.Desc {
		return f.url("dir", "desc", true)
	}
	if f.Sort == field && f.Desc {
		// Terceiro clique remove a ordenacao e volta a ordem natural.
		g := f
		g.Sort, g.Desc = "", false
		return g.url("page", "", true)
	}
	g := f
	g.Desc = false
	return g.url("sort", field, true)
}

// Arrow is the direction indicator in the header.
func (f Filter) Arrow(field string) string {
	if f.Sort != field {
		return ""
	}
	if f.Desc {
		return "↓"
	}
	return "↑"
}

func (f Filter) url(field, value string, resetsPage bool) string {
	q := url.Values{}
	put := func(k, v string) {
		if v != "" {
			q.Set(k, v)
		}
	}
	put("q", f.Search)
	put("state", f.State)
	put("active", f.Active)
	for _, t := range f.Tags {
		q.Add("tag", t)
	}
	put("project", f.Project)
	put("sort", f.Sort)
	if f.Desc {
		put("dir", "desc")
	}
	if !resetsPage && f.Page > 1 {
		put("page", fmt.Sprint(f.Page))
	}
	if f.PerPage > 0 && f.PerPage != DefaultPerPage {
		put("per", fmt.Sprint(f.PerPage))
	}
	if value == "" {
		q.Del(field)
	} else {
		q.Set(field, value)
	}
	if len(q) == 0 {
		return "/workflows"
	}
	return "/workflows?" + q.Encode()
}

// DefaultPerPage is the lists' page size. Twenty-five fits a laptop screen
// without endless scrolling and without forcing a page turn on every glance.
const DefaultPerPage = 25

// Pagination is the footer of any paginated list.
type Pagination struct {
	Page    int
	PerPage int
	Total     int

	// PageLink builds each page's URL. Injected so the same component serves
	// /workflows and /runs, which have different filters.
	PageLink func(int) string
}

func (p Pagination) Pages() int {
	if p.PerPage <= 0 {
		return 1
	}
	n := (p.Total + p.PerPage - 1) / p.PerPage
	if n < 1 {
		return 1
	}
	return n
}

func (p Pagination) First() int {
	if p.Total == 0 {
		return 0
	}
	return (p.Page-1)*p.PerPage + 1
}

func (p Pagination) Last() int {
	end := p.Page * p.PerPage
	if end > p.Total {
		return p.Total
	}
	return end
}

// Window returns the page numbers to show, centred on the current one. Listing
// them all would break the footer with a hundred pages.
func (p Pagination) Window() []int {
	total := p.Pages()
	de, ate := p.Page-2, p.Page+2
	if de < 1 {
		ate += 1 - de
		de = 1
	}
	if ate > total {
		de -= ate - total
		ate = total
	}
	if de < 1 {
		de = 1
	}
	var out []int
	for i := de; i <= ate; i++ {
		out = append(out, i)
	}
	return out
}

templ Workflows(ws []postgres.WorkflowSummary, tags []string, f Filter, counts WorkflowCounts, recent map[string][]postgres.RecentRun, total, filtered int) {
	@layouts.Base(layouts.Page{Title: "Workflows", Kicker: "Orchestration", Active: "workflows"}) {
		// THE BOX ANSWERS WHILE SOMEBODY TYPES, and the server still decides:
		// the list is paginated, so ui.js submits this form as a fetch
		// (`data-swap-typing`) and swaps the list the handler draws alone. With
		// no script it is the GET form it always was, and Enter submits it.
		// The other filters go along as hidden fields: searching must not erase
		// the state the operator had already chosen.
		<form method="get" action="/workflows" role="search" data-swap="workflows-list" data-swap-typing class="mb-3 w-full sm:w-80">
			for _, h := range f.hidden() {
				<input type="hidden" name={ h[0] } value={ h[1] }/>
			}
			@components.SearchInput("q", f.Search, "Search workflows", "")
		</form>
		<div id="workflows-list">
			@WorkflowsList(ws, tags, f, counts, recent, total, filtered)
		</div>
	}
}

// WorkflowsList is everything under the search box: the filters, the count,
// the table and its pages. It is the page's fragment (X-Brevis-Fragment:
// answer), so the counts follow the search as somebody types.
templ WorkflowsList(ws []postgres.WorkflowSummary, tags []string, f Filter, counts WorkflowCounts, recent map[string][]postgres.RecentRun, total, filtered int) {
	<div class="mb-6 flex flex-wrap items-center gap-2">
		// Each control scrolls on its own when the screen is narrower than its
		// choices, rather than cutting the last one off.
		<div class="max-w-full overflow-x-auto whitespace-nowrap">
			@components.Segmented("State", stateOptions(f, counts))
		</div>
		<div class="max-w-full overflow-x-auto whitespace-nowrap">
			@components.Segmented("Schedule", scheduleOptions(f, counts))
		</div>
		if len(tags) > 0 {
			@tagPopover(tags, f)
			for _, t := range f.Tags {
				<a
					href={ templ.SafeURL(f.WithTag(t)) }
					aria-label={ "Remove the tag " + t }
					class="inline-flex h-8 items-center gap-1.5 rounded-card border border-accent bg-accent-wash px-2.5 text-[0.8rem] text-ink"
				>
					{ t }
					<span class="text-muted">&times;</span>
				</a>
			}
		}
		// The project chip appears only when one is selected. There is no
		// row of every project here on purpose: a project is a namespace,
		// not a category, and most installations have one -- a permanent
		// chip for a filter that is almost never on is noise.
		if f.Project != "" {
			<span class="mx-2 h-5 w-px bg-line"></span>
			<a
				href={ templ.SafeURL(f.With("project", "")) }
				class="inline-flex items-center gap-1.5 rounded-card border border-accent bg-accent-wash px-3 py-1 text-xs text-ink"
			>
				project: <span class="font-mono">{ f.Project }</span>
				<span class="text-muted">&times;</span>
			</a>
		}
	</div>
	<p class="display mb-3 text-lg text-ink">
		{ count(filtered, "workflow", "workflows") }
		if filtered != total {
			<span class="ml-2 text-sm text-muted">of { fmt.Sprint(total) }</span>
			<a href="/workflows" class="ml-3 text-xs text-gold-strong hover:underline">clear filters</a>
		}
	</p>
	if len(ws) == 0 {
		@components.Empty("No workflow matches these filters.", "brevis publish file.yaml")
	} else {
		<div class="overflow-x-auto rounded-card border border-line bg-surface shadow-warm-sm">
			<table class="w-full min-w-[56rem] text-sm">
				<thead>
					<tr class="border-b border-line bg-parchment-soft/60 text-left">
						@th("", "w-16 pl-6")
						@sortableTh("Workflow", "workflow", f, "")
						@sortableTh("Schedule", "schedule", f, "")
						@sortableTh("Next run", "next", f, "")
						@sortableTh("Last run", "last", f, "")
						@th("Tags", "")
						@th("", "w-24 pr-6 text-right")
					</tr>
				</thead>
				<tbody class="divide-y divide-line-soft">
					for _, w := range ws {
						<tr class="transition-colors hover:bg-gold-wash">
							<td class="py-3 pl-6">
								@interruptor(w)
							</td>
							<td class="py-3 pr-3">
								<a href={ templ.SafeURL("/workflows/" + w.Slug) } class="font-medium text-ink hover:text-gold-strong">
									{ w.Slug }
								</a>
								<a
									href={ templ.SafeURL("/workflows?project=" + w.Project) }
									class="text-xs text-muted hover:text-accent-strong hover:underline"
								>{ w.Project }</a>
							</td>
							<td class="py-3 pr-3">
								if w.Cron == "" {
									<span class="text-xs text-muted">manual trigger only</span>
								} else {
									<span class="inline-flex items-center gap-1.5 font-mono text-xs text-ink">
										<svg class="h-3.5 w-3.5 text-gold" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
											<rect x="2" y="3" width="12" height="11" rx="2"></rect>
											<path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3" stroke-linecap="round"></path>
										</svg>
										{ w.Cron }
									</span>
									if w.Catchup {
										<span class="ml-2 text-[0.7rem] text-gold-strong">catchup</span>
									}
									if words := CronText(w.Cron); words != "" {
										<p data-cron-text class="mt-0.5 text-[0.7rem] text-muted">{ words }{ zoneSuffix(w.Timezone) }</p>
									}
								}
							</td>
							<td class="py-3 pr-3 text-xs tabular-nums">
								if w.NextRun != nil {
									<span class="text-ink">{ components.Timestamp(w.NextRun) }</span>
									<span class="ml-1.5 text-muted">{ components.When(w.NextRun) }</span>
								} else if w.HasSchedule && !w.Active {
									<span class="text-muted">paused</span>
								} else {
									<span class="text-muted">—</span>
								}
							</td>
							<td class="py-3 pr-3">
								if w.LastRunID != nil {
									@recentRuns(recent[w.Slug])
									<a href={ templ.SafeURL("/runs/" + *w.LastRunID) } class="mt-1 block text-[0.7rem] tabular-nums text-muted hover:text-gold-strong">
										{ components.Timestamp(w.LastRunAt) } · { count(w.TotalRuns, "run", "runs") }
									</a>
								} else {
									<span class="text-xs text-muted">never ran</span>
								}
							</td>
							<td class="py-3 pr-3">
								<div class="flex flex-wrap gap-1">
									for _, t := range w.Tags {
										@components.Tag(t, f.WithTag(t))
									}
								</div>
							</td>
							<td class="py-3 pr-6 text-right">
								@disparar(w.Slug)
							</td>
						</tr>
					}
				</tbody>
			</table>
			@pagination(Pagination{
				Page: f.Page, PerPage: f.PerPage, Total: filtered,
				PageLink: f.WithPage,
			})
		</div>
	}
}

// recentRuns is a workflow's last runs as a strip of squares, oldest to
// newest, each a link to its run whose title says its state and time, in the
// state's colour.
templ recentRuns(runs []postgres.RecentRun) {
	if len(runs) > 0 {
		<div data-recent-runs class="flex items-center gap-0.5">
			for _, r := range runs {
				<a
					href={ templ.SafeURL("/runs/" + r.ID) }
					title={ recentTitle(r) }
					aria-label={ recentTitle(r) }
					class={ "h-3 w-2 rounded-[1px] transition-opacity hover:opacity-70", components.StateFill(r.Status) }
				></a>
			}
		</div>
	}
}

// tagPopover chooses the tags. It is a <details> holding a GET form -- the
// rest of the filter as hidden fields, a box that filters the tag list, one
// checkbox per tag, Apply -- so with no script it opens, is checked and is
// submitted like any form. With ui.js a checked box submits at once
// (`data-submit-on-change`), and the box filters the list as you type.
templ tagPopover(tags []string, f Filter) {
	<details data-popover class="relative">
		<summary class="inline-flex h-8 cursor-pointer list-none items-center gap-1.5 rounded-card border border-line bg-surface px-2.5 text-[0.8rem] text-muted transition-colors duration-150 hover:text-ink [&::-webkit-details-marker]:hidden">
			@components.Icon("tag", "h-3.5 w-3.5")
			Tags
			if len(f.Tags) > 0 {
				<span class="text-[0.72rem] text-ink tabular-nums">{ fmt.Sprint(len(f.Tags)) }</span>
			}
		</summary>
		<div class="absolute left-0 z-20 mt-1 w-64 rounded-card border border-line bg-surface p-2 shadow-warm-sm">
			<form method="get" action="/workflows" data-submit-on-change>
				for _, h := range f.tagFormHidden() {
					<input type="hidden" name={ h[0] } value={ h[1] }/>
				}
				<input
					type="search"
					aria-label="Filter tags"
					placeholder="Filter tags"
					data-filter-for="workflow-tags"
					autocomplete="off"
					class="mb-2 h-8 w-full rounded-card border border-line bg-surface px-2.5 text-[0.82rem] text-ink placeholder:text-faint focus:border-accent-strong focus:outline-none"
				/>
				<ul id="workflow-tags" class="max-h-60 overflow-y-auto">
					for _, t := range tags {
						<li data-filter-row data-filter-text={ strings.ToLower(t) }>
							<label class="flex cursor-pointer items-center gap-2 rounded-[2px] px-1.5 py-1 text-[0.82rem] text-ink hover:bg-surface-2">
								<input type="checkbox" name="tag" value={ t } checked?={ f.HasTag(t) } class="accent-accent-strong"/>
								{ t }
							</label>
						</li>
					}
				</ul>
				<p data-filter-empty hidden class="px-1.5 py-1 text-[0.8rem] text-muted">No tag matches.</p>
				<button type="submit" class="mt-2 h-7 w-full rounded-card bg-ink text-xs font-medium text-surface">Apply</button>
			</form>
		</div>
	</details>
}

// interruptor pauses and resumes the schedule. It is a form, and not a checkbox
// with JS: with no script the page stays operable, and a POST makes it clear
// there is an effect.
templ interruptor(w postgres.WorkflowSummary) {
	if w.HasSchedule {
		<form method="post" action={ templ.SafeURL("/workflows/" + w.Slug + "/toggle") }>
			if w.Active {
				<button
					type="submit"
					title="Pause the schedule"
					aria-label={ "Pausar " + w.Slug }
					class="flex h-5 w-9 items-center rounded-full bg-state-success/80 px-0.5 transition-colors hover:bg-state-success"
				>
					<span class="ml-auto h-4 w-4 rounded-full bg-surface shadow-sm"></span>
				</button>
			} else {
				<button
					type="submit"
					title="Resume the schedule"
					aria-label={ "Retomar " + w.Slug }
					class="flex h-5 w-9 items-center rounded-full bg-line px-0.5 transition-colors hover:bg-muted/40"
				>
					<span class="h-4 w-4 rounded-full bg-surface shadow-sm"></span>
				</button>
			}
		</form>
	} else {
		<span class="block h-5 w-9" title="No schedule: manual trigger only"></span>
	}
}

// disparar is the button with no parameters — used in the LIST, where there is
// no room for a form and where the defaults are the right choice.
templ disparar(slug string) {
	<form method="post" action={ templ.SafeURL("/workflows/" + slug + "/trigger") } class="inline">
		<button
			type="submit"
			title="Run now"
			aria-label={ "Run " + slug }
			class="inline-flex h-8 w-8 items-center justify-center rounded-card border border-line text-gold-strong transition-colors hover:border-gold hover:bg-gold-wash"
		>
			<svg class="h-3.5 w-3.5" viewBox="0 0 12 12" fill="currentColor"><path d="M2.5 1.6v8.8L10 6z"></path></svg>
		</button>
	</form>
}

templ chip(rota, text string, active1 bool, ponto string) {
	if active1 {
		<a href={ templ.SafeURL(rota) } class="inline-flex items-center gap-1.5 rounded-card border border-ink bg-ink px-3.5 py-1.5 text-xs font-medium text-surface">
			if ponto != "" {
				<span class={ "h-1.5 w-1.5 rounded-full", ponto }></span>
			}
			{ text }
		</a>
	} else {
		<a href={ templ.SafeURL(rota) } class="inline-flex items-center gap-1.5 rounded-card border border-line bg-surface px-3.5 py-1.5 text-xs text-muted transition-colors hover:border-gold hover:text-ink">
			if ponto != "" {
				<span class={ "h-1.5 w-1.5 rounded-full", ponto }></span>
			}
			{ text }
		</a>
	}
}


// ---------------------------------------------------------------------------
// Runs, projects and detail
// ---------------------------------------------------------------------------

// RunFilter is the run screen's slice. It arrives through the query string, so
// a dashboard chart can point at "that hour's runs" with a link.
type RunFilter struct {
	State   string
	Workflow string
	De       string // YYYY-MM-DDTHH, the same format the chart emits
	Ate      string
	Label   string // descricao legivel do periodo, montada no servidor

	Page    int
	PerPage int
}

func (f RunFilter) url(field, value string, resetsPage bool) string {
	q := url.Values{}
	put := func(k, v string) {
		if v != "" {
			q.Set(k, v)
		}
	}
	put("state", f.State)
	put("workflow", f.Workflow)
	put("from", f.De)
	put("to", f.Ate)
	if !resetsPage && f.Page > 1 {
		put("page", fmt.Sprint(f.Page))
	}
	if value == "" {
		q.Del(field)
	} else {
		q.Set(field, value)
	}
	if len(q) == 0 {
		return "/runs"
	}
	return "/runs?" + q.Encode()
}

func (f RunFilter) With(field, value string) string { return f.url(field, value, true) }
func (f RunFilter) WithPage(n int) string         { return f.url("page", fmt.Sprint(n), false) }

// Active says whether there is any slice — without it the screen would show the
// "filters
// aplicados" vazia.
func (f RunFilter) Active() bool {
	return f.State != "" || f.Workflow != "" || f.De != "" || f.Ate != ""
}

templ Runs(runs []postgres.RunSummary, f RunFilter, counts map[string]int, total int) {
	@layouts.Base(layouts.Page{Title: "Runs", Kicker: "History", Active: "runs", Actions: liveSwitch()}) {
		<div id="runs-list">
			@RunsList(runs, f, counts, total)
		</div>
	}
}

// liveSwitch follows the list as runs arrive. Hidden until ui.js can drive it
// -- with no script it would be a switch that does nothing -- and off until
// somebody turns it on; ui.js remembers the choice.
templ liveSwitch() {
	<span hidden>
		<button
			type="button"
			data-live-list="runs-list"
			aria-pressed="false"
			class="inline-flex h-8 items-center gap-2 rounded-card border border-line bg-surface px-3 text-[0.82rem] text-muted transition-colors duration-150 hover:text-ink aria-pressed:border-accent-strong aria-pressed:text-ink"
		>
			<span data-live-dot class="h-1.5 w-1.5 rounded-full bg-line-strong"></span>
			Live
		</button>
	</span>
}

// RunsList is the list's region: the filter with its counts, the count, the
// table and its pages. It is the page's fragment (X-Brevis-Fragment: rows),
// which the Live switch fetches and swaps.
templ RunsList(runs []postgres.RunSummary, f RunFilter, counts map[string]int, total int) {
	<div class="mb-5 flex flex-wrap items-center gap-2">
		<div class="max-w-full overflow-x-auto whitespace-nowrap">
			@components.Segmented("State", runStateOptions(f, counts))
		</div>
		if f.Workflow != "" {
			<span class="mx-2 h-5 w-px bg-line"></span>
			@filterApplied("workflow", f.Workflow, f.With("workflow", ""))
		}
		if f.Label != "" {
			@filterApplied("period", f.Label, f.With("from", "")+"&to=")
		}
	</div>
	<p class="display mb-3 text-lg text-ink">
		{ count(total, "run", "runs") }
		if f.Active() {
			<a href="/runs" class="ml-3 text-xs text-gold-strong hover:underline">clear filters</a>
		}
	</p>
	@runsTable(runs, Pagination{
		Page: f.Page, PerPage: f.PerPage, Total: total, PageLink: f.WithPage,
	})
}

// filterApplied shows a slice that came from another screen (a click on the
// chart, for instance) with the way to remove it beside it — a filter you can
// only take off by editing the URL is not a filter, it is a trap.
templ filterApplied(label, value, remover string) {
	<span class="inline-flex items-center gap-2 rounded-card border border-gold/40 bg-gold-wash px-3 py-1.5 text-xs text-ink">
		<span class="text-gold-strong">{ label }:</span>
		<span class="font-medium">{ value }</span>
		<a href={ templ.SafeURL(remover) } class="text-muted hover:text-ink" aria-label="Remove this filter">×</a>
	</span>
}

// Projects is the list of namespaces.
//
// A project is what makes a workflow's slug unique WITHIN it -- two projects can
// each have a `daily_ingest` -- and it arrives from `brevis publish --project`.
// This screen used to end there: four numbers and a date, with nothing to click.
// A page that only tells you a thing exists is a page people stop opening.
//
// Each card now leads to that project's workflows, which is the one question
// the namespace exists to answer.
templ Projects(ps []postgres.ProjectSummary) {
	@layouts.Base(layouts.Page{Title: "Projects", Kicker: "Organization", Active: "projects"}) {
		if len(ps) == 0 {
			@components.Empty("No project yet.", "brevis publish --project my-project")
		} else {
			// A MEASURE ON THE BLOCK, which is where it belongs now that the
			// page has the window. Three lines of prose set across 2500px is
			// a line the eye loses on the way back.
			<p class="mb-4 max-w-3xl text-sm text-muted">
				A project namespaces its workflows: two projects can each have a
				<code class="font-mono text-xs">daily_ingest</code> without colliding.
				A workflow joins one with <code class="font-mono text-xs">brevis publish --project</code>.
			</p>
			// A FOURTH COLUMN WHERE THERE IS ROOM. Three cards across a wide
			// screen is three cards of 800px holding two numbers each.
			<div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
				for _, p := range ps {
					<a
						href={ templ.SafeURL("/workflows?project=" + p.Slug) }
						class="group rounded-card border border-line bg-surface p-5 transition-colors hover:border-accent"
					>
						<div class="flex items-baseline justify-between gap-3">
							<h3 class="display truncate text-base text-ink">{ p.Name }</h3>
							<span class="shrink-0 font-mono text-[0.7rem] text-muted">{ p.Slug }</span>
						</div>
						<dl class="mt-4 flex gap-6 text-sm">
							<div>
								<dt class="text-[0.7rem] tracking-wide text-muted uppercase">Workflows</dt>
								<dd class="display text-xl tabular-nums text-ink">{ fmt.Sprint(p.Workflows) }</dd>
							</div>
							<div>
								<dt class="text-[0.7rem] tracking-wide text-muted uppercase">Runs</dt>
								<dd class="display text-xl tabular-nums text-ink">{ fmt.Sprint(p.Runs) }</dd>
							</div>
						</dl>
						<p class="mt-4 flex items-center justify-between text-xs text-muted">
							<span>since { p.CreatedAt.Local().Format("2006-01-02") }</span>
							<span class="text-accent-strong opacity-0 transition-opacity group-hover:opacity-100">
								see the workflows &rarr;
							</span>
						</p>
					</a>
				}
			</div>
		}
	}
}

templ runsTable(runs []postgres.RunSummary, p Pagination) {
	if len(runs) == 0 {
		@components.Empty("No run yet.", "brevis scheduler")
	} else {
		<div class="overflow-hidden rounded-card border border-line bg-surface shadow-warm-sm">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-line bg-parchment-soft/60 text-left">
						@th("State", "pl-6")
						@th("Workflow", "")
						@th("Trigger", "")
						@th("Slot", "")
						@th("Duration", "")
						@th("Created", "text-right")
						@th("", "w-16 pr-6")
					</tr>
				</thead>
				<tbody class="divide-y divide-line-soft">
					{{ longest := longestDuration(runs) }}
					for _, r := range runs {
						<tr data-run-id={ r.ID } class="transition-colors hover:bg-gold-wash">
							<td class="px-3 py-3 pl-6">
								@components.State(r.Status)
								if r.Attempt > 0 {
									<span class="ml-2 text-[0.7rem] text-state-retrying">attempt { fmt.Sprint(r.Attempt+1) }</span>
								}
							</td>
							<td class="px-3 py-3">
								<a href={ templ.SafeURL("/runs/" + r.ID) } class="font-medium text-ink hover:text-gold-strong">
									{ r.WorkflowSlug }
								</a>
							</td>
							<td class="px-3 py-3 text-xs text-muted">{ r.TriggerType }</td>
							<td class="px-3 py-3 text-xs tabular-nums text-muted">{ components.UTCStamp(r.LogicalDate) }</td>
							<td class="px-3 py-3 text-xs tabular-nums text-muted">
								{ components.Duration(r.Duration) }
								if w := durationShare(r.Duration, longest); w != "" {
									<span class="mt-1 block h-1 w-24 rounded-full bg-surface-2">
										<span data-duration-bar style={ "width:" + w } class="block h-1 rounded-full bg-accent/70"></span>
									</span>
								}
							</td>
							<td class="px-3 py-3 text-right text-xs text-muted">
								{ components.When(&r.CreatedAt) }
							</td>
							<td class="px-3 py-3 pr-6 text-right">
								if r.Err != "" {
									@components.ErrorButton(r.ID)
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			@pagination(p)
		</div>
		// The dialogs sit OUTSIDE the table: a <dialog> inside a <tbody> is
		// invalid HTML, and the browser moves it out — breaking the row's
		// layout.
		for _, r := range runs {
			if r.Err != "" {
				@components.ErrorDialog(r.ID, r.WorkflowSlug, r.Status, r.Err)
			}
		}
	}
}

// dagAssets is the island's exact load order. The order is not style: the shim
// references `React` the instant it runs, and React Flow's bundle references
// `jsxRuntime` in its own. Swapping two lines here leaves the screen blank.
var dagAssets = layouts.Island{
	CSS: []string{assets.URL("vendor/xyflow.css")},
	JS: []string{
		assets.URL("vendor/react.js"),
		assets.URL("vendor/react-dom.js"),
		assets.URL("jsx-shim.js"),
		assets.URL("vendor/xyflow.js"),
		assets.URL("dag.js"),
	},
}

// Workflow shows the published definition. With no run state: it is the screen
// for "what this workflow is", and it has to serve a workflow that never ran
// too.
// WorkflowStats is one workflow's numbers, over workflowWindow.
//
// Every field degrades to its zero value on purpose: a definition has to stay
// readable with the database in trouble, and somebody looking at a broken
// installation is exactly who needs to read the graph.
type WorkflowStats struct {
	Window time.Duration
	Ind    postgres.Indicators
	Days   []postgres.Day

	// Load is what this workflow's SDK pipelines measured, per day. Empty for a
	// workflow whose steps are shell commands, which is why the panel checks
	// before drawing: four empty boxes would be four questions with no answer.
	Load []postgres.LoadDay
}

// workflowEyebrow is the line above the slug: the project, the schedule in
// words (or the expression, when the words are not sure), and whether the
// schedule is on. sum is nil when the summary could not be read, and the line
// then says only what the definition does.
templ workflowEyebrow(w wf.Workflow, sum *postgres.WorkflowSummary) {
	<span data-eyebrow class="contents">
		if sum != nil && sum.Project != "" {
			<a href={ templ.SafeURL("/workflows?project=" + sum.Project) } class="text-[0.75rem] text-ink-2 hover:underline">{ sum.Project }</a>
			<span class="text-faint">·</span>
		}
		if w.Schedule == "" {
			<span class="text-[0.75rem] text-muted">manual trigger only</span>
		} else if words := CronText(w.Schedule); words != "" {
			<span class="text-[0.75rem] text-muted">{ words }{ zoneSuffix(scheduleZone(sum)) }</span>
		} else {
			<span class="font-mono text-[0.72rem] text-muted">{ w.Schedule }</span>
		}
		if sum != nil && sum.HasSchedule {
			<span class="text-faint">·</span>
			if sum.Active {
				<span class="inline-flex items-center gap-1.5 text-[0.75rem] text-state-success"><span class="h-1.5 w-1.5 rounded-full bg-state-success"></span>Active</span>
			} else {
				<span class="inline-flex items-center gap-1.5 text-[0.75rem] text-muted"><span class="h-1.5 w-1.5 rounded-full bg-state-pending"></span>Paused</span>
			}
		}
	</span>
}

// about is the question mark beside the name, or nothing.
func about(w wf.Workflow) templ.Component {
	if w.Description == "" {
		return nil
	}
	return components.AboutButton(w.Slug)
}

templ Workflow(w wf.Workflow, sum *postgres.WorkflowSummary, latest []postgres.RunSummary, st WorkflowStats) {
	@layouts.Base(layouts.Page{
		Title: w.Slug, Kicker: "Workflow", Active: "workflows", Mono: true,
		Eyebrow: workflowEyebrow(w, sum),
		Island: dagAssets, Actions: runAction(w),
		// The question mark only exists when there is something behind it: a
		// control that opens an empty dialog is a promise the page does not
		// keep.
		Aside: about(w),
	}) {
		if w.Description != "" {
			@components.AboutDialog(w.Slug, w.Description)
		}
		<div class="mb-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted">
			<span>{ fmt.Sprint(len(w.Nodes)) } steps</span>
			<span>{ fmt.Sprint(len(w.Edges)) } dependencies</span>
			if w.Schedule != "" {
				<span class="font-mono text-xs text-ink">{ w.Schedule }</span>
			} else {
				<span>manual trigger only</span>
			}
			for _, t := range w.Tags {
				@components.Tag(t, "/workflows?tag="+t)
			}
		</div>
		if len(w.Params) > 0 {
			@runDrawer(w)
		}
		// The same four numbers the dashboard opens with, scoped to this
		// workflow -- and over thirty days rather than one, because a daily job
		// has a single run in twenty-four hours and a rate over one sample is
		// not a rate.
		<div class="mb-5">
			@components.Stats(workflowStats(st))
		</div>
		@dag("/api/workflows/" + w.Slug + "/graph")
		<section class="mt-6">
			@components.Card("A year of runs") {
				<p class="-mt-2 mb-4 text-sm text-muted">
					One square per day. The colour is the day&#39;s worst outcome, not how
					much ran &mdash; the question a calendar answers is when this broke.
				</p>
				@components.Heatmap(st.Days, w.Slug)
			}
		</section>
		if len(st.Load) > 0 {
			<section class="mt-6">
				@components.Card("What it loads") {
					<p class="-mt-2 mb-5 text-sm text-muted">
						{ components.TrendWindow(st.Load) }. The calendar above answers whether
						it ran; this answers whether it is getting worse.
					</p>
					@components.LoadTrend(components.Trend(st.Load), components.TrendWindow(st.Load))
				}
			</section>
		}
		if len(latest) > 0 {
			<section class="mt-6">
				<div class="mb-3 flex items-baseline justify-between">
					<h2 class="kicker">This workflow's runs</h2>
					<a href={ templ.SafeURL("/runs?workflow=" + w.Slug) } class="text-xs text-gold-strong hover:underline">
						see all
					</a>
				</div>
				@runsTable(latest, Pagination{})
			</section>
		}
	}
}

// Run shows one run. The header comes from the server already rendered; only the
// DAG with each step's state depends on JavaScript.
templ Run(r run.Run, logs []postgres.StepLog, raised []alerts.Record, wait *postgres.Wait) {
	@layouts.Base(layouts.Page{
		Title: r.WorkflowSlug, Kicker: "Run", Active: "runs",
		Island: dagAssets,
	}) {
		// Two regions the server refreshes, and the graph between them.
		//
		// The DAG polled and everything around it did not: the drawing showed a
		// step turning green while the status pill above it still said `queued`
		// and the output below was whatever the first response had. The fix is
		// not a second poller -- it is `/runs/{id}/live`, one request that
		// returns BOTH of these already rendered, on the cadence the graph
		// already uses. See RunLive.
		<div id="run-head" data-live={ "/runs/" + r.ID.String() + "/live" }>
			@runHead(r, wait)
		</div>
		// The indicator sits OUTSIDE the swapped region, because a region that
		// replaces its own contents would replace this too and lose whatever
		// the script had written into it.
		//
		// It exists because a page that refreshes silently is a page nobody
		// trusts: an operator who does not know it is live presses F5 anyway,
		// which is the behaviour this whole change is meant to remove.
		<p id="live-indicator" class="mb-5 -mt-3 hidden items-center gap-1.5 text-[0.7rem] text-muted">
			<span class="h-1.5 w-1.5 rounded-full bg-state-running"></span>
			<span data-live-label>following this run</span>
		</p>
		@dag("/api/runs/" + r.ID.String() + "/graph")
		<div id="run-body">
			@runBody(r, logs, raised)
		</div>
	}
}

// RunLive is the same two regions, with no layout around them.
//
// It is HTML and not JSON on purpose: the alternative is a second rendering of
// every one of these in JavaScript, and two renderings of a step's state is two
// places for "what colour is retrying" -- the class of bug this repository has
// hit five times. The server already knows how to draw them.
templ RunLive(r run.Run, logs []postgres.StepLog, raised []alerts.Record, wait *postgres.Wait) {
	// `terminal` is what stops the polling, and it is the RUN's answer rather
	// than the step's: a failed run is a retry away from running again, and
	// stopping there would freeze the screen in the middle of one.
	<div data-live-target="run-head" data-terminal={ fmt.Sprint(r.Status.Terminal()) }>
		@runHead(r, wait)
	</div>
	<div data-live-target="run-body">
		@runBody(r, logs, raised)
	</div>
}

templ runHead(r run.Run, wait *postgres.Wait) {
	<div class="mb-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
		@components.State(string(r.Status))
		<span class="text-muted">{ r.TriggerType }</span>
		if r.LogicalDate != nil {
			<span class="font-mono text-xs text-muted">slot { components.UTCStamp(r.LogicalDate) }</span>
		}
		if r.Attempt > 0 {
			<span class="text-xs text-state-retrying">attempt { fmt.Sprint(r.Attempt+1) }</span>
		}
		<a href={ templ.SafeURL("/workflows/" + r.WorkflowSlug) } class="text-xs text-gold-strong hover:underline">see definition</a>
		<span class="font-mono text-[0.7rem] text-muted/70">{ r.ID.String() }</span>
	</div>
	@phases(PhasesOf(r, time.Now()))
	if wait != nil {
		@waitLine(wait)
	}
	if r.Err != "" {
		<pre class="mb-5 overflow-auto rounded-card border border-state-failed/20 bg-state-failed/5 px-5 py-4 font-mono text-xs text-state-failed">{ r.Err }</pre>
	}
}

// phases is the run's life as a strip: made, started, running, finished, the
// current one marked. It sits in the live head, so it moves with the run.
templ phases(ps []Phase) {
	<ol data-phases class="mb-5 grid grid-cols-2 gap-px overflow-hidden rounded-card border border-line bg-line-soft sm:grid-cols-4">
		for _, p := range ps {
			<li data-phase={ p.Key } data-phase-state={ p.State } class="bg-surface px-4 py-3">
				<p class="flex items-center gap-1.5 text-[0.78rem] text-muted">
					<span class={ "h-1.5 w-1.5 rounded-full", phaseDot(p.State) }></span>
					if p.State == "current" {
						<span class="font-medium text-ink">{ p.Label }</span>
					} else {
						{ p.Label }
					}
				</p>
				<p title={ p.Detail } class="mt-1 truncate text-[0.8rem] tabular-nums text-ink-2">
					if p.Detail != "" {
						{ p.Detail }
					} else {
						<span class="text-faint">—</span>
					}
				</p>
			</li>
		}
	</ol>
}

templ runBody(r run.Run, logs []postgres.StepLog, raised []alerts.Record) {
	@autoParams(r)
	@alertsRaised(raised)
	@stepsOutput(r, logs)
}

// autoParams shows what the engine worked out for this run.
//
// On the screen because a value a pipeline reads is a value somebody debugging
// that pipeline has to be able to see. "Why did this run fetch that window" is
// answered here rather than by reading the fetcher's source and reconstructing
// its arithmetic.
//
// The one worth reading first is `adjusted_at`: the clock a step reads instead
// of now(). Next to `delay` it says, at a glance, that a run was forty minutes
// late AND that it still read the right window -- which is exactly the pair
// somebody stares at after finding a gap in a table.
templ autoParams(r run.Run) {
	<section class="mt-8">
		<h2 class="display mb-1 text-xl text-ink">Auto params</h2>
		<p class="mb-4 text-xs text-muted">
			The engine works these out for every run. No workflow declares them, and
			every step can read them — as <code class="font-mono">$BREVIS_AUTO_*</code>.
		</p>
		<div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
			@autoValue("adjusted_at", components.UTCStamp(&r.Auto.AdjustedAt),
				"the clock to read instead of now()")
			@autoValue("date", r.Auto.Date, "the UTC day of adjusted_at — the partition")
			@autoValue("delay", lateness(r.Auto.DelaySeconds), "how late this attempt started")
			if r.Auto.ScheduledAt != nil {
				@autoValue("scheduled_at", components.UTCStamp(r.Auto.ScheduledAt), "the slot this run represents")
			}
			if r.Auto.StartedAt != nil {
				@autoValue("started_at", components.UTCStamp(r.Auto.StartedAt), "when this attempt began")
			}
			if r.Auto.IntervalStart != nil {
				@autoValue("interval_start", components.UTCStamp(r.Auto.IntervalStart), "the window this run covers, from")
			}
			if r.Auto.IntervalEnd != nil {
				@autoValue("interval_end", components.UTCStamp(r.Auto.IntervalEnd), "…up to, excluded")
			}
			@autoValue("previous_error", fmt.Sprint(r.Auto.PreviousError), "did the run before this one fail")
			if r.Auto.PreviousSuccessAt != nil {
				@autoValue("previous_success_at", components.UTCStamp(r.Auto.PreviousSuccessAt), "how far back to catch up from")
			}
		</div>
	</section>
}

templ autoValue(name, value, why string) {
	<div class="rounded-2xl border border-line bg-surface px-4 py-3">
		<div class="font-mono text-[0.7rem] uppercase tracking-wider text-muted">{ name }</div>
		<div class="mt-0.5 font-mono text-sm text-ink">{ value }</div>
		<div class="mt-1 text-[0.7rem] leading-snug text-muted/80">{ why }</div>
	</div>
}

// lateness reads as a duration rather than as a count of seconds. "2220" is a
// number somebody converts; "37m" is an answer.
func lateness(seconds int) string {
	if seconds <= 0 {
		return "on time"
	}
	d := time.Duration(seconds) * time.Second
	return components.Duration(&d)
}

// alertsRaised shows what was announced about this run, and whether it arrived.
//
// It is the part that keeps the feature honest: an alert nobody can see is
// indistinguishable from an alert that was never sent. Before the outbox there
// was nothing to show -- a failed webhook was a log line in a pod that no
// longer exists.
//
// The row that matters is "undelivered". It is the case where somebody is
// waiting for a message that is not coming, and it is the only way to find out
// without reading the alert pod's logs.
templ alertsRaised(raised []alerts.Record) {
	if len(raised) > 0 {
		<section class="mt-8">
			<h2 class="display mb-4 text-xl text-ink">Alerts</h2>
			<div class="space-y-2">
				for _, a := range raised {
					<div class="rounded-2xl border border-line bg-surface px-5 py-3.5">
						<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
							@components.State(alertTone(a.State()))
							<span class="text-ink">{ alertWording(a) }</span>
							<span class="font-mono text-xs text-muted">{ a.Channel }</span>
							if a.Attempts > 0 {
								<span class="text-xs text-muted">{ attemptWord(a.Attempts) }</span>
							}
							if a.DeliveredAt != nil {
								<span class="text-xs text-muted">{ components.Timestamp(a.DeliveredAt) }</span>
							} else {
								<span class="text-xs text-muted">raised { components.Timestamp(&a.CreatedAt) }</span>
							}
						</div>
						if a.Err != "" {
							// Shown even on a delivered alert's history? No: the
							// error is cleared on success, so anything here is
							// live. A row that succeeded on the third try must
							// not still display the second try's failure.
							<pre class="mt-2.5 overflow-auto rounded-xl border border-state-failed/20 bg-state-failed/5 px-4 py-2.5 font-mono text-xs text-state-failed">{ a.Err }</pre>
						}
					</div>
				}
			</div>
		</section>
	}
}

// alertTone borrows the run states' palette rather than inventing colours for a
// second vocabulary. The words stay the alert's own.
func alertTone(state string) string {
	switch state {
	case "delivered":
		return "success"
	case "undelivered":
		return "failed"
	}
	return "running"
}

// alertWording says what happened in the reader's terms, not the table's.
//
// "sending" on its own is ambiguous in the way that matters: it is also what a
// row looks like when nothing is draining the outbox, so it says which process
// is supposed to.
func alertWording(a alerts.Record) string {
	subject := "run failed"
	if a.Kind == alerts.KindStep && a.NodeID != "" {
		subject = "step " + a.NodeID + " failed"
	}
	switch a.State() {
	case "delivered":
		return subject + " — delivered"
	case "undelivered":
		return subject + " — never delivered"
	}
	return subject + " — waiting for `brevis alert`"
}

func attemptWord(n int) string {
	if n == 1 {
		return "1 try"
	}
	return fmt.Sprint(n) + " tries"
}

// duracaoMs adapts the milliseconds the query returns to the existing formatter,
// which speaks in time.Duration.
func durationMs(ms int64) string {
	d := time.Duration(ms) * time.Millisecond
	return components.Duration(&d)
}

// stepsOutput shows each attempt's log.
//
// It exists because the log lived only in the pod, and the pod is deleted when
// the step ends: a pipeline that failed at 4am left "failed" on the screen and
// nothing else. Rendered on the server inside a <details>, with no JavaScript
// and no second call — the graph above is already polled second by second, and
// attaching the log to that JSON would make every poll more expensive.
//
// One entry per NODE, in the graph's order, so it reads like the flow above
// it: a mapped step is one entry with its "2/3" and an instance per item.
templ stepsOutput(r run.Run, logs []postgres.StepLog) {
	if len(logs) > 0 {
		<section class="mt-8">
			<h2 class="display mb-4 text-xl text-ink">Step output</h2>
			<div class="space-y-2">
				for _, g := range StepOutputs(r, logs) {
					if g.Mapped {
						<details class="group rounded-2xl border border-line bg-surface">
							<summary class="flex cursor-pointer flex-wrap items-center gap-x-4 gap-y-1 px-5 py-3.5 text-sm">
								@components.State(g.Status)
								<span class="font-medium text-ink">{ g.Node }</span>
								<span class="font-mono text-xs text-muted">{ fmt.Sprint(g.Ok) }/{ fmt.Sprint(g.Total) } ok</span>
							</summary>
							<div class="space-y-2 px-4 pb-4">
								for _, row := range g.Rows {
									@stepRow(row)
								}
							</div>
						</details>
					} else {
						for _, row := range g.Rows {
							@stepRow(row)
						}
					}
				}
			</div>
		</section>
	}
}

// stepRow is one attempt of one step, or of one instance of a mapped step,
// named by the item it ran for.
templ stepRow(p StepRow) {
	<details class="group rounded-2xl border border-line bg-surface">
		<summary class="flex cursor-pointer flex-wrap items-center gap-x-4 gap-y-1 px-5 py-3.5 text-sm">
			@components.State(p.Status)
			if p.Item != "" {
				<span class="font-mono text-xs text-ink">{ p.Item }</span>
			} else {
				<span class="font-medium text-ink">{ p.NodeID }</span>
			}
			if p.Attempt > 0 {
				<span class="text-xs text-state-retrying">attempt { fmt.Sprint(p.Attempt+1) }</span>
			}
			if p.ExitCode != nil {
				<span class="font-mono text-xs text-muted">exit { fmt.Sprint(*p.ExitCode) }</span>
			}
			if p.DurationMs > 0 {
				<span class="text-xs text-muted">{ durationMs(p.DurationMs) }</span>
			}
			// What the step published, as its node in the flow shows it.
			for _, o := range p.Output {
				<span class="max-w-[24rem] truncate font-mono text-xs text-muted" title={ o.Value }>
					<span class="text-muted/70">{ o.Key }</span> { o.Value }
				</span>
			}
			if p.Log == "" {
				<span class="text-xs text-muted/70 italic">no output recorded</span>
			}
		</summary>
		if p.Err != "" {
			<p class="mx-5 mb-3 rounded-xl bg-state-failed/5 px-4 py-2.5 text-xs text-state-failed">{ p.Err }</p>
		}
		if p.Log != "" {
			// `overflow-auto` with a maximum height: a dbt output
			// with hundreds of lines must not push the rest of the
			// page off the screen.
			<pre class="mx-5 mb-5 max-h-[28rem] overflow-auto rounded-card bg-surface-2 px-4 py-3 font-mono text-[0.7rem] leading-relaxed whitespace-pre text-ink">{ p.Log }</pre>
		}
	</details>
}

// dag is the island's mount point. The height is fixed on purpose: with `h-full`
// inside a scrolling container, React Flow's canvas is born at 0px and the
// grafo some.
// The height here is a STARTING one. dag.js measures the drawing and sets the
// real one, because a graph eight steps wide and one lane deep needs a third of
// what a fixed height gives it.
//
// There is deliberately no `min-height`. It would win against the computed
// value, and it did: the box stayed at 380px while the script asked for 300,
// and the drawing sat pinned to the bottom of the empty part.
templ dag(src string) {
	<div
		id="dag"
		data-src={ src }
		class="rounded-card border border-line bg-surface shadow-warm-sm"
		style="height: 380px;"
	></div>
}

// ---------------------------------------------------------------------------
// Formatadores locais
// ---------------------------------------------------------------------------

func pct(v float64) string { return fmt.Sprintf("%.1f%%", v) }

// contagem agrees the noun with the number. "1 workflows" is the kind of detail
// that makes a screen look generated rather than written.
func count(n int, singular, plural string) string {
	if n == 1 {
		return fmt.Sprintf("1 %s", singular)
	}
	return fmt.Sprintf("%d %s", n, plural)
}

// failureHue leaves the number neutral when there is no failure at all: painting
// a "0.0%" red teaches the eye to ignore the colour on exactly the screen where
// it has to mean something.
func failureHue(n int) string {
	if n == 0 {
		return "text-ink"
	}
	return "text-state-failed"
}

func failureNote(n int) string {
	if n == 0 {
		return "no failure in the window"
	}
	if n == 1 {
		return "1 run failed"
	}
	return fmt.Sprintf("%d runs failed", n)
}

func meanDuration(d time.Duration) string {
	if d == 0 {
		return "no duration measured"
	}
	return "average duration " + components.Duration(&d)
}

// startOrCreated shows when the work actually started; for whatever is still in
// the queue, what matters is how long it has been waiting.
func startOrCreated(r postgres.RunSummary) *time.Time {
	if r.StartedAt != nil {
		return r.StartedAt
	}
	return &r.CreatedAt
}

var _ = strings.TrimSpace


// runAction is the page's verb. With parameters it is "Run…", a link to the
// drawer: ui.js opens it as a dialog, and with no script `#run` shows the
// form in place. With none it is the one-click ▶, since there is nothing to
// ask.
func runAction(w wf.Workflow) templ.Component {
	if len(w.Params) == 0 {
		return disparar(w.Slug)
	}
	return runLink()
}

templ runLink() {
	<a href="#run" data-dialogo="run" aria-haspopup="dialog" class={ components.ButtonClass(components.ButtonPrimary, components.SizeRegular) }>
		@components.Icon("play", "h-3.5 w-3.5")
		Run…
	</a>
}

// runDrawer asks for a run's parameters: the fields the params declare, the
// payload they make (filled by ui.js, so it is hidden with no script rather
// than wrong), and Run, posting to the same trigger the ▶ does. A native
// <dialog>: Esc closes it and the focus goes back to Run….
templ runDrawer(w wf.Workflow) {
	<dialog
		id="run"
		aria-labelledby="run-title"
		class="run-drawer fixed inset-y-0 right-0 left-auto m-0 h-full max-h-none w-[min(440px,100vw)] border-l border-line bg-surface p-0 text-ink backdrop:bg-ink/40"
	>
		<form
			method="post"
			action={ templ.SafeURL("/workflows/" + w.Slug + "/trigger") }
			data-run-form
			class="flex h-full flex-col"
		>
			<div class="flex items-center justify-between gap-4 border-b border-line px-5 py-4">
				<div class="min-w-0">
					<p id="run-title" class="text-[0.95rem] font-medium text-ink">Run with parameters</p>
					<p class="truncate font-mono text-[0.75rem] text-muted">{ w.Slug }</p>
				</div>
				<button type="submit" formmethod="dialog" formnovalidate aria-label="Close" class="flex h-8 w-8 items-center justify-center rounded-card text-muted transition-colors hover:bg-surface-2 hover:text-ink">
					@components.Icon("x", "h-4 w-4")
				</button>
			</div>
			<div class="flex-1 space-y-4 overflow-y-auto px-5 py-4">
				for _, p := range w.Params {
					@paramField(p)
				}
				<div data-run-preview hidden>
					<p class="mb-1.5 text-[0.75rem] text-muted">Payload</p>
					<pre class="overflow-x-auto rounded-card border border-line-soft bg-canvas px-3 py-2 font-mono text-[0.75rem] text-ink-2"><code></code></pre>
				</div>
			</div>
			<div class="flex justify-end gap-2 border-t border-line px-5 py-3">
				<button type="submit" class={ components.ButtonClass(components.ButtonPrimary, components.SizeRegular) }>
					@components.Icon("play", "h-3.5 w-3.5")
					Run
				</button>
			</div>
		</form>
	</dialog>
}

// paramField is one parameter's field. The drawer is the trigger WITH values
// — the difference between running the workflow and reprocessing a window.
//
// The fields come from the YAML's declaration, and the `name` carries a `param.`
// prefix so it does not collide with the form's own future fields. Types become
// controls: a boolean is a select, an integer is a number, an enum is a select —
// each refusing in the browser what the server would refuse again afterwards.
templ paramField(p wf.Param) {
	<label class="flex flex-col gap-1">
		<span class="font-mono text-[0.8rem] text-ink">{ p.Name }</span>
		if p.Description != "" {
			<span class="text-[0.72rem] text-muted">{ p.Description }</span>
		}
		if p.Type == wf.ParamBool {
			<select name={ "param." + p.Name } class="h-8 rounded-card border border-line bg-surface px-2.5 text-[0.82rem] text-ink">
				@option("false", p.Default)
				@option("true", p.Default)
			</select>
		} else if p.Type.IsList() && len(p.Enum) > 0 {
			@listaComEnum(p)
		} else if p.Type.IsList() {
			@listaLivre(p)
		} else if len(p.Enum) > 0 {
			<select name={ "param." + p.Name } class="h-8 rounded-card border border-line bg-surface px-2.5 text-[0.82rem] text-ink">
				for _, v := range p.Enum {
					@option(v, p.Default)
				}
			</select>
		} else {
			<input
				type={ fieldType(p) }
				name={ "param." + p.Name }
				value={ p.Default }
				placeholder={ p.Pattern }
				class="h-8 rounded-card border border-line bg-surface px-2.5 font-mono text-[0.82rem] text-ink placeholder:text-faint focus:border-accent-strong focus:outline-none"
			/>
		}
	</label>
}

// A list with an enum is a multi-select, and checkboxes are what a browser
// already does well: they need no JavaScript, they are reachable by keyboard,
// and the browser sends one value per box ticked -- which the handler joins
// with commas, the same shape the value has everywhere else.
//
// The hidden empty value is what makes "none of them" different from "the
// operator did not touch this": with every box unticked the key would otherwise
// be absent from the form, and the resolver would fall back to the default.
templ listaComEnum(p wf.Param) {
	<input type="hidden" name={ "param." + p.Name } value=""/>
	<div class="flex flex-wrap gap-x-3 gap-y-1 rounded-xl border border-line bg-parchment-soft px-3 py-2">
		for _, v := range p.Enum {
			<label class="flex items-center gap-1.5 text-sm text-ink">
				if marcado(v, p.Default) {
					<input type="checkbox" name={ "param." + p.Name } value={ v } checked class="accent-ink"/>
				} else {
					<input type="checkbox" name={ "param." + p.Name } value={ v } class="accent-ink"/>
				}
				<span class="font-mono text-xs">{ v }</span>
			</label>
		}
	</div>
}

// A list with no enum is free text, and the separator is the comma the value
// already uses. `data-lista` is the hook for the chips: with JavaScript the
// items become removable pills, and without it this stays a text field that
// works -- which is the rule the rest of this interface follows.
templ listaLivre(p wf.Param) {
	<input
		type="text"
		name={ "param." + p.Name }
		value={ p.Default }
		data-lista={ string(p.Type.ElementType()) }
		placeholder="one, two, three"
		class="rounded-xl border border-line bg-parchment-soft px-3 py-2 font-mono text-sm text-ink placeholder:text-muted/60"
	/>
}

templ option(value, fallback string) {
	if value == fallback {
		<option value={ value } selected>{ value }</option>
	} else {
		<option value={ value }>{ value }</option>
	}
}

// marcado answers whether this enum value is in the param's default, which for
// a list is a comma-separated set rather than a single value.
func marcado(value, deflt string) bool {
	for _, item := range strings.Split(deflt, ",") {
		if strings.TrimSpace(item) == value {
			return true
		}
	}
	return false
}

// fieldType picks the browser's control. `number` for an integer makes a
// phone's keyboard open right and blocks a letter before the server has to.
func fieldType(p wf.Param) string {
	if p.Type == wf.ParamInteger {
		return "number"
	}
	return "text"
}

// meanValue is the mean duration as a headline number. An em dash rather than
// "0s" when nothing has finished: a zero there reads as "instant", which is the
// opposite of "unknown".
func meanValue(d time.Duration) string {
	if d <= 0 {
		return "—"
	}
	return components.Duration(&d)
}

// openNote says what the "Open" number is made of. The headline adds running and
// queued together because both mean "not finished yet", and the note is what
// keeps that from hiding which of the two it is -- a queue of forty and forty
// running are the same number and very different mornings.
func openNote(i postgres.Indicators) string {
	if i.Running+i.Pending == 0 {
		return "nothing in flight"
	}
	return fmt.Sprintf("%d running, %d queued", i.Running, i.Pending)
}

// waitLine says what concurrency limit holds a queued run (#95): the group or
// the workflow's own limit, the runs in the slots, and how many of the same
// key are ahead of it. Drawn only when WaitingOn proved it -- a run waiting on
// a dispatcher slot, --max-pods or a retry's backoff gets no line at all.
templ waitLine(w *postgres.Wait) {
	<p class="mb-5 -mt-2 text-xs text-muted" data-wait>
		<span class="text-state-queued">Waiting for</span>
		if w.Group != "" {
			concurrency group <code class="font-mono text-ink">{ w.Group }</code>
		} else {
			this workflow's own concurrency
		}
		(limit { fmt.Sprint(w.Limit) })
		if len(w.Holders) > 0 {
			— held by
			for i, h := range firstHolders(w.Holders) {
				if i > 0 {
					,
				}
				<a href={ templ.SafeURL("/runs/" + h.RunID.String()) } class="text-gold-strong hover:underline">{ h.Workflow }</a>
				<span class="font-mono">since { components.UTCStamp(&h.Since) }</span>
			}
			if more := len(w.Holders) - len(firstHolders(w.Holders)); more > 0 {
				and { fmt.Sprint(more) } more
			}
		}
		if w.Ahead > 0 {
			<span>· { aheadOf(w.Ahead) } ahead of it in the queue</span>
		}
	</p>
}

// firstHolders is the three a line has room for, oldest first.
func firstHolders(hs []postgres.Holder) []postgres.Holder {
	if len(hs) > 3 {
		return hs[:3]
	}
	return hs
}

func aheadOf(n int) string {
	if n == 1 {
		return "1 run"
	}
	return fmt.Sprintf("%d runs", n)
}
