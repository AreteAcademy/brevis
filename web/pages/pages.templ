package pages

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/AreteAcademy/brevis/internal/domain/run"
	wf "github.com/AreteAcademy/brevis/internal/domain/workflow"
	"github.com/AreteAcademy/brevis/internal/alerts"
	"github.com/AreteAcademy/brevis/internal/infrastructure/postgres"
	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/layouts"
)

// ---------------------------------------------------------------------------
// Overview
// ---------------------------------------------------------------------------

// OverviewData is everything the landing screen shows. A struct rather than
// seven parameters: the signature was already illegible with four.
type OverviewData struct {
	Window    time.Duration
	Ind       postgres.Indicators
	Buckets    []postgres.Bucket
	EmCurso   []postgres.RunSummary
	Proximas  []NextRun
	Recentes  []postgres.RunSummary
	Pending int
}

// ProximaExecucao is a future trigger, already computed from the cron.
type NextRun struct {
	Workflow string
	Cron     string
	Timezone string
	When   time.Time
}

templ Overview(d OverviewData) {
	@layouts.Base(layouts.Page{Title: "Overview", Kicker: "Dashboard", Active: "overview"}) {
		<div class="grid grid-cols-2 gap-5 lg:grid-cols-4">
			@components.Metric("Success rate", pct(d.Ind.Ratio(d.Ind.Succeeded)),
				fmt.Sprintf("%d of %d finished", d.Ind.Succeeded, d.Ind.Succeeded+d.Ind.Failed), "text-state-success")
			@components.Metric("Failure rate", pct(d.Ind.Ratio(d.Ind.Failed)),
				failureNote(d.Ind.Failed), failureHue(d.Ind.Failed))
			@components.Metric("Running", fmt.Sprint(d.Ind.Running),
				meanDuration(d.Ind.MeanDuration), "text-state-running")
			@components.Metric("Queued", fmt.Sprint(d.Ind.Pending),
				fmt.Sprintf("%d items queued", d.Pending), "text-state-queued")
		</div>
		<div class="mt-6 grid grid-cols-1 gap-5 xl:grid-cols-[1fr_320px]">
			@components.Card("Runs per hour") {
				<p class="-mt-2 mb-5 text-sm text-muted">
					Count and average duration over the last { fmt.Sprint(int(d.Window.Hours())) } hours.
				</p>
				@components.RunsChart(d.Buckets)
			}
			@components.Card("Distribution") {
				@components.Rosca(d.Ind)
				<dl class="mt-4 space-y-1.5 text-sm">
					@distLine("Success", d.Ind.Succeeded, "bg-state-success")
					@distLine("Failure", d.Ind.Failed, "bg-state-failed")
					@distLine("Running", d.Ind.Running, "bg-state-running")
					@distLine("Queued", d.Ind.Pending, "bg-state-queued")
				</dl>
			}
		</div>
		<div class="mt-6 grid grid-cols-1 gap-5 xl:grid-cols-2">
			@components.Card("In progress") {
				if len(d.EmCurso) == 0 {
					@components.Empty("Nothing running right now.", "")
				} else {
					<table class="w-full text-sm">
						<thead>
							<tr class="border-b border-line text-left">
								@th("Workflow", "")
								@th("Origem", "")
								@th("Started", "")
								@th("State", "text-right")
							</tr>
						</thead>
						<tbody class="divide-y divide-line-soft">
							for _, r := range d.EmCurso {
								<tr>
									<td class="py-2.5 pr-3">
										<a href={ templ.SafeURL("/runs/" + r.ID) } class="font-medium text-ink hover:text-gold-strong">
											{ r.WorkflowSlug }
										</a>
									</td>
									<td class="py-2.5 pr-3 text-xs text-muted">{ r.TriggerType }</td>
									<td class="py-2.5 pr-3 text-xs text-muted tabular-nums">
										{ components.When(startOrCreated(r)) }
									</td>
									<td class="py-2.5 text-right">
										@components.State(r.Status)
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			}
			@components.Card("Upcoming runs") {
				if len(d.Proximas) == 0 {
					@components.Empty("No active schedule.", "brevis publish file.yaml")
				} else {
					<table class="w-full text-sm">
						<thead>
							<tr class="border-b border-line text-left">
								@th("Workflow", "")
								@th("Schedule", "")
								@th("Next trigger", "text-right")
							</tr>
						</thead>
						<tbody class="divide-y divide-line-soft">
							for _, p := range d.Proximas {
								<tr>
									<td class="py-2.5 pr-3">
										<a href={ templ.SafeURL("/workflows/" + p.Workflow) } class="font-medium text-ink hover:text-gold-strong">
											{ p.Workflow }
										</a>
									</td>
									<td class="py-2.5 pr-3 font-mono text-xs text-muted">{ p.Cron }</td>
									<td class="py-2.5 text-right text-xs tabular-nums text-muted">
										<span class="text-ink">{ components.Timestamp(&p.When) }</span>
										<span class="ml-2 text-gold-strong">{ components.When(&p.When) }</span>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			}
		</div>
		<section class="mt-6">
			<div class="mb-3 flex items-baseline justify-between">
				<h2 class="kicker">Recent runs</h2>
				<a href="/runs" class="text-xs text-gold-strong hover:underline">see all</a>
			</div>
			@runsTable(d.Recentes, Pagination{})
		</section>
	}
}

templ distLine(label string, value int, matiz string) {
	<div class="flex items-center gap-2">
		<span class={ "h-2 w-2 shrink-0 rounded-full", matiz }></span>
		<dt class="flex-1 text-muted">{ label }</dt>
		<dd class="font-medium tabular-nums text-ink">{ fmt.Sprint(value) }</dd>
	</div>
}

// th is a column header. The vertical breathing room (py-4) is deliberate:
// pressed against the title, the header competed with the first row instead of
// separating from it.
templ th(text, extra string) {
	<th class={ "px-3 py-4 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-muted", extra }>{ text }</th>
}

// sortableTh is the same column, clickable. The arrow appears only on the
// active column — one in every header becomes noise.
templ sortableTh(text, field string, f Filter, extra string) {
	<th class={ "px-3 py-4 text-[0.7rem] font-semibold uppercase tracking-[0.12em]", extra, columnColour(f, field) }>
		<a href={ templ.SafeURL(f.WithSort(field)) } class="inline-flex items-center gap-1 hover:text-gold-strong">
			{ text }
			if s := f.Arrow(field); s != "" {
				<span class="text-gold">{ s }</span>
			} else {
				<span class="text-line">↕</span>
			}
		</a>
	</th>
}

func columnColour(f Filter, field string) string {
	if f.Sort == field {
		return "text-ink"
	}
	return "text-muted"
}

// paginacao is the lists' footer.
templ pagination(p Pagination) {
	if p.Total > 0 {
		<div class="flex flex-wrap items-center justify-between gap-4 border-t border-line px-6 py-4 text-xs text-muted">
			<span>
				{ fmt.Sprintf("%d–%d of %d", p.First(), p.Last(), p.Total) }
			</span>
			if p.Pages() > 1 {
				<nav class="flex items-center gap-1">
					if p.Page > 1 {
						<a href={ templ.SafeURL(p.PageLink(p.Page - 1)) } class="rounded-card border border-line px-3 py-1 transition-colors hover:border-gold hover:text-ink">previous</a>
					} else {
						<span class="rounded-card border border-line-soft px-3 py-1 text-line">previous</span>
					}
					for _, n := range p.Window() {
						if n == p.Page {
							<span class="rounded-card border border-ink bg-ink px-3 py-1 font-medium text-surface">{ fmt.Sprint(n) }</span>
						} else {
							<a href={ templ.SafeURL(p.PageLink(n)) } class="rounded-card border border-line px-3 py-1 transition-colors hover:border-gold hover:text-ink">{ fmt.Sprint(n) }</a>
						}
					}
					if p.Page < p.Pages() {
						<a href={ templ.SafeURL(p.PageLink(p.Page + 1)) } class="rounded-card border border-line px-3 py-1 transition-colors hover:border-gold hover:text-ink">next</a>
					} else {
						<span class="rounded-card border border-line-soft px-3 py-1 text-line">next</span>
					}
				</nav>
			}
		</div>
	}
}

// ---------------------------------------------------------------------------
// Workflows — a lista de DAGs
// ---------------------------------------------------------------------------

// Filter holds the search bar's state. It lives in the URL, not in memory: that
// way an applied filter can be pasted into the on-call chat and opens the same
// on the other
// lado.
type Filter struct {
	Search  string
	State string // ultimo estado: failed, queued, running, success
	Active  string // active | paused
	Tag    string

	// Sort is the sort field; Desc inverts it. They live in the URL for the same
	// reason the filters do: a sorted screen has to be pasteable to somebody
	// else.
	Sort string
	Desc  bool

	Page    int
	PerPage int
}

// With returns the same URL with one field swapped — since every chip becomes a
// link, the rest of the filter has to survive the click.
//
// Changing a filter always returns to the first page: staying on page 7 of a
// result that now has two would be an empty screen with no explanation.
func (f Filter) With(field, value string) string {
	return f.url(field, value, true)
}

// WithPage navigates without touching anything else.
func (f Filter) WithPage(n int) string {
	return f.url("page", fmt.Sprint(n), false)
}

// WithSort flips the direction when the field is already the sorted one, and
// starts ascending when it is another — the behaviour any table teaches.
func (f Filter) WithSort(field string) string {
	if f.Sort == field && !f.Desc {
		return f.url("dir", "desc", true)
	}
	if f.Sort == field && f.Desc {
		// Terceiro clique remove a ordenacao e volta a ordem natural.
		g := f
		g.Sort, g.Desc = "", false
		return g.url("page", "", true)
	}
	g := f
	g.Desc = false
	return g.url("sort", field, true)
}

// Arrow is the direction indicator in the header.
func (f Filter) Arrow(field string) string {
	if f.Sort != field {
		return ""
	}
	if f.Desc {
		return "↓"
	}
	return "↑"
}

func (f Filter) url(field, value string, resetsPage bool) string {
	q := url.Values{}
	put := func(k, v string) {
		if v != "" {
			q.Set(k, v)
		}
	}
	put("q", f.Search)
	put("state", f.State)
	put("active", f.Active)
	put("tag", f.Tag)
	put("sort", f.Sort)
	if f.Desc {
		put("dir", "desc")
	}
	if !resetsPage && f.Page > 1 {
		put("page", fmt.Sprint(f.Page))
	}
	if f.PerPage > 0 && f.PerPage != DefaultPerPage {
		put("per", fmt.Sprint(f.PerPage))
	}
	if value == "" {
		q.Del(field)
	} else {
		q.Set(field, value)
	}
	if len(q) == 0 {
		return "/workflows"
	}
	return "/workflows?" + q.Encode()
}

// DefaultPerPage is the lists' page size. Twenty-five fits a laptop screen
// without endless scrolling and without forcing a page turn on every glance.
const DefaultPerPage = 25

// Pagination is the footer of any paginated list.
type Pagination struct {
	Page    int
	PerPage int
	Total     int

	// PageLink builds each page's URL. Injected so the same component serves
	// /workflows and /runs, which have different filters.
	PageLink func(int) string
}

func (p Pagination) Pages() int {
	if p.PerPage <= 0 {
		return 1
	}
	n := (p.Total + p.PerPage - 1) / p.PerPage
	if n < 1 {
		return 1
	}
	return n
}

func (p Pagination) First() int {
	if p.Total == 0 {
		return 0
	}
	return (p.Page-1)*p.PerPage + 1
}

func (p Pagination) Last() int {
	end := p.Page * p.PerPage
	if end > p.Total {
		return p.Total
	}
	return end
}

// Window returns the page numbers to show, centred on the current one. Listing
// them all would break the footer with a hundred pages.
func (p Pagination) Window() []int {
	total := p.Pages()
	de, ate := p.Page-2, p.Page+2
	if de < 1 {
		ate += 1 - de
		de = 1
	}
	if ate > total {
		de -= ate - total
		ate = total
	}
	if de < 1 {
		de = 1
	}
	var out []int
	for i := de; i <= ate; i++ {
		out = append(out, i)
	}
	return out
}

templ Workflows(ws []postgres.WorkflowSummary, tags []string, f Filter, total, filtered int) {
	@layouts.Base(layouts.Page{Title: "Workflows", Kicker: "Orchestration", Active: "workflows", Wide: true}) {
		<form method="get" action="/workflows" class="mb-5">
			<div class="flex items-center gap-3 rounded-card border border-line bg-surface px-5 py-3 shadow-warm-sm">
				<svg class="h-4 w-4 shrink-0 text-muted" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6">
					<circle cx="9" cy="9" r="6"></circle>
					<path d="M13.5 13.5 17 17" stroke-linecap="round"></path>
				</svg>
				<input
					type="search"
					name="q"
					value={ f.Search }
					placeholder="Search workflows"
					class="w-full bg-transparent text-sm text-ink placeholder:text-muted focus:outline-none"
				/>
				// The other filters go along as hidden fields: searching must not
				// erase the state the operator had already chosen.
				<input type="hidden" name="state" value={ f.State }/>
				<input type="hidden" name="active" value={ f.Active }/>
				<input type="hidden" name="tag" value={ f.Tag }/>
				<button type="submit" class="shrink-0 rounded-card bg-ink px-4 py-1.5 text-xs font-medium text-surface transition-colors hover:bg-accent-strong">
					Search
				</button>
			</div>
		</form>
		<div class="mb-6 flex flex-wrap items-center gap-2">
			@chip(f.With("state", ""), "All", f.State == "", "")
			@chip(f.With("state", "success"), "Success", f.State == "success", "bg-state-success")
			@chip(f.With("state", "failed"), "Failure", f.State == "failed", "bg-state-failed")
			@chip(f.With("state", "running"), "Running", f.State == "running", "bg-state-running")
			@chip(f.With("state", "queued"), "Queued", f.State == "queued", "bg-state-queued")
			<span class="mx-2 h-5 w-px bg-line"></span>
			@chip(f.With("active", ""), "All", f.Active == "", "")
			@chip(f.With("active", "active"), "Active", f.Active == "active", "")
			@chip(f.With("active", "paused"), "Paused", f.Active == "paused", "")
			if len(tags) > 0 {
				<span class="mx-2 h-5 w-px bg-line"></span>
				for _, t := range tags {
					@chip(f.With("tag", alterna(f.Tag, t)), t, f.Tag == t, "")
				}
			}
		</div>
		<p class="display mb-3 text-lg text-ink">
			{ count(filtered, "workflow", "workflows") }
			if filtered != total {
				<span class="ml-2 text-sm text-muted">de { fmt.Sprint(total) }</span>
				<a href="/workflows" class="ml-3 text-xs text-gold-strong hover:underline">clear filters</a>
			}
		</p>
		if len(ws) == 0 {
			@components.Empty("No workflow matches these filters.", "brevis publish file.yaml")
		} else {
			<div class="overflow-hidden rounded-card border border-line bg-surface shadow-warm-sm">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-line bg-parchment-soft/60 text-left">
							@th("", "w-16 pl-6")
							@sortableTh("Workflow", "workflow", f, "")
							@sortableTh("Schedule", "schedule", f, "")
							@sortableTh("Next run", "next", f, "")
							@sortableTh("Last run", "last", f, "")
							@th("Tags", "")
							@th("", "w-24 pr-6 text-right")
						</tr>
					</thead>
					<tbody class="divide-y divide-line-soft">
						for _, w := range ws {
							<tr class="transition-colors hover:bg-gold-wash">
								<td class="py-3 pl-6">
									@interruptor(w)
								</td>
								<td class="py-3 pr-3">
									<a href={ templ.SafeURL("/workflows/" + w.Slug) } class="font-medium text-ink hover:text-gold-strong">
										{ w.Slug }
									</a>
									<p class="text-xs text-muted">{ w.Project }</p>
								</td>
								<td class="py-3 pr-3">
									if w.Cron == "" {
										<span class="text-xs text-muted">manual trigger only</span>
									} else {
										<span class="inline-flex items-center gap-1.5 font-mono text-xs text-ink">
											<svg class="h-3.5 w-3.5 text-gold" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
												<rect x="2" y="3" width="12" height="11" rx="2"></rect>
												<path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3" stroke-linecap="round"></path>
											</svg>
											{ w.Cron }
										</span>
										if w.Catchup {
											<span class="ml-2 text-[0.7rem] text-gold-strong">catchup</span>
										}
									}
								</td>
								<td class="py-3 pr-3 text-xs tabular-nums">
									if w.NextRun != nil {
										<span class="text-ink">{ components.Timestamp(w.NextRun) }</span>
										<span class="ml-1.5 text-muted">{ components.When(w.NextRun) }</span>
									} else if w.HasSchedule && !w.Active {
										<span class="text-muted">paused</span>
									} else {
										<span class="text-muted">—</span>
									}
								</td>
								<td class="py-3 pr-3">
									if w.LastRunID != nil {
										<a href={ templ.SafeURL("/runs/" + *w.LastRunID) } class="inline-flex items-center gap-2">
											<span class="text-xs tabular-nums text-ink hover:text-gold-strong">
												{ components.Timestamp(w.LastRunAt) }
											</span>
											@components.Dot(w.LastStatus)
										</a>
										<p class="text-[0.7rem] text-muted">{ fmt.Sprint(w.TotalRuns) } runs</p>
									} else {
										<span class="text-xs text-muted">never ran</span>
									}
								</td>
								<td class="py-3 pr-3">
									<div class="flex flex-wrap gap-1">
										for _, t := range w.Tags {
											@components.Tag(t, f.With("tag", alterna(f.Tag, t)))
										}
									</div>
								</td>
								<td class="py-3 pr-6 text-right">
									@disparar(w.Slug)
								</td>
							</tr>
						}
					</tbody>
				</table>
				@pagination(Pagination{
					Page: f.Page, PerPage: f.PerPage, Total: filtered,
					PageLink: f.WithPage,
				})
			</div>
		}
	}
}

// interruptor pauses and resumes the schedule. It is a form, and not a checkbox
// with JS: with no script the page stays operable, and a POST makes it clear
// there is an effect.
templ interruptor(w postgres.WorkflowSummary) {
	if w.HasSchedule {
		<form method="post" action={ templ.SafeURL("/workflows/" + w.Slug + "/toggle") }>
			if w.Active {
				<button
					type="submit"
					title="Pause the schedule"
					aria-label={ "Pausar " + w.Slug }
					class="flex h-5 w-9 items-center rounded-full bg-state-success/80 px-0.5 transition-colors hover:bg-state-success"
				>
					<span class="ml-auto h-4 w-4 rounded-full bg-surface shadow-sm"></span>
				</button>
			} else {
				<button
					type="submit"
					title="Resume the schedule"
					aria-label={ "Retomar " + w.Slug }
					class="flex h-5 w-9 items-center rounded-full bg-line px-0.5 transition-colors hover:bg-muted/40"
				>
					<span class="h-4 w-4 rounded-full bg-surface shadow-sm"></span>
				</button>
			}
		</form>
	} else {
		<span class="block h-5 w-9" title="No schedule: manual trigger only"></span>
	}
}

// disparar is the button with no parameters — used in the LIST, where there is
// no room for a form and where the defaults are the right choice.
templ disparar(slug string) {
	<form method="post" action={ templ.SafeURL("/workflows/" + slug + "/trigger") } class="inline">
		<button
			type="submit"
			title="Run now"
			aria-label={ "Run " + slug }
			class="inline-flex h-8 w-8 items-center justify-center rounded-card border border-line text-gold-strong transition-colors hover:border-gold hover:bg-gold-wash"
		>
			<svg class="h-3.5 w-3.5" viewBox="0 0 12 12" fill="currentColor"><path d="M2.5 1.6v8.8L10 6z"></path></svg>
		</button>
	</form>
}

templ chip(rota, text string, active1 bool, ponto string) {
	if active1 {
		<a href={ templ.SafeURL(rota) } class="inline-flex items-center gap-1.5 rounded-card border border-ink bg-ink px-3.5 py-1.5 text-xs font-medium text-surface">
			if ponto != "" {
				<span class={ "h-1.5 w-1.5 rounded-full", ponto }></span>
			}
			{ text }
		</a>
	} else {
		<a href={ templ.SafeURL(rota) } class="inline-flex items-center gap-1.5 rounded-card border border-line bg-surface px-3.5 py-1.5 text-xs text-muted transition-colors hover:border-gold hover:text-ink">
			if ponto != "" {
				<span class={ "h-1.5 w-1.5 rounded-full", ponto }></span>
			}
			{ text }
		</a>
	}
}

// alterna makes the tag chip work as a toggle: clicking an already-active tag
// removes the filter instead of reapplying the same value.
func alterna(current, value string) string {
	if current == value {
		return ""
	}
	return value
}

// ---------------------------------------------------------------------------
// Runs, projects and detail
// ---------------------------------------------------------------------------

// RunFilter is the run screen's slice. It arrives through the query string, so
// a dashboard chart can point at "that hour's runs" with a link.
type RunFilter struct {
	State   string
	Workflow string
	De       string // YYYY-MM-DDTHH, the same format the chart emits
	Ate      string
	Label   string // descricao legivel do periodo, montada no servidor

	Page    int
	PerPage int
}

func (f RunFilter) url(field, value string, resetsPage bool) string {
	q := url.Values{}
	put := func(k, v string) {
		if v != "" {
			q.Set(k, v)
		}
	}
	put("state", f.State)
	put("workflow", f.Workflow)
	put("from", f.De)
	put("to", f.Ate)
	if !resetsPage && f.Page > 1 {
		put("page", fmt.Sprint(f.Page))
	}
	if value == "" {
		q.Del(field)
	} else {
		q.Set(field, value)
	}
	if len(q) == 0 {
		return "/runs"
	}
	return "/runs?" + q.Encode()
}

func (f RunFilter) With(field, value string) string { return f.url(field, value, true) }
func (f RunFilter) WithPage(n int) string         { return f.url("page", fmt.Sprint(n), false) }

// Active says whether there is any slice — without it the screen would show the
// "filters
// aplicados" vazia.
func (f RunFilter) Active() bool {
	return f.State != "" || f.Workflow != "" || f.De != "" || f.Ate != ""
}

templ Runs(runs []postgres.RunSummary, f RunFilter, total int) {
	@layouts.Base(layouts.Page{Title: "Runs", Kicker: "History", Active: "runs"}) {
		<div class="mb-5 flex flex-wrap items-center gap-2">
			@chip(f.With("state", ""), "All", f.State == "", "")
			@chip(f.With("state", "success"), "Success", f.State == "success", "bg-state-success")
			@chip(f.With("state", "failed"), "Failure", f.State == "failed", "bg-state-failed")
			@chip(f.With("state", "running"), "Running", f.State == "running", "bg-state-running")
			@chip(f.With("state", "queued"), "Queued", f.State == "queued", "bg-state-queued")
			if f.Workflow != "" {
				<span class="mx-2 h-5 w-px bg-line"></span>
				@filterApplied("workflow", f.Workflow, f.With("workflow", ""))
			}
			if f.Label != "" {
				@filterApplied("period", f.Label, f.With("from", "")+"&to=")
			}
		</div>
		<p class="display mb-3 text-lg text-ink">
			{ count(total, "run", "runs") }
			if f.Active() {
				<a href="/runs" class="ml-3 text-xs text-gold-strong hover:underline">clear filters</a>
			}
		</p>
		@runsTable(runs, Pagination{
			Page: f.Page, PerPage: f.PerPage, Total: total, PageLink: f.WithPage,
		})
	}
}

// filterApplied shows a slice that came from another screen (a click on the
// chart, for instance) with the way to remove it beside it — a filter you can
// only take off by editing the URL is not a filter, it is a trap.
templ filterApplied(label, value, remover string) {
	<span class="inline-flex items-center gap-2 rounded-card border border-gold/40 bg-gold-wash px-3 py-1.5 text-xs text-ink">
		<span class="text-gold-strong">{ label }:</span>
		<span class="font-medium">{ value }</span>
		<a href={ templ.SafeURL(remover) } class="text-muted hover:text-ink" aria-label="remover filtro">×</a>
	</span>
}

templ Projects(ps []postgres.ProjectSummary) {
	@layouts.Base(layouts.Page{Title: "Projects", Kicker: "Organization", Active: "projects"}) {
		if len(ps) == 0 {
			@components.Empty("No project yet.", "brevis publish --project my-project")
		} else {
			<div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
				for _, p := range ps {
					<div class="rounded-card border border-line bg-surface p-6 shadow-warm-sm">
						<p class="kicker">{ p.Slug }</p>
						<h3 class="display mt-1 text-2xl text-ink">{ p.Name }</h3>
						<dl class="mt-5 flex gap-6 text-sm">
							<div>
								<dt class="text-xs text-muted">Workflows</dt>
								<dd class="display text-2xl tabular-nums text-ink">{ fmt.Sprint(p.Workflows) }</dd>
							</div>
							<div>
								<dt class="text-xs text-muted">Runs</dt>
								<dd class="display text-2xl tabular-nums text-ink">{ fmt.Sprint(p.Runs) }</dd>
							</div>
						</dl>
						<p class="mt-5 text-xs text-muted">created em { p.CreatedAt.Local().Format("02/01/2006") }</p>
					</div>
				}
			</div>
		}
	}
}

templ runsTable(runs []postgres.RunSummary, p Pagination) {
	if len(runs) == 0 {
		@components.Empty("No run yet.", "brevis scheduler")
	} else {
		<div class="overflow-hidden rounded-card border border-line bg-surface shadow-warm-sm">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-line bg-parchment-soft/60 text-left">
						@th("State", "pl-6")
						@th("Workflow", "")
						@th("Origem", "")
						@th("Slot", "")
						@th("Duration", "")
						@th("Criado", "text-right")
						@th("", "w-16 pr-6")
					</tr>
				</thead>
				<tbody class="divide-y divide-line-soft">
					for _, r := range runs {
						<tr class="transition-colors hover:bg-gold-wash">
							<td class="px-3 py-3 pl-6">
								@components.State(r.Status)
								if r.Attempt > 0 {
									<span class="ml-2 text-[0.7rem] text-state-retrying">attempt { fmt.Sprint(r.Attempt+1) }</span>
								}
							</td>
							<td class="px-3 py-3">
								<a href={ templ.SafeURL("/runs/" + r.ID) } class="font-medium text-ink hover:text-gold-strong">
									{ r.WorkflowSlug }
								</a>
							</td>
							<td class="px-3 py-3 text-xs text-muted">{ r.TriggerType }</td>
							<td class="px-3 py-3 text-xs tabular-nums text-muted">{ components.UTCStamp(r.LogicalDate) }</td>
							<td class="px-3 py-3 text-xs tabular-nums text-muted">{ components.Duration(r.Duration) }</td>
							<td class="px-3 py-3 text-right text-xs text-muted">
								{ components.When(&r.CreatedAt) }
							</td>
							<td class="px-3 py-3 pr-6 text-right">
								if r.Err != "" {
									@components.ErrorButton(r.ID)
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			@pagination(p)
		</div>
		// The dialogs sit OUTSIDE the table: a <dialog> inside a <tbody> is
		// invalid HTML, and the browser moves it out — breaking the row's
		// layout.
		for _, r := range runs {
			if r.Err != "" {
				@components.ErrorDialog(r.ID, r.WorkflowSlug, r.Status, r.Err)
			}
		}
	}
}

// dagAssets is the island's exact load order. The order is not style: the shim
// references `React` the instant it runs, and React Flow's bundle references
// `jsxRuntime` in its own. Swapping two lines here leaves the screen blank.
var dagAssets = layouts.Island{
	CSS: []string{"/assets/vendor/xyflow.css"},
	JS: []string{
		"/assets/vendor/react.js",
		"/assets/vendor/react-dom.js",
		"/assets/jsx-shim.js",
		"/assets/vendor/xyflow.js",
		"/assets/dag.js",
	},
}

// Workflow shows the published definition. With no run state: it is the screen
// for "what this workflow is", and it has to serve a workflow that never ran
// too.
templ Workflow(w wf.Workflow, latest []postgres.RunSummary) {
	@layouts.Base(layouts.Page{
		Title: w.Slug, Kicker: "Workflow", Active: "workflows",
		Island: dagAssets, Wide: true, Actions: disparar(w.Slug),
	}) {
		<div class="mb-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted">
			<span>{ fmt.Sprint(len(w.Nodes)) } steps</span>
			<span>{ fmt.Sprint(len(w.Edges)) } dependencies</span>
			if w.Schedule != "" {
				<span class="font-mono text-xs text-ink">{ w.Schedule }</span>
			} else {
				<span>manual trigger only</span>
			}
			for _, t := range w.Tags {
				@components.Tag(t, "/workflows?tag="+t)
			}
		</div>
		if len(w.Params) > 0 {
			@paramsForm(w)
		}
		@dag("/api/workflows/" + w.Slug + "/graph")
		if len(latest) > 0 {
			<section class="mt-6">
				<div class="mb-3 flex items-baseline justify-between">
					<h2 class="kicker">This workflow's runs</h2>
					<a href={ templ.SafeURL("/runs?workflow=" + w.Slug) } class="text-xs text-gold-strong hover:underline">
						see all
					</a>
				</div>
				@runsTable(latest, Pagination{})
			</section>
		}
	}
}

// Run shows one run. The header comes from the server already rendered; only the
// DAG with each step's state depends on JavaScript.
templ Run(r run.Run, logs []postgres.StepLog, raised []alerts.Record) {
	@layouts.Base(layouts.Page{
		Title: r.WorkflowSlug, Kicker: "Run", Active: "runs",
		Island: dagAssets, Wide: true,
	}) {
		<div class="mb-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
			@components.State(string(r.Status))
			<span class="text-muted">{ r.TriggerType }</span>
			if r.LogicalDate != nil {
				<span class="font-mono text-xs text-muted">slot { components.UTCStamp(r.LogicalDate) }</span>
			}
			if r.Attempt > 0 {
				<span class="text-xs text-state-retrying">attempt { fmt.Sprint(r.Attempt+1) }</span>
			}
			<a href={ templ.SafeURL("/workflows/" + r.WorkflowSlug) } class="text-xs text-gold-strong hover:underline">see definition</a>
			<span class="font-mono text-[0.7rem] text-muted/70">{ r.ID.String() }</span>
		</div>
		if r.Err != "" {
			<pre class="mb-5 overflow-auto rounded-card border border-state-failed/20 bg-state-failed/5 px-5 py-4 font-mono text-xs text-state-failed">{ r.Err }</pre>
		}
		@dag("/api/runs/" + r.ID.String() + "/graph")
		@autoParams(r)
		@alertsRaised(raised)
		@stepsOutput(logs)
	}
}

// autoParams shows what the engine worked out for this run.
//
// On the screen because a value a pipeline reads is a value somebody debugging
// that pipeline has to be able to see. "Why did this run fetch that window" is
// answered here rather than by reading the fetcher's source and reconstructing
// its arithmetic.
//
// The one worth reading first is `adjusted_at`: the clock a step reads instead
// of now(). Next to `delay` it says, at a glance, that a run was forty minutes
// late AND that it still read the right window -- which is exactly the pair
// somebody stares at after finding a gap in a table.
templ autoParams(r run.Run) {
	<section class="mt-8">
		<h2 class="display mb-1 text-xl text-ink">Auto params</h2>
		<p class="mb-4 text-xs text-muted">
			The engine works these out for every run. No workflow declares them, and
			every step can read them — as <code class="font-mono">$BREVIS_AUTO_*</code>.
		</p>
		<div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
			@autoValue("adjusted_at", components.UTCStamp(&r.Auto.AdjustedAt),
				"the clock to read instead of now()")
			@autoValue("date", r.Auto.Date, "the UTC day of adjusted_at — the partition")
			@autoValue("delay", lateness(r.Auto.DelaySeconds), "how late this attempt started")
			if r.Auto.ScheduledAt != nil {
				@autoValue("scheduled_at", components.UTCStamp(r.Auto.ScheduledAt), "the slot this run represents")
			}
			if r.Auto.StartedAt != nil {
				@autoValue("started_at", components.UTCStamp(r.Auto.StartedAt), "when this attempt began")
			}
			if r.Auto.IntervalStart != nil {
				@autoValue("interval_start", components.UTCStamp(r.Auto.IntervalStart), "the window this run covers, from")
			}
			if r.Auto.IntervalEnd != nil {
				@autoValue("interval_end", components.UTCStamp(r.Auto.IntervalEnd), "…up to, excluded")
			}
			@autoValue("previous_error", fmt.Sprint(r.Auto.PreviousError), "did the run before this one fail")
			if r.Auto.PreviousSuccessAt != nil {
				@autoValue("previous_success_at", components.UTCStamp(r.Auto.PreviousSuccessAt), "how far back to catch up from")
			}
		</div>
	</section>
}

templ autoValue(name, value, why string) {
	<div class="rounded-2xl border border-line bg-surface px-4 py-3">
		<div class="font-mono text-[0.7rem] uppercase tracking-wider text-muted">{ name }</div>
		<div class="mt-0.5 font-mono text-sm text-ink">{ value }</div>
		<div class="mt-1 text-[0.7rem] leading-snug text-muted/80">{ why }</div>
	</div>
}

// lateness reads as a duration rather than as a count of seconds. "2220" is a
// number somebody converts; "37m" is an answer.
func lateness(seconds int) string {
	if seconds <= 0 {
		return "on time"
	}
	d := time.Duration(seconds) * time.Second
	return components.Duration(&d)
}

// alertsRaised shows what was announced about this run, and whether it arrived.
//
// It is the part that keeps the feature honest: an alert nobody can see is
// indistinguishable from an alert that was never sent. Before the outbox there
// was nothing to show -- a failed webhook was a log line in a pod that no
// longer exists.
//
// The row that matters is "undelivered". It is the case where somebody is
// waiting for a message that is not coming, and it is the only way to find out
// without reading the alert pod's logs.
templ alertsRaised(raised []alerts.Record) {
	if len(raised) > 0 {
		<section class="mt-8">
			<h2 class="display mb-4 text-xl text-ink">Alerts</h2>
			<div class="space-y-2">
				for _, a := range raised {
					<div class="rounded-2xl border border-line bg-surface px-5 py-3.5">
						<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
							@components.State(alertTone(a.State()))
							<span class="text-ink">{ alertWording(a) }</span>
							<span class="font-mono text-xs text-muted">{ a.Channel }</span>
							if a.Attempts > 0 {
								<span class="text-xs text-muted">{ attemptWord(a.Attempts) }</span>
							}
							if a.DeliveredAt != nil {
								<span class="text-xs text-muted">{ components.Timestamp(a.DeliveredAt) }</span>
							} else {
								<span class="text-xs text-muted">raised { components.Timestamp(&a.CreatedAt) }</span>
							}
						</div>
						if a.Err != "" {
							// Shown even on a delivered alert's history? No: the
							// error is cleared on success, so anything here is
							// live. A row that succeeded on the third try must
							// not still display the second try's failure.
							<pre class="mt-2.5 overflow-auto rounded-xl border border-state-failed/20 bg-state-failed/5 px-4 py-2.5 font-mono text-xs text-state-failed">{ a.Err }</pre>
						}
					</div>
				}
			</div>
		</section>
	}
}

// alertTone borrows the run states' palette rather than inventing colours for a
// second vocabulary. The words stay the alert's own.
func alertTone(state string) string {
	switch state {
	case "delivered":
		return "success"
	case "undelivered":
		return "failed"
	}
	return "running"
}

// alertWording says what happened in the reader's terms, not the table's.
//
// "sending" on its own is ambiguous in the way that matters: it is also what a
// row looks like when nothing is draining the outbox, so it says which process
// is supposed to.
func alertWording(a alerts.Record) string {
	subject := "run failed"
	if a.Kind == alerts.KindStep && a.NodeID != "" {
		subject = "step " + a.NodeID + " failed"
	}
	switch a.State() {
	case "delivered":
		return subject + " — delivered"
	case "undelivered":
		return subject + " — never delivered"
	}
	return subject + " — waiting for `brevis alert`"
}

func attemptWord(n int) string {
	if n == 1 {
		return "1 try"
	}
	return fmt.Sprint(n) + " tries"
}

// duracaoMs adapts the milliseconds the query returns to the existing formatter,
// which speaks in time.Duration.
func durationMs(ms int64) string {
	d := time.Duration(ms) * time.Millisecond
	return components.Duration(&d)
}

// stepsOutput shows each attempt's log.
//
// It exists because the log lived only in the pod, and the pod is deleted when
// the step ends: a pipeline that failed at 4am left "failed" on the screen and
// nothing else. Rendered on the server inside a <details>, with no JavaScript
// and no second call — the graph above is already polled second by second, and
// attaching the log to that JSON would make every poll more expensive.
templ stepsOutput(logs []postgres.StepLog) {
	if len(logs) > 0 {
		<section class="mt-8">
			<h2 class="display mb-4 text-xl text-ink">Step output</h2>
			<div class="space-y-2">
				for _, p := range logs {
					<details class="group rounded-2xl border border-line bg-surface">
						<summary class="flex cursor-pointer flex-wrap items-center gap-x-4 gap-y-1 px-5 py-3.5 text-sm">
							@components.State(p.Status)
							<span class="font-medium text-ink">{ p.NodeID }</span>
							if p.Attempt > 0 {
								<span class="text-xs text-state-retrying">attempt { fmt.Sprint(p.Attempt+1) }</span>
							}
							if p.ExitCode != nil {
								<span class="font-mono text-xs text-muted">exit { fmt.Sprint(*p.ExitCode) }</span>
							}
							if p.DurationMs > 0 {
								<span class="text-xs text-muted">{ durationMs(p.DurationMs) }</span>
							}
							if p.Log == "" {
								<span class="text-xs text-muted/70 italic">no output recorded</span>
							}
						</summary>
						if p.Err != "" {
							<p class="mx-5 mb-3 rounded-xl bg-state-failed/5 px-4 py-2.5 text-xs text-state-failed">{ p.Err }</p>
						}
						if p.Log != "" {
							// `overflow-auto` with a maximum height: a dbt output
							// with hundreds of lines must not push the rest of the
							// page off the screen.
							<pre class="mx-5 mb-5 max-h-[28rem] overflow-auto rounded-card bg-surface-2 px-4 py-3 font-mono text-[0.7rem] leading-relaxed whitespace-pre text-ink">{ p.Log }</pre>
						}
					</details>
				}
			</div>
		</section>
	}
}

// dag is the island's mount point. The height is fixed on purpose: with `h-full`
// inside a scrolling container, React Flow's canvas is born at 0px and the
// grafo some.
// The height here is a STARTING one. dag.js measures the drawing and sets the
// real one, because a graph eight steps wide and one lane deep needs a third of
// what a fixed height gives it.
//
// There is deliberately no `min-height`. It would win against the computed
// value, and it did: the box stayed at 380px while the script asked for 300,
// and the drawing sat pinned to the bottom of the empty part.
templ dag(src string) {
	<div
		id="dag"
		data-src={ src }
		class="rounded-card border border-line bg-surface shadow-warm-sm"
		style="height: 380px;"
	></div>
}

// ---------------------------------------------------------------------------
// Formatadores locais
// ---------------------------------------------------------------------------

func pct(v float64) string { return fmt.Sprintf("%.1f%%", v) }

// contagem agrees the noun with the number. "1 workflows" is the kind of detail
// that makes a screen look generated rather than written.
func count(n int, singular, plural string) string {
	if n == 1 {
		return fmt.Sprintf("1 %s", singular)
	}
	return fmt.Sprintf("%d %s", n, plural)
}

// failureHue leaves the number neutral when there is no failure at all: painting
// a "0.0%" red teaches the eye to ignore the colour on exactly the screen where
// it has to mean something.
func failureHue(n int) string {
	if n == 0 {
		return "text-ink"
	}
	return "text-state-failed"
}

func failureNote(n int) string {
	if n == 0 {
		return "no failure in the window"
	}
	if n == 1 {
		return "1 run failed"
	}
	return fmt.Sprintf("%d runs failed", n)
}

func meanDuration(d time.Duration) string {
	if d == 0 {
		return "no duration measured"
	}
	return "average duration " + components.Duration(&d)
}

// startOrCreated shows when the work actually started; for whatever is still in
// the queue, what matters is how long it has been waiting.
func startOrCreated(r postgres.RunSummary) *time.Time {
	if r.StartedAt != nil {
		return r.StartedAt
	}
	return &r.CreatedAt
}

var _ = strings.TrimSpace


// paramsForm is the trigger WITH values — the difference between running
// the workflow and reprocessing a window.
//
// The fields come from the YAML's declaration, and the `name` carries a `param.`
// prefix so it does not collide with the form's own future fields. Types become
// controls: a boolean is a select, an integer is a number, an enum is a select —
// each refusing in the browser what the server would refuse again afterwards.
templ paramsForm(w wf.Workflow) {
	<form
		method="post"
		action={ templ.SafeURL("/workflows/" + w.Slug + "/trigger") }
		class="mb-5 rounded-card border border-line bg-surface p-6 shadow-warm-sm"
	>
		<p class="kicker mb-4">Run with parameters</p>
		<div class="flex flex-wrap items-end gap-4">
			for _, p := range w.Params {
				<label class="flex min-w-[180px] flex-col gap-1">
					<span class="text-xs font-medium text-ink">{ p.Name }</span>
					if p.Description != "" {
						<span class="text-[0.7rem] text-muted">{ p.Description }</span>
					}
					if p.Type == wf.ParamBool {
						<select name={ "param." + p.Name } class="rounded-xl border border-line bg-parchment-soft px-3 py-2 text-sm text-ink">
							@option("false", p.Default)
							@option("true", p.Default)
						</select>
					} else if len(p.Enum) > 0 {
						<select name={ "param." + p.Name } class="rounded-xl border border-line bg-parchment-soft px-3 py-2 text-sm text-ink">
							for _, v := range p.Enum {
								@option(v, p.Default)
							}
						</select>
					} else {
						<input
							type={ fieldType(p) }
							name={ "param." + p.Name }
							value={ p.Default }
							placeholder={ p.Pattern }
							class="rounded-xl border border-line bg-parchment-soft px-3 py-2 font-mono text-sm text-ink placeholder:text-muted/60"
						/>
					}
				</label>
			}
			<button
				type="submit"
				class="rounded-card bg-ink px-4 py-2 text-xs font-medium text-surface transition-colors hover:bg-accent-strong"
			>Run</button>
		</div>
	</form>
}

templ option(value, fallback string) {
	if value == fallback {
		<option value={ value } selected>{ value }</option>
	} else {
		<option value={ value }>{ value }</option>
	}
}

// fieldType picks the browser's control. `number` for an integer makes a
// phone's keyboard open right and blocks a letter before the server has to.
func fieldType(p wf.Param) string {
	if p.Type == wf.ParamInteger {
		return "number"
	}
	return "text"
}
