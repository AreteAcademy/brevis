package pages

import (
	"context"
	"github.com/AreteAcademy/brevis/web/assets"
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/AreteAcademy/brevis/internal/domain/diagnosis"
	"github.com/AreteAcademy/brevis/internal/domain/run"
	wf "github.com/AreteAcademy/brevis/internal/domain/workflow"
	"github.com/AreteAcademy/brevis/internal/alerts"
	"github.com/AreteAcademy/brevis/internal/infrastructure/postgres"
	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/layouts"
	"github.com/AreteAcademy/brevis/web/i18n"
)

// ---------------------------------------------------------------------------
// Overview
// ---------------------------------------------------------------------------

// OverviewData is everything the landing screen shows. A struct rather than
// seven parameters: the signature was already illegible with four.
type OverviewData struct {
	Window    Window
	Ind       postgres.Indicators
	Buckets    []postgres.Bucket
	Proximas  []NextRun
	Recentes  []postgres.RunSummary
	Pending int
	// Now is the page's clock, for "next trigger in 12m".
	Now time.Time
	// Attention is what needs the reader, the page's first section.
	Attention Attention
	// Events are the event log's, newest first; Logos what each recent run's
	// workflow runs in.
	Events []postgres.Event
	Logos  map[string][]string
}

// ProximaExecucao is a future trigger, already computed from the cron.
type NextRun struct {
	Workflow string
	Cron     string
	Timezone string
	When   time.Time
	// Logos are what the workflow runs in.
	Logos []string
}


// windowToggle is the Overview's three windows, as links: GET, shareable,
// the open one marked.
func windowToggle(w Window) templ.Component {
	return windowToggleT(w)
}

templ windowToggleT(current Window) {
	<nav aria-label={ i18n.T(ctx, "window.label") } class="flex items-center rounded-card border border-line text-[12px]">
		for _, w := range overviewWindows {
			if w.Key == current.Key {
				<a href={ templ.SafeURL("/?window=" + w.Key) } aria-current="page" class="bg-surface-2 px-2.5 py-1 font-medium text-ink">{ windowShort(ctx, w) }</a>
			} else {
				<a href={ templ.SafeURL("/?window=" + w.Key) } class="px-2.5 py-1 text-muted hover:text-ink">{ windowShort(ctx, w) }</a>
			}
		}
	</nav>
}

// nextTriggers are the eight soonest triggers (screen-overview T5): what the
// workflow runs in and its name, when -- green when it is about to fire, so
// the reader can watch it -- the schedule in words and the cron.
templ nextTriggers(d OverviewData) {
	<section data-next-triggers>
		@components.PanelLink(i18n.T(ctx, "overview.next.title"), "", "/workflows", i18n.T(ctx, "overview.next.all")+" →") {
			if len(d.Proximas) == 0 {
				<div class="px-3.5 py-3">
					@components.Empty(i18n.T(ctx, "overview.next.none"), "brevis publish file.yaml")
				</div>
			} else {
				<ul class="divide-y divide-line-soft">
					for _, p := range d.Proximas {
						{{ in := p.When.Sub(d.Now) }}
						<li class="px-3.5 py-2.5">
							<div class="flex items-center gap-2">
								for _, k := range p.Logos {
									@components.Logo(k, 18)
								}
								<a href={ templ.SafeURL("/workflows/" + p.Workflow) } class="min-w-0 truncate font-mono text-[13px] text-ink hover:underline">{ p.Workflow }</a>
								if in < 2*time.Minute {
									<span title={ components.UTCStamp(&p.When) } class="ml-auto shrink-0 text-[12.5px] font-medium whitespace-nowrap text-state-success">{ i18n.T(ctx, "time.in", "span", untilText(in)) }</span>
								} else {
									<span title={ components.UTCStamp(&p.When) } class="ml-auto shrink-0 text-[12.5px] whitespace-nowrap text-ink">{ i18n.T(ctx, "time.in", "span", untilText(in)) }</span>
								}
							</div>
							<div class="mt-0.5 flex items-baseline justify-between gap-3 text-[12px]">
								<span class="min-w-0 truncate text-muted">{ CronTextIn(ctx, p.Cron) }</span>
								<span class="shrink-0 font-mono text-[11.5px] text-faint">{ p.Cron }</span>
							</div>
						</li>
					}
				</ul>
			}
		}
	</section>
}

// th is a column header. The vertical breathing room (py-4) is deliberate:
// pressed against the title, the header competed with the first row instead of
// separating from it.
templ th(text, extra string) {
	<th class={ "px-2.5 text-[11.5px] font-medium whitespace-nowrap text-faint", extra }>{ text }</th>
}

// sortableTh is the same column, clickable. The arrow appears only on the
// active column — one in every header becomes noise.
templ sortableTh(text, field string, f Filter, extra string) {
	<th class={ "px-2.5 text-[11.5px] font-medium whitespace-nowrap", extra, columnColour(f, field) }>
		<a href={ templ.SafeURL(f.WithSort(field)) } class="inline-flex items-center gap-1 hover:underline">
			{ text }
			if s := f.Arrow(field); s != "" {
				<span class="text-ink">{ s }</span>
			} else {
				<span class="text-line">↕</span>
			}
		</a>
	</th>
}

func columnColour(f Filter, field string) string {
	if f.Sort == field {
		return "text-ink"
	}
	return "text-muted"
}

// paginacao is the lists' footer.
templ pagination(p Pagination) {
	if p.Total > 0 {
		<div class="flex flex-wrap items-center justify-between gap-4 border-t border-line px-6 py-4 text-xs text-muted">
			<span>
				{ fmt.Sprintf("%d–%d of %d", p.First(), p.Last(), p.Total) }
			</span>
			if p.Pages() > 1 {
				<nav class="flex items-center gap-1">
					if p.Page > 1 {
						<a href={ templ.SafeURL(p.PageLink(p.Page - 1)) } class="rounded-card border border-line px-3 py-1 transition-colors hover:border-line-strong hover:text-ink">previous</a>
					} else {
						<span class="rounded-card border border-line-soft px-3 py-1 text-line">previous</span>
					}
					for _, n := range p.Window() {
						if n == p.Page {
							<span class="rounded-card border border-ink bg-ink px-3 py-1 font-medium text-surface">{ fmt.Sprint(n) }</span>
						} else {
							<a href={ templ.SafeURL(p.PageLink(n)) } class="rounded-card border border-line px-3 py-1 transition-colors hover:border-line-strong hover:text-ink">{ fmt.Sprint(n) }</a>
						}
					}
					if p.Page < p.Pages() {
						<a href={ templ.SafeURL(p.PageLink(p.Page + 1)) } class="rounded-card border border-line px-3 py-1 transition-colors hover:border-line-strong hover:text-ink">next</a>
					} else {
						<span class="rounded-card border border-line-soft px-3 py-1 text-line">next</span>
					}
				</nav>
			}
		</div>
	}
}

// ---------------------------------------------------------------------------
// Workflows — a lista de DAGs
// ---------------------------------------------------------------------------

// Filter holds the search bar's state. It lives in the URL, not in memory: that
// way an applied filter can be pasted into the on-call chat and opens the same
// on the other
// lado.
type Filter struct {
	Search  string
	State string // ultimo estado: failed, queued, running, success
	Active  string // active | paused

	// Tags is a set: a workflow must carry ALL of them. One `tag=` each in the
	// URL, in the order they were chosen.
	Tags []string

	// Project scopes the list to one project's workflows. It is what makes a
	// project more than a row on a screen: the slug is unique WITHIN a project,
	// so two of them can each have a `daily_ingest`, and until this existed
	// there was no way to look at one project's half of that.
	Project string

	// Sort is the sort field; Desc inverts it. They live in the URL for the same
	// reason the filters do: a sorted screen has to be pasteable to somebody
	// else.
	Sort string
	Desc  bool

	Page    int
	PerPage int
}

// With returns the same URL with one field swapped — since every chip becomes a
// link, the rest of the filter has to survive the click.
//
// Changing a filter always returns to the first page: staying on page 7 of a
// result that now has two would be an empty screen with no explanation.
func (f Filter) With(field, value string) string {
	return f.url(field, value, true)
}

// WithTag toggles one tag in the set: a tag not chosen joins it, a chosen one
// leaves it and the others stay.
func (f Filter) WithTag(tag string) string {
	g := f
	g.Tags = nil
	found := false
	for _, t := range f.Tags {
		if t == tag {
			found = true
			continue
		}
		g.Tags = append(g.Tags, t)
	}
	if !found {
		g.Tags = append(g.Tags, tag)
	}
	return g.url("page", "", true)
}

// HasTag says whether the tag is chosen.
func (f Filter) HasTag(tag string) bool {
	for _, t := range f.Tags {
		if t == tag {
			return true
		}
	}
	return false
}

// WithPage navigates without touching anything else.
func (f Filter) WithPage(n int) string {
	return f.url("page", fmt.Sprint(n), false)
}

// WithSort flips the direction when the field is already the sorted one, and
// starts ascending when it is another — the behaviour any table teaches.
func (f Filter) WithSort(field string) string {
	if f.Sort == field && !f.Desc {
		return f.url("dir", "desc", true)
	}
	if f.Sort == field && f.Desc {
		// Terceiro clique remove a ordenacao e volta a ordem natural.
		g := f
		g.Sort, g.Desc = "", false
		return g.url("page", "", true)
	}
	g := f
	g.Desc = false
	return g.url("sort", field, true)
}

// Arrow is the direction indicator in the header.
func (f Filter) Arrow(field string) string {
	if f.Sort != field {
		return ""
	}
	if f.Desc {
		return "↓"
	}
	return "↑"
}

func (f Filter) url(field, value string, resetsPage bool) string {
	q := url.Values{}
	put := func(k, v string) {
		if v != "" {
			q.Set(k, v)
		}
	}
	put("q", f.Search)
	put("state", f.State)
	put("active", f.Active)
	for _, t := range f.Tags {
		q.Add("tag", t)
	}
	put("project", f.Project)
	put("sort", f.Sort)
	if f.Desc {
		put("dir", "desc")
	}
	if !resetsPage && f.Page > 1 {
		put("page", fmt.Sprint(f.Page))
	}
	if f.PerPage > 0 && f.PerPage != DefaultPerPage {
		put("per", fmt.Sprint(f.PerPage))
	}
	if value == "" {
		q.Del(field)
	} else {
		q.Set(field, value)
	}
	if len(q) == 0 {
		return "/workflows"
	}
	return "/workflows?" + q.Encode()
}

// DefaultPerPage is the lists' page size. Twenty-five fits a laptop screen
// without endless scrolling and without forcing a page turn on every glance.
const DefaultPerPage = 25

// Pagination is the footer of any paginated list.
type Pagination struct {
	Page    int
	PerPage int
	Total     int

	// PageLink builds each page's URL. Injected so the same component serves
	// /workflows and /runs, which have different filters.
	PageLink func(int) string
}

func (p Pagination) Pages() int {
	if p.PerPage <= 0 {
		return 1
	}
	n := (p.Total + p.PerPage - 1) / p.PerPage
	if n < 1 {
		return 1
	}
	return n
}

func (p Pagination) First() int {
	if p.Total == 0 {
		return 0
	}
	return (p.Page-1)*p.PerPage + 1
}

func (p Pagination) Last() int {
	end := p.Page * p.PerPage
	if end > p.Total {
		return p.Total
	}
	return end
}

// Window returns the page numbers to show, centred on the current one. Listing
// them all would break the footer with a hundred pages.
func (p Pagination) Window() []int {
	total := p.Pages()
	de, ate := p.Page-2, p.Page+2
	if de < 1 {
		ate += 1 - de
		de = 1
	}
	if ate > total {
		de -= ate - total
		ate = total
	}
	if de < 1 {
		de = 1
	}
	var out []int
	for i := de; i <= ate; i++ {
		out = append(out, i)
	}
	return out
}

templ Workflows(ws []postgres.WorkflowSummary, tags []string, f Filter, counts WorkflowCounts, recent map[string][]postgres.RecentRun, logos map[string][]string, total, filtered int) {
	@layouts.Base(layouts.Page{Title: "Workflows", Kicker: "Orchestration", Active: "workflows"}) {
		// THE BOX ANSWERS WHILE SOMEBODY TYPES, and the server still decides:
		// the list is paginated, so ui.js submits this form as a fetch
		// (`data-swap-typing`) and swaps the list the handler draws alone. With
		// no script it is the GET form it always was, and Enter submits it.
		// The other filters go along as hidden fields: searching must not erase
		// the state the operator had already chosen.
		<form method="get" action="/workflows" role="search" data-swap="workflows-list" data-swap-typing class="mb-3 w-full sm:w-80">
			for _, h := range f.hidden() {
				<input type="hidden" name={ h[0] } value={ h[1] }/>
			}
			@components.SearchInput("q", f.Search, "Search workflows", "")
		</form>
		<div id="workflows-list">
			@WorkflowsList(ws, tags, f, counts, recent, logos, total, filtered)
		</div>
	}
}

// WorkflowsList is everything under the search box: the filters, the count,
// the table and its pages. It is the page's fragment (X-Brevis-Fragment:
// answer), so the counts follow the search as somebody types. Logos are what
// each workflow runs in, by slug.
templ WorkflowsList(ws []postgres.WorkflowSummary, tags []string, f Filter, counts WorkflowCounts, recent map[string][]postgres.RecentRun, logos map[string][]string, total, filtered int) {
	<div class="mb-3 flex flex-wrap items-center gap-2">
		// Each control scrolls on its own when the screen is narrower than its
		// choices, rather than cutting the last one off.
		<div class="max-w-full overflow-x-auto whitespace-nowrap">
			@components.Segmented("State", stateOptions(f, counts))
		</div>
		<div class="max-w-full overflow-x-auto whitespace-nowrap">
			@components.Segmented("Schedule", scheduleOptions(f, counts))
		</div>
		if len(tags) > 0 {
			@tagPopover(tags, f)
			for _, t := range f.Tags {
				<a
					href={ templ.SafeURL(f.WithTag(t)) }
					aria-label={ "Remove the tag " + t }
					class="inline-flex h-8 items-center gap-1.5 rounded-card border border-line-strong bg-surface-2 px-2.5 text-[0.8rem] text-ink"
				>
					{ t }
					<span class="text-muted">&times;</span>
				</a>
			}
		}
		// The project chip appears only when one is selected. There is no
		// row of every project here on purpose: a project is a namespace,
		// not a category, and most installations have one -- a permanent
		// chip for a filter that is almost never on is noise.
		if f.Project != "" {
			<span class="mx-2 h-5 w-px bg-line"></span>
			<a
				href={ templ.SafeURL(f.With("project", "")) }
				class="inline-flex items-center gap-1.5 rounded-card border border-line-strong bg-surface-2 px-3 py-1 text-xs text-ink"
			>
				project: <span class="font-mono">{ f.Project }</span>
				<span class="text-muted">&times;</span>
			</a>
		}
	</div>
	<p class="mb-2 text-[13px] font-semibold text-ink">
		{ count(filtered, "workflow", "workflows") }
		if filtered != total {
			<span class="ml-2 text-sm text-muted">of { fmt.Sprint(total) }</span>
			<a href="/workflows" class="ml-3 text-xs text-ink underline decoration-line-strong underline-offset-2 hover:decoration-ink">clear filters</a>
		}
	</p>
	if len(ws) == 0 {
		@components.Empty("No workflow matches these filters.", "brevis publish file.yaml")
	} else {
		<div class="overflow-x-auto rounded-card border border-line bg-surface shadow-warm-sm">
			<table class="ct w-full min-w-[56rem] text-sm">
				<thead>
					<tr class="border-b border-line bg-parchment-soft/60 text-left">
						@th("", "w-16 pl-6")
						@sortableTh("Workflow", "workflow", f, "")
						@sortableTh("Schedule", "schedule", f, "")
						@sortableTh("Next run", "next", f, "")
						@sortableTh("Last run", "last", f, "")
						@th("Tags", "")
						@th("", "w-24 pr-6 text-right")
					</tr>
				</thead>
				<tbody class="divide-y divide-line-soft">
					for _, w := range ws {
						<tr class="transition-colors hover:bg-hover">
							<td class="py-3 pl-6">
								@interruptor(w)
							</td>
							<td class="py-3 pr-3">
								<a href={ templ.SafeURL("/workflows/" + w.Slug) } class="font-medium text-ink hover:underline">
									{ w.Slug }
								</a>
								if ks := logos[w.Slug]; len(ks) > 0 {
									<span class="ml-1.5 inline-flex items-center gap-1 align-middle">
										for _, k := range ks {
											@components.Logo(k, 18)
										}
									</span>
								}
								<a
									href={ templ.SafeURL("/workflows?project=" + w.Project) }
									class="text-xs text-muted hover:text-ink hover:underline"
								>{ w.Project }</a>
							</td>
							<td class="py-3 pr-3">
								if w.Cron == "" {
									<span class="text-xs text-muted">manual trigger only</span>
								} else {
									<span class="inline-flex items-center gap-1.5 font-mono text-xs text-ink">
										<svg class="h-3.5 w-3.5 text-muted" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
											<rect x="2" y="3" width="12" height="11" rx="2"></rect>
											<path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3" stroke-linecap="round"></path>
										</svg>
										{ w.Cron }
									</span>
									if w.Catchup {
										<span class="ml-2 text-[0.7rem] text-muted">catchup</span>
									}
									if words := CronText(w.Cron); words != "" {
										<p data-cron-text class="mt-0.5 text-[0.7rem] text-muted">{ words }{ zoneSuffix(w.Timezone) }</p>
									}
								}
							</td>
							<td class="py-3 pr-3 text-xs tabular-nums">
								if w.NextRun != nil {
									<span class="text-ink">@components.ShortStamp(w.NextRun)</span>
									<span class="ml-1.5 text-muted">{ components.When(w.NextRun) }</span>
								} else if w.HasSchedule && !w.Active {
									<span class="text-muted">paused</span>
								} else {
									<span class="text-muted">—</span>
								}
							</td>
							<td class="py-3 pr-3">
								if w.LastRunID != nil {
									@recentRuns(recent[w.Slug])
									<a href={ templ.SafeURL("/runs/" + *w.LastRunID) } class="mt-1 block text-[0.7rem] tabular-nums text-muted hover:underline">
										@components.ShortStamp(w.LastRunAt) · { count(w.TotalRuns, "run", "runs") }
									</a>
								} else {
									<span class="text-xs text-muted">never ran</span>
								}
							</td>
							<td class="py-3 pr-3">
								<div class="flex flex-wrap gap-1">
									for _, t := range w.Tags {
										@components.Tag(t, f.WithTag(t))
									}
								</div>
							</td>
							<td class="py-3 pr-6 text-right">
								@disparar(w.Slug)
							</td>
						</tr>
					}
				</tbody>
			</table>
			@pagination(Pagination{
				Page: f.Page, PerPage: f.PerPage, Total: filtered,
				PageLink: f.WithPage,
			})
		</div>
	}
}

// recentRuns is a workflow's last runs as a strip of squares, oldest to
// newest, each a link to its run whose title says its state and time, in the
// state's colour.
templ recentRuns(runs []postgres.RecentRun) {
	if len(runs) > 0 {
		<div data-recent-runs class="flex items-center gap-0.5">
			for _, r := range runs {
				<a
					href={ templ.SafeURL("/runs/" + r.ID) }
					title={ recentTitle(r) }
					aria-label={ recentTitle(r) }
					class={ "h-3 w-2 rounded-[1px] transition-opacity hover:opacity-70", components.StateFill(r.Status) }
				></a>
			}
		</div>
	}
}

// tagPopover chooses the tags. It is a <details> holding a GET form -- the
// rest of the filter as hidden fields, a box that filters the tag list, one
// checkbox per tag, Apply -- so with no script it opens, is checked and is
// submitted like any form. With ui.js a checked box submits at once
// (`data-submit-on-change`), and the box filters the list as you type.
templ tagPopover(tags []string, f Filter) {
	<details data-popover class="relative">
		<summary class="inline-flex h-8 cursor-pointer list-none items-center gap-1.5 rounded-card border border-line bg-surface px-2.5 text-[0.8rem] text-muted transition-colors duration-150 hover:text-ink [&::-webkit-details-marker]:hidden">
			@components.Icon("tag", "h-3.5 w-3.5")
			Tags
			if len(f.Tags) > 0 {
				<span class="text-[0.72rem] text-ink tabular-nums">{ fmt.Sprint(len(f.Tags)) }</span>
			}
		</summary>
		<div class="absolute left-0 z-20 mt-1 w-64 rounded-card border border-line bg-surface p-2 shadow-warm-sm">
			<form method="get" action="/workflows" data-submit-on-change>
				for _, h := range f.tagFormHidden() {
					<input type="hidden" name={ h[0] } value={ h[1] }/>
				}
				<input
					type="search"
					aria-label="Filter tags"
					placeholder="Filter tags"
					data-filter-for="workflow-tags"
					autocomplete="off"
					class="mb-2 h-8 w-full rounded-card border border-line bg-surface px-2.5 text-[0.82rem] text-ink placeholder:text-faint focus:border-accent-strong focus:outline-none"
				/>
				<ul id="workflow-tags" class="max-h-60 overflow-y-auto">
					for _, t := range tags {
						<li data-filter-row data-filter-text={ strings.ToLower(t) }>
							<label class="flex cursor-pointer items-center gap-2 rounded-[2px] px-1.5 py-1 text-[0.82rem] text-ink hover:bg-surface-2">
								<input type="checkbox" name="tag" value={ t } checked?={ f.HasTag(t) } class="accent-ink"/>
								{ t }
							</label>
						</li>
					}
				</ul>
				<p data-filter-empty hidden class="px-1.5 py-1 text-[0.8rem] text-muted">No tag matches.</p>
				<button type="submit" class="mt-2 h-7 w-full rounded-card bg-ink text-xs font-medium text-surface">Apply</button>
			</form>
		</div>
	</details>
}

// interruptor pauses and resumes the schedule. It is a form, and not a checkbox
// with JS: with no script the page stays operable, and a POST makes it clear
// there is an effect.
templ interruptor(w postgres.WorkflowSummary) {
	if w.HasSchedule {
		<form method="post" action={ templ.SafeURL("/workflows/" + w.Slug + "/toggle") }>
			if w.Active {
				<button
					type="submit"
					title="Pause the schedule"
					aria-label={ "Pausar " + w.Slug }
					class="flex h-5 w-9 items-center rounded-full bg-state-success/80 px-0.5 transition-colors hover:bg-state-success"
				>
					<span class="ml-auto h-4 w-4 rounded-full bg-surface shadow-sm"></span>
				</button>
			} else {
				<button
					type="submit"
					title="Resume the schedule"
					aria-label={ "Retomar " + w.Slug }
					class="flex h-5 w-9 items-center rounded-full bg-line px-0.5 transition-colors hover:bg-muted/40"
				>
					<span class="h-4 w-4 rounded-full bg-surface shadow-sm"></span>
				</button>
			}
		</form>
	} else {
		<span class="block h-5 w-9" title="No schedule: manual trigger only"></span>
	}
}

// disparar is the button with no parameters — used in the LIST, where there is
// no room for a form and where the defaults are the right choice.
templ disparar(slug string) {
	<form method="post" action={ templ.SafeURL("/workflows/" + slug + "/trigger") } class="inline">
		<button
			type="submit"
			title="Run now"
			aria-label={ "Run " + slug }
			class="inline-flex h-8 w-8 items-center justify-center rounded-card border border-line text-muted transition-colors hover:border-line-strong hover:bg-hover hover:text-ink"
		>
			<svg class="h-3.5 w-3.5" viewBox="0 0 12 12" fill="currentColor"><path d="M2.5 1.6v8.8L10 6z"></path></svg>
		</button>
	</form>
}

templ chip(rota, text string, active1 bool, ponto string) {
	if active1 {
		<a href={ templ.SafeURL(rota) } class="inline-flex items-center gap-1.5 rounded-card border border-ink bg-ink px-3.5 py-1.5 text-xs font-medium text-surface">
			if ponto != "" {
				<span class={ "h-1.5 w-1.5 rounded-full", ponto }></span>
			}
			{ text }
		</a>
	} else {
		<a href={ templ.SafeURL(rota) } class="inline-flex items-center gap-1.5 rounded-card border border-line bg-surface px-3.5 py-1.5 text-xs text-muted transition-colors hover:border-line-strong hover:text-ink">
			if ponto != "" {
				<span class={ "h-1.5 w-1.5 rounded-full", ponto }></span>
			}
			{ text }
		</a>
	}
}


// ---------------------------------------------------------------------------
// Runs, projects and detail
// ---------------------------------------------------------------------------

// RunFilter is the run screen's slice. It arrives through the query string, so
// a dashboard chart can point at "that hour's runs" with a link.
type RunFilter struct {
	State   string
	Workflow string
	De       string // YYYY-MM-DDTHH, the same format the chart emits
	Ate      string
	Label   string // descricao legivel do periodo, montada no servidor

	Page    int
	PerPage int
}

func (f RunFilter) url(field, value string, resetsPage bool) string {
	q := url.Values{}
	put := func(k, v string) {
		if v != "" {
			q.Set(k, v)
		}
	}
	put("state", f.State)
	put("workflow", f.Workflow)
	put("from", f.De)
	put("to", f.Ate)
	if !resetsPage && f.Page > 1 {
		put("page", fmt.Sprint(f.Page))
	}
	if value == "" {
		q.Del(field)
	} else {
		q.Set(field, value)
	}
	if len(q) == 0 {
		return "/runs"
	}
	return "/runs?" + q.Encode()
}

func (f RunFilter) With(field, value string) string { return f.url(field, value, true) }
func (f RunFilter) WithPage(n int) string         { return f.url("page", fmt.Sprint(n), false) }

// Active says whether there is any slice — without it the screen would show the
// "filters
// aplicados" vazia.
func (f RunFilter) Active() bool {
	return f.State != "" || f.Workflow != "" || f.De != "" || f.Ate != ""
}

// liveSwitch follows the list as runs arrive. Hidden until ui.js can drive it
// -- with no script it would be a switch that does nothing -- and off until
// somebody turns it on; ui.js remembers the choice.
templ liveSwitch() {
	<span data-js>
		<button
			type="button"
			data-live-list="runs-list"
			aria-pressed="false"
			class="inline-flex h-8 items-center gap-2 rounded-card border border-line bg-surface px-3 text-[0.82rem] text-muted transition-colors duration-150 hover:text-ink aria-pressed:border-line-strong aria-pressed:bg-surface-2 aria-pressed:text-ink"
		>
			<span data-live-dot class="h-1.5 w-1.5 rounded-full bg-line-strong"></span>
			{ i18n.T(ctx, "runs.live") }
		</button>
	</span>
}

// filterApplied shows a slice that came from another screen (a click on the
// chart, for instance) with the way to remove it beside it — a filter you can
// only take off by editing the URL is not a filter, it is a trap.
templ filterApplied(label, value, remover string) {
	<span class="inline-flex items-center gap-2 rounded-card border border-line-strong bg-surface-2 px-3 py-1.5 text-xs text-ink">
		<span class="text-muted">{ label }:</span>
		<span class="font-medium">{ value }</span>
		<a href={ templ.SafeURL(remover) } class="text-muted hover:text-ink" aria-label={ i18n.T(ctx, "runs.remove_filter") }>×</a>
	</span>
}

// Projects is the list of namespaces.
//
// A project is what makes a workflow's slug unique WITHIN it -- two projects can
// each have a `daily_ingest` -- and it arrives from `brevis publish --project`.
// This screen used to end there: four numbers and a date, with nothing to click.
// A page that only tells you a thing exists is a page people stop opening.
//
// Each card now leads to that project's workflows, which is the one question
// the namespace exists to answer.
templ Projects(ps []postgres.ProjectSummary) {
	@layouts.Base(layouts.Page{Title: "Projects", Kicker: "Organization", Active: "projects"}) {
		if len(ps) == 0 {
			@components.Empty("No project yet.", "brevis publish --project my-project")
		} else {
			// A MEASURE ON THE BLOCK, which is where it belongs now that the
			// page has the window. Three lines of prose set across 2500px is
			// a line the eye loses on the way back.
			<p class="mb-4 max-w-3xl text-sm text-muted">
				A project namespaces its workflows: two projects can each have a
				<code class="font-mono text-xs">daily_ingest</code> without colliding.
				A workflow joins one with <code class="font-mono text-xs">brevis publish --project</code>.
			</p>
			// A FOURTH COLUMN WHERE THERE IS ROOM. Three cards across a wide
			// screen is three cards of 800px holding two numbers each.
			<div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
				for _, p := range ps {
					<a
						href={ templ.SafeURL("/workflows?project=" + p.Slug) }
						class="group rounded-card border border-line bg-surface p-5 transition-colors hover:border-line-strong"
					>
						<div class="flex items-baseline justify-between gap-3">
							<h3 class="display truncate text-base text-ink">{ p.Name }</h3>
							<span class="shrink-0 font-mono text-[0.7rem] text-muted">{ p.Slug }</span>
						</div>
						<dl class="mt-4 flex gap-3 text-sm">
							<div>
								<dt class="text-[0.7rem] tracking-wide text-muted uppercase">Workflows</dt>
								<dd class="display text-xl tabular-nums text-ink">{ fmt.Sprint(p.Workflows) }</dd>
							</div>
							<div>
								<dt class="text-[0.7rem] tracking-wide text-muted uppercase">Runs</dt>
								<dd class="display text-xl tabular-nums text-ink">{ fmt.Sprint(p.Runs) }</dd>
							</div>
						</dl>
						<p class="mt-4 flex items-center justify-between text-xs text-muted">
							<span>since { p.CreatedAt.Local().Format("2006-01-02") }</span>
							<span class="text-muted opacity-0 transition-opacity group-hover:opacity-100">
								see the workflows &rarr;
							</span>
						</p>
					</a>
				}
			</div>
		}
	}
}

templ runsTable(runs []postgres.RunSummary, p Pagination) {
	@runsTableWith(runs, p, runsOpts{Workflow: true})
}

// runsOpts are the runs table's two forms: on /runs and the Overview it
// names each run's workflow and is a card of its own; on a workflow's page
// (screen-workflow-v2 WV4) the workflow is the page, and the table sits
// inside a panel -- the state is then the link to the run.
type runsOpts struct {
	Workflow bool
	Bare     bool
	// Logos are what each workflow runs in, by slug; nil draws none.
	Logos map[string][]string
}

templ runsTableWith(runs []postgres.RunSummary, p Pagination, o runsOpts) {
	if len(runs) == 0 {
		@components.Empty("No run yet.", "brevis scheduler")
	} else {
		<div class={ templ.KV("overflow-hidden rounded-card border border-line bg-surface shadow-warm-sm", !o.Bare), templ.KV("overflow-x-auto", o.Bare) }>
			<table class="ct w-full text-sm">
				<thead>
					<tr class="border-b border-line bg-parchment-soft/60 text-left">
						@th(i18n.T(ctx, "runs.col.state"), "pl-6")
						if o.Workflow {
							@th(i18n.T(ctx, "runs.col.workflow"), "")
						}
						@th(i18n.T(ctx, "runs.col.trigger"), "")
						@th(i18n.T(ctx, "runs.col.slot"), "")
						@th(i18n.T(ctx, "runs.col.duration"), "")
						@th(i18n.T(ctx, "runs.col.created"), "text-right")
						@th("", "w-16 pr-6")
					</tr>
				</thead>
				<tbody class="divide-y divide-line-soft">
					{{ longest := longestDuration(runs) }}
					for _, r := range runs {
						<tr data-run-id={ r.ID } data-status={ r.Status } class="transition-colors hover:bg-hover">
							<td class="px-3 py-3 pl-6">
								if o.Workflow {
									@components.State(r.Status)
								} else {
									<a href={ templ.SafeURL("/runs/" + r.ID) } class="hover:underline">
										@components.State(r.Status)
									</a>
								}
								if r.Attempt > 0 {
									@components.Retry(r.Attempt)
								}
							</td>
							if o.Workflow {
								<td class="px-3 py-3">
									<span class="inline-flex items-center gap-1.5">
										for _, k := range o.Logos[r.WorkflowSlug] {
											@components.Logo(k, 18)
										}
										<a href={ templ.SafeURL("/runs/" + r.ID) } class="font-medium text-ink hover:underline">
											{ r.WorkflowSlug }
										</a>
									</span>
								</td>
							}
							<td class="px-3 py-3 text-xs text-muted">{ triggerWord(ctx, r.TriggerType) }</td>
							<td class="px-3 py-3 text-xs tabular-nums text-muted">@components.ShortStamp(r.LogicalDate)</td>
							<td class="px-3 py-3 text-xs tabular-nums text-muted">
								{ components.Duration(r.Duration) }
								if w := durationShare(r.Duration, longest); w != "" {
									<span class="mt-1 block h-1 w-24 rounded-full bg-surface-2">
										<span data-duration-bar style={ "width:" + w } class="block h-1 rounded-full bg-bar"></span>
									</span>
								}
							</td>
							<td class="px-3 py-3 text-right text-xs text-muted">
								{ i18n.Since(ctx, time.Now(), r.CreatedAt) }
							</td>
							<td class="px-3 py-3 pr-6 text-right">
								if r.Err != "" {
									@components.ErrorButton(r.ID)
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			@pagination(p)
		</div>
		// The dialogs sit OUTSIDE the table: a <dialog> inside a <tbody> is
		// invalid HTML, and the browser moves it out — breaking the row's
		// layout.
		for _, r := range runs {
			if r.Err != "" {
				@components.ErrorDialog(r.ID, r.WorkflowSlug, r.Status, r.Err)
			}
		}
	}
}

// dagAssets is the island's exact load order. The order is not style: the shim
// references `React` the instant it runs, and React Flow's bundle references
// `jsxRuntime` in its own. Swapping two lines here leaves the screen blank.
var dagAssets = layouts.Island{
	CSS: []string{assets.URL("vendor/xyflow.css")},
	JS: []string{
		assets.URL("vendor/react.js"),
		assets.URL("vendor/react-dom.js"),
		assets.URL("jsx-shim.js"),
		assets.URL("vendor/xyflow.js"),
		assets.URL("dag.js"),
	},
}

// Workflow shows the published definition. With no run state: it is the screen
// for "what this workflow is", and it has to serve a workflow that never ran
// too.
// WorkflowStats is one workflow's numbers, over workflowWindow.
//
// Every field degrades to its zero value on purpose: a definition has to stay
// readable with the database in trouble, and somebody looking at a broken
// installation is exactly who needs to read the graph.
type WorkflowStats struct {
	Window time.Duration
	Ind    postgres.Indicators
	Days   []postgres.Day

	// Load is what this workflow's SDK pipelines measured, per day. Empty for a
	// workflow whose steps are shell commands, which is why the panel checks
	// before drawing: four empty boxes would be four questions with no answer.
	Load []postgres.LoadDay
}

// workflowEyebrow is the line above the slug: the project, the schedule in
// words (or the expression, when the words are not sure), and whether the
// schedule is on. sum is nil when the summary could not be read, and the line
// then says only what the definition does.
// workflowMeta is the one line under the title (screen-workflow-v2 WV1):
// whether the schedule runs, the project, the cron with its words and zone,
// the size of the graph, the tags -- what an eyebrow above the title and a
// line below it said between them.
templ workflowMeta(p WorkflowPage) {
	{{ w, sum := p.Def, p.Sum }}
	<p data-workflow-meta class="mb-3 -mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-[12.5px] text-muted">
		if sum != nil && sum.HasSchedule {
			if sum.Active {
				<span class="inline-flex items-center gap-1.5 text-state-success"><span class="h-[7px] w-[7px] rounded-full bg-state-success"></span>Active</span>
			} else {
				<span class="inline-flex items-center gap-1.5 text-muted"><span class="h-[7px] w-[7px] rounded-full bg-state-pending"></span>Paused</span>
			}
			<span class="text-faint">·</span>
		}
		if sum != nil && sum.Project != "" {
			<a href={ templ.SafeURL("/workflows?project=" + sum.Project) } class="text-ink-2 hover:underline">{ sum.Project }</a>
			<span class="text-faint">·</span>
		}
		if w.Schedule == "" {
			<span>manual trigger only</span>
		} else {
			<span class="font-mono text-[12px] text-ink">{ w.Schedule }</span>
			if words := CronText(w.Schedule); words != "" {
				<span>{ words }{ zoneSuffix(scheduleZone(sum)) }</span>
			}
		}
		<span class="text-faint">·</span>
		<span>{ count(len(w.Nodes), "step", "steps") } · { count(len(w.Edges), "dependency", "dependencies") }</span>
		for _, t := range w.Tags {
			@components.Tag(t, "/workflows?tag="+t)
		}
	</p>
}

// yearOfRuns is the workflow's calendar.
templ yearOfRuns(st WorkflowStats, slug string) {
	@components.Panel("A year of runs", "") {
		<div class="px-3.5 py-3">
			<p class="mb-3 text-[12.5px] text-muted">
				One square per day. The colour is the day&#39;s worst outcome, not how
				much ran &mdash; the question a calendar answers is when this broke.
			</p>
			@components.Heatmap(st.Days, slug)
		</div>
	}
}

// workflowIsland is the graph's island for a workflow drawn as a graph; a
// one-step workflow's line needs no React.
func workflowIsland(p WorkflowPage) layouts.Island {
	if p.Step != nil {
		return layouts.Island{}
	}
	return dagAssets
}

// workflowActions are the page's verbs: Pause or Resume when there is a
// schedule, and Run (▶ or the drawer).
func workflowActions(p WorkflowPage) templ.Component {
	return workflowActionsT(p)
}

templ workflowActionsT(p WorkflowPage) {
	<div class="flex items-center gap-2">
		if p.Sum != nil && p.Sum.HasSchedule {
			@pauseAction(*p.Sum)
		}
		@runAction(p.Def)
	</div>
}

// pauseAction pauses or resumes the schedule from the workflow's own page:
// the toggle the list's switch posts to, as a button worded by what it will
// do. A form, so it works with no script and is never prefetched.
templ pauseAction(sum postgres.WorkflowSummary) {
	<form method="post" action={ templ.SafeURL("/workflows/" + sum.Slug + "/toggle") }>
		<button type="submit" class={ components.ButtonClass(components.ButtonSecondary, components.SizeRegular) }>
			if sum.Active {
				Pause
			} else {
				Resume
			}
		</button>
	</form>
}

// about is the question mark beside the name, or nothing.
func about(w wf.Workflow) templ.Component {
	if w.Description == "" {
		return nil
	}
	return components.AboutButton(w.Slug)
}

templ Workflow(p WorkflowPage) {
	{{ w, latest, st, graph := p.Def, p.Latest, p.Stats, p.Graph }}
	@layouts.Base(layouts.Page{
		Title: w.Slug, Kicker: "Workflow", Active: "workflows", Mono: true,
		Island: workflowIsland(p), Actions: workflowActions(p),
		// The question mark only exists when there is something behind it: a
		// control that opens an empty dialog is a promise the page does not
		// keep.
		Aside: about(w),
	}) {
		if w.Description != "" {
			@components.AboutDialog(w.Slug, w.Description)
		}
		@workflowMeta(p)
		if len(w.Params) > 0 {
			@runDrawer(w, runDrawerText)
		}
		// The same four numbers the dashboard opens with, scoped to this
		// workflow -- and over thirty days rather than one, because a daily job
		// has a single run in twenty-four hours and a rate over one sample is
		// not a rate.
		<div class="mb-3">
			@components.Stats(workflowPageStats(p))
		</div>
		// ONE STEP IS A LINE, BESIDE ITS CALENDAR (screen-workflow-v2 WV3);
		// two or more are the graph, the calendar under it.
		if p.Step != nil {
			<div class="grid grid-cols-1 items-start gap-3 min-[1180px]:grid-cols-2">
				@stepLine(*p.Step)
				@yearOfRuns(st, w.Slug)
			</div>
		} else {
			@dag("/api/workflows/"+w.Slug+"/graph", graph)
			<div class="mt-3">
				@yearOfRuns(st, w.Slug)
			</div>
		}
		if len(st.Load) > 0 {
			<section class="mt-3">
				@components.Panel("What it loads", "") {
					<div class="px-3.5 py-3">
						<p class="mb-3 text-[12.5px] text-muted">
							{ components.TrendWindow(st.Load) }. The calendar above answers whether
							it ran; this answers whether it is getting worse.
						</p>
						@components.LoadTrend(components.Trend(st.Load), components.TrendWindow(st.Load))
					</div>
				}
			</section>
		}
		if len(latest) > 0 {
			<section data-workflow-runs class="mt-3">
				@components.PanelLink("Runs", fmt.Sprint(len(latest)), "/runs?workflow="+w.Slug, "see all") {
					@runsTableWith(latest, Pagination{}, runsOpts{Bare: true})
				}
			</section>
		}
	}
}

// RunDetail is the open run, beside the list (screen-runs). The header comes
// from the server already rendered; only the DAG with each step's state
// depends on JavaScript.
templ RunDetail(p RunPage) {
	{{ r := p.Run }}
	// data-crumb is the bar's last item, which ui.js writes when this pane
	// is swapped in: the bar is the layout's, and is not part of the swap.
	<div data-run-detail={ r.ID.String() } data-crumb={ runCrumb(r) }>
		// Two regions the server refreshes, and the graph between them.
		//
		// The DAG polled and everything around it did not: the drawing showed a
		// step turning green while the status pill above it still said `queued`
		// and the output below was whatever the first response had. The fix is
		// not a second poller -- it is `/runs/{id}/live`, one request that
		// returns BOTH of these already rendered, on the cadence the graph
		// already uses. See RunLive.
		<div id="run-head" data-live={ "/runs/" + r.ID.String() + "/live" }>
			@runHead(p)
		</div>
		// The indicator sits OUTSIDE the swapped region, because a region that
		// replaces its own contents would replace this too and lose whatever
		// the script had written into it.
		//
		// It exists because a page that refreshes silently is a page nobody
		// trusts: an operator who does not know it is live presses F5 anyway,
		// which is the behaviour this whole change is meant to remove.
		<p id="live-indicator" class="mb-3 -mt-3 hidden items-center gap-1.5 text-[0.7rem] text-muted">
			<span class="h-1.5 w-1.5 rounded-full bg-state-running"></span>
			<span data-live-label>{ i18n.T(ctx, "run.live.following") }</span>
		</p>
		// THE TABS (screen-runs T5, T7). Three regions in one tab set: the
		// bar and the body are the live refresh's, the graph is not. It is a
		// Steps panel of its own OUTSIDE the body, because the body is
		// redrawn when a step ends, and a React root inside it would be torn
		// out from under itself. Its scripts come with the tab (ui.js reads
		// data-island-*): the page does not pay for React to show a log.
		@templ.Raw("<style>" + hashTabsCSS("run-tabs", "logs", "steps", "params", "context") + "</style>")
		<div id="run-tabs" data-hash-tabs>
			<div id="run-tabs-bar" data-hash-tabs-bar data-js class="mb-3">
				@runTabsBar(p)
			</div>
			if p.Step == nil {
				// data-js: with no script there is no React, and the box would be
				// 380px of nothing above the steps.
				<div data-tab-panel="steps" data-run-graph data-js data-island-js={ strings.Join(dagAssets.JS, " ") } data-island-css={ strings.Join(dagAssets.CSS, " ") } class="mb-3">
					@dag("/api/runs/"+r.ID.String()+"/graph", p.Graph)
				</div>
			}
			<div id="run-body">
				@runBody(p)
			</div>
		</div>
		if p.Workflow != nil && len(p.Workflow.Params) > 0 {
			{{ w, dropped := rerunWorkflow(p) }}
			@runDrawer(w, rerunDrawerText(r, dropped))
		}
	</div>
}

// rerunAction is the run page's verb (screen-run-v2 RV2): Rerun, posting to
// the trigger the workflow page uses. With no params it is that one click;
// with params it opens the drawer, pre-filled from this run. A workflow that
// is gone has nothing to rerun, so there is no button rather than a dead one.
func rerunAction(p RunPage) templ.Component {
	if p.Workflow == nil {
		return nil
	}
	if len(p.Workflow.Params) == 0 {
		return rerunNow(p.Run)
	}
	return rerunLink(p.Run)
}

templ rerunNow(r run.Run) {
	<form method="post" action={ templ.SafeURL("/workflows/" + r.WorkflowSlug + "/trigger") } class="inline">
		<button type="submit" data-rerun title={ rerunTitle(ctx, r) } class={ components.ButtonClass(components.ButtonSecondary, components.SizeRegular) }>
			@components.Icon("refresh-cw", "h-3.5 w-3.5")
			{ i18n.T(ctx, "run.rerun") }
		</button>
	</form>
}

// A link and not a GET form: it opens the dialog on this page, and
// `data-no-prefetch` keeps the hover from fetching anything for it.
templ rerunLink(r run.Run) {
	<a href="#run" data-rerun data-dialogo="run" data-no-prefetch aria-haspopup="dialog" title={ rerunTitle(ctx, r) } class={ components.ButtonClass(components.ButtonSecondary, components.SizeRegular) }>
		@components.Icon("refresh-cw", "h-3.5 w-3.5")
		{ i18n.T(ctx, "run.rerun_more") }
	</a>
}

func rerunTitle(ctx context.Context, r run.Run) string {
	if r.LogicalDate != nil {
		return i18n.T(ctx, "run.rerun_note", "slot", components.UTCStamp(r.LogicalDate))
	}
	return i18n.T(ctx, "run.rerun_title")
}

// runCancel stops a run that can still be stopped (D3). In the head and not
// beside Rerun, because the head is what the page refreshes: the button goes
// away the moment the run ends, and "Canceling…" turns into `canceled` without
// a reload. It asks first, because stopping cannot be undone.
templ runCancel(r run.Run) {
	if r.Status.InFlight() {
		if r.CancelRequestedAt != nil {
			<span data-canceling class="ms-auto text-xs text-muted">{ i18n.T(ctx, "run.canceling") }</span>
		} else {
			<form method="post" action={ templ.SafeURL("/runs/" + r.ID.String() + "/cancel") } data-confirm={ i18n.T(ctx, "run.cancel_confirm") } class="ms-auto">
				<button type="submit" class={ components.ButtonClass(components.ButtonDanger, components.SizeSmall) }>
					@components.Icon("square", "h-3 w-3")
					{ i18n.T(ctx, "run.cancel") }
				</button>
			</form>
		}
	}
}

// RunLive is the same two regions, with no layout around them.
//
// It is HTML and not JSON on purpose: the alternative is a second rendering of
// every one of these in JavaScript, and two renderings of a step's state is two
// places for "what colour is retrying" -- the class of bug this repository has
// hit five times. The server already knows how to draw them.
templ RunLive(p RunPage) {
	{{ r := p.Run }}
	// `terminal` is what stops the polling, and it is the RUN's answer rather
	// than the step's: a failed run is a retry away from running again, and
	// stopping there would freeze the screen in the middle of one.
	<div data-live-target="run-head" data-terminal={ fmt.Sprint(r.Status.Terminal()) }>
		@runHead(p)
	</div>
	<div data-live-target="run-tabs-bar">
		@runTabsBar(p)
	</div>
	<div data-live-target="run-body">
		@runBody(p)
	</div>
}

// runHead is the open run's head (screen-runs T4), inside the live region so
// all of it moves with the run: the state, what the workflow runs in and its
// name, the verbs this state allows, how it was started, for which slot and
// how long it took -- then why it failed, and its timeline.
templ runHead(p RunPage) {
	{{ r := p.Run }}
	<div class="mb-2 flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
		<div class="min-w-0">
			<div class="mb-1 flex items-center text-sm">
				@components.State(string(r.Status))
				@components.Retry(r.Attempt)
			</div>
			<h2 class="flex min-w-0 items-center gap-2 font-mono text-[22px] leading-tight font-medium text-ink">
				for _, k := range p.Logos {
					@components.Logo(k, 28)
				}
				<span class="break-all">{ r.WorkflowSlug }</span>
			</h2>
		</div>
		<div data-run-actions class="flex shrink-0 items-center gap-3">
			<a href={ templ.SafeURL("/workflows/" + r.WorkflowSlug) } class="inline-flex items-center gap-1 text-[13px] text-muted transition-colors hover:text-ink">
				{ i18n.T(ctx, "run.view_workflow") }
				<span aria-hidden="true">&rarr;</span>
			</a>
			if r.Status.InFlight() {
				@runCancel(r)
			} else if rerunAction(p) != nil {
				@rerunAction(p)
			}
		</div>
	</div>
	<dl class="mb-3 flex flex-wrap items-center gap-x-5 gap-y-1 text-[13px]">
		<div class="flex items-baseline gap-1.5">
			<dt class="text-muted">{ i18n.T(ctx, "run.trigger") }</dt>
			<dd class="text-ink">{ triggerWord(ctx, r.TriggerType) }</dd>
		</div>
		if r.LogicalDate != nil {
			<div class="flex items-baseline gap-1.5">
				<dt class="text-muted">{ i18n.T(ctx, "run.slot") }</dt>
				<dd class="font-mono text-[12.5px] text-ink-2">{ components.UTCStamp(r.LogicalDate) }</dd>
			</div>
		}
		<div class="flex items-baseline gap-1.5">
			<dt class="text-muted">{ i18n.T(ctx, "run.duration") }</dt>
			<dd class="text-ink">{ runDuration(ctx, r) }</dd>
		</div>
		<div class="flex items-center gap-1">
			<dt class="sr-only">ID</dt>
			<dd title={ r.ID.String() } class="font-mono text-[12px] text-muted">{ r.ID.String()[:8] }</dd>
			<span id="run-id" hidden>{ r.ID.String() }</span>
			<span data-js>
				@components.CopyIcon("#run-id", i18n.T(ctx, "run.copy_id"))
			</span>
		</div>
	</dl>
	if showsWhy(p) {
		@runWhy(p.Cause, p.Streak)
	} else if r.Err != "" {
		// ONE LINE THAT OPENS (density-base DB6), where there is no cause to
		// put in its place -- a canceled run's error is who stopped it.
		<details data-run-error class="mb-3 rounded-card border border-state-failed/30 bg-state-failed/5">
			<summary class="flex h-[34px] cursor-pointer list-none items-center gap-2 px-3 text-[12.5px] [&::-webkit-details-marker]:hidden">
				@components.Icon("triangle-alert", "h-3.5 w-3.5 text-state-failed")
				@components.Retry(r.Attempt)
				<span class="min-w-0 truncate font-mono text-[12px] text-state-failed">{ firstLine(r.Err) }</span>
				<span class="ml-auto shrink-0 text-[11.5px] text-faint">{ i18n.T(ctx, "run.error.details") }</span>
			</summary>
			<pre class="overflow-auto border-t border-state-failed/20 px-3 py-2.5 font-mono text-[12px] leading-relaxed whitespace-pre-wrap text-state-failed">{ r.Err }</pre>
		</details>
	}
	@phases(PhasesOf(ctx, r, time.Now()))
	if p.Wait != nil {
		@waitLine(p.Wait)
	}
}

// runWhy is why the run failed (screen-runs T4): the step and how it exited,
// how many times in a row when it is not the first, and the lines before the
// cause, in the run's own words. No prose explains them: the words that would
// come from a model, and this page shows only what the run said.
templ runWhy(c *diagnosis.Cause, streak int) {
	<section data-why class="mb-3 rounded-card border border-state-failed/40 bg-state-failed/5 px-4 py-3">
		<div class="flex items-start gap-2.5">
			@components.Icon("triangle-alert", "mt-0.5 h-4 w-4 shrink-0 text-state-failed")
			<div class="min-w-0 flex-1">
				<div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
					<h3 class="text-[14px] font-medium text-ink">{ whyTitle(ctx, c) }</h3>
					// Only when the cause is a line of the log: one read from
					// the engine's error has no line to go to.
					if c.LineNo > 0 {
						<button type="button" data-js data-goto-error class={ components.ButtonClass(components.ButtonSecondary, components.SizeSmall) }>{ i18n.T(ctx, "run.why.goto") }</button>
					}
				</div>
				if streak >= 2 {
					<p class="mt-0.5 text-[12.5px] text-muted">{ i18n.N(ctx, "run.why.streak", streak) }</p>
				}
				<pre class="mt-2 overflow-x-auto font-mono text-[12px] leading-relaxed whitespace-pre-wrap text-state-failed">{ whyExcerpt(c) }</pre>
			</div>
		</div>
	</section>
}

// phases is the run's life as a strip: made, started, running, finished, the
// current one marked. It sits in the live head, so it moves with the run.
templ phases(ps []Phase) {
	// FOUR STEPS WITH A BAR ON TOP (screen-runs T4): the bar's colour is how
	// the phase went -- done, failed, going, not yet -- so the strip reads
	// from across the room, and the label and value sit under it.
	// Two by two until the PANE -- not the window -- has room for four: beside
	// the list, a wide window still gives the run a narrow pane.
	<ol data-phases data-timeline class="mb-3 grid grid-cols-2 overflow-hidden rounded-card border border-line bg-surface @2xl:grid-cols-4">
		for _, p := range ps {
			<li data-phase={ p.Key } data-phase-state={ p.State } class="relative min-w-0 border-b border-line-soft px-3.5 pt-3 pb-2.5 odd:border-r @2xl:border-b-0 @2xl:not-last:border-r">
				<span data-phase-bar aria-hidden="true" class={ "absolute top-0 right-0 left-0 h-[2px]", phaseBar(p.State) }></span>
				if p.State == "current" {
					<p class="text-[11.5px] font-medium text-ink">{ p.Label }</p>
				} else {
					<p class="text-[11.5px] text-muted">{ p.Label }</p>
				}
				<p title={ p.Detail } class="mt-px truncate font-mono text-[12.5px] tabular-nums text-ink-2">
					if p.Detail != "" {
						{ p.Detail }
					} else {
						<span class="text-faint">—</span>
					}
				</p>
			</li>
		}
	</ol>
}

// runTabsBar is the tabs, each with its count. Live, so "Logs 17" grows as
// steps end.
templ runTabsBar(p RunPage) {
	@components.Tabs(i18n.T(ctx, "run.tabs"), []components.Tab{
		{Key: "logs", Label: i18n.T(ctx, "run.tab.logs"), Count: fmt.Sprint(RunLogOf(p.Logs, p.Cause).Lines), Selected: true},
		{Key: "steps", Label: i18n.T(ctx, "run.tab.steps"), Count: fmt.Sprint(len(StepOutputs(p.Run, p.Logs)))},
		{Key: "params", Label: i18n.T(ctx, "run.tab.params"), Count: fmt.Sprint(len(autoItems(ctx, p.Run)) + len(p.Run.Params))},
		{Key: "context", Label: i18n.T(ctx, "run.tab.context")},
	})
}

// runBody is the run's tab panels (screen-runs T5, T7): Logs first, then its
// steps, its parameters and what each step published. Shown by the hash --
// a link can open one, and the CSS beside the tabs shows it before the first
// paint -- and stacked, each with its heading, where no script runs. Inside
// the live region, so a step that ends adds its lines without a reload.
templ runBody(p RunPage) {
	<section id="logs" data-tab-panel="logs" class="mb-3">
		<h2 data-panel-heading class="mb-3 text-[13px] font-semibold text-ink">{ i18n.T(ctx, "run.tab.logs") }</h2>
		@logsPanel(p.Run, RunLogOf(p.Logs, p.Cause))
	</section>
	<section id="steps" data-tab-panel="steps" class="mb-3">
		<h2 data-panel-heading class="mb-3 text-[13px] font-semibold text-ink">{ i18n.T(ctx, "run.tab.steps") }</h2>
		if p.Step != nil {
			@stepLine(*p.Step)
		}
		@stepsOutput(p.Run, p.Logs)
		@alertsRaised(p.Raised)
	</section>
	<section id="params" data-tab-panel="params" class="mb-3">
		<h2 data-panel-heading class="mb-3 text-[13px] font-semibold text-ink">{ i18n.T(ctx, "run.tab.params") }</h2>
		@autoParams(p.Run)
		@paramsUsed(p.Run)
	</section>
	<section id="context" data-tab-panel="context" class="mb-3">
		<h2 data-panel-heading class="mb-3 text-[13px] font-semibold text-ink">{ i18n.T(ctx, "run.tab.context") }</h2>
		@publishedContext(ContextOf(p.Run, p.Logs))
	</section>
}

// paramsUsed is what this run was given -- the values Rerun starts from.
templ paramsUsed(r run.Run) {
	<section class="mt-3">
		@components.Panel(i18n.T(ctx, "run.params.used"), "") {
			if len(r.Params) == 0 {
				<p class="px-3.5 py-3 text-[12.5px] text-muted">{ i18n.T(ctx, "run.params.none") }</p>
			} else {
				@components.KV(usedParams(r))
			}
		}
	</section>
}

// publishedContext is what each step published for the steps below it
// ($BREVIS_OUTPUT), whole and formatted -- or why there is none.
templ publishedContext(entries []ContextEntry) {
	if len(entries) == 0 {
		<p class="rounded-card border border-line bg-surface px-3.5 py-3 text-[12.5px] text-muted">{ i18n.T(ctx, "run.log.empty") }</p>
	}
	for _, e := range entries {
		<div data-context={ e.Step } class="mb-2 overflow-hidden rounded-card border border-line bg-surface">
			<div class="flex items-center justify-between gap-3 border-b border-line-soft px-3.5 py-2 text-[12.5px]">
				<span class="font-mono text-ink">{ e.Step }</span>
				if e.JSON != "" {
					<span class="text-[11.5px] text-faint">{ i18n.N(ctx, "run.context.bytes", e.Bytes) }</span>
				}
			</div>
			if e.JSON != "" {
				<pre class="max-h-[24rem] overflow-auto px-3.5 py-2.5 font-mono text-[12px] leading-relaxed text-ink">{ e.JSON }</pre>
			} else {
				<p class="px-3.5 py-2.5 text-[12.5px] text-muted">{ contextState(ctx, e.State) }</p>
			}
		</div>
	}
}

// logsPanel is the run's log as one (screen-runs T5): each attempt under its
// heading, each line numbered with the level it reads as, the line the run
// failed on marked for the head's "go to the error", and the lines a huge
// log leaves out counted, with the whole log one click away.
templ logsPanel(r run.Run, log RunLog) {
	<div data-log data-run={ r.ID.String() } class="overflow-hidden rounded-card border border-line bg-surface">
		<div data-log-tools class="flex flex-wrap items-center gap-2 border-b border-line-soft px-3 py-2">
			// The tools are the script's (screen-runs T6): with none, a search
			// box that searches nothing is worse than no box. ui.js keeps
			// what they hold through the live refresh.
			<label data-js class="relative min-w-[12rem] flex-1">
				<span class="sr-only">{ i18n.T(ctx, "run.log.search") }</span>
				@components.Icon("search", "pointer-events-none absolute top-1/2 left-2.5 h-3.5 w-3.5 -translate-y-1/2 text-faint")
				<input type="search" data-log-search placeholder={ i18n.T(ctx, "run.log.search") } autocomplete="off" class="h-8 w-full rounded-card border border-line bg-canvas pr-2 pl-8 text-[13px] text-ink placeholder:text-faint focus:border-line-strong focus:outline-none"/>
			</label>
			<div data-js role="group" aria-label={ i18n.T(ctx, "run.log.level") } class="inline-flex rounded-card border border-line p-0.5">
				for _, lv := range logLevels {
					<button type="button" data-log-level={ lv } aria-pressed={ fmt.Sprint(lv == "all") } class="rounded-[5px] px-2.5 py-1 text-[12.5px] text-muted hover:text-ink aria-pressed:bg-surface-2 aria-pressed:text-ink">{ logLevelLabel(ctx, lv) }</button>
				}
			</div>
			<span class="ml-auto"></span>
			<button type="button" data-js data-log-wrap aria-pressed="false" class="rounded-card px-2.5 py-1 text-[12.5px] text-muted hover:text-ink aria-pressed:bg-surface-2 aria-pressed:text-ink">{ i18n.T(ctx, "run.log.wrap") }</button>
			<button type="button" data-js data-log-copy class={ components.ButtonClass(components.ButtonSecondary, components.SizeSmall) }>
				@components.Icon("copy", "h-3 w-3")
				<span data-label>{ i18n.T(ctx, "run.log.copy") }</span>
			</button>
			<a href={ templ.SafeURL("/runs/" + r.ID.String() + "/log.txt") } download class={ components.ButtonClass(components.ButtonSecondary, components.SizeSmall) }>
				@components.Icon("download", "h-3 w-3")
				{ i18n.T(ctx, "run.download_log") }
			</a>
		</div>
		if len(log.Blocks) == 0 {
			<p class="px-3.5 py-3 text-[12.5px] text-muted">{ i18n.T(ctx, "run.log.empty") }</p>
		} else {
			<div data-log-lines class="max-h-[70vh] overflow-auto pb-1 font-mono text-[12px] leading-[1.65]">
				for _, b := range log.Blocks {
					<div data-log-step class="sticky top-0 border-b border-line-soft bg-surface-2 px-3 py-1 text-[11.5px] text-muted">
						{ b.Step } · { i18n.T(ctx, "run.log.attempt", "n", b.Attempt) }
						if b.Status != "" {
							· { components.StateWord(ctx, b.Status) }
						}
						if b.ExitCode != nil {
							· exit { fmt.Sprint(*b.ExitCode) }
						}
					</div>
					if b.Running {
						<div class="px-3 py-1 font-sans text-faint">{ i18n.T(ctx, "run.log.running", "step", b.Step) }</div>
					}
					for _, it := range b.Items {
						if it.Gap > 0 {
							<div data-log-gap class="px-3 py-1 font-sans text-[11.5px] text-faint italic">{ i18n.N(ctx, "run.log.gap", it.Gap) }</div>
						} else {
							<div
								data-n={ fmt.Sprint(it.N) }
								data-level={ it.Level }
								if it.Cause {
									id="log-cause"
								}
								class={ "grid grid-cols-[3.5rem_minmax(0,1fr)] gap-x-3 px-3", logLevelClass(it.Level) }
							>
								<span aria-hidden="true" class="text-right text-faint tabular-nums select-none">{ fmt.Sprint(it.N) }</span>
								<span data-text class="whitespace-pre">{ it.Text }</span>
							</div>
						}
					}
				}
			</div>
		}
	</div>
}

// stepLine is a one-step run's step (screen-run-v2 RV3): what the graph's one
// card said, on a line -- the step, its command, what it runs in, the SDK it
// announced, what it published and how long it took -- and under it each SDK
// stage with the numbers the card's pills carried. Inside the live region, so
// a running step's stages advance with the page.
templ stepLine(l StepLine) {
	<section data-step-line class="mb-3">
		@components.Panel(i18n.T(ctx, "run.tab.steps"), "1") {
			<div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1 px-3.5 py-2.5 text-[12.5px]">
				if l.Status == "" {
					// A definition, not a run: a hollow mark with no state.
					<span aria-hidden="true" class="inline-block h-2.5 w-2.5 rounded-full border border-line-strong"></span>
				} else {
					@components.Dot(l.Status)
				}
				<span class="font-mono font-medium text-ink">{ l.Name }</span>
				if l.Action != "" {
					<span title={ l.Action } class="min-w-0 max-w-[28rem] truncate font-mono text-[12px] text-muted">{ l.Action }</span>
				}
				if l.Runtime != "" {
					if l.RuntimeInferred {
						<span title={ i18n.T(ctx, "run.step.inferred") } class="rounded-[4px] border border-dashed border-line-strong px-1.5 font-mono text-[11px] text-ink-2">{ runtimeLabel(l.Runtime) }</span>
					} else {
						<span class="rounded-[4px] border border-line-strong px-1.5 font-mono text-[11px] text-ink-2">{ runtimeLabel(l.Runtime) }</span>
					}
				}
				if l.SDK != "" {
					<span class="rounded-[4px] border border-line-strong px-1.5 font-mono text-[11px] text-ink-2">SDK { l.SDK }</span>
				}
				if l.Status != "" {
				<span class="ml-auto shrink-0 text-[11.5px] text-faint">
					if l.Published > 0 {
						{ publishedText(l.Published) } ·
					}
					if l.DurationMs > 0 {
						{ durationMs(l.DurationMs) }
					} else {
						—
					}
				</span>
				}
			</div>
			if len(l.Stages) > 0 {
				<ol data-stages class="grid grid-cols-1 gap-px border-t border-line-soft bg-line-soft min-[640px]:grid-cols-2 min-[1100px]:grid-flow-col min-[1100px]:auto-cols-fr min-[1100px]:grid-cols-none">
					for _, st := range l.Stages {
						<li data-stage={ st.Label } data-stage-state={ st.State } class="min-w-0 bg-surface px-3.5 py-2">
							<div class="flex items-center gap-1.5 text-[12.5px]">
								@components.Dot(stageTone(st.State))
								<span class="font-medium text-ink">{ st.Label }</span>
								<span class="ml-auto font-mono text-[11.5px] text-faint">
									if st.Ms != nil {
										{ durationMs(*st.Ms) }
									} else {
										—
									}
								</span>
							</div>
							<div class="mt-0.5 flex min-w-0 items-baseline gap-2 text-[11.5px] text-muted">
								for i, n := range st.Numbers {
									if i > 0 {
										<span aria-hidden="true" class="text-faint">·</span>
									}
									<span class="shrink-0"><b class="font-mono font-medium text-ink-2">{ n.Value }</b> { n.Key }</span>
								}
								if st.Detail != "" {
									<span title={ st.Detail } class="min-w-0 truncate font-mono text-faint">{ st.Detail }</span>
								}
							</div>
						</li>
					}
				</ol>
			}
		}
	</section>
}

// autoParams shows what the engine worked out for this run.
//
// On the screen because a value a pipeline reads is a value somebody debugging
// that pipeline has to be able to see. "Why did this run fetch that window" is
// answered here rather than by reading the fetcher's source and reconstructing
// its arithmetic.
//
// The one worth reading first is `adjusted_at`: the clock a step reads instead
// of now(). Next to `delay` it says, at a glance, that a run was forty minutes
// late AND that it still read the right window -- which is exactly the pair
// somebody stares at after finding a gap in a table.
templ autoParams(r run.Run) {
	<section>
		@components.Panel(i18n.T(ctx, "run.params.auto"), i18n.T(ctx, "run.params.auto_hint")) {
			@components.KV(autoItems(ctx, r))
			<p class="border-t border-line-soft px-3.5 py-2 text-[12px] text-faint">{ i18n.T(ctx, "run.params.auto_note") }</p>
		}
	</section>
}

// lateness reads as a duration rather than as a count of seconds. "2220" is a
// number somebody converts; "37m" is an answer.
func lateness(seconds int) string {
	if seconds <= 0 {
		return "on time"
	}
	d := time.Duration(seconds) * time.Second
	return components.Duration(&d)
}

// alertsRaised shows what was announced about this run, and whether it arrived.
//
// It is the part that keeps the feature honest: an alert nobody can see is
// indistinguishable from an alert that was never sent. Before the outbox there
// was nothing to show -- a failed webhook was a log line in a pod that no
// longer exists.
//
// The row that matters is "undelivered". It is the case where somebody is
// waiting for a message that is not coming, and it is the only way to find out
// without reading the alert pod's logs.
templ alertsRaised(raised []alerts.Record) {
	if len(raised) > 0 {
		// LINES IN A PANEL (screen-run-v2 RV5): one 34px line per alert, its
		// error opening under it like the run's -- the words, channel, tries
		// and dates the cards carried.
		<section data-alerts class="mt-3">
			@components.Panel(i18n.T(ctx, "run.alerts"), fmt.Sprint(len(raised))) {
				for _, a := range raised {
					if a.Err != "" {
						// Shown even on a delivered alert's history? No: the
						// error is cleared on success, so anything here is
						// live. A row that succeeded on the third try must
						// not still display the second try's failure.
						<details class="group/alert border-b border-line-soft last:border-b-0">
							<summary class="flex h-[34px] cursor-pointer list-none items-center gap-3 px-3.5 text-[12.5px] hover:bg-surface-2 [&::-webkit-details-marker]:hidden">
								@alertLine(a)
								@components.Icon("chevron-right", "h-3 w-3 shrink-0 text-faint transition-transform group-open/alert:rotate-90")
							</summary>
							<pre class="mx-3.5 mb-2.5 overflow-auto rounded-card border border-state-failed/20 bg-state-failed/5 px-3 py-2 font-mono text-[12px] whitespace-pre-wrap text-state-failed">{ a.Err }</pre>
						</details>
					} else {
						<div class="flex h-[34px] items-center gap-3 border-b border-line-soft px-3.5 text-[12.5px] last:border-b-0">
							@alertLine(a)
							<span aria-hidden="true" class="w-3 shrink-0"></span>
						</div>
					}
				}
			}
		</section>
	}
}

templ alertLine(a alerts.Record) {
	@components.State(alertTone(a.State()))
	<span class="min-w-0 truncate text-ink">{ alertWording(ctx, a) }</span>
	<span class="font-mono text-[12px] text-muted">{ a.Channel }</span>
	if a.Attempts > 0 {
		<span class="text-[11.5px] text-muted">{ i18n.N(ctx, "run.alert.tries", a.Attempts) }</span>
	}
	<span class="ml-auto shrink-0 text-[11.5px] text-faint">
		if a.DeliveredAt != nil {
			@components.ShortStamp(a.DeliveredAt)
		} else {
			{ i18n.T(ctx, "run.alert.raised") }
			@components.ShortStamp(&a.CreatedAt)
		}
	</span>
}

// alertTone borrows the run states' palette rather than inventing colours for a
// second vocabulary. The words stay the alert's own.
func alertTone(state string) string {
	switch state {
	case "delivered":
		return "success"
	case "undelivered":
		return "failed"
	}
	return "running"
}

// alertWording says what happened in the reader's terms, not the table's.
//
// "sending" on its own is ambiguous in the way that matters: it is also what a
// row looks like when nothing is draining the outbox, so it says which process
// is supposed to.
func alertWording(ctx context.Context, a alerts.Record) string {
	subject := i18n.T(ctx, "run.alert.run")
	if a.Kind == alerts.KindStep && a.NodeID != "" {
		subject = i18n.T(ctx, "run.alert.step", "step", a.NodeID)
	}
	switch a.State() {
	case "delivered":
		return i18n.T(ctx, "run.alert.delivered", "subject", subject)
	case "undelivered":
		return i18n.T(ctx, "run.alert.undelivered", "subject", subject)
	}
	return i18n.T(ctx, "run.alert.waiting", "subject", subject)
}

// duracaoMs adapts the milliseconds the query returns to the existing formatter,
// which speaks in time.Duration.
func durationMs(ms int64) string {
	d := time.Duration(ms) * time.Millisecond
	return components.Duration(&d)
}

// stepsOutput shows each attempt's log.
//
// It exists because the log lived only in the pod, and the pod is deleted when
// the step ends: a pipeline that failed at 4am left "failed" on the screen and
// nothing else. Rendered on the server inside a <details>, with no JavaScript
// and no second call — the graph above is already polled second by second, and
// attaching the log to that JSON would make every poll more expensive.
//
// One entry per NODE, in the graph's order, so it reads like the flow above
// it: a mapped step is one entry with its "2/3" and an instance per item.
templ stepsOutput(r run.Run, logs []postgres.StepLog) {
	if len(logs) > 0 {
		{{ groups := StepOutputs(r, logs) }}
		// A TABLE WHOSE ROWS OPEN (screen-run-v2 RV4): one 34px row per
		// attempt, the columns a reader scans down -- state, retry, exit,
		// duration, what it published -- and the error and the log under the
		// row, opened with no script. A grid of <details> and not a table element,
		// because a row that opens is not something a <tr> can do; the roles
		// say it is a table all the same.
		<section class="mt-3">
			// The download is the Logs tab's, beside the log it downloads.
			@components.Panel(i18n.T(ctx, "run.steps.output"), i18n.N(ctx, "run.steps.count", len(groups))) {
				<div class="overflow-x-auto">
					<div data-step-table role="table" aria-label={ i18n.T(ctx, "run.steps.output") } class="min-w-[44rem] text-[12.5px]">
						<div role="row" class={ "h-[30px] border-b border-line-soft text-[11.5px] font-medium text-faint", stepGrid }>
							<span role="columnheader">{ i18n.T(ctx, "run.steps.step") }</span>
							<span role="columnheader">{ i18n.T(ctx, "run.steps.state") }</span>
							<span role="columnheader"><span class="sr-only">{ i18n.T(ctx, "run.steps.retry") }</span></span>
							<span role="columnheader">{ i18n.T(ctx, "run.steps.exit") }</span>
							<span role="columnheader" class="text-right">{ i18n.T(ctx, "run.steps.duration") }</span>
							<span role="columnheader">{ i18n.T(ctx, "run.steps.command") }</span>
						</div>
						for _, g := range groups {
							if g.Mapped {
								<details data-step-group role="rowgroup" class="group/map border-b border-line-soft last:border-b-0">
									<summary role="row" class={ "h-[34px] cursor-pointer list-none hover:bg-surface-2 [&::-webkit-details-marker]:hidden", stepGrid }>
										<span role="cell" class="flex min-w-0 items-center gap-1.5 font-mono text-ink">
											@components.Icon("chevron-right", "h-3 w-3 shrink-0 text-faint transition-transform group-open/map:rotate-90")
											<span class="truncate">{ g.Node }</span>
										</span>
										<span role="cell">
											@components.State(g.Status)
										</span>
										<span role="cell"></span>
										<span role="cell"></span>
										<span role="cell"></span>
										<span role="cell" class="font-mono text-[12px] text-muted">{ fmt.Sprint(g.Ok) }/{ fmt.Sprint(g.Total) } ok</span>
									</summary>
									<div class="bg-canvas/40">
										for _, row := range g.Rows {
											@stepRow(row)
										}
									</div>
								</details>
							} else {
								for _, row := range g.Rows {
									@stepRow(row)
								}
							}
						}
					</div>
				</div>
			}
		</section>
	}
}

// stepGrid is the step table's columns, shared by its header and its rows.
const stepGrid = "grid grid-cols-[minmax(9rem,1.3fr)_6.5rem_2.5rem_3rem_4.5rem_minmax(0,3fr)] items-center gap-x-3 px-3.5"

// stepRow is one attempt of one step, or of one instance of a mapped step,
// named by the item it ran for. A row with neither an error nor a log has
// nothing to open, and is a plain row.
templ stepRow(p StepRow) {
	// The row opens on its error alone: the log is the Logs tab's, whole and
	// numbered, and drawing it here too made a ten-megabyte log a
	// twenty-megabyte page (screen-runs T5).
	if p.Err != "" {
		<details data-step-row role="rowgroup" class="group/row border-b border-line-soft last:border-b-0">
			<summary role="row" class={ "h-[34px] cursor-pointer list-none hover:bg-surface-2 [&::-webkit-details-marker]:hidden", stepGrid }>
				@stepCells(p, true)
			</summary>
			<p class="mx-3.5 mb-2 rounded-card bg-state-failed/5 px-3 py-2 text-[12px] text-state-failed">{ p.Err }</p>
		</details>
	} else {
		<div data-step-row role="row" class={ "h-[34px] border-b border-line-soft last:border-b-0", stepGrid }>
			@stepCells(p, false)
		</div>
	}
}

templ stepCells(p StepRow, opens bool) {
	<span role="cell" class="flex min-w-0 items-center gap-1.5">
		if opens {
			@components.Icon("chevron-right", "h-3 w-3 shrink-0 text-faint transition-transform group-open/row:rotate-90")
		} else {
			<span aria-hidden="true" class="w-3 shrink-0"></span>
		}
		if p.Item != "" {
			// An instance sits under its step, a step's width in.
			<span class="truncate pl-4 font-mono text-[12px] text-ink">{ p.Item }</span>
		} else {
			<span class="truncate font-mono text-ink">{ p.NodeID }</span>
		}
	</span>
	<span role="cell">
		@components.State(p.Status)
	</span>
	<span role="cell">
		if p.Attempt > 0 {
			@components.Retry(p.Attempt)
		}
	</span>
	<span role="cell" data-col="exit" class="font-mono text-[12px] text-muted">
		if p.ExitCode != nil {
			{ fmt.Sprint(*p.ExitCode) }
		}
	</span>
	<span role="cell" class="text-right font-mono text-[12px] tabular-nums text-muted">
		if p.DurationMs > 0 {
			{ durationMs(p.DurationMs) }
		}
	</span>
	<span role="cell" title={ p.Command } class="min-w-0 truncate font-mono text-[12px] text-muted">{ p.Command }</span>
}

// dag is the island's mount point. The height is fixed on purpose: with `h-full`
// inside a scrolling container, React Flow's canvas is born at 0px and the
// grafo some.
// The height here is a STARTING one. dag.js measures the drawing and sets the
// real one, because a graph eight steps wide and one lane deep needs a third of
// what a fixed height gives it.
//
// There is deliberately no `min-height`. It would win against the computed
// value, and it did: the box stayed at 380px while the script asked for 300,
// and the drawing sat pinned to the bottom of the empty part.
// dag is the graph's island. seed is the graph itself, the same JSON the
// island would fetch from src, embedded so it draws on mount -- the fetch
// painted an empty canvas, then popped the graph in (nav-latency NL5). src
// stays for a live run's refresh, and for a seed that could not be built.
templ dag(src, seed string) {
	<div
		id="dag"
		data-src={ src }
		class="rounded-card border border-line bg-surface shadow-warm-sm"
		style="height: 380px;"
	>
		if seed != "" {
			@templ.Raw(`<script type="application/json" data-graph>` + seed + `</script>`)
		}
	</div>
}

// ---------------------------------------------------------------------------
// Formatadores locais
// ---------------------------------------------------------------------------

func pct(v float64) string { return fmt.Sprintf("%.1f%%", v) }

// contagem agrees the noun with the number. "1 workflows" is the kind of detail
// that makes a screen look generated rather than written.
func count(n int, singular, plural string) string {
	if n == 1 {
		return fmt.Sprintf("1 %s", singular)
	}
	return fmt.Sprintf("%d %s", n, plural)
}

func failureNote(n int) string {
	if n == 0 {
		return "no failure in the window"
	}
	if n == 1 {
		return "1 run failed"
	}
	return fmt.Sprintf("%d runs failed", n)
}

func meanDuration(d time.Duration) string {
	if d == 0 {
		return "no duration measured"
	}
	return "average duration " + components.Duration(&d)
}

// startOrCreated shows when the work actually started; for whatever is still in
// the queue, what matters is how long it has been waiting.
func startOrCreated(r postgres.RunSummary) *time.Time {
	if r.StartedAt != nil {
		return r.StartedAt
	}
	return &r.CreatedAt
}

var _ = strings.TrimSpace


// runAction is the page's verb. With parameters it is "Run…", a link to the
// drawer: ui.js opens it as a dialog, and with no script `#run` shows the
// form in place. With none it is the one-click ▶, since there is nothing to
// ask.
func runAction(w wf.Workflow) templ.Component {
	if len(w.Params) == 0 {
		return disparar(w.Slug)
	}
	return runLink()
}

templ runLink() {
	<a href="#run" data-dialogo="run" aria-haspopup="dialog" class={ components.ButtonClass(components.ButtonPrimary, components.SizeRegular) }>
		@components.Icon("play", "h-3.5 w-3.5")
		Run…
	</a>
}

// runDrawer asks for a run's parameters: the fields the params declare, the
// payload they make (filled by ui.js, so it is hidden with no script rather
// than wrong), and Run, posting to the same trigger the ▶ does. A native
// <dialog>: Esc closes it and the focus goes back to Run….
templ runDrawer(w wf.Workflow, t drawerText) {
	<dialog
		id="run"
		aria-labelledby="run-title"
		class="run-drawer fixed inset-y-0 right-0 left-auto m-0 h-full max-h-none w-[min(440px,100vw)] border-l border-line bg-surface p-0 text-ink backdrop:bg-ink/40"
	>
		<form
			method="post"
			action={ templ.SafeURL("/workflows/" + w.Slug + "/trigger") }
			data-run-form
			class="flex h-full flex-col"
		>
			<div class="flex items-center justify-between gap-4 border-b border-line px-5 py-4">
				<div class="min-w-0">
					<p id="run-title" class="text-[0.95rem] font-medium text-ink">{ t.Title }</p>
					<p class="truncate font-mono text-[0.75rem] text-muted">{ w.Slug }</p>
				</div>
				<button type="submit" formmethod="dialog" formnovalidate aria-label="Close" class="flex h-8 w-8 items-center justify-center rounded-card text-muted transition-colors hover:bg-surface-2 hover:text-ink">
					@components.Icon("x", "h-4 w-4")
				</button>
			</div>
			<div class="flex-1 space-y-4 overflow-y-auto px-5 py-4">
				if t.Note != "" {
					<p data-rerun-note class="rounded-card border border-line-soft bg-surface-2 px-3 py-2 text-[12px] text-muted">{ t.Note }</p>
				}
				for _, p := range w.Params {
					@paramField(p)
				}
				for _, name := range t.Dropped {
					<p class="font-mono text-[0.8rem] text-faint">{ name } <span class="font-sans text-[0.72rem]">not in the current definition, not sent</span></p>
				}
				<div data-run-preview hidden>
					<p class="mb-1.5 text-[0.75rem] text-muted">Payload</p>
					<pre class="overflow-x-auto rounded-card border border-line-soft bg-canvas px-3 py-2 font-mono text-[0.75rem] text-ink-2"><code></code></pre>
				</div>
			</div>
			<div class="flex justify-end gap-2 border-t border-line px-5 py-3">
				<button type="submit" class={ components.ButtonClass(components.ButtonPrimary, components.SizeRegular) }>
					@components.Icon("play", "h-3.5 w-3.5")
					{ t.Button }
				</button>
			</div>
		</form>
	</dialog>
}

// paramField is one parameter's field. The drawer is the trigger WITH values
// — the difference between running the workflow and reprocessing a window.
//
// The fields come from the YAML's declaration, and the `name` carries a `param.`
// prefix so it does not collide with the form's own future fields. Types become
// controls: a boolean is a select, an integer is a number, an enum is a select —
// each refusing in the browser what the server would refuse again afterwards.
//
// A title is the label, with the name beside it -- the name is what the CLI and
// the template know the param by. A warning is a hint under the field: what a
// value other than the default costs.
templ paramField(p wf.Param) {
	<label class="flex flex-col gap-1">
		if p.Title != "" {
			<span class="flex items-baseline gap-2">
				<span class="text-[0.82rem] font-medium text-ink">{ p.Title }</span>
				<span class="font-mono text-[0.72rem] text-faint">{ p.Name }</span>
			</span>
		} else {
			<span class="font-mono text-[0.8rem] text-ink">{ p.Name }</span>
		}
		if p.Description != "" {
			<span class="text-[0.72rem] text-muted">{ p.Description }</span>
		}
		if p.Type == wf.ParamBool {
			<select name={ "param." + p.Name } class="h-8 rounded-card border border-line bg-surface px-2.5 text-[0.82rem] text-ink">
				@option("false", p.Default)
				@option("true", p.Default)
			</select>
		} else if p.Type.IsList() && len(p.Enum) > 0 {
			@listaComEnum(p)
		} else if p.Type.IsList() {
			@listaLivre(p)
		} else if len(p.Enum) > 0 {
			<select name={ "param." + p.Name } class="h-8 rounded-card border border-line bg-surface px-2.5 text-[0.82rem] text-ink">
				for _, v := range p.Enum {
					@option(v, p.Default)
				}
			</select>
		} else {
			<input
				type={ fieldType(p) }
				name={ "param." + p.Name }
				value={ p.Default }
				placeholder={ p.Pattern }
				class="h-8 rounded-card border border-line bg-surface px-2.5 font-mono text-[0.82rem] text-ink placeholder:text-faint focus:border-accent-strong focus:outline-none"
			/>
		}
		if p.Warn != "" {
			<span data-param-warn class="text-[0.72rem] text-warn">{ p.Warn }</span>
		}
	</label>
}

// A list with an enum is a multi-select, and checkboxes are what a browser
// already does well: they need no JavaScript, they are reachable by keyboard,
// and the browser sends one value per box ticked -- which the handler joins
// with commas, the same shape the value has everywhere else.
//
// The hidden empty value is what makes "none of them" different from "the
// operator did not touch this": with every box unticked the key would otherwise
// be absent from the form, and the resolver would fall back to the default.
templ listaComEnum(p wf.Param) {
	<input type="hidden" name={ "param." + p.Name } value=""/>
	<div class="flex flex-wrap gap-x-3 gap-y-1 rounded-xl border border-line bg-parchment-soft px-3 py-2">
		for _, v := range p.Enum {
			<label class="flex items-center gap-1.5 text-sm text-ink">
				if marcado(v, p.Default) {
					<input type="checkbox" name={ "param." + p.Name } value={ v } checked class="accent-ink"/>
				} else {
					<input type="checkbox" name={ "param." + p.Name } value={ v } class="accent-ink"/>
				}
				<span class="font-mono text-xs">{ v }</span>
			</label>
		}
	</div>
}

// A list with no enum is free text, and the separator is the comma the value
// already uses. `data-lista` is the hook for the chips: with JavaScript the
// items become removable pills, and without it this stays a text field that
// works -- which is the rule the rest of this interface follows.
templ listaLivre(p wf.Param) {
	<input
		type="text"
		name={ "param." + p.Name }
		value={ p.Default }
		data-lista={ string(p.Type.ElementType()) }
		placeholder="one, two, three"
		class="rounded-xl border border-line bg-parchment-soft px-3 py-2 font-mono text-sm text-ink placeholder:text-muted/60"
	/>
}

templ option(value, fallback string) {
	if value == fallback {
		<option value={ value } selected>{ value }</option>
	} else {
		<option value={ value }>{ value }</option>
	}
}

// marcado answers whether this enum value is in the param's default, which for
// a list is a comma-separated set rather than a single value.
func marcado(value, deflt string) bool {
	for _, item := range strings.Split(deflt, ",") {
		if strings.TrimSpace(item) == value {
			return true
		}
	}
	return false
}

// fieldType picks the browser's control. `number` for an integer makes a
// phone's keyboard open right and blocks a letter before the server has to.
func fieldType(p wf.Param) string {
	if p.Type == wf.ParamInteger {
		return "number"
	}
	return "text"
}

// meanValue is the mean duration as a headline number. An em dash rather than
// "0s" when nothing has finished: a zero there reads as "instant", which is the
// opposite of "unknown".
func meanValue(d time.Duration) string {
	if d <= 0 {
		return "—"
	}
	return components.Duration(&d)
}

// openNote says what the "Open" number is made of. The headline adds running and
// queued together because both mean "not finished yet", and the note is what
// keeps that from hiding which of the two it is -- a queue of forty and forty
// running are the same number and very different mornings.
func openNote(i postgres.Indicators) string {
	if i.Running+i.Pending == 0 {
		return "nothing in flight"
	}
	return fmt.Sprintf("%d running, %d queued", i.Running, i.Pending)
}

// waitLine says what concurrency limit holds a queued run (#95): the group or
// the workflow's own limit, the runs in the slots, and how many of the same
// key are ahead of it. Drawn only when WaitingOn proved it -- a run waiting on
// a dispatcher slot, --max-pods or a retry's backoff gets no line at all.
templ waitLine(w *postgres.Wait) {
	<p class="mb-3 -mt-2 text-xs text-muted" data-wait>
		<span class="text-state-queued">{ i18n.T(ctx, "run.wait.for") }</span>
		if w.Group != "" {
			{ i18n.T(ctx, "run.wait.group") } <code class="font-mono text-ink">{ w.Group }</code>
		} else {
			{ i18n.T(ctx, "run.wait.own") }
		}
		({ i18n.T(ctx, "run.wait.limit", "n", w.Limit) })
		if len(w.Holders) > 0 {
			— { i18n.T(ctx, "run.wait.held_by") }
			for i, h := range firstHolders(w.Holders) {
				if i > 0 {
					,
				}
				<a href={ templ.SafeURL("/runs/" + h.RunID.String()) } class="text-ink underline decoration-line-strong underline-offset-2 hover:decoration-ink">{ h.Workflow }</a>
				<span class="font-mono">{ i18n.T(ctx, "run.wait.since", "at", components.UTCStamp(&h.Since)) }</span>
			}
			if more := len(w.Holders) - len(firstHolders(w.Holders)); more > 0 {
				{ i18n.T(ctx, "run.wait.more", "n", more) }
			}
		}
		if w.Ahead > 0 {
			<span>· { i18n.N(ctx, "run.wait.ahead", w.Ahead) }</span>
		}
	</p>
}

// firstHolders is the three a line has room for, oldest first.
func firstHolders(hs []postgres.Holder) []postgres.Holder {
	if len(hs) > 3 {
		return hs[:3]
	}
	return hs
}

