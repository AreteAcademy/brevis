package pages

import (
	"fmt"
	"net/url"
	"strings"

	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/i18n"
	"github.com/AreteAcademy/brevis/web/layouts"
)

// Endpoints is Data → Endpoints (screen-endpoints): metrics published as an
// HTTP API -- read-only SQL over warehouse tables, a tenant per key, a cache
// that follows the data -- each judged by the tables it reads.
templ Endpoints(v EndpointsView) {
	@layouts.Base(layouts.Page{Title: i18n.T(ctx, "endpoints.title"), Crumb: i18n.T(ctx, "nav.endpoints"), Active: "endpoints", Actions: publishEndpointButton()}) {
		<p class="-mt-2 mb-3 max-w-3xl text-[13.5px] text-muted">
			{ i18n.T(ctx, "endpoints.lead.before") } <strong class="font-medium text-ink">{ i18n.T(ctx, "endpoints.lead.strong") }</strong>{ i18n.T(ctx, "endpoints.lead.after") }
		</p>
		if v.Total > 0 {
			<div data-endpoints-summary class="mb-4 flex flex-wrap items-baseline gap-x-5 gap-y-1 text-[13px] text-muted">
				<span>{ i18n.N(ctx, "endpoints.summary.endpoints", v.Total) }</span>
				<span>{ i18n.N(ctx, "endpoints.summary.apis", v.APIs) }</span>
				if v.Fresh > 0 {
					<span class="inline-flex items-baseline gap-1.5">
						@components.FreshnessMark("on_time")
						{ i18n.N(ctx, "endpoints.summary.fresh", v.Fresh) }
					</span>
				}
				if v.Stale > 0 {
					<span class="inline-flex items-baseline gap-1.5">
						@components.FreshnessMark("stale")
						{ i18n.N(ctx, "endpoints.summary.stale", v.Stale) }
					</span>
				}
				for _, c := range v.Caches {
					<span class="text-faint">{ i18n.T(ctx, "endpoints.summary.cache", "type", c) }</span>
				}
				for _, c := range v.Connections {
					<span class="text-faint">{ i18n.T(ctx, "endpoints.summary.connection", "name", c) }</span>
				}
			</div>
			// THE BOX ANSWERS WHILE SOMEBODY TYPES, as the other lists'.
			<form method="get" action="/data/endpoints" role="search" data-swap="endpoints-list" data-swap-typing class="mb-3 w-full sm:w-96">
				if v.Filter.API != "" {
					<input type="hidden" name="api" value={ v.Filter.API }/>
				}
				if v.Filter.State != "" {
					<input type="hidden" name="state" value={ v.Filter.State }/>
				}
				@components.SearchInput("q", v.Filter.Q, i18n.T(ctx, "endpoints.search"), "")
			</form>
		}
		<div id="endpoints-list">
			@EndpointsList(v)
		</div>
		@endpointsHow()
		@publishEndpointDrawer()
	}
}

// publishEndpointButton is the header's verb. A link to #publicar, so with no
// script the drawer is drawn in place (`:target`); ui.js opens it modal.
templ publishEndpointButton() {
	<a href="#publicar" data-dialogo="publicar" aria-haspopup="dialog" class={ components.ButtonClass(components.ButtonPrimary, components.SizeRegular) }>
		@components.Icon("plus", "h-3.5 w-3.5")
		{ i18n.T(ctx, "endpoints.publish") }
	</a>
}

// publishEndpointDrawer says how an endpoint is published; it publishes
// nothing. An endpoint is declared in its API's file and published from
// there, so a form here would be a second source of truth the API never
// reads.
templ publishEndpointDrawer() {
	<dialog
		id="publicar"
		aria-labelledby="publicar-title"
		class="run-drawer fixed inset-y-0 right-0 left-auto m-0 h-full max-h-none w-[min(560px,100vw)] border-l border-line bg-surface p-0 text-ink backdrop:bg-ink/40"
	>
		<div class="flex h-full flex-col">
			<div class="flex items-start justify-between gap-4 border-b border-line px-5 py-4">
				<div class="min-w-0">
					<p id="publicar-title" class="text-[15px] font-semibold text-ink">{ i18n.T(ctx, "endpoints.publish") }</p>
					<p class="mt-1 text-[12.5px] text-muted">{ i18n.T(ctx, "endpoints.publish.lead") }</p>
				</div>
				<form method="dialog">
					<button type="submit" aria-label={ i18n.T(ctx, "dialog.close") } class="flex h-8 w-8 items-center justify-center rounded-card text-muted transition-colors hover:bg-surface-2 hover:text-ink">
						@components.Icon("x", "h-4 w-4")
					</button>
				</form>
			</div>
			<div class="flex-1 space-y-4 overflow-y-auto px-5 py-4 text-[12.5px]">
				@copyBlock(i18n.T(ctx, "endpoints.publish.declare"), "publicar-yaml", publishEndpointYAML)
				@copyBlock(i18n.T(ctx, "endpoints.publish.commands"), "publicar-commands", publishEndpointCommands)
				<p class="text-muted">{ i18n.T(ctx, "endpoints.publish.note") }</p>
			</div>
		</div>
	</dialog>
}

// EndpointsList is the table and its empty states: the part the search
// redraws.
templ EndpointsList(v EndpointsView) {
	{{ f := v.Filter }}
	if v.Total > 0 {
		<div class="mb-3 flex flex-wrap items-center gap-2">
			if len(v.APINames) > 1 {
				<div role="group" aria-label={ i18n.T(ctx, "endpoints.col.api") } class="inline-flex h-8 max-w-full shrink-0 items-center gap-0.5 overflow-x-auto rounded-card border border-line bg-surface p-0.5">
					@langOption(f.With("api", ""), f.API == "") {
						{ i18n.T(ctx, "endpoints.filter.api.all") }
					}
					for _, api := range v.APINames {
						@langOption(f.With("api", api), f.API == api) {
							<span class="font-mono text-[12px]">{ api }</span>
						}
					}
				</div>
			}
			<div role="group" aria-label={ i18n.T(ctx, "endpoints.col.status") } class="inline-flex h-8 max-w-full shrink-0 items-center gap-0.5 overflow-x-auto rounded-card border border-line bg-surface p-0.5">
				@langOption(f.With("state", ""), f.State == "") {
					{ i18n.T(ctx, "endpoints.filter.state.all") }
				}
				@langOption(f.With("state", "fresh"), f.State == "fresh") {
					@components.FreshnessMark("on_time")
					{ i18n.T(ctx, "endpoints.filter.state.fresh") }
				}
				@langOption(f.With("state", "stale"), f.State == "stale") {
					@components.FreshnessMark("stale")
					{ i18n.T(ctx, "endpoints.filter.state.stale") }
				}
			</div>
		</div>
	}
	if len(v.Rows) == 0 {
		<div class="rounded-card border border-dashed border-line px-6 py-12 text-center">
			if v.Total > 0 {
				<p class="text-sm text-muted">{ i18n.T(ctx, "endpoints.empty.filtered") }</p>
				<a href="/data/endpoints" class="mt-2 inline-block text-xs text-ink underline decoration-line-strong underline-offset-2 hover:decoration-ink">{ i18n.T(ctx, "workflows.clear") }</a>
			} else {
				<p class="text-sm text-muted">{ i18n.T(ctx, "endpoints.empty") }</p>
				<p class="mt-1 font-mono text-xs text-faint">brevis endpoints publish manifest.json</p>
			}
		</div>
	} else {
		<div class="overflow-hidden rounded-card border border-line bg-surface">
			<div class="overflow-x-auto">
				<table id="endpoint-rows" class="ct w-full text-[13px]">
					<thead>
						<tr class="border-b border-line text-left text-[11.5px] font-medium text-muted">
							<th class="px-2.5 py-2 pl-4 font-medium">{ i18n.T(ctx, "endpoints.col.endpoint") }</th>
							<th class="px-2.5 py-2 font-medium max-[1280px]:hidden">{ i18n.T(ctx, "endpoints.col.api") }</th>
							<th class="px-2.5 py-2 font-medium max-[960px]:hidden">{ i18n.T(ctx, "endpoints.col.reads") }</th>
							<th class="px-2.5 py-2 font-medium max-[1180px]:hidden">{ i18n.T(ctx, "endpoints.col.cache") }</th>
							<th class="px-2.5 py-2 font-medium max-[1180px]:hidden">{ i18n.T(ctx, "endpoints.col.params") }</th>
							<th class="px-2.5 py-2 font-medium">{ i18n.T(ctx, "endpoints.col.status") }</th>
							<th class="px-2.5 py-2 font-medium max-[1280px]:hidden">{ i18n.T(ctx, "endpoints.col.published") }</th>
							<th class="w-8 px-2.5 py-2 pr-4"></th>
						</tr>
					</thead>
					<tbody class="divide-y divide-line-soft">
						for _, r := range v.Rows {
							@endpointRow(v, r)
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

// endpointRow is one endpoint: what it is, the table it reads and when that
// was rebuilt, how long an answer is cached, its parameters, how its data
// stands and when it was published. The whole row opens its page; the path
// is a real link for the keyboard and no script.
templ endpointRow(v EndpointsView, r EndpointRow) {
	<tr data-href={ r.Href() } class="cursor-pointer align-top transition-colors hover:bg-hover">
		<td class="px-2.5 py-3 pl-4">
			<a href={ templ.SafeURL(r.Href()) } class="inline-flex items-center gap-2 font-mono text-[13px]">
				@components.MethodPill("GET")
				<span class="font-medium text-ink">{ r.Path }</span>
			</a>
			if r.About != "" {
				<p class="mt-1 max-w-[22rem] truncate text-[12px] text-muted" title={ r.About }>{ r.About }</p>
			}
		</td>
		<td class="px-2.5 py-3 max-[1280px]:hidden">
			<span class="rounded-card border border-line px-1.5 py-px font-mono text-[11.5px] text-ink-2">{ r.API }</span>
		</td>
		<td class="px-2.5 py-3 max-[960px]:hidden">
			if len(r.Reads) > 0 {
				{{ where, what := splitDestination(r.Reads[0]) }}
				<div class="min-w-0 max-w-[18rem]">
					<p class="flex min-w-0 items-center gap-1.5 font-mono text-[12px]" title={ r.Reads[0] }>
						@components.Logo(kindLogo(kindOf(r.Reads[0])), 16)
						<span class="truncate text-faint">{ where }</span><span class="shrink-0 text-ink">{ what }</span>
						if len(r.Reads) > 1 {
							<span class="shrink-0 font-sans text-[11.5px] text-muted" title={ strings.Join(r.Reads[1:], "\n") }>{ fmt.Sprintf("+%d", len(r.Reads)-1) }</span>
						}
					</p>
					if said := rebuiltSaid(ctx, v.Now, r.Read); said != "" {
						<p class="mt-0.5 truncate text-[11.5px] text-muted">{ said }</p>
					}
				</div>
			}
		</td>
		<td class="px-2.5 py-3 text-[12.5px] whitespace-nowrap text-ink-2 max-[1180px]:hidden">
			if r.TTL != "" {
				{ i18n.T(ctx, "endpoints.ttl", "ttl", durationWords(ctx, r.TTL)) }
			} else {
				<span class="text-faint">—</span>
			}
		</td>
		<td class="px-2.5 py-3 text-[12.5px] whitespace-nowrap text-ink-2 max-[1180px]:hidden">{ paramsSaid(ctx, r) }</td>
		<td class="px-2.5 py-3 whitespace-nowrap">
			@endpointFreshness(r.Freshness)
		</td>
		<td class="px-2.5 py-3 text-xs whitespace-nowrap text-muted max-[1280px]:hidden">{ i18n.Since(ctx, v.Now, r.PublishedAt) }</td>
		<td class="px-2.5 py-3 pr-4 text-right text-faint">
			@components.Icon("chevron-right", "h-4 w-4")
		</td>
	</tr>
}

// endpointFreshness is how an endpoint's data stands, by the tables it
// reads: fresh, stale, or not known to the catalog.
templ endpointFreshness(f string) {
	switch f {
		case "stale":
			<span class="inline-flex items-center gap-1.5 text-[12.5px] text-state-queued">
				@components.FreshnessMark("stale")
				{ i18n.T(ctx, "endpoints.state.stale") }
			</span>
		case "fresh":
			<span class="inline-flex items-center gap-1.5 text-[12.5px] text-state-success">
				@components.FreshnessMark("on_time")
				{ i18n.T(ctx, "endpoints.state.fresh") }
			</span>
		default:
			<span class="text-[12.5px] text-faint" title={ i18n.T(ctx, "endpoints.state.unknown.tip") }>{ i18n.T(ctx, "endpoints.state.unknown") }</span>
	}
}

// endpointsHow is the footer: an endpoint in three steps.
templ endpointsHow() {
	<ol data-how-it-works class="mt-4 grid grid-cols-1 overflow-hidden rounded-card border border-line bg-surface min-[860px]:grid-cols-3">
		<li class="px-4 py-3.5">
			<p class="text-[11px] font-medium tracking-[0.08em] text-muted uppercase">{ i18n.T(ctx, "endpoints.how.1") }</p>
			<p class="mt-1 text-[13px] font-semibold text-ink">{ i18n.T(ctx, "endpoints.how.declare") }</p>
			<p class="mt-1 text-[12.5px] text-muted">{ i18n.T(ctx, "endpoints.how.declare.text") }</p>
		</li>
		<li class="border-t border-line-soft px-4 py-3.5 min-[860px]:border-t-0 min-[860px]:border-l">
			<p class="text-[11px] font-medium tracking-[0.08em] text-muted uppercase">{ i18n.T(ctx, "endpoints.how.2") }</p>
			<p class="mt-1 text-[13px] font-semibold text-ink">{ i18n.T(ctx, "endpoints.how.publish") }</p>
			<p class="mt-1 text-[12.5px] text-muted"><code class="font-mono">brevis endpoints publish</code> { i18n.T(ctx, "endpoints.how.publish.text") }</p>
		</li>
		<li class="border-t border-line-soft px-4 py-3.5 min-[860px]:border-t-0 min-[860px]:border-l">
			<p class="text-[11px] font-medium tracking-[0.08em] text-muted uppercase">{ i18n.T(ctx, "endpoints.how.3") }</p>
			<p class="mt-1 text-[13px] font-semibold text-ink">{ i18n.T(ctx, "endpoints.how.serve") }</p>
			<p class="mt-1 text-[12.5px] text-muted">{ i18n.T(ctx, "endpoints.how.serve.text") }</p>
		</li>
	</ol>
}

templ Endpoint(v EndpointView) {
	@layouts.Base(layouts.Page{
		Title: v.Row.Path, Kicker: "Data", Active: "endpoints", Mono: true,
		Eyebrow: endpointEyebrow(v),
	}) {
		// THE CONTRACT IS THE PAGE, and Try it sits beside it -- after it in
		// the document, so a narrow screen reads what the endpoint takes
		// before the form that sends it.
		//
		// NO TRY IT, NO SIDE COLUMN. Where this console cannot run the
		// endpoint -- it does not ask who you are, or has no address for the
		// API -- nothing is offered, not even a card saying so: a control that
		// can only answer "not here" is a question nobody can act on.
		<div
			if v.CanRun {
				class="grid grid-cols-1 gap-3 min-[1180px]:grid-cols-[minmax(0,1fr)_380px]"
			} else {
				class="grid grid-cols-1 gap-3"
			}
		>
			<div class="flex min-w-0 flex-col gap-3">
				<div class="flex flex-col gap-3">
					if v.About != "" {
						<p class="max-w-3xl text-sm whitespace-pre-line text-ink-2">{ v.About }</p>
					}
					// WHOSE ROWS A REQUEST READS, said before anything else
					// about it: the one fact a caller cannot change.
					<div class="flex max-w-3xl items-start gap-2.5 rounded-card border border-line bg-surface px-3.5 py-3 text-[0.82rem] text-ink-2">
						if v.Row.Keyed {
							<span class="mt-0.5 text-ink">
								@components.Icon("key-round", "h-4 w-4")
							</span>
							<span>Each request reads as each key's tenant; a caller cannot send one.</span>
						} else {
							<span class="mt-0.5 text-state-running">
								@components.Icon("info", "h-4 w-4")
							</span>
							<span>The same rows for every key: its file says the data is not per tenant.</span>
						}
					</div>
				</div>
				@components.Panel("Parameters", paramsCount(v.Params)) {
					if len(v.Params) == 0 {
						<p class="px-4 py-3 text-sm text-muted">None. Every request reads the same.</p>
					} else {
						<div class="overflow-x-auto">
							<table class="ct w-full text-[0.82rem]">
								<thead>
									<tr class="border-b border-line bg-canvas-subtle text-left">
										@th("Name", "pl-4")
										@th("Type", "")
										@th("Accepts", "")
										@th("Default", "pr-4")
									</tr>
								</thead>
								<tbody class="divide-y divide-line-soft">
									for _, p := range v.Params {
										<tr class="align-top">
											<td class="px-3 py-2.5 pl-4">
												<span class="font-mono text-[0.8rem] text-ink">{ p.Name }</span>
												if p.Required {
													<span class="ml-1.5 rounded-card bg-state-queued/13 px-1.5 py-px text-[0.68rem] font-medium text-state-queued">required</span>
												}
												if p.Note != "" {
													<p class="mt-1 max-w-md text-[0.75rem] whitespace-pre-line text-muted">{ p.Note }</p>
												}
											</td>
											<td class="px-3 py-2.5 font-mono text-[0.75rem] text-muted">{ p.Type }</td>
											<td class="px-3 py-2.5 text-[0.78rem] text-ink-2">{ p.Accepts }</td>
											<td class="px-3 py-2.5 pr-4 font-mono text-[0.75rem] text-ink">
												if p.Default == "" {
													<span class="text-faint">—</span>
												} else {
													{ p.Default }
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				}
				<section>
					<h2 class="mb-2 text-[0.875rem] font-semibold text-ink">Limits</h2>
					@components.Stats([]components.Stat{
						{Label: "Timeout", Value: v.Limits.Timeout, Icon: "clock"},
						{Label: "Rows", Value: thousands(v.Limits.MaxRows), Icon: "rows-3"},
						{Label: "Bytes billed", Value: v.BytesBilled(), Icon: "hard-drive"},
					})
				</section>
				@components.Panel("Reads", fmt.Sprint(len(v.Row.Reads))) {
					<ul class="divide-y divide-line-soft">
						for _, t := range v.Row.Reads {
							<li class="flex flex-wrap items-center gap-2.5 px-4 py-2.5">
								@components.Icon("database", "h-3.5 w-3.5 text-muted")
								{{ where, what := SplitTarget(t) }}
								<a href={ templ.SafeURL(TargetHref(t)) } class="min-w-0 flex-1 font-mono text-[0.78rem] break-all hover:underline"><span class="text-faint">{ where }</span><span class="text-ink">{ what }</span></a>
								if layouts.HasSQL(ctx) {
									@components.ButtonLink(components.ButtonSecondary, components.SizeSmall, "/sql?target="+url.QueryEscape(t)) {
										Open in SQL
									}
								}
							</li>
						}
					</ul>
				}
				@components.Panel("Call it", "") {
					<div class="p-4">
						@components.CodeBlock("endpoint-curl", v.Curl(), curlAttrs(v))
					</div>
				}
			</div>
			if v.CanRun {
				<div data-side class="flex min-w-0 flex-col gap-3 min-[1180px]:sticky min-[1180px]:top-4 min-[1180px]:self-start">
					@components.Panel("Try it", "") {
						<div class="p-4">
							@tryIt(v)
						</div>
					}
				</div>
			}
		</div>
	}
}

// endpointEyebrow is what the endpoint is, above its path: the method, the
// API that serves it, when it was published.
templ endpointEyebrow(v EndpointView) {
	@components.MethodPill("GET")
	<span class="font-mono text-[0.75rem] text-ink-2">{ v.Row.API }</span>
	<span class="text-[0.72rem] text-muted">published { components.When(&v.Row.PublishedAt) }</span>
}

templ readBy(refs []EndpointRef) {
	if len(refs) > 0 {
		@components.Panel("Read by", fmt.Sprint(len(refs))) {
			<ul class="divide-y divide-line-soft">
				for _, e := range refs {
					<li class="flex flex-wrap items-center gap-1.5 px-4 py-2.5">
						@components.MethodPill("GET")
						<a href={ templ.SafeURL(e.Href) } class="font-mono text-[0.78rem] text-ink hover:underline">{ e.Path }</a>
						<span class="text-[0.72rem] text-muted">· { e.API }</span>
					</li>
				}
			</ul>
		}
	}
}

templ tryIt(v EndpointView) {
	<p class="mb-3 text-[0.75rem] text-muted">
		Runs through this console's key, as that key's tenant, for every login. An empty field is the parameter's default.
	</p>
	// A GET, so a run is a link somebody can send -- these are an endpoint's
	// parameters, not SQL. `data-swap` names the pane the answer goes into:
	// ui.js fetches the answer alone and swaps it, and with no script the
	// form draws the whole page with the answer in it.
	<form id="try-it" method="get" action={ templ.SafeURL(v.Row.Href()) } data-swap="endpoint-answer" class="flex flex-col gap-3">
		<input type="hidden" name="run" value="1"/>
		<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
			for _, f := range v.Form {
				<label class="flex min-w-0 flex-col gap-1">
					<span class="flex items-center gap-1.5 font-mono text-[0.75rem] text-ink-2">
						{ f.Name }
						if f.Required {
							<span class="rounded-card bg-state-queued/13 px-1 py-px font-sans text-[0.65rem] font-medium text-state-queued">required</span>
						}
					</span>
					if f.Kind == "select" {
						<select name={ f.Name } class={ fieldClass }>
							<option value="">default</option>
							for _, o := range f.Options {
								if o == f.Value {
									<option value={ o } selected>{ o }</option>
								} else {
									<option value={ o }>{ o }</option>
								}
							}
						</select>
					} else if f.MaxLen > 0 {
						<input type={ f.Kind } name={ f.Name } value={ f.Value } maxlength={ fmt.Sprint(f.MaxLen) } class={ fieldClass }/>
					} else {
						<input type={ f.Kind } name={ f.Name } value={ f.Value } class={ fieldClass }/>
					}
				</label>
			}
		</div>
		@components.Button(components.ButtonPrimary, components.SizeRegular, templ.Attributes{"type": "submit"}) {
			@components.Icon("play", "h-3.5 w-3.5")
			Run request
			<span class="ml-1 font-mono text-[0.7rem] opacity-60">⌘↵</span>
		}
	</form>
	// WHERE THE ANSWER GOES, and what a screen reader hears when it arrives.
	// Dimmed while a run is in flight (`aria-busy`, set by ui.js).
	<div id="endpoint-answer" aria-live="polite" class="mt-4 transition-opacity aria-busy:opacity-50">
		@EndpointAnswer(v)
	</div>
}

// EndpointAnswer is what a run brought back -- the status, the cache, the
// time and the rows -- or why there is nothing. ONE DEFINITION FOR BOTH
// SHAPES: the page draws it in its pane, and a run that asks for the answer
// alone (X-Brevis-Fragment: answer) gets exactly this.
templ EndpointAnswer(v EndpointView) {
	if v.RunErr != "" {
		<p class="rounded-card border border-line bg-canvas-subtle px-3 py-2.5 text-[0.82rem] text-ink">{ v.RunErr }</p>
	} else if a := v.Answer; a != nil {
		<div class="mb-2 flex flex-wrap items-center gap-2 text-[0.75rem] text-muted">
			if a.Status < 300 {
				<span class="rounded-card bg-state-success/13 px-1.5 py-px font-mono font-semibold text-state-success">{ fmt.Sprint(a.Status) }</span>
			} else {
				<span class="rounded-card bg-state-failed/13 px-1.5 py-px font-mono font-semibold text-state-failed">{ fmt.Sprint(a.Status) }</span>
			}
			<span class="tabular-nums">{ fmt.Sprint(a.Millis) } ms</span>
			if a.Status == 200 {
				<span class="tabular-nums">{ Total(a.Received, a.Truncated) } rows</span>
			}
			if a.Cache != "" {
				<span>cache <span class="font-mono text-ink">{ a.Cache }</span></span>
			}
		</div>
		if a.Received > len(a.Rows) {
			<p class="mb-2 text-[0.72rem] text-muted">
				Showing the first { fmt.Sprint(len(a.Rows)) } of { fmt.Sprint(a.Received) } rows; call the API for the rest.
			</p>
		}
		if a.Error != "" {
			<p class="rounded-card border border-line bg-canvas-subtle px-3 py-2.5 text-[0.82rem] text-ink">{ a.Error }</p>
		} else if len(a.Rows) == 0 {
			<p class="text-[0.82rem] text-muted">No rows.</p>
		} else {
			<div class="max-h-[28rem] overflow-auto rounded-card border border-line-soft">
				@grid(a.Columns, a.Rows)
			</div>
		}
	} else {
		<p class="text-[0.78rem] text-faint">The answer appears here.</p>
	}
}
