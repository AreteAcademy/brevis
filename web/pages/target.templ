package pages

import (
	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/layouts"
)

templ Target(v TargetView) {
	@layouts.Base(layouts.Page{Title: "Destination", Kicker: "Catalog", Active: "data"}) {
		<a href="/data" class="text-xs text-muted hover:text-gold-strong">&larr; Data</a>
		<div class="mt-2 mb-6 flex flex-wrap items-center gap-3">
			<h2 class="font-mono text-base break-all text-ink">{ v.Row.Target }</h2>
			@components.Freshness(string(v.Row.Status))
			if v.Row.Legacy {
				<span class="rounded-card border border-line px-1.5 py-px text-[0.7rem] font-medium text-muted">legacy label</span>
			} else {
				<span class="text-xs text-muted">{ v.Row.Kind }</span>
			}
		</div>
		<section class="mb-8">
			<h3 class="kicker mb-2">Writers</h3>
			<div class="overflow-x-auto rounded-card border border-line bg-surface shadow-warm-sm">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-line bg-parchment-soft/60 text-left">
							@th("Step", "pl-6")
							@th("Schedule", "")
							@th("Last loaded", "")
							@th("Status", "pr-6")
						</tr>
					</thead>
					<tbody class="divide-y divide-line-soft">
						for _, w := range v.Row.Writers {
							<tr class="align-top">
								<td class="px-3 py-3 pl-6">
									if g := w.Gateway; g != nil {
										<span class="mr-1 rounded-card border border-line px-1 py-px text-[0.65rem] text-muted">gateway</span>
										<span class="font-medium text-ink">{ g.Name }</span>
										<span class="font-mono text-xs text-muted">{ g.Stream }</span>
									} else {
										<a href={ templ.SafeURL("/workflows/" + w.Workflow) } class="font-medium text-ink hover:text-gold-strong">{ w.Workflow }</a>
										<span class="text-muted">· { w.Node }</span>
									}
									if r := w.Reason(); r != "" {
										<p class="mt-1 max-w-xl text-xs text-muted">{ r }</p>
									}
									if w.RunInFlight != nil {
										<a href={ templ.SafeURL("/runs/" + *w.RunInFlight) } class="mt-1 inline-block text-xs text-state-running hover:underline">run in progress</a>
									}
								</td>
								<td class="px-3 py-3 font-mono text-xs whitespace-nowrap text-muted">
									if w.Gateway != nil {
										<span class="font-sans">continuous</span>
									} else if w.HasSchedule {
										{ w.Cron } <span class="font-sans">{ w.Timezone }</span>
									} else {
										<span class="font-sans">by hand</span>
									}
								</td>
								<td class="px-3 py-3 text-xs whitespace-nowrap text-muted">
									if w.Gateway != nil {
										—
									} else {
										{ components.When(&w.LastLoaded) }
									}
								</td>
								<td class="px-3 py-3 pr-6">
									@components.Freshness(string(w.Verdict.Status))
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
		@configurations(v)
		<section class="mb-8">
			<h3 class="kicker mb-2">Rows per load</h3>
			<div class="rounded-card border border-line bg-surface p-4 shadow-warm-sm">
				@components.LoadBars(v.Bars, v.Missed)
				<p class="mt-2 max-w-3xl text-xs text-muted">
					Oldest on the left; each bar opens its run. A hollow bar is a load that did not say how many rows it wrote.
					if v.Missed > 0 {
						Dashed bars are scheduled loads that did not arrive.
					}
				</p>
			</div>
		</section>
		<section>
			<h3 class="kicker mb-2">Recent loads</h3>
			<div class="overflow-x-auto rounded-card border border-line bg-surface shadow-warm-sm">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-line bg-parchment-soft/60 text-left">
							@th("Loaded", "pl-6")
							@th("Step", "")
							@th("Rows", "text-right")
							@th("Bytes", "text-right")
							@th("Run", "pr-6")
						</tr>
					</thead>
					<tbody class="divide-y divide-line-soft">
						for _, l := range v.Loads {
							<tr>
								<td class="px-3 py-2 pl-6 text-xs tabular-nums whitespace-nowrap text-muted">{ components.UTCStamp(&l.LoadedAt) }</td>
								<td class="px-3 py-2 text-xs">{ l.Workflow } <span class="text-muted">· { l.Node }</span></td>
								<td class="px-3 py-2 text-right text-xs tabular-nums">{ rowsText(l.Rows) }</td>
								<td class="px-3 py-2 text-right text-xs tabular-nums">{ rowsText(l.Bytes) }</td>
								<td class="px-3 py-2 pr-6 text-xs">
									<a href={ templ.SafeURL("/runs/" + l.RunID) } class="font-mono text-gold-strong hover:underline">{ shortID(l.RunID) }</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
		@panels(v)
	}
}

// configurations is how each writer of this destination is configured: its
// settings by section, the default ones marked, and the config file's comments
// beside the setting they were written on.
//
// OPEN, NOT FOLDED. This is what somebody came to the page to read; what folds
// is a long comment, down to its first line.
templ configurations(v TargetView) {
	for _, c := range v.Configs {
		<section class="mb-8" data-config={ c.Gateway + " " + c.Stream }>
			<div class="mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
				<h3 class="kicker">Configuration</h3>
				<span class="text-xs text-muted">
					gateway <span class="font-medium text-ink">{ c.Gateway }</span>
					· <span class="font-mono">{ c.Stream }</span>
					· { c.Role } · published { c.PublishedAt.UTC().Format("Jan 2 15:04 UTC") }
				</span>
			</div>
			<div class="divide-y divide-line-soft rounded-card border border-line bg-surface shadow-warm-sm">
				<p class="px-4 py-3 text-sm text-ink sm:px-6" data-summary>{ c.Config.Summary }</p>
				if c.Config.Note != "" {
					<div class="px-4 py-3 sm:px-6">
						@configNote(c.Config.Note)
					</div>
				}
				for _, s := range c.Config.Sections {
					<div class="px-4 py-3 sm:px-6">
						<h4 class="text-xs font-semibold text-ink">{ s.Title }</h4>
						if s.Note != "" {
							<div class="mt-1">
								@configNote(s.Note)
							</div>
						}
						<div class="mt-2">
							for _, r := range s.Rows {
								for _, b := range r.Before {
									<div class="mt-3 mb-1">
										<span class="font-mono text-xs text-ink">{ b.Label }</span>
										@configNote(b.Text)
									</div>
								}
								<div class="grid grid-cols-1 gap-x-6 py-1 sm:grid-cols-[16rem_1fr]" data-path={ r.Path } data-defaulted={ boolText(r.Default) }>
									<div class="font-mono text-xs break-all text-muted">{ r.Label }</div>
									<div class="text-xs">
										if r.Value == "" {
											<span class="text-muted">empty</span>
										} else {
											<span class="font-mono break-all text-ink">{ r.Value }</span>
										}
										if r.Default {
											<span class="ml-2 rounded-card border border-line px-1 py-px text-[0.65rem] text-muted" title="Not written in the file: the value the gateway filled in">default</span>
										}
										if r.Note != "" {
											<div class="mt-1">
												@configNote(r.Note)
											</div>
										}
									</div>
								</div>
							}
						</div>
					</div>
				}
				if len(c.Config.Changes) > 0 {
					<div class="px-4 py-3 sm:px-6">
						<h4 class="text-xs font-semibold text-ink">Changes</h4>
						<ol class="mt-2 space-y-2">
							for _, ch := range c.Config.Changes {
								<li class="text-xs" data-change>
									<span class="tabular-nums text-muted">{ components.UTCStamp(&ch.At) }</span>
									if ch.First {
										<span class="ml-2 text-muted">First published</span>
									} else if len(ch.Lines) == 0 {
										<span class="ml-2 text-muted">Earlier changes are not shown</span>
									}
									if len(ch.Lines) > 0 {
										<ul class="mt-1 space-y-0.5 pl-4">
											for _, l := range ch.Lines {
												<li>
													<span class="font-mono text-muted">{ l.Path }</span>
													<span class="ml-2 font-mono break-all text-ink">{ l.Text }</span>
												</li>
											}
										</ul>
									}
								</li>
							}
						</ol>
					</div>
				}
			</div>
		</section>
	}
}

// configNote is a comment from the config file, in its author's line breaks.
// One line is shown whole; a longer one folds to its first line.
templ configNote(text string) {
	if NoteRest(text) == "" {
		<p class="text-xs whitespace-pre-wrap text-muted">{ text }</p>
	} else {
		<details class="text-xs text-muted">
			<summary class="cursor-pointer hover:text-ink">{ NoteHead(text) }</summary>
			<p class="mt-1 whitespace-pre-wrap">{ NoteRest(text) }</p>
		</details>
	}
}

// panels is the tab strip and whichever one is open.
//
// SERVER-RENDERED, like everything else here: `base.templ` states the rule --
// "the HTML already arrives complete, the script only enriches it" -- and a
// grid is exactly the thing somebody would reach for a framework to draw.
// The tab is a LINK with a query parameter, which also makes it shareable,
// the way /data's filters already are.
templ panels(v TargetView) {
	if v.Tabs {
		<section class="mt-8">
			<nav class="mb-4 flex items-center gap-1 border-b border-line-soft text-sm" aria-label="Destination tools">
				@tab(v, "preview", "Preview")
				// THE WORKBENCH, AND NOT A SECOND TAB. A preview is "show me
				// this table" -- asked about the thing already on the screen,
				// which is what a destination page is for. A query joins,
				// groups and reaches across, and pretending it belongs to one
				// table is what made both screens worse.
				//
				// It carries the destination, so nobody has to find the
				// connection again in a picker.
				<a
					href={ templ.SafeURL(v.WorkbenchHref()) }
					class="-mb-px ml-auto border-b-2 border-transparent px-3 py-2 text-muted hover:text-ink"
				>Query in SQL &rarr;</a>
			</nav>
			if v.Tab == "preview" {
				@preview(v)
			}
		</section>
	}
}

// tab is one link in the strip. `aria-current` is what says which one is open
// to somebody who is not looking at the underline.
templ tab(v TargetView, name, label string) {
	if v.Tab == name {
		<a
			href={ templ.SafeURL(v.TabHref(name)) }
			aria-current="page"
			class="-mb-px border-b-2 border-gold-strong px-3 py-2 font-medium text-ink"
		>{ label }</a>
	} else {
		<a
			href={ templ.SafeURL(v.TabHref(name)) }
			class="-mb-px border-b-2 border-transparent px-3 py-2 text-muted hover:text-ink"
		>{ label }</a>
	}
}

// preview is the destination's first rows, when a SQL service answered.
templ preview(v TargetView) {
	if v.HasPreview() {
		if v.PreviewErr != "" {
			<p class="rounded-card border border-line-soft px-4 py-3 text-sm text-muted">{ v.PreviewErr }</p>
		} else if v.Preview != nil {
			@grid(v.Preview.Columns, v.Preview.Rows)
			<p class="mt-2 text-xs text-muted">{ v.PreviewNote() }</p>
		}
	}
}

// grid draws a result set. ONE OF THEM, for both tabs: a preview and a query
// answer the same shape and drawing them twice is two places for a NULL to
// start rendering as an empty cell.
templ grid(columns []string, rows [][]any) {
	<div class="overflow-x-auto rounded-card border border-line-soft">
		<table class="w-full text-sm">
			<thead class="border-b border-line-soft text-left text-xs text-muted">
				<tr>
					for _, c := range columns {
						<th class="px-3 py-2 font-medium whitespace-nowrap">{ c }</th>
					}
				</tr>
			</thead>
			<tbody class="divide-y divide-line-soft">
				for _, row := range rows {
					<tr>
						for _, cell := range row {
							<td class="px-3 py-2 text-xs whitespace-nowrap">{ Cell(cell) }</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}
