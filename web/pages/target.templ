package pages

import (
	"fmt"
	"github.com/AreteAcademy/brevis/web/components"
)

// targetActions are the page's verbs. Copy URI is hidden until ui.js can
// drive it. Query in SQL only where there is a SQL service to ask: the
// workbench, not a second tab -- a preview is "show me this table", a query
// joins and reaches across -- and it carries the destination, so nobody has
// to find the connection again in a picker.
templ targetActions(v TargetView) {
	<span data-js>
		@components.Button(components.ButtonSecondary, components.SizeRegular, templ.Attributes{"data-copy": "#destination-uri"}) {
			@components.Icon("copy", "h-3.5 w-3.5")
			Copy URI
		}
	</span>
	if v.Tabs {
		@components.ButtonLink(components.ButtonPrimary, components.SizeRegular, v.WorkbenchHref()) {
			@components.Icon("terminal", "h-3.5 w-3.5")
			Query in SQL
		}
	}
}

// card is a titled panel of this page: a head with the title and, when it
// helps, a count; the body is the children.
templ card(title, count string) {
	<section class="overflow-hidden rounded-card border border-line bg-surface">
		<header class="flex items-center justify-between border-b border-line-soft px-4 py-3">
			<h2 class="text-[0.875rem] font-semibold text-ink">{ title }</h2>
			if count != "" {
				<span class="text-[0.75rem] text-faint tabular-nums">{ count }</span>
			}
		</header>
		{ children... }
	</section>
}

// configurations is how each writer of this destination is configured: its
// settings by section, the default ones marked, and the config file's comments
// beside the setting they were written on.
//
// OPEN, NOT FOLDED. This is what somebody came to the page to read; what folds
// is a long comment, down to its first line.
templ configurations(v TargetView) {
	for _, c := range v.Configs {
		<section class="mb-8" data-config={ c.Key() }>
			<div class="mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
				<h3 class="kicker">Configuration</h3>
				<span class="text-xs text-muted">
					if c.Gateway != "" {
						gateway <span class="font-medium text-ink">{ c.Gateway }</span>
						· <span class="font-mono">{ c.Stream }</span>
						· { c.Role } · published { c.PublishedAt.UTC().Format("Jan 2 15:04 UTC") }
					} else {
						step <a href={ templ.SafeURL("/workflows/" + c.Workflow) } class="font-medium text-ink hover:text-gold-strong">{ c.Workflow }</a>
						· { c.Node }
					}
				</span>
			</div>
			if !c.Described {
				<p class="rounded-card border border-line bg-surface px-4 py-3 text-xs text-muted shadow-warm-sm sm:px-6">
					This step did not describe itself. Only the Go SDK sends its configuration; a Python, dbt or shell step lands without one.
					To see what it runs, open <a href={ templ.SafeURL("/workflows/" + c.Workflow) } class="text-accent-strong hover:underline">the workflow's definition</a>.
				</p>
			} else {
				<div class="divide-y divide-line-soft rounded-card border border-line bg-surface shadow-warm-sm">
					<p class="px-4 py-3 text-sm text-ink sm:px-6" data-summary>{ c.Config.Summary }</p>
					if c.Flow != nil {
						@flowDiagram(c.Flow)
					}
					if dl := c.Config.DeadLetter; c.Gateway != "" && dl != nil {
						@deadLetterPanel(dl)
					}
					if c.Config.Note != "" {
						<div class="px-4 py-3 sm:px-6">
							@configNote(c.Config.Note)
						</div>
					}
					for _, s := range c.Config.Sections {
						<div class="px-4 py-3 sm:px-6">
							<h4 class="text-xs font-semibold text-ink">{ s.Title }</h4>
							if s.Note != "" {
								<div class="mt-1">
									@configNote(s.Note)
								</div>
							}
							<div class="mt-2">
								for _, r := range s.Rows {
									for _, b := range r.Before {
										<div class="mt-3 mb-1">
											<span class="font-mono text-xs text-ink">{ b.Label }</span>
											@configNote(b.Text)
										</div>
									}
									<div class="grid grid-cols-1 gap-x-6 py-1 sm:grid-cols-[16rem_1fr]" data-path={ r.Path } data-defaulted={ boolText(r.Default) }>
										<div class="font-mono text-xs break-all text-muted">{ r.Label }</div>
										<div class="text-xs">
											if r.Value == "" {
												<span class="text-muted">empty</span>
											} else {
												<span class="font-mono break-all text-ink">{ r.Value }</span>
											}
											if r.Default {
												<span class="ml-2 rounded-card border border-line px-1 py-px text-[0.65rem] text-muted" title="Not written in the file: the value the gateway filled in">default</span>
											}
											if r.Note != "" {
												<div class="mt-1">
													@configNote(r.Note)
												</div>
											}
										</div>
									</div>
								}
							</div>
						</div>
					}
					if len(c.Config.Changes) > 0 {
						<div class="px-4 py-3 sm:px-6">
							<h4 class="text-xs font-semibold text-ink">Changes</h4>
							<ol class="mt-2 space-y-2">
								for _, ch := range c.Config.Changes {
									<li class="text-xs" data-change>
										<span class="tabular-nums text-muted">{ components.UTCStamp(&ch.At) }</span>
										if ch.RunID != "" {
											<a href={ templ.SafeURL("/runs/" + ch.RunID) } class="ml-2 font-mono text-gold-strong hover:underline">run { shortID(ch.RunID) }</a>
										}
										if ch.First && c.Gateway != "" {
											<span class="ml-2 text-muted">First published</span>
										} else if ch.First {
											<span class="ml-2 text-muted">First recorded</span>
										} else if len(ch.Lines) == 0 {
											<span class="ml-2 text-muted">Earlier changes are not shown</span>
										}
										if len(ch.Lines) > 0 {
											<ul class="mt-1 space-y-0.5 pl-4">
												for _, l := range ch.Lines {
													<li>
														<span class="font-mono text-muted">{ l.Path }</span>
														<span class="ml-2 font-mono break-all text-ink">{ l.Text }</span>
													</li>
												}
											</ul>
										}
									</li>
								}
							</ol>
						</div>
					}
				</div>
			}
		</section>
	}
}

// configNote is a comment from the config file, in its author's line breaks.
// One line is shown whole; a longer one folds to its first line.
templ configNote(text string) {
	if NoteRest(text) == "" {
		<p class="text-xs whitespace-pre-wrap text-muted">{ text }</p>
	} else {
		<details class="text-xs text-muted">
			<summary class="cursor-pointer hover:text-ink">{ NoteHead(text) }</summary>
			<p class="mt-1 whitespace-pre-wrap">{ NoteRest(text) }</p>
		</details>
	}
}

// panels is the tab strip and whichever one is open.
//
// SERVER-RENDERED, like everything else here: `base.templ` states the rule --
// "the HTML already arrives complete, the script only enriches it" -- and a
// grid is exactly the thing somebody would reach for a framework to draw.
// The tab is a LINK with a query parameter, which also makes it shareable,
// the way /data's filters already are.
templ panels(v TargetView) {
	if v.Tabs {
		<section>
			<nav class="mb-4 flex items-center gap-1 border-b border-line-soft text-sm" aria-label="Destination tools">
				@tab(v, "preview", "Preview")
			</nav>
			if v.Tab == "preview" {
				@preview(v)
			}
		</section>
	}
}

// tab is one link in the strip. `aria-current` is what says which one is open
// to somebody who is not looking at the underline.
templ tab(v TargetView, name, label string) {
	if v.Tab == name {
		<a
			href={ templ.SafeURL(v.TabHref(name)) }
			aria-current="page"
			class="-mb-px border-b-2 border-gold-strong px-3 py-2 font-medium text-ink"
		>{ label }</a>
	} else {
		<a
			href={ templ.SafeURL(v.TabHref(name)) }
			class="-mb-px border-b-2 border-transparent px-3 py-2 text-muted hover:text-ink"
		>{ label }</a>
	}
}

// preview is the destination's first rows, when a SQL service answered.
templ preview(v TargetView) {
	if v.HasPreview() {
		if v.PreviewErr != "" {
			<p class="rounded-card border border-line-soft px-4 py-3 text-sm text-muted">{ v.PreviewErr }</p>
		} else if v.Preview != nil {
			@grid(v.Preview.Columns, v.Preview.Rows)
			<p class="mt-2 text-xs text-muted">{ v.PreviewNote() }</p>
		}
	}
}

// grid draws a result set. ONE OF THEM, for both tabs: a preview and a query
// answer the same shape and drawing them twice is two places for a NULL to
// start rendering as an empty cell.
templ grid(columns []string, rows [][]any) {
	<div class="overflow-x-auto rounded-card border border-line-soft">
		<table class="w-full text-sm">
			<thead class="border-b border-line-soft text-left text-xs text-muted">
				<tr>
					for _, c := range columns {
						<th class="px-3 py-2 font-medium whitespace-nowrap">{ c }</th>
					}
				</tr>
			</thead>
			<tbody class="divide-y divide-line-soft">
				for _, row := range rows {
					<tr>
						for _, cell := range row {
							<td class="px-3 py-2 text-xs whitespace-nowrap">{ Cell(cell) }</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// deadLetterPanel is where a stream's refused batches go and how to get them
// back (#86). The commands run where the destination's credentials are -- the
// gateway, a Job with its image, a laptop -- and the console runs nothing: it
// cannot read the dead letter and holds no credential for it.
templ deadLetterPanel(dl *DeadLetterView) {
	<div class="px-4 py-3 sm:px-6" data-deadletter>
		<h4 class="text-xs font-semibold text-ink">Dead letter</h4>
		<p class="mt-1 text-xs text-muted">
			Batches the destination refuses go to { dl.Where }.
		</p>
		if dl.Readable {
			<p class="mt-2 text-xs text-muted">
				To list them and send one back, run these where the gateway's credentials are — the gateway itself, a Job with its image, or a laptop with access:
			</p>
			<pre class="mt-2 overflow-auto rounded-card border border-line-soft bg-canvas px-3 py-2 font-mono text-xs text-ink">{ dl.Commands() }</pre>
			<p class="mt-2 text-xs text-muted">
				switch dl.Write {
					case "append":
						This stream appends. A resend skips rows whose BigQuery load job already landed, refuses jobs still running, and refuses rows with no job unless given --allow-duplicates — those could be written twice.
					case "merge":
						This stream merges: the dedup key makes a resent row that already landed a no-op. A resend still skips jobs that landed and refuses jobs still running.
					default:
						This destination has no merge: a resend delivers the rows again, so whoever consumes them has to be idempotent on ingestion_id, which the rows keep.
				}
			</p>
		} else {
			<p class="mt-2 text-xs text-muted">
				gateway deadletter reads back only a files dead letter (a directory, gs:// or s3://); this one is read with the destination's own tools.
			</p>
		}
	</div>
}

// flowDiagram draws a writer's Flow: the nodes left to right (top to bottom
// on a narrow screen), the destination marked, and the dead letter as a
// dashed branch under it. Server-drawn boxes, not the graph island: four
// nodes in a row need no layout engine, and the page works with no script.
templ flowDiagram(f *Flow) {
	<div data-flow class="flow-ground px-4 py-4 sm:px-6">
		<ol class="flex flex-col gap-3 min-[700px]:flex-row min-[700px]:items-stretch">
			for _, n := range f.Nodes {
				<li data-flow-node={ n.Kind } class={ "flow-step min-w-0 flex-1 rounded-card border bg-surface px-3 py-2", flowBorder(n.Kind) }>
					<p class="flex items-center gap-1.5 text-[0.68rem] font-medium tracking-[0.08em] text-muted uppercase">
						@components.Icon(flowIcon(n.Kind), "h-3.5 w-3.5")
						{ n.Title }
					</p>
					<p class="mt-1 font-mono text-[0.78rem] break-all text-ink">{ n.Main }</p>
					if n.Detail != "" {
						<p class="mt-0.5 text-[0.72rem] text-muted">{ n.Detail }</p>
					}
				</li>
			}
		</ol>
		if dl := f.DeadLetter; dl != nil {
			<div class="mt-3 flex min-[700px]:justify-end">
				<div data-flow-node={ dl.Kind } class="flow-branch w-full min-w-0 rounded-card border border-dashed border-line px-3 py-2 min-[700px]:w-[calc((100%-1.5rem)/3)]">
					<p class="flex items-center gap-1.5 text-[0.68rem] font-medium tracking-[0.08em] text-muted uppercase">
						@components.Icon(flowIcon(dl.Kind), "h-3.5 w-3.5")
						{ dl.Title }
					</p>
					<p class="mt-1 font-mono text-[0.78rem] break-all text-ink">{ dl.Main }</p>
					<p class="mt-0.5 text-[0.72rem] text-state-failed">{ dl.Detail }</p>
				</div>
			</div>
		}
	</div>
}

// recentLoads is the destination's loads, newest first, each with its run.
templ recentLoads(v TargetView) {
	@card("Recent loads", fmt.Sprint(len(v.Loads))) {
		<div class="overflow-x-auto">
			<table class="w-full text-[0.82rem]">
				<thead>
					<tr class="border-b border-line bg-canvas-subtle text-left">
						@th("Loaded", "pl-4")
						@th("Step", "")
						@th("Rows", "text-right")
						@th("Bytes", "text-right")
						@th("Run", "pr-4")
					</tr>
				</thead>
				<tbody class="divide-y divide-line-soft">
					for _, l := range v.Loads {
						<tr>
							<td class="px-3 py-2 pl-4 font-mono text-[0.75rem] whitespace-nowrap text-muted tabular-nums">{ components.UTCStamp(&l.LoadedAt) }</td>
							<td class="px-3 py-2 text-[0.78rem]"><span class="font-mono text-ink">{ l.Workflow }</span> <span class="text-muted">· { l.Node }</span></td>
							<td class="px-3 py-2 text-right text-[0.78rem] tabular-nums">{ rowsText(l.Rows) }</td>
							<td class="px-3 py-2 text-right text-[0.78rem] tabular-nums">{ rowsText(l.Bytes) }</td>
							<td class="px-3 py-2 pr-4 text-[0.78rem]">
								<a href={ templ.SafeURL("/runs/" + l.RunID) } class="font-mono text-accent-strong hover:underline">{ shortID(l.RunID) }</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
