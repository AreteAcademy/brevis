package pages

import (
	"fmt"

	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/i18n"
)

// configurations is how each writer of this destination is configured: its
// settings by section, the default ones marked, and the config file's comments
// beside the setting they were written on.
//
// OPEN, NOT FOLDED. This is what somebody came to the page to read; what folds
// is a long comment, down to its first line.
templ configurations(v TargetView) {
	for _, c := range v.Configs {
		<section class="mb-3" data-config={ c.Key() }>
			<div class="mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
				<h3 class="text-[13px] font-semibold text-ink">{ i18n.T(ctx, "config.title") }</h3>
				<span class="text-xs text-muted">
					if c.Gateway != "" {
						gateway <span class="font-medium text-ink">{ c.Gateway }</span>
						· <span class="font-mono">{ c.Stream }</span>
						· { c.Role } · { i18n.T(ctx, "config.published", "at", i18n.Date(ctx, c.PublishedAt.UTC(), "brief")+" UTC") }
					} else {
						{ i18n.T(ctx, "config.step") } <a href={ templ.SafeURL("/workflows/" + c.Workflow) } class="font-medium text-ink hover:underline">{ c.Workflow }</a>
						· { c.Node }
					}
				</span>
			</div>
			if !c.Described {
				<p class="rounded-card border border-line bg-surface px-4 py-3 text-xs text-muted shadow-warm-sm sm:px-6">
					{ i18n.T(ctx, "config.undescribed") } <a href={ templ.SafeURL("/workflows/" + c.Workflow) } class="text-ink underline decoration-line-strong underline-offset-2 hover:decoration-ink">{ i18n.T(ctx, "config.definition") }</a>.
				</p>
			} else {
				<div class="divide-y divide-line-soft rounded-card border border-line bg-surface shadow-warm-sm">
					<p class="px-4 py-3 text-sm text-ink sm:px-6" data-summary>{ c.Config.SummaryIn(ctx) }</p>
					if c.Flow != nil {
						@flowDiagram(c.Flow)
					}
					if dl := c.Config.DeadLetter; c.Gateway != "" && dl != nil {
						@deadLetterPanel(dl)
					}
					if c.Config.Note != "" {
						<div class="px-4 py-3 sm:px-6">
							@configNote(c.Config.Note)
						</div>
					}
					for _, s := range c.Config.Sections {
						<div class="px-4 py-3 sm:px-6">
							<h4 class="text-xs font-semibold text-ink">{ s.TitleIn(ctx) }</h4>
							if s.Note != "" {
								<div class="mt-1">
									@configNote(s.Note)
								</div>
							}
							<div class="mt-2">
								for _, r := range s.Rows {
									for _, b := range r.Before {
										<div class="mt-3 mb-1">
											<span class="font-mono text-xs text-ink">{ b.Label }</span>
											@configNote(b.Text)
										</div>
									}
									<div class="grid grid-cols-1 gap-x-6 py-1 sm:grid-cols-[16rem_1fr]" data-path={ r.Path } data-defaulted={ boolText(r.Default) }>
										<div class="font-mono text-xs break-all text-muted">{ r.Label }</div>
										<div class="text-xs">
											if r.Value == "" {
												<span class="text-muted">{ i18n.T(ctx, "config.empty") }</span>
											} else {
												<span class="font-mono break-all text-ink">{ r.Value }</span>
											}
											if r.Default {
												<span class="ml-2 rounded-card border border-line px-1 py-px text-[0.65rem] text-muted" title={ i18n.T(ctx, "config.default.tip") }>{ i18n.T(ctx, "config.default") }</span>
											}
											if r.Note != "" {
												<div class="mt-1">
													@configNote(r.Note)
												</div>
											}
										</div>
									</div>
								}
							</div>
						</div>
					}
					if len(c.Config.Changes) > 0 {
						<div class="px-4 py-3 sm:px-6">
							<h4 class="text-xs font-semibold text-ink">{ i18n.T(ctx, "config.changes") }</h4>
							<ol class="mt-2 space-y-2">
								for _, ch := range c.Config.Changes {
									<li class="text-xs" data-change>
										<span class="tabular-nums text-muted">{ components.UTCStamp(&ch.At) }</span>
										if ch.RunID != "" {
											<a href={ templ.SafeURL("/runs/" + ch.RunID) } class="ml-2 font-mono text-ink underline decoration-line-strong underline-offset-2 hover:decoration-ink">{ i18n.T(ctx, "config.run", "run", shortID(ch.RunID)) }</a>
										}
										if ch.First && c.Gateway != "" {
											<span class="ml-2 text-muted">{ i18n.T(ctx, "config.first_published") }</span>
										} else if ch.First {
											<span class="ml-2 text-muted">{ i18n.T(ctx, "config.first_recorded") }</span>
										} else if len(ch.Lines) == 0 {
											<span class="ml-2 text-muted">{ i18n.T(ctx, "config.earlier") }</span>
										}
										if len(ch.Lines) > 0 {
											<ul class="mt-1 space-y-0.5 pl-4">
												for _, l := range ch.Lines {
													<li>
														<span class="font-mono text-muted">{ l.Path }</span>
														<span class="ml-2 font-mono break-all text-ink">{ l.TextIn(ctx) }</span>
													</li>
												}
											</ul>
										}
									</li>
								}
							</ol>
						</div>
					}
				</div>
			}
		</section>
	}
}

// configNote is a comment from the config file, in its author's line breaks.
// One line is shown whole; a longer one folds to its first line.
templ configNote(text string) {
	if NoteRest(text) == "" {
		<p class="text-xs whitespace-pre-wrap text-muted">{ text }</p>
	} else {
		<details class="text-xs text-muted">
			<summary class="cursor-pointer hover:text-ink">{ NoteHead(text) }</summary>
			<p class="mt-1 whitespace-pre-wrap">{ NoteRest(text) }</p>
		</details>
	}
}

// grid draws a result set. ONE OF THEM, for both tabs: a preview and a query
// answer the same shape and drawing them twice is two places for a NULL to
// start rendering as an empty cell.
templ grid(columns []string, rows [][]any) {
	<div class="overflow-x-auto rounded-card border border-line-soft">
		<table class="ct w-full text-sm">
			<thead class="border-b border-line-soft text-left text-xs text-muted">
				<tr>
					for _, c := range columns {
						<th class="px-3 py-2 font-medium whitespace-nowrap">{ c }</th>
					}
				</tr>
			</thead>
			<tbody class="divide-y divide-line-soft">
				for _, row := range rows {
					<tr>
						for _, cell := range row {
							<td class="px-3 py-2 text-xs whitespace-nowrap">{ Cell(cell) }</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// deadLetterPanel is where a stream's refused batches go and how to get them
// back (#86). The commands run where the destination's credentials are -- the
// gateway, a Job with its image, a laptop -- and the console runs nothing: it
// cannot read the dead letter and holds no credential for it.
templ deadLetterPanel(dl *DeadLetterView) {
	<div class="px-4 py-3 sm:px-6" data-deadletter>
		<h4 class="text-xs font-semibold text-ink">{ i18n.T(ctx, "deadletter.commands.title") }</h4>
		<p class="mt-1 text-xs text-muted">{ i18n.T(ctx, "deadletter.goes", "where", dl.WhereIn(ctx)) }</p>
		if dl.Readable {
			<p class="mt-2 text-xs text-muted">{ i18n.T(ctx, "deadletter.commands.where") }</p>
			<pre class="mt-2 overflow-auto rounded-card border border-line-soft bg-canvas px-3 py-2 font-mono text-xs text-ink">{ dl.Commands() }</pre>
			<p class="mt-2 text-xs text-muted">
				switch dl.Write {
					case "append":
						{ i18n.T(ctx, "deadletter.resend.append") }
					case "merge":
						{ i18n.T(ctx, "deadletter.resend.merge") }
					default:
						{ i18n.T(ctx, "deadletter.resend.other") }
				}
			</p>
		} else {
			<p class="mt-2 text-xs text-muted">{ i18n.T(ctx, "deadletter.unreadable") }</p>
		}
	</div>
}

// flowDiagram draws a writer's Flow: the nodes left to right (top to bottom
// on a narrow screen), the destination marked, and the dead letter as a
// dashed branch under it. Server-drawn boxes, not the graph island: four
// nodes in a row need no layout engine, and the page works with no script.
templ flowDiagram(f *Flow) {
	<div data-flow class="flow-ground px-4 py-4 sm:px-6">
		<ol class="flex flex-col gap-3 min-[700px]:flex-row min-[700px]:items-stretch">
			for i, n := range f.Nodes {
				<li data-flow-node={ n.Kind } class={ "flow-step min-w-0 flex-1 rounded-card border bg-surface px-3 py-2", flowBorder(n.Kind) }>
					if i > 0 {
						// A batch on its way along the edge before this step;
						// still with reduced motion (app.src.css).
						<span data-flow-packet class="flow-packet" aria-hidden="true"></span>
					}
					<p class="flex items-center gap-1.5 text-[0.68rem] font-medium tracking-[0.08em] text-muted uppercase">
						@components.Icon(flowIcon(n.Kind), "h-3.5 w-3.5")
						{ fmt.Sprint(i+1) } · { flowTitle(ctx, n.Kind) }
					</p>
					<p class="mt-1 font-mono text-[0.78rem] break-all text-ink">{ n.MainIn(ctx) }</p>
					if d := n.DetailIn(ctx); d != "" {
						<p class="mt-0.5 text-[0.72rem] text-muted">{ d }</p>
					}
				</li>
			}
		</ol>
		if dl := f.DeadLetter; dl != nil {
			<div class="mt-3 flex min-[700px]:justify-end">
				<div data-flow-node={ dl.Kind } class="flow-branch w-full min-w-0 rounded-card border border-dashed border-state-failed/60 px-3 py-2 min-[700px]:w-[calc((100%-1.5rem)/3)]">
					<p class="flex items-center gap-1.5 text-[0.68rem] font-medium tracking-[0.08em] text-state-failed uppercase">
						@components.Icon("triangle-alert", "h-3.5 w-3.5")
						{ flowTitle(ctx, dl.Kind) }
					</p>
					<p class="mt-1 font-mono text-[0.78rem] break-all text-ink">{ dl.MainIn(ctx) }</p>
					<p class="mt-0.5 text-[0.72rem] text-state-failed">{ dl.DetailIn(ctx) }</p>
				</div>
			</div>
		}
	</div>
}

