package pages

import (
	"fmt"

	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/layouts"
)

// Streams is what comes in through the gateways: each stream where events are
// posted, the one destination they land on, and the dead letter its refusals
// go to -- the dead letter inside its stream, never an item of its own.
templ Streams(v StreamsView) {
	@layouts.Base(layouts.Page{Title: "Streams", Active: "streams"}) {
		<p class="mb-3 max-w-3xl text-sm text-ink-2">
			Continuous ingest through the gateways. Each stream takes events over HTTP, batches them and writes one destination; what the destination refuses goes to the stream's own dead letter.
		</p>
		if v.Total == 0 {
			@components.Empty("No stream yet.", "A stream appears when a gateway is published: brevis gateway publish gateway.yaml")
		} else {
			<div class="mb-5 flex flex-wrap items-center gap-2 text-sm">
				<span class="font-medium text-ink tabular-nums">{ plural(v.Total, "stream") }</span>
				<span class="text-muted">in</span>
				<span class="mr-1 font-medium text-ink tabular-nums">{ plural(v.Gateways, "gateway") }</span>
				@components.Freshness("continuous")
				if v.WithDeadLetter > 0 {
					<span class="text-[0.78rem] text-muted tabular-nums">{ fmt.Sprint(v.WithDeadLetter) } with a dead letter</span>
				}
			</div>
			<div data-filter-keep class="mb-4 flex flex-wrap items-center gap-2">
				<form method="get" action="/ingest/streams" role="search" class="w-full sm:w-80">
					if v.Filter.Kind != "" {
						<input type="hidden" name="kind" value={ v.Filter.Kind }/>
					}
					@components.SearchInput("q", v.Filter.Q, "Search paths, destinations or dead letters", "stream-cards")
				</form>
				if len(v.Kinds) > 1 {
					<div class="max-w-full overflow-x-auto whitespace-nowrap">
						@components.Segmented("Destination", streamKindOptions(v))
					</div>
				}
			</div>
			<div data-filter-scope>
				<div data-filter-empty class="rounded-card border border-line bg-surface px-6 py-10 text-center text-sm text-muted" hidden?={ v.Shown() > 0 }>
					Nothing matches this filter.
					<a href="/ingest/streams" class="ml-1 text-accent-strong hover:underline">Show every stream</a>
				</div>
				<div id="stream-cards" class="flex flex-col gap-8">
					for _, g := range v.Groups {
						@streamGroup(g)
					}
				</div>
			</div>
		}
	}
}

// streamGroup is one gateway: its name, how many streams, and where its
// traffic is -- the gateway's own /metrics, named and not linked, since the
// console does not know the gateway's address.
templ streamGroup(g StreamGroupView) {
	<section data-filter-group={ g.Name } hidden?={ g.Hidden }>
		<header class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1">
			<span class="flex h-7 w-7 items-center justify-center rounded-card border border-line-soft text-muted">
				@components.Icon("plug", "h-3.5 w-3.5")
			</span>
			<h2 class="font-mono text-[0.9rem] font-medium text-ink">{ g.Name }</h2>
			@components.Tag("gateway", "")
			<span class="text-[0.75rem] text-muted">{ plural(g.Count, "stream") }</span>
			<span class="ml-auto text-[0.72rem] text-muted">
				traffic: <code class="font-mono text-ink-2">brevis_gateway_*</code> on the gateway's /metrics
			</span>
		</header>
		<div class="flex flex-col gap-3">
			for _, c := range g.Cards {
				@streamCard(c)
			}
		</div>
	</section>
}

// streamCard is one stream: what it is, then its compact flow.
templ streamCard(c StreamCard) {
	<article
		data-stream-card={ c.Key() }
		data-filter-row
		data-filter-text={ c.SearchText() }
		hidden?={ c.Hidden }
		class="overflow-hidden rounded-card border border-line bg-surface"
	>
		<header class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5 border-b border-line-soft px-4 py-3">
			@components.Freshness("continuous")
			<a href={ templ.SafeURL(c.Href()) } class="font-mono text-[0.85rem] hover:underline">
				<span class="text-state-success">POST</span>
				<span class="text-ink">{ c.Path }</span>
			</a>
			if f := c.Field("format"); f != "" {
				@components.Tag(f, "")
			}
			if h := c.Field("hook"); h != "" {
				<span class="rounded-card border border-line px-1.5 py-px font-mono text-[0.7rem] text-muted">hook { h }</span>
			}
			<span class="ml-auto flex items-center gap-3">
				if !c.PublishedAt.IsZero() {
					<span class="text-[0.72rem] text-muted">published { components.UTCStamp(&c.PublishedAt) }</span>
				}
				@components.ButtonLink(components.ButtonSecondary, components.SizeSmall, c.Href()+"#config") {
					Configuration
				}
			</span>
		</header>
		@flowDiagram(streamFlow(c.Stream))
	</article>
}
