package pages

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/i18n"
)

// loadConfiguration is a step's configuration on its load's page, in tabs
// (screen-load-v2 LV3): Summary, Sources, Transform, Destination, Schema --
// only those with something in them. Hash tabs, as on a stream's page: every
// panel is in the HTML, `#sources` is the open one from the first paint, and
// with no script the panels stack under their headings.
templ loadConfiguration(v LoadView) {
	if c, ok := v.StepConfig(); ok {
		if !c.Described {
			@components.Panel(i18n.T(ctx, "config.title"), "") {
				<p data-config={ c.Key() } class="px-3.5 py-3 text-[12.5px] text-muted">
					{ i18n.T(ctx, "config.undescribed") } <a href={ templ.SafeURL("/workflows/" + c.Workflow) } class="text-ink underline decoration-line-strong underline-offset-2 hover:decoration-ink">{ i18n.T(ctx, "config.definition") }</a>.
				</p>
			}
		} else {
			{{ t := LoadConfigTabs(c.Config) }}
			{{ tabs := loadTabs(ctx, t) }}
			@templ.Raw("<style>" + hashTabsCSS("load-config", tabKeys(tabs)...) + "</style>")
			@components.Panel(i18n.T(ctx, "config.title"), "") {
				<div id="load-config" data-hash-tabs data-config={ c.Key() }>
					<div data-hash-tabs-bar data-js class="px-2 pt-1">
						@components.Tabs(i18n.T(ctx, "config.title"), tabs)
					</div>
					<section id="summary" data-tab-panel="summary">
						<h3 data-panel-heading class="px-3.5 pt-3 text-[12.5px] font-semibold text-ink">{ i18n.T(ctx, "config.tab.summary") }</h3>
						<p class="px-3.5 py-3 text-[12.5px] text-ink" data-summary>{ c.Config.SummaryIn(ctx) }</p>
						@stageRow(t)
						if c.Flow != nil {
							<div class="border-t border-line-soft">
								@flowDiagram(c.Flow)
							</div>
						}
						if c.Config.Note != "" {
							<div class="border-t border-line-soft px-3.5 py-2.5">
								@configNote(c.Config.Note)
							</div>
						}
						for _, s := range t.Other {
							<div class="border-t border-line-soft">
								<h4 class="px-3.5 pt-2.5 text-[12px] font-semibold text-ink">{ s.TitleIn(ctx) }</h4>
								@cfgRows(s.Rows)
							</div>
						}
					</section>
					if hasTab(tabs, "sources") {
						<section id="sources" data-tab-panel="sources">
							<h3 data-panel-heading class="px-3.5 pt-3 text-[12.5px] font-semibold text-ink">{ i18n.T(ctx, "config.tab.sources") }</h3>
							@cfgRows(t.SourceHead)
							if t.SourceCount > 0 {
								<div data-common class="flex flex-wrap items-center gap-1.5 border-t border-line-soft px-3.5 py-2.5 text-[12px]">
									<span class="font-medium text-ink">{ i18n.T(ctx, "config.common", "n", fmt.Sprint(t.SourceCount)) }</span>
									if len(t.Common) == 0 {
										<span class="text-faint">{ i18n.T(ctx, "config.common.none") }</span>
									}
									for _, r := range t.Common {
										<span data-path={ "sources.*." + r.Label } title={ r.Note } class="rounded-[4px] border border-line-strong px-1.5 font-mono text-[11.5px] text-ink-2">
											<span class="text-faint">{ r.Label }</span> { r.Value }
											if r.Default {
												<span class="text-faint">({ i18n.T(ctx, "config.default") })</span>
											}
										</span>
									}
								</div>
								if len(t.Varying) > 0 {
									<div class="overflow-x-auto border-t border-line-soft">
										<table class="ct w-full text-[12.5px]">
											<thead>
												<tr class="text-left">
													@th("#", "pl-3.5 w-10")
													for _, k := range t.Varying {
														@th(k, "")
													}
												</tr>
											</thead>
											<tbody class="divide-y divide-line-soft">
												for _, s := range t.Sources {
													<tr>
														<td class="px-3 pl-3.5 font-mono text-faint tabular-nums">{ fmt.Sprint(s.Index) }</td>
														for _, cell := range s.Cells {
															if cell == nil {
																<td class="px-3 text-faint">—</td>
															} else {
																<td data-path={ cell.Path } title={ cellTitle(*cell) } class="max-w-[28rem] truncate px-3 font-mono text-[12px] text-ink">
																	{ cell.Value }
																	if cell.Default {
																		<span class="text-faint">({ i18n.T(ctx, "config.default") })</span>
																	}
																</td>
															}
														}
													</tr>
												}
											</tbody>
										</table>
									</div>
								}
							}
						</section>
					}
					if hasTab(tabs, "transform") {
						<section id="transform" data-tab-panel="transform">
							<h3 data-panel-heading class="px-3.5 pt-3 text-[12.5px] font-semibold text-ink">{ i18n.T(ctx, "config.tab.transform") }</h3>
							<ol class="divide-y divide-line-soft">
								for _, op := range t.Transform {
									<li class="flex gap-3 px-3.5 py-2 text-[12.5px]">
										<span class="w-5 shrink-0 font-mono text-faint tabular-nums">{ op.Index }</span>
										<div class="min-w-0 flex-1">
											for _, r := range op.Rows {
												<div data-path={ r.Path } class="flex flex-wrap items-baseline gap-x-2">
													<span class="font-mono text-[12px] text-muted">{ strings.TrimPrefix(r.Label, op.Index+".") }</span>
													if len(r.List) > 0 {
														<span class="font-mono text-[12px] text-ink">{ strings.Join(r.List, " · ") }</span>
													} else {
														<span class="font-mono text-[12px] text-ink">{ r.Value }</span>
													}
													if r.Note != "" {
														@configNote(r.Note)
													}
												</div>
											}
										</div>
									</li>
								}
							</ol>
						</section>
					}
					<section id="destination" data-tab-panel="destination">
						<h3 data-panel-heading class="px-3.5 pt-3 text-[12.5px] font-semibold text-ink">{ i18n.T(ctx, "config.tab.destination") }</h3>
						<div class="px-3.5 py-3">
							@components.DefinitionList(destinationIdentity(ctx, v.TargetView))
						</div>
						@cfgRows(t.Destination)
					</section>
					if hasTab(tabs, "schema") {
						<section id="schema" data-tab-panel="schema">
							<h3 data-panel-heading class="px-3.5 pt-3 text-[12.5px] font-semibold text-ink">{ i18n.T(ctx, "config.tab.schema") }</h3>
							if len(t.Schema) > 0 {
								<div class="overflow-x-auto">
									<table class="ct w-full text-[12.5px]">
										<thead>
											<tr class="text-left">
												@th(i18n.T(ctx, "config.schema.column"), "pl-3.5")
												@th(i18n.T(ctx, "config.schema.type"), "")
												@th(i18n.T(ctx, "config.schema.role"), "pr-3.5")
											</tr>
										</thead>
										<tbody class="divide-y divide-line-soft">
											for _, col := range t.Schema {
												<tr>
													<td class="px-3 pl-3.5 font-mono text-ink">{ col.Name }</td>
													<td class="px-3 font-mono text-[12px] text-muted">{ col.Type }</td>
													<td class="px-3 pr-3.5 text-muted">{ schemaRole(ctx, col.Role) }</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							}
							@cfgRows(schemaExtra(t.SchemaRows))
						</section>
					}
				</div>
			}
		}
	}
}

// stageRow is the configuration's path in one line: where it reads, how it
// changes the rows, where it writes.
templ stageRow(t LoadTabs) {
	<ol data-stage-row class="grid grid-cols-1 gap-px border-t border-line-soft bg-line-soft min-[760px]:grid-cols-3">
		<li class="min-w-0 bg-surface px-3.5 py-2 text-[12px]">
			<p class="font-medium text-ink">{ i18n.T(ctx, "config.stage.source") } <span class="font-mono font-normal text-muted">{ rowValue(t.SourceHead, "driver") }</span></p>
			<p class="mt-0.5 text-muted">
				if t.SourceCount > 0 {
					{ i18n.N(ctx, "config.stage.sources", t.SourceCount) }
					if w, err := strconv.Atoi(rowValue(t.SourceHead, "workers")); err == nil {
						· { i18n.N(ctx, "config.stage.workers", w) }
					}
				} else {
					{ i18n.T(ctx, "config.stage.one_source") }
				}
			</p>
		</li>
		<li class="min-w-0 bg-surface px-3.5 py-2 text-[12px]">
			<p class="font-medium text-ink">{ i18n.T(ctx, "config.stage.transform") } <span class="font-mono font-normal text-muted">{ i18n.N(ctx, "config.stage.stages", len(t.Transform)) }</span></p>
			<p title={ transformNames(t) } class="mt-0.5 truncate text-muted">
				if len(t.Transform) == 0 {
					{ i18n.T(ctx, "config.stage.as_read") }
				} else {
					{ transformNames(t) }
				}
			</p>
		</li>
		<li class="min-w-0 bg-surface px-3.5 py-2 text-[12px]">
			<p class="font-medium text-ink">{ i18n.T(ctx, "config.stage.target") } <span class="font-mono font-normal text-muted">{ rowValue(t.Destination, "driver") }</span></p>
			<p class="mt-0.5 text-muted">
				if d := rowValue(t.Destination, "dedup"); d != "" {
					dedup { d }
				} else {
					{ i18n.T(ctx, "config.stage.appends") }
				}
			</p>
		</li>
	</ol>
}

// cfgRows is a list of settings, each its label, value, default flag and
// note, with any block comment it begins.
templ cfgRows(rows []ConfigRow) {
	if len(rows) > 0 {
		<div class="px-3.5 py-2">
			for _, r := range rows {
				for _, b := range r.Before {
					<div class="mt-2 mb-1">
						<span class="font-mono text-[12px] text-ink">{ b.Label }</span>
						@configNote(b.Text)
					</div>
				}
				<div class="grid grid-cols-1 gap-x-4 py-1 sm:grid-cols-[14rem_1fr]" data-path={ r.Path } data-defaulted={ boolText(r.Default) }>
					<div class="font-mono text-[12px] break-all text-muted">{ r.Label }</div>
					<div class="text-[12px]">
						if r.Value == "" {
							<span class="text-muted">{ i18n.T(ctx, "config.empty") }</span>
						} else {
							<span class="font-mono break-all text-ink">{ r.Value }</span>
						}
						if r.Default {
							<span class="ml-2 rounded-card border border-line px-1 py-px text-[0.65rem] text-muted" title={ i18n.T(ctx, "config.default.tip") }>{ i18n.T(ctx, "config.default") }</span>
						}
						if r.Note != "" {
							<div class="mt-1">
								@configNote(r.Note)
							</div>
						}
					</div>
				</div>
			}
		</div>
	}
}

// loadChanges is the configuration's history, beside the page.
templ loadChanges(v LoadView) {
	if c, ok := v.StepConfig(); ok && c.Described && len(c.Config.Changes) > 0 {
		@components.Panel(i18n.T(ctx, "config.changes.title"), fmt.Sprint(len(c.Config.Changes))) {
			<ol class="divide-y divide-line-soft">
				for _, ch := range c.Config.Changes {
					<li class="px-3.5 py-2 text-[12px]" data-change>
						<span class="font-mono text-muted tabular-nums">
							@components.ShortStamp(&ch.At)
						</span>
						if ch.RunID != "" {
							<a href={ templ.SafeURL("/runs/" + ch.RunID) } class="ml-2 font-mono text-ink underline decoration-line-strong underline-offset-2 hover:decoration-ink">{ shortID(ch.RunID) }</a>
						}
						if ch.First {
							<span class="ml-2 text-muted">{ i18n.T(ctx, "config.first_recorded") }</span>
						} else if len(ch.Lines) == 0 {
							<span class="ml-2 text-muted">{ i18n.T(ctx, "config.earlier") }</span>
						}
						if len(ch.Lines) > 0 {
							<ul class="mt-1 space-y-0.5">
								for _, l := range ch.Lines {
									<li>
										<span class="font-mono text-muted">{ l.Path }</span>
										<span class="ml-2 font-mono break-all text-ink">{ l.TextIn(ctx) }</span>
									</li>
								}
							</ul>
						}
					</li>
				}
			</ol>
		}
	}
}

// loadRecent is the step's recent loads in its drawer (screen-load-v2 LV5,
// screen-loads T4): when, rows, bytes and the run, each a 34px row. No step
// column -- it is always this drawer's step, already in the head.
templ loadRecent(v LoadView) {
	@components.Panel(i18n.T(ctx, "loads.drawer.recent"), loadsCount(ctx, len(v.Loads))) {
		<div class="max-h-[28rem] overflow-auto">
			<table class="ct w-full text-[12.5px]">
				<thead class="sticky top-0 bg-surface">
					<tr class="text-left">
						@th(i18n.T(ctx, "loads.drawer.recent.at"), "pl-3.5")
						@th(i18n.T(ctx, "loads.col.rows"), "text-right")
						@th(i18n.T(ctx, "loads.drawer.recent.bytes"), "text-right")
						@th(i18n.T(ctx, "loads.drawer.recent.run"), "pr-3.5")
					</tr>
				</thead>
				<tbody class="divide-y divide-line-soft">
					for _, l := range v.Loads {
						<tr>
							<td class="px-2.5 pl-3.5 font-mono text-[12px] whitespace-nowrap text-muted tabular-nums">
								@components.ShortStamp(&l.LoadedAt)
							</td>
							<td class="px-2.5 text-right tabular-nums">{ rowsText(l.Rows) }</td>
							<td class="px-2.5 text-right tabular-nums">{ rowsText(l.Bytes) }</td>
							<td class="px-2.5 pr-3.5">
								<a href={ templ.SafeURL("/runs/" + l.RunID) } class="font-mono text-[12px] text-ink underline decoration-line-strong underline-offset-2 hover:decoration-ink">{ shortID(l.RunID) }</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
