package pages

import (
	"fmt"
	"net/url"

	"github.com/AreteAcademy/brevis/internal/domain/catalog"
	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/layouts"
)

templ Data(v DataView) {
	@layouts.Base(layouts.Page{Title: "Data", Kicker: "Catalog", Active: "data"}) {
		<p class="mb-4 max-w-3xl text-sm text-muted">
			Destinations written by Brevis: SDK pipelines, any step that prints a
			<code class="font-mono text-xs">landed</code> line, and published gateways. Writes from outside Brevis do not appear here.
		</p>
		if v.Total == 0 {
			@components.Empty("No destination yet.",
				"One appears after an SDK pipeline's first load, or a step that prints a landed line. See docs/LANDINGS.md.")
		} else {
			<div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
				<span class="mr-1 font-medium text-ink">{ plural(v.Total, "destination") }</span>
				for _, s := range statusOrder {
					if v.Counts[s] > 0 {
						<span class="inline-flex items-center gap-1.5">
							<span class="tabular-nums text-ink">{ fmt.Sprint(v.Counts[s]) }</span>
							@components.Freshness(string(s))
						</span>
					}
				}
			</div>
			@dataFilters(v)
			if len(v.Rows) == 0 {
				<div class="rounded-card border border-dashed border-line px-6 py-10 text-center text-sm text-muted">
					Nothing matches this filter.
					<a href="/data" class="ml-1 text-gold-strong hover:underline">Show every destination</a>
				</div>
			} else {
				<div class="overflow-x-auto rounded-card border border-line bg-surface shadow-warm-sm">
					<table class="w-full text-sm">
						<thead>
							<tr class="border-b border-line bg-parchment-soft/60 text-left">
								@th("Status", "pl-6")
								@th("Destination", "")
								@th("Writers", "")
								@th("Last loaded", "")
								@th("Rows, last load", "text-right")
								@th("Last loads", "pr-6")
							</tr>
						</thead>
						<tbody class="divide-y divide-line-soft">
							for _, r := range v.Rows {
								@dataRow(r)
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}

templ dataFilters(v DataView) {
	{{ f := v.Filter }}
	<div class="mb-4 flex flex-wrap items-center gap-2">
		@chip(f.With("status", ""), "All", f.Status == "", "")
		if v.Counts[catalog.Late]+v.Counts[catalog.Stale] > 0 {
			@chip(f.With("status", "attention"), "Needs attention", f.Status == "attention", "bg-state-failed")
		}
		for _, s := range statusOrder {
			if v.Counts[s] > 0 {
				@chip(f.With("status", string(s)), components.FreshnessLabel(string(s)), f.Status == string(s), "")
			}
		}
		if len(v.Kinds) > 1 {
			<span class="mx-1 h-4 w-px bg-line"></span>
			@chip(f.With("kind", ""), "Every kind", f.Kind == "", "")
			for _, k := range v.Kinds {
				@chip(f.With("kind", k), k, f.Kind == k, "")
			}
		}
		if v.HasLegacy {
			<span class="mx-1 h-4 w-px bg-line"></span>
			if f.Legacy {
				@chip(f.With("legacy", ""), "Legacy only", true, "")
			} else {
				@chip(f.With("legacy", "1"), "Legacy only", false, "")
			}
		}
		if f.Active() {
			<span class="ml-auto text-xs text-muted">{ fmt.Sprintf("showing %d of %d", len(v.Rows), v.Total) }</span>
		}
	</div>
}

templ dataRow(r DataRow) {
	<tr class="align-top transition-colors hover:bg-gold-wash">
		<td class="px-3 py-3 pl-6">
			@components.Freshness(string(r.Status))
		</td>
		<td class="px-3 py-3">
			if r.Target == "" {
				<span class="text-[0.8rem] text-muted italic">unnamed destination</span>
			} else {
				<a href={ templ.SafeURL("/data/target?u=" + url.QueryEscape(r.Target)) } class="font-mono text-[0.8rem] break-all text-ink hover:text-gold-strong">{ r.Target }</a>
			}
			<span class="mt-1 block text-[0.7rem] text-muted">
				if r.Target == "" && len(r.Writers) > 0 && r.Writers[0].Gateway != nil {
					{ r.Writers[0].Gateway.Kind } · { r.Writers[0].Gateway.Note }
				} else if r.Legacy {
					<span
						class="rounded-card border border-line px-1.5 py-px font-medium"
						title="A label recovered from before steps named their target; it is never turned into one."
					>legacy</span>
					label
				} else {
					{ r.Kind }
				}
			</span>
		</td>
		<td class="px-3 py-3">
			for _, w := range r.Writers {
				<div class="whitespace-nowrap">
					if g := w.Gateway; g != nil {
						<span class="mr-1 rounded-card border border-line px-1 py-px text-[0.65rem] text-muted">gateway</span>
						<span class="font-medium text-ink">{ g.Name }</span>
						<span class="font-mono text-xs text-muted">{ g.Stream }</span>
						<span class="text-[0.7rem] text-muted">({ g.Role })</span>
					} else {
						<a href={ templ.SafeURL("/workflows/" + w.Workflow) } class="font-medium text-ink hover:text-gold-strong">{ w.Workflow }</a>
						<span class="text-muted">· { w.Node }</span>
					}
					if len(r.Writers) > 1 || w.Verdict.Status != r.Status {
						<span class="ml-1 text-[0.7rem] text-muted">({ components.FreshnessLabel(string(w.Verdict.Status)) })</span>
					}
					if w.RunInFlight != nil && (w.Verdict.Status == catalog.Late || w.Verdict.Status == catalog.Stale) {
						<a href={ templ.SafeURL("/runs/" + *w.RunInFlight) } class="ml-1 text-[0.7rem] text-state-running hover:underline">run in progress</a>
					}
				</div>
			}
		</td>
		<td class="px-3 py-3 text-xs whitespace-nowrap text-muted">{ components.When(r.LastWhen) }</td>
		<td class="px-3 py-3 text-right text-xs tabular-nums text-ink">{ rowsText(r.LastRows) }</td>
		<td class="px-3 py-3 pr-6">
			if len(r.Recent) == 0 && r.LastWhen == nil {
				<span class="text-xs text-muted">the gateway's /metrics</span>
			} else {
				@components.Spark(r.Recent)
			}
		</td>
	</tr>
}
