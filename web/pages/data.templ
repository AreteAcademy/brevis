package pages

import (
	"fmt"
	"net/url"

	"github.com/AreteAcademy/brevis/internal/domain/catalog"
	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/layouts"
)

templ Data(v DataView) {
	@layouts.Base(layouts.Page{Title: "Catalog", Kicker: "Catalog", Active: "data"}) {
		<p class="mb-3 max-w-3xl text-sm text-ink-2">
			Destinations written by Brevis: SDK pipelines, any step that prints a
			<code class="font-mono text-xs">landed</code> line, and published gateways. Writes from outside Brevis do not appear here.
		</p>
		if v.Total == 0 {
			@components.Empty("No destination yet.",
				"One appears after an SDK pipeline's first load, or a step that prints a landed line. See docs/LANDINGS.md.")
		} else {
			// THE FLEET AT A GLANCE, whatever the filter shows: how many, and
			// how many stand where.
			<div class="mb-5 flex flex-wrap items-center gap-2 text-sm">
				<span class="mr-1 font-medium text-ink tabular-nums">{ plural(v.Total, "destination") }</span>
				for _, s := range statusOrder {
					if v.Counts[s] > 0 {
						<span class="inline-flex items-center gap-1.5">
							<span class="text-ink-2 tabular-nums">{ fmt.Sprint(v.Counts[s]) }</span>
							@components.Freshness(string(s))
						</span>
					}
				}
			</div>
			@dataFilters(v)
			<div data-filter-scope class="overflow-hidden rounded-card border border-line bg-surface">
				// ALWAYS DRAWN, hidden while a row shows: the list filter
				// reveals it when typing hides the last one.
				<div data-filter-empty class="px-6 py-10 text-center text-sm text-muted" hidden?={ v.Shown() > 0 }>
					Nothing matches this filter.
					<a href="/data" class="ml-1 text-accent-strong hover:underline">Show every destination</a>
				</div>
				if len(v.Rows) > 0 {
					<div class="overflow-x-auto">
						<table class="w-full text-[0.82rem]">
							<thead>
								<tr class="border-b border-line bg-canvas-subtle text-left">
									@th("Destination", "pl-4")
									@th("Status", "")
									@th("Writers", "")
									@th("Last loaded", "")
									@th("Rows", "text-right")
									@th("Last loads", "pr-4")
								</tr>
							</thead>
							<tbody id="catalog-rows" class="divide-y divide-line-soft">
								for _, r := range v.Rows {
									@dataRow(r)
								}
							</tbody>
						</table>
					</div>
				}
				@components.TableFoot(v.Shown(), v.Total, "destinations")
			</div>
		}
	}
}

// dataFilters is the bar above the table: a search over where and who, then
// the status, the kind and the label, each a URL. The search is a GET form
// that carries the other filters along, so searching never drops them.
templ dataFilters(v DataView) {
	{{ f := v.Filter }}
	// `data-filter-keep`: the list filter rewrites these links' `q` as
	// somebody types, so a status clicked after typing keeps the search.
	<div data-filter-keep class="mb-3 flex flex-wrap items-center gap-2">
		<form method="get" action="/data" role="search" class="w-full sm:w-80">
			if f.Status != "" {
				<input type="hidden" name="status" value={ f.Status }/>
			}
			if f.Kind != "" {
				<input type="hidden" name="kind" value={ f.Kind }/>
			}
			if f.Legacy {
				<input type="hidden" name="legacy" value="1"/>
			}
			@components.SearchInput("q", f.Q, "Search destinations or writers", "catalog-rows")
		</form>
		<div class="flex flex-wrap items-center gap-2">
			@components.Segmented("Status", statusOptions(v))
			if len(v.Kinds) > 1 {
				@components.Segmented("Kind", kindOptions(v))
			}
			if v.HasLegacy {
				@components.Segmented("Label", legacyOptions(v))
			}
		</div>
	</div>
}

// dataRow is one destination. The whole row goes to its page (ui.js follows
// `data-href` on a click that did not land on a link); the URI is a real link
// too, for the keyboard and for no script.
templ dataRow(r DataRow) {
	<tr
		data-filter-row
		data-filter-text={ r.SearchText() }
		hidden?={ r.Hidden }
		if r.Target != "" {
			data-href={ "/data/target?u=" + url.QueryEscape(r.Target) }
			class="cursor-pointer align-top transition-colors hover:bg-surface-2"
		} else {
			class="align-top"
		}
	>
		// A FLOOR UNDER THE URI: on a phone the table scrolls inside its frame
		// rather than squeezing the one column that matters to a letter per
		// line.
		<td class="min-w-[17rem] px-3 py-2.5 pl-4">
			<div class="flex items-start gap-2.5">
				<span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-card border border-line-soft text-muted">
					@components.Icon(kindIcon(r.Kind), "h-3.5 w-3.5")
				</span>
				<div class="min-w-0">
					if r.Target == "" {
						<span class="text-muted italic">unnamed destination</span>
					} else {
						{{ where, what := SplitTarget(r.Target) }}
						<a href={ templ.SafeURL("/data/target?u=" + url.QueryEscape(r.Target)) } class="font-mono text-[0.78rem] break-all hover:underline">
							<span class="text-faint">{ where }</span><span class="text-ink">{ what }</span>
						</a>
					}
					<span class="mt-0.5 flex items-center gap-1.5 text-[0.72rem] text-muted">
						if r.Target == "" && len(r.Writers) > 0 && r.Writers[0].Gateway != nil {
							{ r.Writers[0].Gateway.Kind } · { r.Writers[0].Gateway.Note }
						} else if r.Legacy {
							<span title="A label recovered from before steps named their target; it is never turned into one.">
								@components.Tag("legacy", "")
							</span>
							label
						} else {
							{ r.Kind }
						}
					</span>
				</div>
			</div>
		</td>
		<td class="px-3 py-2.5">
			@components.Freshness(string(r.Status))
		</td>
		<td class="px-3 py-2.5">
			for _, w := range r.Writers {
				<div class="whitespace-nowrap">
					if g := w.Gateway; g != nil {
						@components.Tag("gateway", "")
						<span class="ml-1 font-mono text-[0.78rem] text-ink">{ g.Name }</span>
						<span class="font-mono text-[0.72rem] text-muted">{ g.Stream }</span>
						<span class="text-[0.72rem] text-faint">({ g.Role })</span>
					} else {
						<a href={ templ.SafeURL("/workflows/" + w.Workflow) } class="font-mono text-[0.78rem] text-ink hover:underline">{ w.Workflow }</a>
						<span class="text-[0.72rem] text-muted">· { w.Node }</span>
					}
					if len(r.Writers) > 1 || w.Verdict.Status != r.Status {
						<span class="ml-1 text-[0.72rem] text-muted">({ components.FreshnessLabel(string(w.Verdict.Status)) })</span>
					}
					if w.RunInFlight != nil && (w.Verdict.Status == catalog.Late || w.Verdict.Status == catalog.Stale) {
						<a href={ templ.SafeURL("/runs/" + *w.RunInFlight) } class="ml-1 text-[0.72rem] text-state-running hover:underline">run in progress</a>
					}
				</div>
			}
		</td>
		<td class="px-3 py-2.5 text-[0.78rem] whitespace-nowrap text-muted">{ components.When(r.LastWhen) }</td>
		<td class="px-3 py-2.5 text-right text-[0.78rem] text-ink tabular-nums">{ rowsText(r.LastRows) }</td>
		<td class="px-3 py-2.5 pr-4">
			if len(r.Recent) == 0 && r.LastWhen == nil {
				<span class="text-[0.72rem] text-faint">the gateway's /metrics</span>
			} else {
				@components.Spark(r.Recent)
			}
		</td>
	</tr>
}
