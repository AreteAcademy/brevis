package pages

import (
	"fmt"

	"github.com/AreteAcademy/brevis/internal/domain/catalog"
	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/layouts"
)

templ Data(v DataView) {
	@layouts.Base(layouts.Page{Title: "Data", Kicker: "Catalog", Active: "data"}) {
		<p class="mb-4 max-w-3xl text-sm text-muted">
			Destinations written by Brevis: SDK pipelines, and any step that prints a
			<code class="font-mono text-xs">landed</code> line. Writes from outside Brevis do not appear here.
		</p>
		if v.Total == 0 {
			@components.Empty("No destination yet.",
				"One appears after an SDK pipeline's first load, or a step that prints a landed line. See docs/LANDINGS.md.")
		} else {
			<div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
				<span class="mr-1 font-medium text-ink">{ plural(v.Total, "destination") }</span>
				for _, s := range statusOrder {
					if v.Counts[s] > 0 {
						<span class="inline-flex items-center gap-1.5">
							<span class="tabular-nums text-ink">{ fmt.Sprint(v.Counts[s]) }</span>
							@components.Freshness(string(s))
						</span>
					}
				}
			</div>
			<div class="overflow-x-auto rounded-card border border-line bg-surface shadow-warm-sm">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-line bg-parchment-soft/60 text-left">
							@th("Status", "pl-6")
							@th("Destination", "")
							@th("Writers", "")
							@th("Last loaded", "")
							@th("Rows, last load", "text-right")
							@th("Last loads", "pr-6")
						</tr>
					</thead>
					<tbody class="divide-y divide-line-soft">
						for _, r := range v.Rows {
							@dataRow(r)
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ dataRow(r DataRow) {
	<tr class="align-top transition-colors hover:bg-gold-wash">
		<td class="px-3 py-3 pl-6">
			@components.Freshness(string(r.Status))
		</td>
		<td class="px-3 py-3">
			<span class="font-mono text-[0.8rem] break-all text-ink">{ r.Target }</span>
			<span class="mt-1 block text-[0.7rem] text-muted">
				if r.Legacy {
					<span
						class="rounded-card border border-line px-1.5 py-px font-medium"
						title="A label recovered from before steps named their target; it is never turned into one."
					>legacy</span>
					label
				} else {
					{ r.Kind }
				}
			</span>
		</td>
		<td class="px-3 py-3">
			for _, w := range r.Writers {
				<div class="whitespace-nowrap">
					<a href={ templ.SafeURL("/workflows/" + w.Workflow) } class="font-medium text-ink hover:text-gold-strong">{ w.Workflow }</a>
					<span class="text-muted">· { w.Node }</span>
					if len(r.Writers) > 1 || w.Verdict.Status != r.Status {
						<span class="ml-1 text-[0.7rem] text-muted">({ components.FreshnessLabel(string(w.Verdict.Status)) })</span>
					}
					if w.RunInFlight != nil && (w.Verdict.Status == catalog.Late || w.Verdict.Status == catalog.Stale) {
						<a href={ templ.SafeURL("/runs/" + *w.RunInFlight) } class="ml-1 text-[0.7rem] text-state-running hover:underline">run in progress</a>
					}
				</div>
			}
		</td>
		<td class="px-3 py-3 text-xs whitespace-nowrap text-muted">{ components.When(r.LastWhen) }</td>
		<td class="px-3 py-3 text-right text-xs tabular-nums text-ink">{ rowsText(r.LastRows) }</td>
		<td class="px-3 py-3 pr-6">
			@components.Spark(r.Recent)
		</td>
	</tr>
}
