package pages

import (
	"strings"

	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/i18n"
	"github.com/AreteAcademy/brevis/web/layouts"
)

// StreamPage is one gateway stream: where events are posted, what it declares,
// and where its refusals go. Three panels, all rendered: ui.js shows one at a
// time by the URL's hash (#config, #deadletter); with no script they stack,
// each an anchor.
templ StreamPage(v StreamView) {
	@layouts.Base(layouts.Page{
		Title: "POST " + v.Path, Crumb: "POST " + v.Path, Active: "streams", Mono: true,
		Eyebrow: streamEyebrow(v), Actions: streamActions(v),
	}) {
		<p class="-mt-1 mb-4 max-w-3xl text-[13.5px] text-muted">{ v.Lede(ctx) }</p>
		@streamStrip(v)
		@testEventDrawer(v)
		@templ.Raw("<style>" + hashTabsCSS("stream-tabs", "overview", "config", "deadletter") + "</style>")
		<div id="stream-tabs" data-hash-tabs>
			<div data-hash-tabs-bar data-js class="mb-3">
				@components.Tabs(i18n.T(ctx, "streams.page.tabs"), []components.Tab{
					{Key: "overview", Label: i18n.T(ctx, "streams.tab.overview"), Selected: true},
					{Key: "config", Label: i18n.T(ctx, "streams.tab.config")},
					{Key: "deadletter", Label: i18n.T(ctx, "streams.tab.dead_letter")},
				})
			</div>
			<section id="overview" data-tab-panel="overview" class="mb-3">
				<h2 data-panel-heading class="mb-3 text-[13px] font-semibold text-ink">{ i18n.T(ctx, "streams.tab.overview") }</h2>
				<div class="overflow-hidden rounded-card border border-line bg-surface">
					@flowDiagram(streamFlow(v.Stream))
				</div>
				<div class="mt-3 grid grid-cols-1 gap-3 min-[1180px]:grid-cols-[minmax(0,1fr)_360px]">
					@components.Panel(i18n.T(ctx, "streams.page.sentence"), "") {
						<div class="px-4 py-3">
							<p class="text-[13.5px] text-ink" data-summary>{ v.Summary(ctx) }</p>
							<p class="mt-3 border-t border-line-soft pt-3 text-[12px] text-muted">{ i18n.T(ctx, "streams.page.metrics") }</p>
						</div>
					}
					@components.Panel(i18n.T(ctx, "streams.page.next"), "") {
						@streamNext(v)
					}
				</div>
			</section>
			<section id="config" data-tab-panel="config" class="mb-3">
				<h2 data-panel-heading class="mb-3 text-[13px] font-semibold text-ink">{ i18n.T(ctx, "streams.tab.config") }</h2>
				if v.Config == nil {
					<p class="rounded-card border border-line bg-surface px-4 py-3 text-xs text-muted">{ i18n.T(ctx, "streamcfg.v1") }</p>
				} else {
					@streamConfig(v)
				}
			</section>
			<section id="deadletter" data-tab-panel="deadletter" class="mb-3">
				<h2 data-panel-heading class="mb-3 text-[13px] font-semibold text-ink">{ i18n.T(ctx, "streams.tab.dead_letter") }</h2>
				if dl := v.DeadLetterShown(); dl == nil {
					<p class="rounded-card border border-line bg-surface px-4 py-3 text-sm text-muted">{ i18n.T(ctx, "deadletter.none") }</p>
				} else {
					<div class="flex flex-col gap-4">
						@components.Panel(i18n.T(ctx, "deadletter.where"), dl.Kind) {
							<div class="flex items-start gap-3 px-4 py-3">
								<pre id="dead-letter-uri" class="min-w-0 flex-1 overflow-x-auto font-mono text-[0.8rem] break-all whitespace-pre-wrap text-ink">{ placeName(ctx, *dl) }</pre>
								<span data-js>
									@components.IconButton(i18n.T(ctx, "loads.drawer.copy"), "copy", templ.Attributes{"data-copy": "#dead-letter-uri"})
								</span>
							</div>
							if dl.Note != "" {
								<p class="px-4 pb-3 text-[12px] text-muted">{ dl.Note }</p>
							}
							<p class="border-t border-line-soft px-4 py-3 text-[0.75rem] text-muted">
								{ i18n.T(ctx, "deadletter.metric") } <code class="font-mono text-ink-2">{ v.BuriedMetric() }</code>
							</p>
						}
						if p := v.DeadLetterPanel(); p != nil {
							<div class="rounded-card border border-line bg-surface">
								@deadLetterPanel(p)
							</div>
						} else {
							<p class="rounded-card border border-line bg-surface px-4 py-3 text-xs text-muted">{ i18n.T(ctx, "deadletter.no_config") }</p>
						}
						<p class="text-[12px] text-faint">{ i18n.T(ctx, "deadletter.count_later") }</p>
					</div>
				}
			</section>
		</div>
	}
}

// streamEyebrow is what the page is, above the path.
templ streamEyebrow(v StreamView) {
	<span class="text-[0.7rem] font-medium tracking-[0.08em] text-muted uppercase">{ i18n.T(ctx, "streams.page.kicker") }</span>
	<span class="font-mono text-[0.75rem] text-ink-2">{ v.Gateway }</span>
}

// streamActions are the page's verbs: a query of the sink where SQL can read
// it and a SQL service answers for it, and the test event, which is the
// page's own.
templ streamActions(v StreamView) {
	if v.SQL && v.Queryable() {
		@components.ButtonLink(components.ButtonSecondary, components.SizeRegular, v.QueryHref()) {
			@components.Icon("terminal", "h-3.5 w-3.5")
			{ i18n.T(ctx, "loads.drawer.query") }
		}
	}
	<a href="#test-event" data-dialogo="test-event" aria-haspopup="dialog" class={ components.ButtonClass(components.ButtonPrimary, components.SizeRegular) }>
		@components.Icon("send", "h-3.5 w-3.5")
		{ i18n.T(ctx, "streams.page.test") }
	</a>
}

// streamStrip is the stream in one line: continuous, from the gateway to the
// destination, its format and when it was published.
templ streamStrip(v StreamView) {
	<div data-stream-strip class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-card border border-line bg-surface px-4 py-3 text-[12.5px] text-muted">
		@components.Freshness("continuous")
		<span>{ i18n.T(ctx, "streams.page.from") }</span>
		<span class="inline-flex items-center gap-1.5 rounded-card border border-line px-2 py-0.5 text-ink-2">
			@components.Logo("gateway", 16)
			{ i18n.T(ctx, "streams.gateway") }
			<span class="font-mono text-ink">{ v.Gateway }</span>
		</span>
		<span>{ i18n.T(ctx, "streams.page.to") }</span>
		<span class="inline-flex min-w-0 items-center gap-1.5 rounded-card border border-line px-2 py-0.5 text-ink-2">
			if v.Sink.Kind != "" {
				@components.Logo(kindLogo(v.Sink.Kind), 16)
				{ components.LogoTitle(ctx, kindLogo(v.Sink.Kind)) }
			}
			<span class="truncate font-mono text-ink" title={ v.Sink.URI }>{ placeName(ctx, v.Sink) }</span>
		</span>
		if f := v.Field("format"); f != "" {
			<span>{ i18n.T(ctx, "streams.page.format", "format", f) }</span>
		}
		if !v.PublishedAt.IsZero() {
			<span>{ i18n.T(ctx, "streams.page.published", "at", i18n.Date(ctx, v.PublishedAt.UTC(), "brief")+" UTC") }</span>
		}
	</div>
}

// streamNext is where the data goes after the stream, as far as Brevis
// knows: the destination -- its tables, for an auto_table -- in the catalog,
// then the endpoints that read it. Workflows that read it are not known and
// are not drawn.
templ streamNext(v StreamView) {
	<ol class="space-y-2 px-4 py-3 text-[12.5px]">
		<li>
			<span class="inline-flex items-center gap-1.5 rounded-card border border-line px-2 py-0.5 font-mono text-ink">
				<span class="font-sans text-[10.5px] tracking-[0.08em] text-muted uppercase">stream</span>
				{ v.Path }
			</span>
		</li>
		<li class="pl-2 text-muted">&darr; { i18n.T(ctx, "streams.page.writes") }</li>
		<li>
			<span class="inline-flex max-w-full flex-wrap items-center gap-1.5 rounded-card border border-line px-2 py-0.5 font-mono text-ink">
				if v.Sink.Kind != "" {
					@components.Logo(kindLogo(v.Sink.Kind), 14)
				}
				if tables := v.Tables(); len(tables) > 0 {
					{ strings.Join(tables, " · ") }
				} else {
					<span class="break-all">{ placeName(ctx, v.Sink) }</span>
				}
			</span>
			if v.Sink.URI != "" {
				<a href={ templ.SafeURL(TargetHref(v.Sink.URI)) } class="mt-1 block text-[12px] text-ink-2 hover:text-ink hover:underline">{ i18n.T(ctx, "loads.drawer.catalog") } &rarr;</a>
			}
		</li>
		<li class="pl-2 text-muted">&darr; { i18n.T(ctx, "streams.page.read_by") }</li>
		<li>
			if len(v.ReadBy) == 0 {
				<span class="text-faint">{ i18n.T(ctx, "streams.page.read_by.none") }</span>
			} else {
				<ul class="space-y-1">
					for _, e := range v.ReadBy {
						<li>
							<a href={ templ.SafeURL(e.Href) } class="font-mono text-ink hover:underline">GET { e.Path }</a>
							<span class="ml-1.5 text-muted">{ e.API }</span>
						</li>
					}
				</ul>
			}
		</li>
	</ol>
}

// testEventDrawer is an example event in the stream's format and the curl that
// would send it. IT SENDS NOTHING: no form, no fetch -- the console holds no
// token for the gateway and does not know where it listens. ui.js validates
// the body against the format as it is edited and rebuilds the curl; with no
// script, #test-event shows the example and its curl in place.
templ testEventDrawer(v StreamView) {
	<dialog
		id="test-event"
		aria-labelledby="test-event-title"
		class="run-drawer fixed inset-y-0 right-0 left-auto m-0 h-full max-h-none w-[min(520px,100vw)] border-l border-line bg-surface p-0 text-ink backdrop:bg-ink/40"
	>
		<div class="flex h-full flex-col">
			<div class="flex items-start justify-between gap-4 border-b border-line px-5 py-4">
				<div class="min-w-0">
					<p class="truncate font-mono text-[11px] tracking-[0.08em] text-muted uppercase">POST { v.Path } · { v.TestFormat() }</p>
					<p id="test-event-title" class="text-[15px] font-semibold text-ink">{ i18n.T(ctx, "testevent.title") }</p>
					<p class="mt-1 text-[12.5px] text-muted">{ i18n.T(ctx, "testevent.lead") }</p>
				</div>
				<form method="dialog">
					<button type="submit" aria-label={ i18n.T(ctx, "dialog.close") } class="flex h-8 w-8 items-center justify-center rounded-card text-muted transition-colors hover:bg-surface-2 hover:text-ink">
						@components.Icon("x", "h-4 w-4")
					</button>
				</form>
			</div>
			<div class="flex-1 space-y-4 overflow-y-auto px-5 py-4">
				<label class="flex flex-col gap-1.5">
					<span class="text-[12.5px] font-medium text-ink">{ i18n.T(ctx, "testevent.body") }</span>
					// The rules the browser checks the body by are the
					// server's, written here, so the two cannot disagree; and
					// so are the words it says them in.
					<textarea
						data-test-body
						data-test-format={ v.TestFormat() }
						if v.TestTable() != "" {
							data-test-table={ v.TestTable() }
							data-test-allow={ v.TestAllow() }
							data-test-dataset={ v.TestDataset() }
						} else {
							data-test-lands={ v.TestLands() }
						}
						data-msg-invalid={ i18n.T(ctx, "testevent.invalid") }
						data-msg-array={ i18n.T(ctx, "testevent.array") }
						data-msg-items={ i18n.T(ctx, "testevent.items") }
						data-msg-line={ i18n.T(ctx, "testevent.line") }
						data-msg-object={ i18n.T(ctx, "testevent.object") }
						data-msg-no-table={ i18n.T(ctx, "testevent.no_table", "field", v.TestTable()) }
						data-msg-refused={ i18n.T(ctx, "testevent.refused") }
						data-msg-lands={ i18n.T(ctx, "testevent.lands") }
						data-msg-valid={ i18n.T(ctx, "testevent.valid") }
						rows="8"
						spellcheck="false"
						class="w-full rounded-card border border-line bg-canvas px-3 py-2 font-mono text-[0.78rem] text-ink focus:border-accent-strong focus:outline-none"
					>{ v.TestBody() }</textarea>
				</label>
				<p data-test-status class="text-[12px] text-muted" aria-live="polite"></p>
				<div>
					<div class="mb-1.5 flex items-center justify-between">
						<span class="text-[12.5px] text-muted">{ i18n.T(ctx, "testevent.send_with") }</span>
						<span data-js>
							@components.IconButton(i18n.T(ctx, "testevent.copy"), "copy", templ.Attributes{"data-copy": "#test-event-curl"})
						</span>
					</div>
					<pre class="overflow-x-auto rounded-card border border-line-soft bg-canvas px-3 py-2 font-mono text-[0.72rem] text-ink-2"><code id="test-event-curl" data-test-curl data-test-curl-head={ v.TestCurlHead() }>{ v.TestCurl() }</code></pre>
				</div>
				<p class="text-[12px] text-muted">{ i18n.T(ctx, "testevent.note", "sink", placeName(ctx, v.Sink)) }</p>
			</div>
		</div>
	</dialog>
}

// streamConfig is the Configuration tab (screen-streams T4): the settings
// Explained -- in cards, a label in the reader's words over each YAML key --
// or as the YAML they make. Both are drawn; a script shows one at a time by
// data-view, and with none they stack, the YAML under its heading.
templ streamConfig(v StreamView) {
	<div data-config-view="explained">
		<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
			<p class="text-[12.5px] text-muted">{ i18n.T(ctx, "streamcfg.lead") }</p>
			<div data-js role="group" aria-label={ i18n.T(ctx, "streams.tab.config") } class="inline-flex h-8 items-center gap-0.5 rounded-card border border-line bg-surface p-0.5">
				<button type="button" data-view-set="explained" aria-pressed="true" class="rounded-[5px] px-2.5 py-1 text-[12.5px] text-muted aria-pressed:bg-surface-2 aria-pressed:text-ink">{ i18n.T(ctx, "streamcfg.explained") }</button>
				<button type="button" data-view-set="yaml" aria-pressed="false" class="rounded-[5px] px-2.5 py-1 text-[12.5px] text-muted aria-pressed:bg-surface-2 aria-pressed:text-ink">YAML</button>
			</div>
		</div>
		<div data-view-pane="explained" class="grid grid-cols-1 gap-3 min-[900px]:grid-cols-2">
			for _, card := range ExplainConfig(v.Config) {
				@components.Panel(cardTitle(ctx, card.Key), "") {
					<dl class="divide-y divide-line-soft">
						for _, r := range card.Rows {
							<div class="grid grid-cols-[minmax(0,11rem)_minmax(0,1fr)] gap-x-4 px-4 py-2.5 text-[12.5px]" data-explained={ r.Path }>
								<dt>
									<span class="text-ink-2">{ r.LabelIn(ctx) }</span>
									<span class="mt-0.5 block font-mono text-[11px] text-faint">{ r.Path }</span>
								</dt>
								<dd class="min-w-0">
									<span class="font-mono break-all text-ink">{ r.Value }</span>
									if r.Default {
										<span class="ml-2 rounded-card border border-line px-1 py-px text-[0.65rem] text-muted uppercase" title={ i18n.T(ctx, "config.default.tip") }>{ i18n.T(ctx, "config.default") }</span>
									}
									if r.Note != "" {
										// The note's first line; the rest a click away, as
										// everywhere a configuration's notes are drawn.
										<div class="mt-1">
											@configNote(r.Note)
										</div>
									}
								</dd>
							</div>
						}
					</dl>
				}
			}
		</div>
		<section data-view-pane="yaml">
			<div class="mb-1.5 flex items-center justify-between">
				<h3 class="text-[12.5px] text-muted">{ i18n.T(ctx, "streamcfg.yaml") }</h3>
				<span data-js>
					@components.IconButton(i18n.T(ctx, "loads.drawer.copy"), "copy", templ.Attributes{"data-copy": "#stream-yaml"})
				</span>
			</div>
			<pre class="overflow-x-auto rounded-card border border-line bg-canvas px-4 py-3 font-mono text-[12px] text-ink-2"><code id="stream-yaml">{ ConfigYAML(v.Config) }</code></pre>
			<p class="mt-1.5 text-[11.5px] text-faint">{ i18n.T(ctx, "catalog.drawer.credentials") }</p>
		</section>
		if v.Configured != nil && len(v.Configured.Config.Changes) > 0 {
			<p data-config-history class="mt-3 text-[12px] text-muted">
				{ i18n.T(ctx, "streamcfg.history") }
				for i, ch := range v.Configured.Config.Changes {
					if i > 0 {
						<span class="text-faint">·</span>
					}
					<span>{ i18n.Date(ctx, ch.At.UTC(), "brief") } UTC — { changeSaid(ctx, ch) }</span>
				}
			</p>
		}
	</div>
}
