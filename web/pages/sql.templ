package pages

import "github.com/AreteAcademy/brevis/web/layouts"

// editorAssets is the island's load order, and the order is not style: the
// SQL mode registers itself with `CodeMirror`, which the first file defines.
//
// Only this screen pays for it -- the rule base.templ states and the DAG's
// React already follows.
var editorAssets = layouts.Island{
	CSS: []string{"/assets/vendor/codemirror.css"},
	JS: []string{
		"/assets/vendor/codemirror.js",
		"/assets/vendor/codemirror-sql.js",
		"/assets/sql.js",
	},
}

// SQL is the workbench.
//
// SERVER-RENDERED, like every other screen here: `base.templ` states the rule
// -- "the HTML already arrives complete, the script only enriches it" -- and
// an editor island will mount ON this textarea rather than replace it, so the
// form keeps working with no script at all.
//
// NO TABS YET, and the reason is V2's: a statement must not reach a URL,
// because a query in a link is a query in a proxy log, in a browser's history
// and in a Referer header. Tab state in a query parameter would be exactly
// that, so tabs wait for the island that can hold state in the browser.
templ SQL(v SQLView) {
	@layouts.Base(layouts.Page{Title: "SQL", Kicker: "Workbench", Active: "sql", Wide: true, Island: editorAssets}) {
		if v.Empty() {
			<p class="rounded-card border border-line-soft px-4 py-3 text-sm text-muted">
				Nothing here can be queried yet. A destination shows up once a pipeline
				lands in a table — a bucket and a topic have no columns to read.
			</p>
		} else {
			<div class="flex gap-5">
				@tree(v)
				<div class="min-w-0 flex-1">
			<form method="post" action="/sql" class="flex flex-col gap-3">
				<div class="flex flex-wrap items-center gap-3">
					<label for="target" class="kicker">Connection</label>
					<select
						id="target"
						name="target"
						class="rounded-card border border-line bg-surface px-3 py-1.5 font-mono text-xs text-ink"
					>
						for _, t := range v.Targets {
							if t == v.Target {
								<option value={ t } selected>{ Short(t) }</option>
							} else {
								<option value={ t }>{ Short(t) }</option>
							}
						}
					</select>
				</div>
				<label for="q" class="sr-only">SQL to run on this warehouse</label>
				<textarea
					id="q"
					name="q"
					rows="10"
					spellcheck="false"
					placeholder="SELECT * FROM dataset.table WHERE day = CURRENT_DATE()"
					class="w-full rounded-card border border-line bg-surface px-3 py-2 font-mono text-xs text-ink"
				>{ v.Statement }</textarea>
				<div class="flex items-center gap-3">
					<button
						type="submit"
						class="rounded-card border border-line bg-surface-2 px-3 py-1.5 text-sm font-medium text-ink hover:bg-surface"
					>Run</button>
					<span class="text-xs text-muted">
						Reads only. The service refuses anything else, and stops a query that would scan too much.
					</span>
				</div>
			</form>
			if v.Err != "" {
				<p class="mt-5 rounded-card border border-line-soft px-4 py-3 text-sm text-muted">{ v.Err }</p>
			} else if v.Result != nil {
				<div class="mt-5">
					@grid(v.Result.Columns, v.Result.Rows)
					<p class="mt-2 text-xs text-muted">{ v.Note() }</p>
				</div>
			}
				</div>
			</div>
		}
	}
}

// tree is what the chosen connection holds.
//
// THE HALF A PICKER CANNOT GIVE: a picker says which warehouse, and this
// says what is IN it -- including the relations nothing landed on, which is
// the whole reason somebody opens a workbench instead of a destination page.
//
// A <details> per schema and not a script: the browser gives the open state,
// the keyboard and the ARIA for free, which is the same choice the account
// menu made.
templ tree(v SQLView) {
	if len(v.Tree) > 0 {
		<aside class="w-60 shrink-0 overflow-y-auto border-r border-line-soft pr-3 text-xs">
			<p class="kicker mb-2">Objects</p>
			for _, s := range v.Tree {
				<details class="mb-0.5">
					<summary class="cursor-pointer list-none rounded-card px-2 py-1 text-muted hover:bg-surface-2 hover:text-ink">
						{ s.Name }
					</summary>
					for _, t := range s.Tables {
						// `data-insert` is what the island reads to put the
						// name in the editor. Without the island it is still
						// a readable list, which is the point of putting the
						// name in the text rather than only in an attribute.
						<button
							type="button"
							data-insert={ s.Name + "." + t }
							class="block w-full truncate rounded-card px-2 py-1 pl-5 text-left font-mono text-muted hover:bg-surface-2 hover:text-ink"
						>{ t }</button>
					}
				</details>
			}
			if v.TreeCut {
				<p class="mt-2 px-2 text-[0.7rem] text-muted">Showing part of this warehouse — there are more.</p>
			}
		</aside>
	}
}
