package pages

import (
	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/assets"
	"fmt"

	"github.com/AreteAcademy/brevis/internal/infrastructure/sqlserve"
	"github.com/AreteAcademy/brevis/web/i18n"
	"github.com/AreteAcademy/brevis/web/layouts"
)

// editorAssets is the island's load order, and the order is not style: each
// file here extends the one above it. The SQL mode registers itself with
// `CodeMirror`; `show-hint` hangs `showHint` off the same object; `sql-hint`
// fills the list that `show-hint` opens, and reads its keywords out of the
// mode. Swap any pair and what is left is a plain textarea and a console
// error.
//
// Only this screen pays for it -- the rule base.templ states and the DAG's
// React already follows. The two addons add 13 KiB to the 212 KiB the editor
// already cost, on the one screen that asks for it.
var editorAssets = layouts.Island{
	CSS: []string{
		assets.URL("vendor/codemirror.css"),
		assets.URL("vendor/show-hint.css"),
	},
	JS: []string{
		assets.URL("vendor/codemirror.js"),
		assets.URL("vendor/codemirror-sql.js"),
		assets.URL("vendor/show-hint.js"),
		assets.URL("vendor/sql-hint.js"),
		assets.URL("sql.js"),
	},
}

// SQL is the workbench.
//
// SERVER-RENDERED, like every other screen here: `base.templ` states the rule
// -- "the HTML already arrives complete, the script only enriches it" -- and
// an editor island will mount ON this textarea rather than replace it, so the
// form keeps working with no script at all.
//
// NO TABS YET, and the reason is V2's: a statement must not reach a URL,
// because a query in a link is a query in a proxy log, in a browser's history
// and in a Referer header. Tab state in a query parameter would be exactly
// that, so tabs wait for the island that can hold state in the browser.
templ SQL(v SQLView) {
	@layouts.Base(layouts.Page{Title: "SQL", Kicker: "Workbench", Active: "sql", Island: editorAssets, Fill: true, Status: sqlStatus(v)}) {
		if v.Empty() {
			<p class="max-w-3xl rounded-card border border-line-soft px-4 py-3 text-sm text-muted">
				Nothing here can be queried yet. A destination shows up once a pipeline
				lands in a table — a bucket and a topic have no columns to read.
			</p>
		} else {
			// THREE ZONES, AND THE TWO THINGS BETWEEN THEM CAN BE DRAGGED.
			//
			// The sizes are custom properties on this element, which is what
			// the island writes: one assignment per drag, and a reload
			// restores a number rather than replaying a gesture.
			<div class="workbench" data-workbench>
				@tree(v)
				// AND THE WAY BACK, WHICH LIVES OUTSIDE THE RAIL.
				//
				// The collapse control sits in the rail's own header, and a
				// collapsed rail is `display: none` -- so the only button that
				// could undo it would have gone with it. This one is drawn
				// only when the rail is away.
				<button
					type="button"
					data-rail-toggle
					aria-expanded="true"
					aria-controls="objects"
					aria-label={ i18n.T(ctx, "sql.tree.show") }
					class="workbench-rail-show self-start rounded-card px-1 py-1 text-muted hover:bg-surface-2 hover:text-ink"
				>&#8677;</button>
				<div
					class="workbench-grip"
					data-grip="rail"
					data-min="180"
					role="separator"
					aria-orientation="vertical"
					aria-label={ i18n.T(ctx, "sql.tree.resize") }
					tabindex="0"
				></div>
				<div class="workbench-main">
					<section class="workbench-editor" data-pane="editor">
						// THE TAB STRIP ARRIVES HIDDEN, like the pager.
						//
						// Several statements open at once is an island's job --
						// they live in `localStorage` and never reach the server,
						// which keeps seeing exactly ONE statement per submit. A
						// browser with no script gets the screen that was always
						// here: one box, one query.
						//
						// AND THE MARKUP OF A TAB IS IN A <template>. W1's rule read
						// forward: the island clones this, it does not write tags,
						// so the classes and the ARIA have one definition that the
						// Go suite can read.
						// THIS CONNECTION MAY BE CHANGED, AND THE SCREEN SAYS SO.
						//
						// Everything that unlocks a write is twenty lines in
						// `serve`; this is the part that matters. The dangerous
						// reader is not the one who types DROP on purpose -- it
						// is the one who does not know this console can, because
						// the last console they used could not.
						//
						// IN WORDS AND NOT ONLY IN AN ATTRIBUTE. A marker only an
						// island reads is a marker nobody sees without
						// JavaScript, and this screen's own rule is that what it
						// draws without a script is what it promises.
						//
						// Drawn only where the service said so, which is the
						// default everywhere else: a warning on every screen is a
						// warning nobody reads.
						if v.Writable {
							<p
								data-writable
								class="workbench-writable shrink-0 rounded px-2 py-1 text-[0.7rem]"
							>
								Statements here can <strong>change data</strong> on this connection — it was unlocked deliberately.
							</p>
						}
						<div
							class="workbench-tabs flex shrink-0 items-center gap-1 overflow-x-auto border-b border-line-soft pb-1"
							data-tabs
							role="tablist"
							aria-label="Open statements"
							data-js
						>
							<button
								type="button"
								data-tab-new
								aria-label="New statement"
								class="shrink-0 rounded-card px-2 py-1 text-sm text-muted hover:bg-surface-2 hover:text-ink"
							>+</button>
						</div>
						<template data-tab-template>
							<span class="workbench-tab inline-flex shrink-0 items-center gap-1 rounded-card px-2 py-1">
								<button
									type="button"
									role="tab"
									aria-selected="false"
									data-tab-pick
									class="max-w-[9rem] truncate text-xs text-muted hover:text-ink"
								></button>
								<button
									type="button"
									data-tab-close
									aria-label="Close this statement"
									class="shrink-0 text-xs text-muted hover:text-ink"
								>&#215;</button>
							</span>
						</template>
						<form id="workbench" method="post" action="/sql" class="flex min-h-0 flex-1 flex-col gap-2">
							// WHAT IS OPEN RIDES WITH EVERY SUBMIT, so running a query
							// does not close the tree somebody just arranged.
							<input type="hidden" name="open" value={ v.Open }/>
							// THE CONNECTION IS THE TREE'S ROOT NOW, not a picker.
							//
							// A <select> said which warehouse and nothing about what is
							// in it, so comparing two meant choosing one, losing the
							// tree, and choosing the other. This field is what the chosen
							// root writes, and it is hidden because the tree is the
							// control.
							<input type="hidden" name="target" value={ v.Target }/>
							<div class="flex shrink-0 items-center gap-3 pb-1">
								// RUN LOOKS LIKE THE THING YOU PRESS: the accent, which
								// this screen spends on nothing else.
								@components.Button(components.ButtonAccent, components.SizeRegular, templ.Attributes{"type": "submit", "data-run": true}) {
									@components.Icon("play", "h-3.5 w-3.5")
									Run
								}
								// AND THE KEY THAT DOES IT. Ctrl-Enter and Cmd-Enter
								// have run the query since the editor island landed,
								// and the screen has never said so.
								@components.Kbd("⌘↵")
								// AND IT SAYS WHERE IT WILL RUN. The picker used to be
								// the answer to "against what"; with the picker gone,
								// the button has to carry it, or choosing a connection
								// in the tree becomes an invisible change.
								if on := v.Running(); on != "" {
									<span class="flex min-w-0 items-center gap-1.5 text-muted">
										@components.Icon("database", "h-3.5 w-3.5")
										<span class="truncate font-mono text-xs" data-running-on>{ on }</span>
									</span>
								}
								// COPY IS THE EDITOR'S TEXT, which only the island
								// holds -- the textarea is written back on submit, not
								// as somebody types -- so it is hidden until the
								// island can drive it.
								<span class="ml-auto" data-js>
									@components.Button(components.ButtonSecondary, components.SizeSmall, templ.Attributes{"data-copy-statement": true}) {
										@components.Icon("copy", "h-3.5 w-3.5")
										Copy
									}
								</span>
							</div>
							<label for="q" class="sr-only">SQL to run on this warehouse</label>
							<textarea
								id="q"
								name="q"
								if v.Preloaded {
									data-preloaded
								}
								rows="10"
								spellcheck="false"
								placeholder="SELECT * FROM dataset.table WHERE day = CURRENT_DATE()"
								class="min-h-0 w-full flex-1 resize-none rounded-card border border-line bg-surface px-3 py-2 font-mono text-xs text-ink"
							>{ v.Statement }</textarea>
							// THE FOOTER, where the cost line joins it in W6. It left
							// the button row because a verb and a caveat read as two
							// controls when they sit on one line.
							// NOT ON A WRITABLE CONNECTION, where the banner above
							// says the opposite and both cannot be true.
							if !v.Writable {
								<p class="shrink-0 text-[0.7rem] text-muted">
									Reads only. The service refuses anything else, and stops a query that would scan too much.
								</p>
							}
							// AND WHAT THE COMPLETION KNOWS, SAID ONCE.
							//
							// Columns are fetched one relation at a time --
							// CHECKPOINT D refused the project-wide COLUMNS query
							// that would fill this list -- so the editor completes
							// the columns of what somebody opened and nothing else.
							// A list that silently knows half a warehouse is how
							// somebody concludes a column does not exist.
							<p class="shrink-0 text-[0.7rem] text-muted">
								<kbd class="rounded border border-line px-1 py-0.5 font-mono">Ctrl+Space</kbd>
								completes names. Columns complete for relations you have opened in the tree.
							</p>
							// THE COST LINE, EMPTY UNTIL SOMETHING FILLS IT.
							//
							// A dry run is an API call against the client's own
							// project quota, so the pause before asking is a number
							// and the number is HERE -- the same rule the grips'
							// floor and the Recent rail's cap follow. A debounce
							// that lived only in the island is a number nobody
							// reading this page can find.
							//
							// `aria-live` polite and not assertive: it changes while
							// somebody is typing, and a screen reader that
							// interrupted every pause would be unusable.
							<p
								data-cost
								data-estimate-after="600"
								aria-live="polite"
								class="min-h-[0.9rem] shrink-0 text-[0.7rem] text-muted"
							></p>
						</form>
					</section>
					<div
						class="workbench-grip"
						data-grip="split"
						data-min="120"
						role="separator"
						aria-orientation="horizontal"
						aria-label="Resize the editor"
						tabindex="0"
					></div>
					<section class="workbench-results" data-pane="results">
						@recent()
						// MARKED, because the island wires the answer from this
						// node and not from the document: a run that replaces
						// the pane hands it the new one.
						<div class="workbench-answer" data-answer>
							@SQLAnswer(v)
						</div>
						// WHAT A RUN SAYS WHILE IT IS RUNNING, cloned into the
						// pane by the island once a Run has taken 120ms. Here
						// and not in sql.js because Tailwind reads templates:
						// a class written only in the island would not exist.
						//
						// "Cancel" is measured, not hoped: aborting the
						// request cancels the query (Postgres: gone from
						// pg_stat_activity half a second after; BigQuery:
						// serve asks jobs.cancel).
						<template data-running-template>
							<div data-running role="status" class="mb-3 flex items-center gap-3 rounded-card border border-line bg-surface-2 px-3 py-2 text-[0.8rem] text-ink">
								<span class="h-2 w-2 shrink-0 animate-pulse rounded-full bg-state-running"></span>
								<span>Running <span class="text-muted">·</span> <span data-running-elapsed class="tabular-nums">0.1 s</span></span>
								<button type="button" data-stop class="ml-auto inline-flex h-7 items-center rounded-card border border-line bg-surface px-2.5 text-[0.78rem] font-medium text-ink transition-colors hover:bg-surface-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-strong">Cancel</button>
							</div>
						</template>
					</section>
				</div>
			</div>
		}
	}
}


// SQLAnswer is the answer pane's content: what ran, as data for the island,
// then the refusal, the result or the sentence that says nothing has run.
//
// ONE DEFINITION FOR BOTH SHAPES. The workbench draws it inside its pane, and
// a run that asks for the answer alone (X-Brevis-Fragment: answer) gets
// exactly this and nothing around it -- so the island swaps in the same
// markup a reload would have drawn.
templ SQLAnswer(v SQLView) {
	// WHAT JUST HAPPENED, AS DATA. The rail is built in the
	// browser and needs the outcome and the cost; the
	// sentence under the grid is for a person. Parsing that
	// sentence back out in JavaScript would break the day
	// somebody rewords it.
	//
	// NOT `data-run`: that is already the Run button.
	if v.Ran() {
		<p data-outcome={ v.Outcome() } data-cost={ v.Cost() } hidden></p>
	}
	if v.Err != "" {
		<p class="max-w-3xl rounded-card border border-line-soft px-4 py-3 text-sm text-muted">{ v.Err }</p>
	} else if v.Result != nil {
		@results(v)
	} else {
		// BEFORE ANYTHING RUNS, HOW TO: the verb and its key, where the
		// answer will be.
		<div class="flex h-full min-h-32 flex-col items-center justify-center gap-2 text-center">
			<span class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-muted">
				@components.Icon("play", "h-4 w-4")
			</span>
			<p class="text-sm font-medium text-ink">Run a query</p>
			<p class="flex items-center gap-1.5 text-[0.75rem] text-muted">
				Nothing has run yet. The answer appears here.
				@components.Kbd("⌘↵")
			</p>
		</div>
	}
}

// recent is the rail of what has been run, and all of it lives in the
// browser.
//
// THE BOUNDARY IS CONSOLE 2.0'S, RESTATED WITH ITS COST: saved queries live
// in the BROWSER until there is a user model. The statements are on that
// machine, in that browser; a second browser starts empty and clearing site
// data empties this. A server store would need a user model, and without one
// it is a shared mutable list with no owner -- every operator reading every
// other operator's drafts.
//
// WHAT IS STORED IS SQL TEXT. That is said out loud because it is a decision
// and not an accident: nothing writes a statement to the server's disk, to a
// metric or to a URL. The browser already keeps what somebody typed into a
// form; this keeps it on purpose.
//
// HIDDEN UNTIL THE ISLAND RUNS, and emptier than the tab strip without it:
// what it lists has no server to come from.
templ recent() {
	<aside
		id="recent"
		class="workbench-recent text-xs"
		data-recent
		data-recent-keep="20"
		aria-label="Recent statements"
		data-js
	>
		<div class="mb-2 flex items-center justify-between gap-2">
			<p class="text-[11.5px] font-medium text-muted">Recent</p>
			<button
				type="button"
				data-recent-toggle
				aria-expanded="true"
				aria-controls="recent"
				aria-label="Collapse the recent statements"
				class="rounded-card px-1 py-0.5 text-muted hover:bg-surface-2 hover:text-ink"
			>&#8676;</button>
		</div>
		<ol data-recent-list class="space-y-0.5"></ol>
		<p data-recent-empty class="px-2 text-[0.7rem] text-muted">
			Nothing yet. What you run shows up here — in this browser, on this machine.
		</p>
	</aside>
	// AND THE WAY BACK, OUTSIDE WHAT IT HIDES. W2 learned this on the object
	// tree: a collapsed rail is `display: none`, so the only control that
	// could undo it would have gone with it.
	<button
		type="button"
		data-recent-toggle
		aria-expanded="true"
		aria-controls="recent"
		aria-label="Show the recent statements"
		class="workbench-recent-show self-start rounded-card px-1 py-1 text-muted hover:bg-surface-2 hover:text-ink"
	>&#8677;</button>
	<template data-recent-template>
		<li>
			<button
				type="button"
				data-recent-open
				class="block w-full rounded-card px-2 py-1 text-left hover:bg-surface-2"
			>
				<span class="flex items-center gap-1.5">
					// BOTH OUTCOMES ARE DRAWN HERE AND ONE IS HIDDEN, rather
					// than a class the island assembles. A class name built by
					// concatenating strings in JavaScript is a class Tailwind
					// never sees in a source file and never emits -- the colour
					// would simply not exist.
					<span data-recent-outcome class="shrink-0 text-[0.7rem]">
						<span data-recent-ok class="text-state-success" hidden>ok</span>
						<span data-recent-failed class="text-state-failed" hidden>failed</span>
					</span>
					<span data-recent-cost class="truncate text-[0.7rem] text-muted"></span>
				</span>
				<span data-recent-text class="mt-0.5 block truncate font-mono text-[0.7rem] text-ink"></span>
			</button>
		</li>
	</template>
}

// tree is the connection picker and what the chosen connection holds
// (screen-sql T1).
//
// A PICKER AND ONE TREE, the handoff's shape, chosen by the owner over the
// roots it replaced. It is a GET form of its own (`?connection=`), so with no
// script choosing a connection is a page; the island submits it on change,
// and the open statements survive in the tabs' storage. The connections this
// console cannot read are offered disabled, with the reason under them.
//
// A <details> per schema and not a script: the browser gives the open state,
// the keyboard and the ARIA for free.
templ tree(v SQLView) {
	if len(v.Targets) > 0 {
		<aside id="objects" class="workbench-rail border-r border-line-soft pr-3 text-xs" data-rail>
			<div class="mb-2 flex items-center justify-between gap-2">
				<p class="text-[11.5px] font-medium text-muted">{ i18n.T(ctx, "sql.tree.title") }</p>
				// COLLAPSING IS A CONTROL, not a drag to zero. A rail dragged
				// to nothing is a rail with no handle left to drag back.
				<button
					type="button"
					data-rail-toggle
					aria-expanded="true"
					aria-controls="objects"
					aria-label={ i18n.T(ctx, "sql.tree.collapse") }
					class="rounded-card px-1 py-0.5 text-muted hover:bg-surface-2 hover:text-ink"
				>&#8676;</button>
			</div>
			<form method="get" action="/sql" data-connection-pick class="mb-2">
				<label class="flex items-center gap-2 rounded-card border border-line bg-surface px-2 py-1">
					if on := v.Running(); on != "" {
						@components.Logo(kindLogo(kindOf(on)), 16)
					}
					<span class="sr-only">{ i18n.T(ctx, "sql.tree.connection") }</span>
					<select name="connection" class="min-w-0 flex-1 bg-transparent py-0.5 font-mono text-xs text-ink focus:outline-none">
						for _, w := range v.Warehouses() {
							if !Queryable(w.Target) {
								<option value={ w.Target } disabled>{ warehouseLabel(ctx, w) }</option>
							} else if v.Active(w) {
								<option value={ w.Target } selected>{ warehouseLabel(ctx, w) }</option>
							} else {
								<option value={ w.Target }>{ warehouseLabel(ctx, w) }</option>
							}
						}
					</select>
				</label>
				<button type="submit" data-no-js class="mt-1 rounded-card border border-line px-2 py-0.5 text-[0.7rem] text-ink hover:bg-surface-2">{ i18n.T(ctx, "sql.tree.open") }</button>
				if kinds := v.Unreadable(); len(kinds) > 0 {
					<p class="mt-1 px-1 text-[0.7rem] text-muted">{ i18n.T(ctx, "sql.tree.unreadable", "kinds", unreadableSaid(ctx, kinds)) }</p>
				}
			</form>
			// THE SEARCH FILTERS WHAT IS LOADED: the chosen connection's
			// listing, which is on the page. Without the island it is an
			// ordinary field that does nothing, so it is marked rather than
			// drawn eagerly: `data-tree-search` is what the script looks for.
			<input
				type="search"
				data-tree-search
				placeholder={ i18n.T(ctx, "sql.tree.filter") }
				aria-label={ i18n.T(ctx, "sql.tree.filter") }
				class="mb-2 w-full rounded-card border border-line bg-surface px-2 py-1 text-xs text-ink placeholder:text-muted"
			/>
			if on := v.Running(); on != "" {
				<div data-connection={ on }>
					<div data-objects={ v.Target }>
						@Objects(v.Branch())
					</div>
				</div>
			}
		</aside>
	}
}

// Objects is one connection's listing: its schemas, their relations, and the
// columns of whichever relation the SERVER was told to open.
//
// EXPORTED, because `/api/sql/objects` draws exactly this when the island
// opens a connection. Two pieces of markup for one tree is how the classes,
// the ARIA and the sentence about a warehouse that cannot say drift apart.
templ Objects(b Branch) {
	for _, s := range b.Tree {
		<details class="mb-0.5" open>
			<summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-card px-2 py-1 text-muted hover:bg-surface-2 hover:text-ink">
				@schemaIcon()
				<span class="min-w-0 truncate">{ s.Name }</span>
			</summary>
			for _, t := range s.Tables {
				<div data-relation={ s.Name + "." + t }>
					// THE TABLE IS ITS FIRST LOOK: the island puts this SELECT
					// in the editor -- in the open tab when it is empty, in a
					// new one when it is not -- and opens the columns. Without
					// the island it is still a readable list, which is the
					// point of putting the name in the text.
					<button
						type="button"
						data-select={ selectOf(s.Name, t) }
						data-relation-name={ s.Name + "." + t }
						class="flex w-full items-center gap-1.5 rounded-card px-2 py-1 pl-5 text-left font-mono text-muted hover:bg-surface-2 hover:text-ink"
					>
						// The span truncates, not the button: a flex row
						// that truncates cuts the icon before the name.
						@tableIcon()
						<span class="min-w-0 truncate">{ t }</span>
					</button>
					// AND A SECOND BUTTON, which SUBMITS THE FORM.
					//
					// Not a link: a GET would discard the textarea, so
					// somebody with a half-written query who opened a
					// table to remember a column name would lose it.
					// `form` points at the editor's form by id, so this
					// button can sit here in the tree and still carry
					// the statement in that form's body -- which is also
					// the only place a statement is allowed to travel.
					//
					// The island answers this click instead, and then
					// nothing reloads and nothing closes.
					//
					// Indented to the table's NAME, past its icon:
					// pl-5 + the icon's 0.75rem + the 0.375rem gap.
					<button
						type="submit"
						form="workbench"
						name="expand"
						value={ s.Name + "." + t }
						data-connection={ b.Target }
						aria-expanded={ openOf(b, s.Name, t) }
						class="block w-full rounded-card px-2 py-0.5 pl-[2.375rem] text-left text-[0.7rem] text-muted hover:text-ink"
					>
						if b.Open == s.Name+"."+t {
							&#8722; { i18n.T(ctx, "sql.tree.columns") }
						} else {
							+ { i18n.T(ctx, "sql.tree.columns") }
						}
					</button>
					<div data-columns={ s.Name + "." + t }>
						if b.Open == s.Name+"."+t {
							@Columns(b.Cols)
						}
					</div>
				</div>
			}
		</details>
	}
	if b.Cut {
		<p class="mt-2 px-2 text-[0.7rem] text-muted">{ i18n.T(ctx, "sql.tree.cut") }</p>
	}
}

// schemaIcon is a cylinder in front of a schema's name. In text a schema and
// a table look alike -- the same colour, the same size -- and in a schema of
// forty tables the eye cannot find where one ends; the shape tells them apart
// without a second colour to keep readable on every installation's ground.
//
// `currentColor`, so it follows the row's own colour and its hover.
// `aria-hidden`, because the <summary> already says what it is.
templ schemaIcon() {
	<svg data-icon="schema" class="h-3 w-3 shrink-0" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
		<ellipse cx="6" cy="3" rx="4" ry="1.5"></ellipse>
		<path d="M2 3v6c0 .8 1.8 1.5 4 1.5s4-.7 4-1.5V3"></path>
	</svg>
}

// tableIcon is a grid in front of a table's name, for the same reason and on
// the same terms as schemaIcon. One shape for a table and a view: the
// catalog hands the tree a name and not a kind.
templ tableIcon() {
	<svg data-icon="table" class="h-3 w-3 shrink-0" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
		<rect x="1.5" y="2" width="9" height="8" rx="1"></rect>
		<path d="M1.5 5h9M5 5v5"></path>
	</svg>
}

// Columns is what one relation holds, drawn by the page and by
// `/api/sql/columns` from the same definition.
//
// `data-column` IS FOR THE COMPLETION, and it is an attribute rather than
// the text of a span because the island would otherwise read a column name
// by picking which of two spans holds it. The tree already names its
// relations the same way, for the filter.
templ Columns(cols []sqlserve.Column) {
	// Under the table's name, like `+ columns`: 2.375rem less each row's own px-2.
	<ul class="mb-1 pl-[1.875rem]">
		for _, c := range cols {
			<li class="flex justify-between gap-2 px-2 py-0.5 font-mono text-[0.7rem]" data-column={ c.Name }>
				<span class="truncate text-ink">{ c.Name }</span>
				<span class="shrink-0 text-muted">{ c.Type }</span>
			</li>
		}
		if len(cols) == 0 {
			<li class="px-2 py-0.5 text-[0.7rem] text-muted">{ i18n.T(ctx, "sql.tree.no_columns") }</li>
		}
	</ul>
}

// Cost is the line under the editor: what a statement would process, before
// anybody presses Run.
//
// THREE STATES AND NOT TWO. A figure is a figure; a refusal is a problem
// with the SQL and is drawn as one; and a warehouse that does not price a
// query before it runs is NEITHER -- nothing is wrong, there is simply no
// number. Drawing the third like the second would teach somebody on Postgres
// to ignore this line, which is where the ceiling's refusal also appears.
//
// THE SENTENCE IS THE SERVICE'S OWN, carried through unchanged. The ceiling
// refuses with the same words at Run, and a console that reworded them would
// drift from what actually happens.
templ Cost(p sqlserve.Price) {
	if p.State == "priced" {
		<span data-cost-state="priced">
			This query will process <strong class="font-medium text-ink">{ bytesText(p.Bytes) }</strong> when run.
		</span>
	} else if p.State == "unpriced" {
		<span data-cost-state="unpriced">{ p.Why }</span>
	} else {
		<span data-cost-state="refused" class="text-state-failed">{ p.Why }</span>
	}
}

// results is the answer: two tabs, a grid and a pager.
//
// TWO TABS, AND THE REFERENCE'S OTHER FOUR ARE NOT DRAWN. BigQuery's panel
// offers Job information, Visualization, Execution details and Execution
// graph. Those are its JOB MODEL, which `serve` does not have -- drawing
// them would be four promises this console cannot keep, and an empty tab is
// worse than an absent one because somebody clicks it.
templ results(v SQLView) {
	<div class="flex h-full min-h-0 flex-col">
		<div class="flex shrink-0 items-center gap-1 border-b border-line-soft" role="tablist" aria-label="How to read the answer">
			<button
				type="button"
				role="tab"
				data-tab="results"
				aria-selected="true"
				class="results-tab px-3 py-1.5 text-xs text-muted"
			>Results</button>
			<button
				type="button"
				role="tab"
				data-tab="json"
				aria-selected="false"
				class="results-tab px-3 py-1.5 text-xs text-muted"
			>JSON</button>
			// MARKED, because a test comparing the rail's figures with this
			// sentence has to find THIS sentence. Searching the document for
			// the figures finds the attribute the rail reads, which is the
			// same string and proves nothing.
			<p data-note class="ml-auto pr-1 text-[0.7rem] text-muted">{ v.Note() }</p>
			// THE ANSWER, TAKEN AWAY: CSV built in the browser from the JSON
			// panel below, so no second query and no route. Hidden until the
			// island can drive it, and absent for a write, whose answer is a
			// sentence and not a table.
			if !v.Result.Wrote {
				<span data-js>
					@components.Button(components.ButtonSecondary, components.SizeSmall, templ.Attributes{"data-export-csv": true}) {
						@components.Icon("download", "h-3.5 w-3.5")
						CSV
					}
				</span>
			}
		</div>
		<div class="min-h-0 flex-1 overflow-auto" data-panel="results">
			if v.Result.Wrote {
				// A WRITE GETS A SENTENCE AND NOT A GRID.
				//
				// The service answers a write with no columns and no rows,
				// and the grid draws that as a table with no headings and
				// "No rows." under them -- which reads as "it found nothing"
				// for a statement that was never looking. An absent table is
				// nothing to interpret; an empty one is.
				<p data-changed class="px-3 py-4 text-sm text-ink">{ v.Changed() }</p>
			} else {
				@resultGrid(v.Result.Columns, v.Result.Rows)
			}
		</div>
		<div class="min-h-0 flex-1 overflow-auto" data-panel="json" hidden>
			<pre class="p-2 font-mono text-[0.7rem] whitespace-pre text-ink">{ v.JSON() }</pre>
		</div>
		// THE PAGER IS AN ENHANCEMENT, AND IT IS HIDDEN UNTIL SOMETHING CAN
		// DRIVE IT.
		//
		// It pages over rows that have already arrived: no second query, no
		// link, no form. Without the island every row is on the page, which
		// is what this screen did before -- rather than a row of buttons
		// that do nothing, which is the shape this console refuses.
		<div
			class="flex shrink-0 items-center justify-end gap-2 border-t border-line-soft px-2 py-1 text-[0.7rem] text-muted"
			data-pager
			data-total={ Total(len(v.Result.Rows), v.Result.Truncated) }
			data-per-page="50"
			hidden
		>
			<label class="flex items-center gap-1">
				Rows per page
				<select data-per-page-pick class="rounded border border-line bg-surface px-1 py-0.5 text-[0.7rem] text-ink">
					<option value="50">50</option>
					<option value="100">100</option>
					<option value="500">500</option>
				</select>
			</label>
			<span data-pager-range class="tabular-nums"></span>
			<button type="button" data-pager-prev aria-label="Previous page" class="rounded px-1.5 py-0.5 hover:bg-surface-2 hover:text-ink">&#8249;</button>
			<button type="button" data-pager-next aria-label="Next page" class="rounded px-1.5 py-0.5 hover:bg-surface-2 hover:text-ink">&#8250;</button>
		</div>
	</div>
}

// resultGrid is the workbench's own grid.
//
// NOT `grid`, which the destination page uses for a ten-row glance: this one
// numbers its rows, keeps its heading while the body scrolls and is paged.
// What the two DO share is the cell, because a NULL has to look the same
// wherever it is drawn.
templ resultGrid(columns []string, rows [][]any) {
	<table class="w-full border-collapse text-xs">
		<thead>
			<tr class="text-left">
				// THE ROW NUMBER'S OWN HEADING IS EMPTY AND SAYS SO. A blank
				// <th> is a column a screen reader announces as nothing.
				<th class="results-rownum results-head w-px px-2 py-1 font-medium">
					<span class="sr-only">Row</span>
				</th>
				for _, c := range columns {
					// NO TYPE HERE, AND THAT IS MEASURED: `dialect.Result`
					// carries names and values and no types at all, so a
					// heading that showed one would be inventing it.
					<th class="results-head px-3 py-1 font-medium whitespace-nowrap">{ c }</th>
				}
			</tr>
		</thead>
		<tbody>
			for i, row := range rows {
				<tr class="border-t border-line-soft" data-row>
					<td class="results-rownum px-2 py-1 text-right tabular-nums" data-rownum>{ fmt.Sprint(i + 1) }</td>
					for _, c := range row {
						@resultCell(c)
					}
				</tr>
			}
			if len(rows) == 0 {
				<tr>
					<td class="px-3 py-2 text-muted" colspan={ fmt.Sprint(len(columns) + 1) }>No rows.</td>
				</tr>
			}
		</tbody>
	</table>
}

// resultCell draws one value, and says which kind of nothing it is.
templ resultCell(v any) {
	if v == nil {
		<td class="px-3 py-1 whitespace-nowrap"><span class="text-muted italic">null</span></td>
	} else if Numeric(v) {
		<td class="px-3 py-1 text-right font-mono tabular-nums whitespace-nowrap text-ink">{ Cell(v) }</td>
	} else {
		<td class="px-3 py-1 font-mono whitespace-nowrap text-ink">{ Cell(v) }</td>
	}
}

// sqlStatus is the top bar's state for the workbench: "Writes allowed" on a
// connection that may change data, and nothing on a read-only one -- the
// default, where a badge on every visit would be one nobody reads.
func sqlStatus(v SQLView) templ.Component {
	if !v.Writable {
		return nil
	}
	return writesAllowed()
}

templ writesAllowed() {
	<span data-mode="write" class="inline-flex items-center gap-1.5 rounded-card bg-state-queued/13 px-2 py-0.5 text-xs font-medium text-state-queued">
		@components.Icon("triangle-alert", "h-3.5 w-3.5")
		Writes allowed
	</span>
}
