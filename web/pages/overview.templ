package pages

import (
	"fmt"
	"net/url"
	"time"

	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/i18n"
	"github.com/AreteAcademy/brevis/web/layouts"
)

// Overview is the screen that answers, at a glance and in this order, what
// needs the reader, how the runs are going, what fires next and what just
// happened (screen-overview).
templ Overview(d OverviewData) {
	@layouts.Base(layouts.Page{Title: i18n.T(ctx, "overview.title"), Active: "overview", Actions: windowToggle(d.Window)}) {
		<p class="mb-3 -mt-1 max-w-3xl text-[13px] text-muted">{ i18n.T(ctx, "overview.lede") }</p>
		// The section follows itself every ten seconds: a rerun shows as
		// going, and the item leaves once its workflow passes.
		<div id="attention" data-live="/overview/attention" data-live-every="10000">
			@attention(d.Attention, d.Now)
		</div>
		<div data-kpis>
			@components.Stats(overviewKPIs(ctx, d))
		</div>
		// THE CHART AND WHAT RUNS NEXT, SIDE BY SIDE (screen-overview-v2 OV3):
		// the donut's four counts are in the strip now.
		<div class="mt-3 grid grid-cols-1 gap-3 xl:grid-cols-[1fr_380px]">
			@components.Panel(chartTitle(d.Window), "") {
				<div class="px-3.5 py-3">
					<p class="mb-3 text-[12.5px] text-muted">
						Count and average duration over the { d.Window.Label }.
					</p>
					@components.RunsChart(d.Buckets)
				</div>
			}
			@nextTriggers(d)
		</div>
		// IN PROGRESS ONLY WHEN SOMETHING RUNS (screen-overview-v2 OV4): the
		// head says "nothing running" otherwise.
		<section class="mt-3">
			@components.PanelLink("Recent runs", "", "/runs", "see all") {
				@runsTableWith(d.Recentes, Pagination{}, runsOpts{Workflow: true, Bare: true})
			}
		</section>
	}
}

// attention is "Needs your attention", always the first section: each
// workflow whose last run failed, with why in one line and the way to its
// log -- or, when there is none, a card that says all is well, since an
// empty space reads as a section that failed to load.
templ attention(a Attention, now time.Time) {
	<section data-attention class="mb-3">
		if a.Total() == 0 {
			<div data-attention-empty class="flex items-start gap-3 rounded-card border border-state-success/30 bg-state-success/5 px-4 py-3">
				@components.Icon("check", "mt-0.5 h-4 w-4 shrink-0 text-state-success")
				<div>
					<p class="text-[13.5px] font-medium text-ink">{ i18n.T(ctx, "overview.attention.none") }</p>
					<p class="mt-0.5 text-[12.5px] text-muted">{ i18n.T(ctx, "overview.attention.none_hint") }</p>
				</div>
			</div>
		} else {
			<div class="overflow-hidden rounded-card border border-state-failed/40 bg-state-failed/5">
				<header class="flex flex-wrap items-baseline gap-x-2 gap-y-1 border-b border-state-failed/20 px-4 py-2.5">
					@components.Icon("triangle-alert", "h-4 w-4 shrink-0 self-center text-state-failed")
					<h2 class="text-[14px] font-medium text-ink">{ i18n.T(ctx, "overview.attention") }</h2>
					<span class="font-mono text-[12px] text-muted tabular-nums">{ fmt.Sprint(a.Total()) }</span>
					<span class="text-[12.5px] text-muted">{ i18n.T(ctx, "overview.attention.hint") }</span>
				</header>
				<ul>
					for _, it := range a.Items {
						<li data-attention-item={ it.Workflow } class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-state-failed/15 px-4 py-3 last:border-b-0">
							@components.Dot("failed")
							<div class="min-w-0 flex-1">
								<p class="text-[13px]">
									<span class="font-mono text-ink">{ it.Workflow }</span>
									<span class="ml-1 text-[12.5px] text-muted">
										{ i18n.T(ctx, "overview.failed") } { i18n.Since(ctx, now, it.FailedAt) }
										if s := streakText(ctx, it.Streak); s != "" {
											· { s }
										}
									</span>
								</p>
								if it.Cause != nil {
									<p class="mt-0.5 truncate text-[12.5px] text-ink-2">
										{ whyTitle(ctx, it.Cause) }
										if it.Cause.Line != "" {
											— <code class="font-mono text-[12px] text-state-failed">{ it.Cause.Line }</code>
										}
									</p>
								}
							</div>
							<div class="flex shrink-0 items-center gap-2">
								<a href={ templ.SafeURL("/runs/" + it.RunID.String() + "#logs") } class={ components.ButtonClass(components.ButtonSecondary, components.SizeSmall) }>{ i18n.T(ctx, "overview.view_log") }</a>
								if it.Rerunning != "" {
									<a href={ templ.SafeURL("/runs/" + it.Rerunning) } class="inline-flex items-center gap-1.5 text-[12.5px] text-state-running hover:underline">
										@components.Dot("running")
										{ i18n.T(ctx, "overview.rerunning") }
									</a>
								} else if it.Rerunnable {
									<form method="post" action={ templ.SafeURL("/workflows/" + it.Workflow + "/trigger") }>
										<input type="hidden" name="back" value="/"/>
										for _, k := range sortedKeys(it.Params) {
											<input type="hidden" name={ "param." + k } value={ it.Params[k] }/>
										}
										<button type="submit" class={ components.ButtonClass(components.ButtonSecondary, components.SizeSmall) }>
											@components.Icon("refresh-cw", "h-3 w-3")
											{ i18n.T(ctx, "overview.rerun") }
										</button>
									</form>
								}
							</div>
						</li>
					}
				</ul>
				if a.More > 0 {
					<a href="/runs?state=failed" class="block border-t border-state-failed/20 px-4 py-2 text-[12.5px] text-ink hover:underline">{ i18n.N(ctx, "overview.attention.more", a.More) } &rarr;</a>
				}
				if len(a.Targets) > 0 {
					<ul class="border-t border-state-failed/20">
						for _, tg := range a.Targets {
							<li data-attention-target={ tg.Target } class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-state-failed/15 px-4 py-3 last:border-b-0">
								@components.StatusMark(string(tg.Status))
								<div class="min-w-0 flex-1">
									<p class="text-[13px]">
										<span class="font-mono break-all text-ink">{ tg.Target }</span>
										<span class="ml-1 text-[12.5px] text-muted">{ components.StateWord(ctx, string(tg.Status)) }</span>
									</p>
									<p class="mt-0.5 text-[12.5px] text-ink-2">{ i18n.T(ctx, "overview.target.missed", "workflow", tg.Workflow, "when", i18n.Since(ctx, now, tg.Missed)) }</p>
								</div>
								<a href={ templ.SafeURL("/data/target?u=" + url.QueryEscape(tg.Target)) } class={ components.ButtonClass(components.ButtonSecondary, components.SizeSmall) }>{ i18n.T(ctx, "overview.open_catalog") }</a>
							</li>
						}
					</ul>
				}
				if a.TargetsMore > 0 {
					<a href="/data?status=attention" class="block border-t border-state-failed/20 px-4 py-2 text-[12.5px] text-ink hover:underline">{ i18n.N(ctx, "overview.target.more", a.TargetsMore) } &rarr;</a>
				}
			</div>
		}
	</section>
}

// AttentionLive is the section alone, for the page that follows it.
templ AttentionLive(a Attention, now time.Time) {
	<div data-live-target="attention">
		@attention(a, now)
	</div>
}
