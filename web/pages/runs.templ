package pages

import (
	"context"
	"fmt"
	"slices"
	"strings"
	"time"

	"github.com/AreteAcademy/brevis/internal/infrastructure/postgres"
	"github.com/AreteAcademy/brevis/web/components"
	"github.com/AreteAcademy/brevis/web/i18n"
	"github.com/AreteAcademy/brevis/web/layouts"
)

// RunsScreen is Runs as one screen (screen-runs): the list as a column, and
// beside it the run that is open. /runs opens the newest; /runs/{id} opens
// that one, on the list or not -- an alert from last week has to land on its
// run, not on whatever ran last.
type RunsScreen struct {
	Runs   []postgres.RunSummary
	Filter RunFilter
	Counts map[string]int
	Total  int

	// Logos is what each workflow on the page runs in, by slug.
	Logos map[string][]string

	// Detail is the open run; nil when there is none to open.
	Detail *RunPage
}

// open is the open run's id, "" with none.
func (s RunsScreen) open() string {
	if s.Detail == nil {
		return ""
	}
	return s.Detail.Run.ID.String()
}

// InFlight is what "Running" lists: a run waiting in the queue, or for its
// retry, is as unfinished as one whose step is going.
var InFlight = []string{"running", "queued", "retrying"}

// runsSegment is the column's three questions -- everything, what broke, what
// is still going -- each with the count its link would show.
func runsSegment(ctx context.Context, f RunFilter, counts map[string]int) []components.SegOption {
	all, going := 0, 0
	for s, n := range counts {
		all += n
		if slices.Contains(InFlight, s) {
			going += n
		}
	}
	return []components.SegOption{
		{Label: i18n.T(ctx, "runs.all"), Href: f.With("state", ""), Count: fmt.Sprint(all), Current: f.State == ""},
		{Label: i18n.T(ctx, "runs.failed"), Href: f.With("state", "failed"), Count: fmt.Sprint(counts["failed"]), Current: f.State == "failed"},
		{Label: i18n.T(ctx, "runs.in_flight"), Href: f.With("state", "running"), Count: fmt.Sprint(going), Current: f.State == "running"},
	}
}

// offSegment says the chosen state is one the segment does not offer -- a
// link from elsewhere to the canceled ones -- and so has to be shown, with
// its ×, as a filter of its own.
func offSegment(state string) bool {
	return state != "" && state != "failed" && state != "running"
}

// PageTo is page n with the filter kept; the first page carries no number,
// so the newest runs have one address.
func (f RunFilter) PageTo(n int) string {
	if n <= 1 {
		return f.url("page", "", false)
	}
	return f.WithPage(n)
}

// Open is the address of a run with this filter kept: opening a run must not
// lose the list it was picked from.
func (f RunFilter) Open(id string) string {
	return strings.Replace(f.url("", "", false), "/runs", "/runs/"+id, 1)
}

func runsCrumb(s RunsScreen) string {
	if s.Detail == nil {
		return ""
	}
	return runCrumb(s.Detail.Run)
}

// runsIsland is none: the graph's scripts come with the Steps tab
// (data-island-js on the graph), so a page opened on a log does not load
// React to show it.
func runsIsland(RunsScreen) layouts.Island {
	return layouts.Island{}
}

// Runs fills the shell, and each pane scrolls on its own: the list stays where
// it was while a long log is read beside it. Below 1000px the list goes on top.
templ Runs(s RunsScreen) {
	@layouts.Base(layouts.Page{
		Title: "Runs", Active: "runs", Fill: true, Crumb: runsCrumb(s), Island: runsIsland(s),
	}) {
		<div data-runs-screen class="-mx-3 -mb-10 flex min-h-0 flex-1 flex-col min-[860px]:-mx-6 min-[1001px]:flex-row">
			<aside data-runs-list class="flex max-h-[300px] shrink-0 flex-col border-b border-line min-[1001px]:max-h-none min-[1001px]:w-[340px] min-[1001px]:border-r min-[1001px]:border-b-0">
				<div class="flex items-center justify-between gap-3 px-4 pt-4 pb-2">
					<h1 class="text-[20px] leading-tight font-semibold tracking-[-0.018em] text-ink">
						Runs
						<span class="ml-1.5 font-mono text-[13px] font-normal text-muted tabular-nums">{ i18n.Number(ctx, int64(s.Total)) }</span>
					</h1>
					@liveSwitch()
				</div>
				<div id="runs-list" class="min-h-0 flex-1 overflow-y-auto">
					@RunsList(s)
				</div>
			</aside>
			<section id="run-pane" class="min-h-0 min-w-0 flex-1 overflow-y-auto px-3 pt-4 pb-10 min-[860px]:px-6">
				// With no run open the pane is blank: the column already says
				// why -- nothing ran yet, or the search found nothing -- and a
				// second message beside it would say it twice.
				if s.Detail != nil {
					@RunDetail(*s.Detail)
				}
			</section>
		</div>
	}
}

// RunPane is the open run alone, for the fragment (X-Brevis-Fragment:
// detail) that ui.js swaps in when another run is opened from the list.
templ RunPane(p RunPage) {
	@RunDetail(p)
}

// RunsList is the column's region: the search, the three questions, the runs
// and their pages. It is the fragment (X-Brevis-Fragment: rows) the Live
// switch fetches and swaps, so it marks the open run itself.
templ RunsList(s RunsScreen) {
	{{ f := s.Filter }}
	@runsSearch(f)
	<div class="flex flex-wrap items-center gap-2 px-4 pb-2">
		@components.Segmented("State", runsSegment(ctx, f, s.Counts))
		if offSegment(f.State) {
			@filterApplied("state", f.State, f.With("state", ""))
		}
		if f.Label != "" {
			@filterApplied("period", f.Label, f.With("from", "")+"&to=")
		}
	</div>
	if len(s.Runs) == 0 {
		if f.Active() {
			@components.Empty(i18n.T(ctx, "runs.none"), "")
		} else {
			@components.Empty("No run yet.", "brevis scheduler")
		}
	} else {
		<nav aria-label="Runs" class="border-t border-line-soft">
			for _, r := range s.Runs {
				@runItem(r, f, r.ID == s.open(), s.Logos[r.WorkflowSlug])
			}
		</nav>
		@runsPager(f, len(s.Runs), s.Total)
	}
}

// runsSearch is a form, so it works with no script; `/` reaches it from
// anywhere on the page. It keeps the state and the period chosen beside it.
templ runsSearch(f RunFilter) {
	<form method="get" action="/runs" role="search" class="px-4 pb-2">
		if f.State != "" {
			<input type="hidden" name="state" value={ f.State }/>
		}
		if f.De != "" {
			<input type="hidden" name="from" value={ f.De }/>
		}
		if f.Ate != "" {
			<input type="hidden" name="to" value={ f.Ate }/>
		}
		<label class="relative block">
			<span class="sr-only">{ i18n.T(ctx, "runs.search") }</span>
			@components.Icon("search", "pointer-events-none absolute top-1/2 left-2.5 h-3.5 w-3.5 -translate-y-1/2 text-faint")
			<input
				type="search"
				name="workflow"
				value={ f.Workflow }
				placeholder={ i18n.T(ctx, "runs.search") }
				data-hotkey="/"
				autocomplete="off"
				class="h-8 w-full rounded-card border border-line bg-surface pr-8 pl-8 text-[13px] text-ink placeholder:text-faint focus:border-line-strong focus:outline-none"
			/>
			<kbd class="pointer-events-none absolute top-1/2 right-2 -translate-y-1/2 rounded-[4px] border border-line px-1.5 font-mono text-[11px] text-faint">/</kbd>
		</label>
	</form>
}

// runsPager is Newer and Older: a column has no room for page numbers, and
// the list is read from the top.
templ runsPager(f RunFilter, shown, total int) {
	{{ first := (f.Page-1)*f.PerPage + 1 }}
	<div class="flex items-center justify-between gap-3 px-4 py-3 text-xs text-muted">
		if f.Page > 1 {
			<a href={ templ.SafeURL(f.PageTo(f.Page - 1)) } class="text-ink hover:underline">{ i18n.T(ctx, "runs.newer") }</a>
		} else {
			<span></span>
		}
		<span class="tabular-nums">{ i18n.T(ctx, "runs.range", "first", first, "last", first+shown-1, "total", total) }</span>
		if f.Page*f.PerPage < total {
			<a href={ templ.SafeURL(f.PageTo(f.Page + 1)) } class="text-ink hover:underline">{ i18n.T(ctx, "runs.older") }</a>
		} else {
			<span></span>
		}
	</div>
}

// runItem is one line to scan: the state's shape, the workflow, how long
// ago, the slot's hour and how long it took -- or that it is still running.
// The open one is marked by a bar on its edge as well as a background, so it
// does not depend on telling two greys apart.
templ runItem(r postgres.RunSummary, f RunFilter, current bool, logos []string) {
	<a
		href={ templ.SafeURL(f.Open(r.ID)) }
		data-run-id={ r.ID }
		data-status={ r.Status }
		if current {
			aria-current="true"
		}
		class="grid grid-cols-[14px_minmax(0,1fr)_auto] items-center gap-x-2.5 gap-y-0.5 border-b border-line-soft px-4 py-2.5 transition-colors hover:bg-surface-2 aria-[current=true]:bg-surface-2 aria-[current=true]:shadow-[inset_2px_0_0_var(--color-ink)]"
	>
		<span class="row-span-2 flex justify-center">
			@components.Dot(r.Status)
		</span>
		<span class="flex min-w-0 items-center gap-1.5">
			for _, k := range logos {
				@components.Logo(k, 18)
			}
			<span class="truncate font-mono text-[13px] text-ink">{ r.WorkflowSlug }</span>
			@components.Retry(r.Attempt)
		</span>
		<span class="text-[11.5px] whitespace-nowrap text-faint">{ i18n.Since(ctx, time.Now(), r.CreatedAt) }</span>
		<span class="col-start-2 col-end-4 flex gap-2 font-mono text-[11.5px] text-muted tabular-nums">
			<span>{ itemHour(r) }</span>
			if r.Duration != nil {
				<span>{ i18n.Elapsed(ctx, *r.Duration) }</span>
			} else if r.Status == "running" {
				<span>{ i18n.T(ctx, "runs.running") }</span>
			}
		</span>
	</a>
}

// itemHour is the hour of the slot a run stands for, in UTC like every slot;
// a run with no slot (a manual one) gives the hour it was made.
func itemHour(r postgres.RunSummary) string {
	if r.LogicalDate != nil {
		return r.LogicalDate.UTC().Format("15:04")
	}
	return r.CreatedAt.UTC().Format("15:04")
}
