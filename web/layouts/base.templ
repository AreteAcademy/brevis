package layouts

import (
	"github.com/AreteAcademy/brevis/internal/auth"
	"github.com/AreteAcademy/brevis/internal/branding"
	"github.com/AreteAcademy/brevis/web/assets"
	"github.com/AreteAcademy/brevis/web/components"
)

// Base is the skeleton of every page.
//
// The design asks for SSR first, with interactive islands only where
// the interaction justifies one (React Flow, in PHASE 6). No SPA: the HTML
// arrives finished.
//
// The visual identity follows Arete Academy — warm parchment, gold and a serif
// for the titles. The tokens are in `web/assets/app.src.css`; here they are only
// composed.

// Page describes each screen's context. A struct rather than five positional
// parameters: by the time the fifth went in, the call had already become
// guesswork.
type Page struct {
	Title string

	// Kicker WAS the small-caps crumb above the title ("DASHBOARD"). It is no
	// longer drawn: the top bar's breadcrumb says where a page is, from the
	// same list the sidebar is drawn from, and a kicker above the title said
	// it a second time in other words. Kept until the screens that set it are
	// redesigned, so this change does not touch nine pages at once.
	Kicker string

	// Active matches a section's key in the sidebar (nav.go). It marks the
	// open section and is where the breadcrumb starts.
	Active string

	// Actions occupies the header's right-hand corner. Nil = no buttons.
	Actions templ.Component

	// Aside sits beside the title, for the one control that belongs to the
	// NAME rather than to the page -- today, the button that opens a
	// workflow's description. Nil draws nothing.
	//
	// Beside the title and not in Actions: Actions is where a page's verbs go
	// (run, retry), and a reader scanning for "what can I do here" should not
	// have to tell a verb from a footnote.
	Aside templ.Component

	// Eyebrow is a line ABOVE the title: what kind of thing the page is and
	// how it stands ("late · postgres", "GET · example-api"). Above and not
	// beside, so the title keeps the line to itself. Nil draws nothing.
	Eyebrow templ.Component

	// Mono draws the title in the machine's face, for a page whose name IS an
	// identifier -- a URI, a path -- that somebody will read character by
	// character and paste. It breaks anywhere instead of being cut short:
	// the end of a URI is usually the part that differs.
	Mono bool

	// Crumb is the breadcrumb's last item when it is not the title: an
	// identifier, drawn in mono -- the run page's "daily_sales · 2c7233f8",
	// so two tabs of one workflow read apart. Empty falls back to Title.
	Crumb string

	// TitleID gives the title an id, for a control that reads it (Copy URI).
	TitleID string

	// Status sits at the right of the top bar: a state of the whole screen
	// that should stay in sight however the page scrolls or its panes are
	// arranged -- the workbench's "Writes allowed". Nil draws nothing, which
	// is the default and should stay the common case.
	Status templ.Component

	// Island carries the extra assets of the interactive screens.
	Island Island

	// Fill gives the screen the whole viewport and stops the page itself
	// from scrolling, so each zone scrolls instead. The workbench asks; it
	// is an explorer, an editor and an answer, and a workbench whose panes
	// scroll off the bottom is three screens stacked.
	//
	// THIS IS NOT `Wide` COMING BACK. `Wide` was a default that won five
	// times by accident: nine screens could set it, five forgot, and nothing
	// on the screen said which was intended. This has ONE caller and the
	// opposite failure mode -- forgetting it gives a page that scrolls like
	// every other page, which is visible in a second, and a test refuses any
	// other screen asking for it.
	//
	// It is an ATTRIBUTE rather than a class because the rules behind it are
	// in app.src.css: a layout that depends on three utilities landing in the
	// right order is a layout nobody can read.
	Fill bool
}

// Island lists an interactive page's extra assets. It exists because only the DAG
// screen loads React (~350 KB): embedding that in Base would make every SSR page
// pay for an interactivity it does not use.
type Island struct {
	CSS []string
	JS  []string
}

templ Base(p Page) {
	{{ brand := branding.De(ctx) }}
	<!DOCTYPE html>
	<html lang="en" class="h-full" data-theme={ Theme(ctx) }>
		<head>
			// THE PAGE KNOWS A SCRIPT WILL RUN BEFORE IT IS DRAWN. One line,
			// first in the head and so ahead of any paint: `js` on <html> is
			// what shows the controls that need a script ([data-js]) from the
			// very first frame, and `data-hash` is what lets a page with tabs
			// draw the one the URL names first. Without it they were drawn
			// hidden and revealed by the deferred ui.js -- after a paint, on
			// every navigation where the HTML arrives in pieces -- and popped
			// in (nav-latency N6). No logic here: anything more is ui.js's.
			@templ.Raw(`<script>document.documentElement.classList.add("js");document.documentElement.dataset.hash=location.hash.slice(1)</script>`)
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title } · { brand.Title }</title>
			// Both fonts are served from the binary. The preload avoids the
			// layout jump on the serif title, which is the first thing the eye
			// goes to.
			<link rel="preload" href={ assets.URL("fonts/plex-sans-latin.woff2") } as="font" type="font/woff2" crossorigin/>
			// A VENDORED SHEET IS A DEFAULT, SO IT LOADS FIRST.
			//
			// It used to load last, and that is not an ordering preference:
			// `codemirror.css` writes `.CodeMirror { background:#fff; color:#000 }`
			// and this console writes the same selector with its own tokens.
			// Same specificity, same origin, both unlayered — the later file
			// wins. Every rule the editor's palette block contained was dead,
			// and the editor was drawn light on a console whose canvas is
			// #141711.
			for _, href := range p.Island.CSS {
				<link rel="stylesheet" href={ href }/>
			}
			<link rel="stylesheet" href={ assets.URL("app.css") }/>
			// The client's theme AFTER the compiled sheet: they are the same
			// variables Tailwind emits, and every utility resolves its colour
			// through `var(--color-*)` — overriding them here repaints the whole
			// interface with no CSS recompile. It comes out empty when the theme
			// is the default.
			if css := brand.CSS(); css != "" {
				@templ.Raw("<style>" + css + "</style>")
			}
		</head>
		<body class="h-full font-sans text-ink antialiased">
			<div class="flex h-full">
				@sidebar(p.Active, brand)
				<div class="flex h-full min-w-0 flex-1 flex-col">
				@topbar(p)
				<main class="flex-1 overflow-y-auto" data-fill?={ p.Fill }>
					// THE PAGE'S OWN HEADER: one title, large, and the page's
					// verbs beside it. Where the page is lives in the top bar
					// now, so this no longer repeats it in small caps.
					// A FILL PAGE DRAWS NO PAGE HEADER: its panes take the height,
					// and the breadcrumb already says where it is.
					if !p.Fill {
					<header data-page-header class="px-3 pt-4 pb-3 min-[860px]:px-6 min-[860px]:pt-5">
						<div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
							<div class="min-w-0">
								if p.Eyebrow != nil {
									<div class="mb-1.5 flex flex-wrap items-center gap-2">
										@p.Eyebrow
									</div>
								}
								<div class="flex items-center gap-2">
									if p.Mono {
										<h1
											if p.TitleID != "" {
												id={ p.TitleID }
											}
											class="font-mono text-[18px] leading-tight font-medium tracking-[-0.01em] break-all text-ink">{ p.Title }</h1>
									} else {
										<h1
											if p.TitleID != "" {
												id={ p.TitleID }
											}
											class="truncate text-[20px] leading-tight font-semibold tracking-[-0.018em] text-ink">{ p.Title }</h1>
									}
									if p.Aside != nil {
										@p.Aside
									}
								</div>
							</div>
							if p.Actions != nil {
								<div class="flex shrink-0 items-center gap-2">
									@p.Actions
								</div>
							}
						</div>
					</header>
					}
					// THE SCREEN GETS THE WINDOW, and a measure is a
					// BLOCK's decision from here on.
					//
					// This used to be `if p.Wide`, a flag four screens
					// remembered and five forgot: Overview, Runs, Projects,
					// Data and Destination were capped at 1400px while
					// Workflows, the two DAG screens and /sql used the glass.
					// Nothing in the code said which was intended -- the
					// default simply won five times, which is how a default
					// becomes a decision nobody made.
					//
					// So a narrow measure now sits on the block it is about,
					// beside the prose it exists for, where the next person
					// can see what it is protecting.
					<div class="px-3 pb-10 min-[860px]:px-6">
						{ children... }
					</div>
				</main>
				</div>
			</div>
			@palette()
			@shortcuts()
			@toasts()
			// The basic interactions (dialogs, chart tooltips) on every page. It
			// sits at the end of the body so it does not block rendering — the
			// HTML already arrives complete, the script only enriches it.
			<script src={ assets.URL("ui.js") } defer></script>
			@templ.Raw(`<script type="speculationrules">` + speculationRules + `</script>`)
			// Then, in order: React's UMD builds have to exist before the shim,
			// and the shim before React Flow's bundle.
			for _, src := range p.Island.JS {
				<script src={ src }></script>
			}
		</body>
	</html>
}

// accountMenu is the bar's right-hand button and its dropdown.
templ accountMenu(operator string, brand branding.Brand) {
	<details class="account-menu relative">
		<summary
			class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-card px-3 py-2 text-[0.82rem] text-muted transition-colors hover:bg-surface-2 hover:text-ink"
		>
			<span class="flex min-w-0 items-center gap-2">
				<svg class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
					<circle cx="8" cy="5.5" r="2.75"></circle>
					<path d="M2.5 14c0-2.6 2.5-4.2 5.5-4.2s5.5 1.6 5.5 4.2"></path>
				</svg>
				if operator != "" {
					<span class="truncate">{ operator }</span>
				} else {
					<span class="truncate">Account</span>
				}
			</span>
			// Rotates when the menu opens, which is the only thing that says
			// the button is a menu before it is clicked.
			<svg class="account-menu-arrow h-3.5 w-3.5 shrink-0 transition-transform" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
				<path d="M4 10l4-4 4 4"></path>
			</svg>
		</summary>
		// IT OPENS UPWARDS, because it sits at the foot of the sidebar: a
		// dropdown from there would be drawn past the bottom of the window.
		// It dropped down for the while it lived in a top bar.
		<div class="absolute bottom-full left-0 z-20 mb-1 w-60 overflow-hidden rounded-card border border-line bg-surface shadow-warm">
			// The installation's phrase, INSIDE the menu.
			//
			// It used to sit in the sidebar's footer, where it was a paragraph
			// of prose between the navigation and a button -- read once, then
			// skipped forever, and taking vertical room from the only two
			// things down there anybody clicks. In here it is still the
			// customer's voice and it costs nothing until the menu is open.
			if rows := brand.Lines(); len(rows) > 0 {
				<p class="border-b border-line px-3 py-2.5 text-[0.75rem] leading-snug text-muted">
					for i, l := range rows {
						if i == 0 {
							{ "“" + l }
						} else {
							<br/>
							if i == len(rows)-1 {
								{ l + "”" }
							} else {
								{ l }
							}
						}
					}
					if len(rows) == 1 {
						{ "”" }
					}
				</p>
			}
			<div class="py-1">
			<a
				href={ templ.SafeURL(branding.DocsURL) }
				target="_blank"
				rel="noreferrer"
				class="flex items-center gap-2.5 px-3 py-2 text-[0.82rem] text-muted transition-colors hover:bg-surface-2 hover:text-ink"
			>
				<svg class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
					<path d="M3 2.5h6.5L13 6v7.5H3z"></path>
					<path d="M9.5 2.5V6H13"></path>
				</svg>
				Documentation
			</a>
			if operator != "" {
				<form method="post" action="/logout">
					// A POST, and not a link. A GET that signs somebody out is
					// a URL anybody can put in an <img> on another page.
					<button
						type="submit"
						class="flex w-full items-center gap-2.5 px-3 py-2 text-left text-[0.82rem] text-muted transition-colors hover:bg-surface-2 hover:text-ink"
					>
						<svg class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
							<path d="M6.5 13.5H3.5v-11h3"></path>
							<path d="M9.5 11l2.5-3-2.5-3"></path>
							<path d="M12 8H6"></path>
						</svg>
						Sign out
					</button>
				</form>
			}
			</div>
		</div>
	</details>
}

// sidebar is the console's frame: who it is, where to go, who you are.
//
// DOWN THE SIDE, which it was not. It moved to the top when the sections were
// few and one level deep; the redesign (2026-10-14) brought it back as three
// labelled groups with an icon per section, which one row cannot carry
// without crowding. It is the part of the screen that does not change between
// pages, and `app-sidebar` names it for the view transition so it holds still
// while the page beside it crossfades.
templ sidebar(active string, brand branding.Brand) {
	<aside id="app-sidebar" class="app-sidebar flex h-full w-[236px] shrink-0 flex-col border-r border-line-soft bg-canvas-subtle">
		<div class="flex h-13 shrink-0 items-center border-b border-line-soft pr-2">
		<a href="/" class="flex min-w-0 flex-1 items-center gap-2.5 px-4">
			if brand.Logo == branding.DefaultLogo {
				// Inline, so the symbol inherits the theme's colour.
				<span class="block h-6 w-6 shrink-0 text-accent">
					@templ.Raw(assets.LogoSVG)
				</span>
			} else if brand.Logo != "" {
				<img src={ brand.Logo } alt={ brand.Title } class="h-6 w-6 shrink-0 rounded-card object-contain"/>
			}
			<span class="display block truncate text-[1.05rem] leading-none text-ink">{ brand.Title }</span>
		</a>
		// Closes the drawer; only there when the sidebar is one. A link to
		// `#` so that, with no script, it clears the `:target` that opened it.
		<a
			href="#"
			data-drawer-close
			aria-label="Close navigation"
			class="flex h-8 w-8 items-center justify-center rounded-card text-muted transition-colors hover:bg-surface-2 hover:text-ink min-[860px]:hidden"
		>
			@components.Icon("x", "h-4 w-4")
		</a>
		</div>
		// THE PROJECT SWITCHER: the scope a reader works in, above the places
		// to go. It opens the list of projects, which is still a page.
		<div class="px-2.5 pt-3">
			<a
				href={ templ.SafeURL(projects.Href) }
				data-project-switcher
				data-tip={ projects.Tip }
				if active == projects.Key {
					aria-current="page"
				}
				class="flex h-8 w-full items-center gap-2 rounded-card border border-line px-2.5 text-[0.8rem] text-ink-2 transition-colors hover:border-line-strong hover:text-ink"
			>
				@components.Icon(projects.Icon, "h-3.5 w-3.5")
				<span class="flex-1 truncate">{ projects.Name }</span>
				@components.Icon("chevron-right", "h-3.5 w-3.5")
			</a>
		</div>
		// THE PALETTE'S OPENER, only where a script will drive it (data-js):
		// without one it would be a button that opens nothing.
		<span class="block px-2.5 pt-3" data-js>
			<button
				type="button"
				data-palette-open
				aria-haspopup="dialog"
				aria-controls="palette"
				class="flex h-8 w-full items-center gap-2 rounded-card border border-line bg-surface px-2.5 text-[0.8rem] text-muted transition-colors hover:border-line-strong hover:text-ink"
			>
				@components.Icon("search", "h-3.5 w-3.5")
				<span class="flex-1 truncate text-left">Search or jump to…</span>
				@components.Kbd("⌘K")
			</button>
		</span>
		<nav aria-label="Sections" class="flex-1 overflow-y-auto px-2.5 py-3">
			// A GROUP IS ANNOUNCED AS ONE -- `role="group"` with its name -- so
			// the label a sighted reader sees in small caps is heard too, and
			// the visible copy is hidden from a screen reader rather than read
			// twice.
			for _, g := range groups(ctx) {
				<div role="group" aria-label={ g.Name } class="mb-4 flex flex-col gap-0.5">
					<p aria-hidden="true" class="px-2.5 pb-1 text-[0.68rem] font-medium tracking-[0.08em] text-faint uppercase">{ g.Name }</p>
					for _, s := range g.Sections {
						@navLink(s, active)
					}
				</div>
			}
		</nav>
		// WHO YOU ARE, AT THE FOOT, which is where a console keeps "who am I
		// and how do I leave". The menu opens upwards from here.
		<div class="flex shrink-0 items-center gap-1 border-t border-line-soft p-2.5">
			<div class="min-w-0 flex-1">
				@accountMenu(auth.De(ctx), brand)
			</div>
			<span class="block shrink-0" data-js>
				<button
					type="button"
					data-dialogo="shortcuts"
					aria-label="Keyboard shortcuts"
					data-tip="Keyboard shortcuts (?)"
					class="flex h-8 w-8 items-center justify-center rounded-card text-muted transition-colors hover:bg-surface-2 hover:text-ink"
				>
					@components.Icon("keyboard", "h-4 w-4")
				</button>
			</span>
			@themeSwitch()
		</div>
	</aside>
	// The drawer's backdrop: a click on it closes the drawer. A sibling AFTER
	// the sidebar so `.app-sidebar:target ~` can show it with no script, and
	// out of the tab order -- the close button is the keyboard's way out.
	<a href="#" data-drawer-close class="app-drawer-backdrop" aria-hidden="true" tabindex="-1"></a>
}

// themeSwitch flips the theme in place and remembers it in the cookie the
// server reads. Only where a script will drive it (data-js): without one it
// would be a button that does nothing. Both glyphs are drawn and the CSS shows
// the one for the theme the click leads to, so the script only flips the
// attribute and the label.
templ themeSwitch() {
	<span class="block shrink-0" data-js>
		<button
			type="button"
			data-theme-toggle
			aria-label={ themeSwitchLabel(ctx) }
			title={ themeSwitchLabel(ctx) }
			class="flex h-8 w-8 items-center justify-center rounded-card text-muted transition-colors hover:bg-surface-2 hover:text-ink"
		>
			<span class="theme-to-light">@components.Icon("sun", "h-4 w-4")</span>
			<span class="theme-to-dark">@components.Icon("moon", "h-4 w-4")</span>
		</button>
	</span>
}

templ navLink(s section, active string) {
	if s.Key == active {
		// `aria-current` and not only the box: the shape says which section
		// to somebody looking at it, and this says it to everybody else.
		<a
			href={ templ.SafeURL(s.Href) }
			aria-current="page"
			data-tip={ s.Tip }
			if s.GoKey != "" {
				data-go-key={ s.GoKey }
			}
			class="flex h-8 items-center gap-2.5 rounded-card border border-line bg-surface-2 px-2.5 text-[0.85rem] font-medium text-ink"
		>
			@components.Icon(s.Icon, "h-4 w-4")
			{ s.Name }
		</a>
	} else {
		<a
			href={ templ.SafeURL(s.Href) }
			data-tip={ s.Tip }
			if s.GoKey != "" {
				data-go-key={ s.GoKey }
			}
			class="flex h-8 items-center gap-2.5 rounded-card border border-transparent px-2.5 text-[0.85rem] text-muted transition-colors hover:bg-surface-2 hover:text-ink"
		>
			@components.Icon(s.Icon, "h-4 w-4")
			{ s.Name }
		</a>
	}
}

// topbar says where the page is: the section's group, the section, and the
// page's own name when it is deeper than the section. The section links back
// to its list; the rest is text.
//
// NOT A SECOND `aria-current`. The sidebar already marks the open section,
// and a screen reader counting two "current page"s is told nothing.
templ topbar(p Page) {
	<header class="app-topbar flex h-13 shrink-0 items-center gap-3 border-b border-line-soft px-4 min-[860px]:px-6">
		// THE DRAWER'S OPENER, on a narrow screen only. A link to the
		// sidebar's id so `:target` opens it without a script; ui.js keeps
		// the URL clean, says `aria-expanded` and moves the focus.
		<a
			href="#app-sidebar"
			data-drawer-open
			aria-controls="app-sidebar"
			aria-expanded="false"
			aria-label="Open navigation"
			class="flex h-8 w-8 items-center justify-center rounded-card text-muted transition-colors hover:bg-surface-2 hover:text-ink min-[860px]:hidden"
		>
			@components.Icon("menu", "h-4 w-4")
		</a>
		if c, ok := where(ctx, p.Active, crumbTitle(p)); ok {
			<nav aria-label="Breadcrumb" class="flex min-w-0 items-center gap-1.5 text-[0.82rem]">
				if c.Group != "" {
					<span class="shrink-0 text-muted">{ c.Group }</span>
					<span aria-hidden="true" class="text-faint">/</span>
				}
				if c.Title != "" {
					<a href={ templ.SafeURL(c.Section.Href) } class="shrink-0 text-muted transition-colors hover:text-ink">{ c.Section.Name }</a>
					<span aria-hidden="true" class="text-faint">/</span>
					if p.Crumb != "" {
						<span class="truncate font-mono text-[0.78rem] text-ink">{ c.Title }</span>
					} else {
						<span class="truncate text-ink">{ c.Title }</span>
					}
				} else {
					<span class="truncate text-ink">{ c.Section.Name }</span>
				}
			</nav>
		}
		if p.Status != nil {
			<div class="ml-auto flex shrink-0 items-center gap-2">
				@p.Status
			</div>
		}
	</header>
}

// shortcuts lists the keyboard's ways around the console, opened by `?` or
// from the sidebar's foot. The section letters come from the sidebar's own
// list, so a section that is not drawn has no letter here either.
templ shortcuts() {
	@components.Modal("shortcuts", "Keyboard shortcuts", nil) {
		<dl class="grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-2.5 text-[0.85rem]">
			@shortcutRow("Search, jump to anything, or run an action") {
				@components.Kbd("⌘K")
			}
			@shortcutRow("Focus the list's search") {
				@components.Kbd("/")
			}
			for _, s := range goKeys(ctx) {
				@shortcutRow("Go to " + s.Name) {
					@components.Kbd("g")
					<span class="text-faint">then</span>
					@components.Kbd(s.GoKey)
				}
			}
			@shortcutRow("This list") {
				@components.Kbd("?")
			}
			@shortcutRow("Close a dialog, a drawer or the search") {
				@components.Kbd("Esc")
			}
		</dl>
		<p class="mt-4 text-[0.78rem] text-muted">None of these fire while you are typing in a field, except ⌘K and Esc.</p>
	}
}

templ shortcutRow(what string) {
	<dt class="flex items-center gap-1.5">{ children... }</dt>
	<dd class="text-ink-2">{ what }</dd>
}

// toasts is where a page says what just happened: a status region, so a
// screen reader hears each toast, at the corner of the window. The server
// draws a flash here (layouts.SetFlash); Brevis.toast adds the rest.
templ toasts() {
	<div id="toasts" role="status" aria-live="polite" class="toasts">
		if f, ok := flashOf(ctx); ok {
			@components.Toast(f.Kind, f.Message, "", "")
		}
	</div>
}

// paletteIcons are the glyphs the palette's rows are drawn with: the
// sections' own, and one per kind of thing it lists.
var paletteIcons = []string{"layout-grid", "workflow", "history", "database", "plug", "terminal", "folder", "sun"}

// palette is the command palette: a native <dialog>, closed, that ui.js opens
// on Cmd/Ctrl-K and fills from /api/palette.
//
// NATIVE, so focus containment, Escape and the backdrop come with the
// element. The input is a combobox over a listbox and names the active
// option (aria-activedescendant), because a screen reader cannot see a
// highlight. Rows and headings are <template>s, and the glyphs are drawn here
// once: Tailwind reads templates, and the island clones rather than writes.
templ palette() {
	<dialog id="palette" aria-label="Search the console" class="palette rounded-panel border border-line bg-surface p-0 text-ink shadow-warm">
		<div class="flex items-center gap-2 border-b border-line-soft px-3">
			<span class="text-muted">
				@components.Icon("search", "h-4 w-4")
			</span>
			<input
				id="palette-input"
				type="text"
				role="combobox"
				aria-controls="palette-list"
				aria-expanded="false"
				aria-autocomplete="list"
				aria-label="Search the console"
				placeholder="Search workflows, destinations, endpoints…"
				autocomplete="off"
				spellcheck="false"
				class="h-11 min-w-0 flex-1 bg-transparent text-sm text-ink placeholder:text-faint focus:outline-none"
			/>
			@components.Kbd("esc")
		</div>
		<div id="palette-list" role="listbox" aria-label="Results" class="max-h-[min(60vh,28rem)] overflow-y-auto p-1.5"></div>
		<div class="flex flex-wrap gap-x-4 gap-y-1 border-t border-line-soft px-3 py-2 text-[0.72rem] text-muted">
			<span class="flex items-center gap-1">@components.Kbd("↑↓") navigate</span>
			<span class="flex items-center gap-1">@components.Kbd("↵") open</span>
			<span class="flex items-center gap-1">@components.Kbd("⌘↵") in a new tab</span>
		</div>
		<template data-palette-row>
			<div
				role="option"
				aria-selected="false"
				class="flex cursor-pointer items-center gap-2.5 rounded-card px-2.5 py-1.5 text-[0.82rem] text-ink-2 aria-selected:bg-surface-2 aria-selected:text-ink"
			>
				<span data-palette-icon class="flex shrink-0 text-muted"></span>
				<span data-palette-label class="min-w-0 truncate"></span>
				<span data-palette-hint class="ml-auto shrink-0 truncate pl-3 font-mono text-[0.72rem] text-faint"></span>
			</div>
		</template>
		<template data-palette-group>
			<div role="presentation" class="px-2.5 pt-2.5 pb-1 text-[0.68rem] font-medium tracking-[0.08em] text-faint uppercase"></div>
		</template>
		<div data-palette-icon-set hidden>
			for _, name := range paletteIcons {
				<span data-icon={ name }>
					@components.Icon(name, "h-4 w-4")
				</span>
			}
		</div>
	</dialog>
}
