package layouts

import (
	"github.com/AreteAcademy/brevis/internal/auth"
	"github.com/AreteAcademy/brevis/internal/branding"
	"github.com/AreteAcademy/brevis/web/assets"
)

// Base is the skeleton of every page.
//
// Section 17 of the plan asks for SSR first, with interactive islands only where
// the interaction justifies one (React Flow, in PHASE 6). No SPA: the HTML
// arrives finished.
//
// The visual identity follows Arete Academy — warm parchment, gold and a serif
// for the titles. The tokens are in `web/assets/app.src.css`; here they are only
// composed.

// Pagina describes each screen's context. A struct rather than five positional
// parameters: by the time the fifth went in, the call had already become
// guesswork.
type Pagina struct {
	Titulo string

	// Kicker is the small-caps crumb above the title ("DASHBOARD", "WORKFLOWS").
	Kicker string

	// Ativo matches the menu item's key.
	Ativo string

	// Acoes occupies the header's right-hand corner. Nil = no buttons.
	Acoes templ.Component

	// Ilha carries the extra assets of the interactive screens.
	Ilha Ilha

	// Largo removes the width limit. The DAG uses the whole screen; text does
	// not.
	Largo bool
}

// Ilha lists an interactive page's extra assets. It exists because only the DAG
// screen loads React (~350 KB): embedding that in Base would make every SSR page
// pay for an interactivity it does not use.
type Ilha struct {
	CSS []string
	JS  []string
}

templ Base(p Pagina) {
	{{ marca := branding.De(ctx) }}
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Titulo } · { marca.Titulo }</title>
			// Both fonts are served from the binary. The preload avoids the
			// layout jump on the serif title, which is the first thing the eye
			// goes to.
			<link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/assets/fonts/cormorant-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/assets/app.css"/>
			// The client's theme AFTER the compiled sheet: they are the same
			// variables Tailwind emits, and every utility resolves its colour
			// through `var(--color-*)` — overriding them here repaints the whole
			// interface with no CSS recompile. It comes out empty when the theme
			// is the default.
			if css := marca.CSS(); css != "" {
				@templ.Raw("<style>" + css + "</style>")
			}
			for _, href := range p.Ilha.CSS {
				<link rel="stylesheet" href={ href }/>
			}
		</head>
		<body class="h-full font-sans text-ink antialiased">
			<div class="flex h-full">
				@sidebar(p.Ativo, marca)
				<main class="flex-1 overflow-y-auto">
					<header class="sticky top-0 z-10 border-b border-line bg-parchment-soft/85 px-10 py-6 backdrop-blur">
						<div class="flex items-end justify-between gap-6">
							<div>
								if p.Kicker != "" {
									<p class="kicker mb-1.5">{ p.Kicker }</p>
								}
								<h1 class="display text-3xl text-ink">{ p.Titulo }</h1>
							</div>
							if p.Acoes != nil {
								<div class="flex shrink-0 items-center gap-3">
									@p.Acoes
								</div>
							}
						</div>
					</header>
					if p.Largo {
						<div class="px-10 py-8">
							{ children... }
						</div>
					} else {
						<div class="mx-auto max-w-[1400px] px-10 py-8">
							{ children... }
						</div>
					}
				</main>
			</div>
			// The basic interactions (dialogs, chart tooltips) on every page. It
			// sits at the end of the body so it does not block rendering — the
			// HTML already arrives complete, the script only enriches it.
			<script src="/assets/ui.js" defer></script>
			// Then, in order: React's UMD builds have to exist before the shim,
			// and the shim before React Flow's bundle.
			for _, src := range p.Ilha.JS {
				<script src={ src }></script>
			}
		</body>
	</html>
}

type item struct {
	Rota  string
	Nome  string
	Chave string
}

templ sidebar(ativo string, marca branding.Marca) {
	<aside class="flex w-60 shrink-0 flex-col border-r border-line bg-surface/60">
		<div class="px-7 pt-7 pb-8">
			<a href="/" class="flex items-center gap-3">
				// h-9 matches the height of the serif title's box: the logo sits
				// with the text rather than competing with it.
				if marca.Logo == branding.LogoPadrao {
					// Inline, so the symbol inherits the theme's colour.
					<span class="block h-9 w-9 shrink-0 text-gold">
						@templ.Raw(assets.LogoSVG)
					</span>
				} else if marca.Logo != "" {
					<img src={ marca.Logo } alt={ marca.Titulo } class="h-9 w-9 shrink-0 rounded-lg object-contain"/>
				}
				<span class="display block text-[2rem] leading-none tracking-[0.02em] text-ink">{ marca.Titulo }</span>
			</a>
			if marca.Subtitulo != "" {
				<p class="kicker mt-2">{ marca.Subtitulo }</p>
			}
		</div>
		<nav class="flex-1 px-4">
			for _, i := range []item{
				{"/", "Overview", "overview"},
				{"/workflows", "Workflows", "workflows"},
				{"/runs", "Runs", "runs"},
				{"/projects", "Projects", "projects"},
			} {
				if i.Chave == ativo {
					<a
						href={ templ.SafeURL(i.Rota) }
						class="mb-1 flex items-center gap-3 rounded-xl border border-line-soft bg-gold-wash px-4 py-2.5 text-sm font-semibold text-ink"
					>
						<span class="h-4 w-[3px] rounded-full bg-gold"></span>
						{ i.Nome }
					</a>
				} else {
					<a
						href={ templ.SafeURL(i.Rota) }
						class="mb-1 flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm text-muted transition-colors hover:bg-gold-wash hover:text-ink"
					>
						<span class="h-4 w-[3px] rounded-full bg-transparent"></span>
						{ i.Nome }
					</a>
				}
			}
		</nav>
		// The footer: the client's phrase and, below it, the attribution. The
		// phrase's line break is preserved — it belongs to the author, and
		// turning it into a space would change the text's rhythm.
		//
		// It appears only when there is a session: in an installation with no
		// credential, a sign-out button would have nowhere to sign out of.
		if operador := auth.De(ctx); operador != "" {
			<form method="post" action="/logout" class="px-7 pb-5">
				<button
					type="submit"
					class="flex w-full items-center justify-between rounded-xl px-3 py-2 text-left text-xs text-muted transition-colors hover:bg-gold-wash hover:text-ink"
				>
					<span class="truncate">{ operador }</span>
					<span class="ml-3 shrink-0 tracking-wide uppercase">Sign out</span>
				</button>
			</form>
		}
		<div class="border-t border-line-soft px-7 py-6">
			if linhas := marca.Linhas(); len(linhas) > 0 {
				<p class="font-serif text-[0.95rem] leading-snug text-muted italic">
					for i, l := range linhas {
						if i == 0 {
							{ "“" + l }
						} else {
							<br/>
							if i == len(linhas)-1 {
								{ l + "”" }
							} else {
								{ l }
							}
						}
					}
					if len(linhas) == 1 {
						{ "”" }
					}
				</p>
			}
			// It does not come from the configuration — it comes from here. No
			// YAML value removes this line, and that is why it is not a field of
			// Marca.
			<a
				href="https://github.com/AreteAcademy/brevis"
				target="_blank"
				rel="noreferrer"
				class="mt-4 block text-[0.68rem] tracking-[0.1em] text-muted/60 uppercase transition-colors hover:text-gold-strong"
			>{ branding.Atribuicao }</a>
		</div>
	</aside>
}
