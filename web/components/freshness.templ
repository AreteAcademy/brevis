package components

// Freshness is a destination's or a writer's status against its schedule, in
// words as well as colour: the colour helps whoever sees it, the word works for
// everyone, screen readers and colour-blind operators included.
//
// A MARK AND A WORD (screen-load-v2 LV1), drawn by Status like State: the
// tinted badge was the last one density-base left on the screen.
templ Freshness(status string) {
	@Status(freshnessKind(status))
}

// FreshnessLabel is the word for a status, as the page and the summary say it.
func FreshnessLabel(s string) string {
	switch s {
	case "on_time":
		return "on time"
	case "late":
		return "late"
	case "stale":
		return "stale"
	case "paused":
		return "paused"
	case "continuous":
		return "continuous"
	case "unidentified":
		return "unidentified"
	}
	return "no schedule"
}

