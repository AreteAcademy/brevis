package components

import "fmt"

// Stats is a strip of numbers -- an endpoint's limits, a screen's headline
// figures -- in one bordered band rather than one card each, which is what
// lets four numbers be read as a row.
//
// A <dl>, because each number is the definition of its label. The hairlines
// between cells are the gap showing the line colour underneath, so they stay
// right however the cells wrap.
templ Stats(items []Stat) {
	<dl class={ "grid gap-px overflow-hidden rounded-card border border-line bg-line-soft", statsCols(len(items)) }>
		for _, s := range items {
			<div class="min-w-0 bg-surface px-3.5 py-2.5" title={ s.Title }>
				<dt class="flex items-center gap-1.5 text-[11.5px] whitespace-nowrap text-muted">
					if s.Dot != "" {
						<span class={ "h-[7px] w-[7px] shrink-0 rounded-full", s.Dot }></span>
					}
					if s.Icon != "" {
						@Icon(s.Icon, "h-3.5 w-3.5")
					}
					<span>{ s.Label }</span>
					if s.Sub != "" {
						<span class="text-faint">· { s.Sub }</span>
					}
				</dt>
				if s.Body != nil {
					<dd class="mt-1">
						@s.Body
					</dd>
				} else {
				<dd class="mt-[3px] flex flex-wrap items-baseline gap-x-1.5 text-[18px] leading-[1.2] font-semibold tracking-[-0.02em] text-ink tabular-nums">
					<span class={ s.Tone }>{ s.Value }</span>
					if s.Unit != "" {
						<span class="text-[11.5px] font-normal tracking-normal text-faint">{ s.Unit }</span>
					}
					if s.Note != "" {
						<span class="min-w-0 text-[11.5px] font-normal tracking-normal text-faint">{ s.Note }</span>
					}
				</dd>
				}
				if len(s.Bar) > 0 {
					<dd class="mt-[7px] flex h-1 gap-0.5 overflow-hidden rounded-sm bg-surface-2" aria-hidden="true">
						for _, seg := range s.Bar {
							<i class={ "block h-full", seg.Class } style={ seg.width() }></i>
						}
					</dd>
				}
			</div>
		}
	</dl>
}

// MethodPill is an HTTP method, as the protocol writes it. GET is green
// because it is the safe one -- the only one this console's endpoints serve.
templ MethodPill(method string) {
	<span class={ "inline-flex h-5 shrink-0 items-center rounded-card px-1.5 font-mono text-[0.68rem] font-semibold", methodClass(method) }>{ method }</span>
}

// TableFoot says how much of a list is on screen, and says "of" only when a
// filter is hiding part of it.
//
// The total and the noun ride along as data, so the list filter can say it
// again as rows are hidden without knowing how to pluralise anything.
templ TableFoot(shown, total int, noun string) {
	<div
		data-foot
		data-foot-total={ fmt.Sprint(total) }
		data-foot-noun={ noun }
		class="border-t border-line-soft px-4 py-2.5 text-[0.75rem] text-muted tabular-nums"
	>{ footText(shown, total, noun) }</div>
}

// DefinitionList is configuration: a term and its value, aligned in two
// columns. A machine's value is mono and may break anywhere -- a URI has no
// spaces to wrap at.
templ DefinitionList(rows []Def) {
	// The terms take what the longest one needs and no more: a fixed width
	// was half of a side column, and the values broke mid-word beside it.
	<dl class="grid grid-cols-[max-content_minmax(0,1fr)] gap-x-4 gap-y-2 text-[0.82rem]">
		for _, r := range rows {
			<dt class="text-muted">{ r.Term }</dt>
			if r.Mono {
				<dd class="font-mono text-[0.78rem] break-all text-ink">{ r.Value }</dd>
			} else {
				<dd class="text-ink">{ r.Value }</dd>
			}
		}
	</dl>
}

// CodeBlock is a block of code to read and to copy -- a curl, a command.
//
// THE COPY BUTTON IS HIDDEN UNTIL A SCRIPT CAN DRIVE IT. Without ui.js it
// would be a button that does nothing; the text is selectable either way.
// The id is the caller's, because the button copies by it.
//
// attrs go on the <pre>: what a script needs to keep the code current (the
// endpoint's curl follows its form).
templ CodeBlock(id, code string, attrs templ.Attributes) {
	<div class="relative">
		<pre id={ id } class="overflow-x-auto rounded-card border border-line bg-canvas-subtle p-3 pr-11 font-mono text-[0.75rem] leading-relaxed text-ink" { attrs... }><code>{ code }</code></pre>
		<span class="absolute top-1.5 right-1.5" data-js>
			@IconButton("Copy", "copy", templ.Attributes{"data-copy": "#" + id})
		</span>
	</div>
}

// KV is a dense key-value grid (density-base DB6): three to a row (one on a
// phone), each a mono key, its value and a faint note, with Copy on the
// value that shows on the cell's hover or focus. The hairlines are the gap
// showing the line colour, as in Stats.
templ KV(items []KVItem) {
	<div data-kv class="grid grid-cols-1 gap-px bg-line-soft min-[860px]:grid-cols-3">
		for _, it := range items {
			<div class="group min-w-0 bg-surface px-3.5 py-2">
				<div class="flex items-center gap-1.5 font-mono text-[11px] tracking-[0.02em] text-faint">
					{ it.Key }
					<span data-js class="ml-auto opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
						@CopyIcon("#kv-"+it.Key, "Copy "+it.Key)
					</span>
				</div>
				<div id={ "kv-" + it.Key } title={ it.Value } class="mt-0.5 truncate font-mono text-[12.5px] text-ink">{ it.Value }</div>
				if it.Note != "" {
					<div title={ it.Note } class="mt-px truncate text-[11.5px] text-faint">{ it.Note }</div>
				}
			</div>
		}
	</div>
}

// CopyIcon is the 18px Copy beside a value: the text of the element target
// names goes to the clipboard. The caller decides when it shows (a cell's
// hover, or always) and wraps it in `data-js`, since it needs the script.
templ CopyIcon(target, label string) {
	<button
		type="button"
		data-copy={ target }
		aria-label={ label }
		title={ label }
		class="flex h-[18px] w-[18px] items-center justify-center rounded-[4px] text-muted hover:bg-surface-2 hover:text-ink"
	>
		@Icon("copy", "h-3 w-3")
	</button>
}
