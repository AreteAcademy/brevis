package components

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/AreteAcademy/brevis/internal/infrastructure/postgres"
)

// Estado desenha o estado de um Run.
//
// The colours are desaturated on purpose: a dashboard's pure green and red fight
// the parchment and shout louder than the information. The shape carries meaning
// too — the dot is filled for what has finished and ringed for what is still
// alive — so it does not depend on colour alone.
templ Estado(status string) {
	<span class={ "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium", classeEstado(status) }>
		<span class={ "h-1.5 w-1.5 rounded-full", pontoEstado(status) }></span>
		{ rotuloEstado(status) }
	</span>
}

// Ponto is the minimal version, for dense tables where the label is already in
// the column.
templ Ponto(status string) {
	<span
		class={ "inline-block h-2.5 w-2.5 rounded-full", pontoEstado(status) }
		title={ rotuloEstado(status) }
	></span>
}

func rotuloEstado(s string) string {
	switch s {
	case "success":
		return "success"
	case "failed":
		return "failed"
	case "running":
		return "running"
	case "queued":
		return "queued"
	case "retrying":
		return "retrying"
	case "canceled":
		return "canceled"
	case "pending":
		return "pending"
	case "":
		return "never ran"
	}
	return s
}

func classeEstado(s string) string {
	switch s {
	case "success":
		return "border-state-success/25 bg-state-success/10 text-state-success"
	case "failed":
		return "border-state-failed/25 bg-state-failed/10 text-state-failed"
	case "running":
		return "border-state-running/25 bg-state-running/10 text-state-running"
	case "queued":
		return "border-state-queued/25 bg-state-queued/10 text-state-queued"
	case "retrying":
		return "border-state-retrying/25 bg-state-retrying/10 text-state-retrying"
	case "canceled":
		return "border-state-canceled/25 bg-state-canceled/10 text-state-canceled"
	}
	return "border-line bg-parchment text-muted"
}

func pontoEstado(s string) string {
	switch s {
	case "success":
		return "bg-state-success"
	case "failed":
		return "bg-state-failed"
	case "running":
		return "bg-state-running animate-pulse"
	case "queued":
		return "bg-state-queued"
	case "retrying":
		return "bg-state-retrying animate-pulse"
	case "canceled":
		return "bg-state-canceled"
	}
	return "bg-state-pending"
}

// Cartao e o painel base: superficie clara, borda fina, sombra quente e larga.
templ Cartao(rotulo string) {
	<section class="rounded-[20px] border border-line bg-surface p-6 shadow-warm-sm">
		if rotulo != "" {
			<p class="kicker mb-4">{ rotulo }</p>
		}
		{ children... }
	</section>
}

// Indicador is one of the four numbers at the top of the Overview. The large
// serif number is what sets the editorial tone — in sans it would become just
// another dashboard.
templ Indicador(rotulo, valor, nota string, matiz string) {
	<div class="rounded-[20px] border border-line bg-surface px-6 py-5 shadow-warm-sm">
		<p class="kicker">{ rotulo }</p>
		<p class={ "display mt-2 text-[2.6rem] leading-none", matiz }>{ valor }</p>
		if nota != "" {
			<p class="mt-2 text-xs text-muted">{ nota }</p>
		}
	</div>
}

// Vazio communicates the absence of data without looking like an error. An empty
// table with no explanation sends the operator looking for a defect where there
// is none.
templ Vazio(msg, dica string) {
	<div class="rounded-[20px] border border-dashed border-line px-6 py-12 text-center">
		<p class="font-serif text-lg text-muted">{ msg }</p>
		if dica != "" {
			<p class="mt-2 font-mono text-xs text-gold-strong">{ dica }</p>
		}
	</div>
}

// Etiqueta is a tag chip. It becomes a link when `rota` exists, to filter.
templ Etiqueta(texto, rota string) {
	if rota != "" {
		<a
			href={ templ.SafeURL(rota) }
			class="inline-flex rounded-full border border-line bg-parchment px-2 py-0.5 text-[0.7rem] text-muted transition-colors hover:border-gold hover:text-gold-strong"
		>{ texto }</a>
	} else {
		<span class="inline-flex rounded-full border border-line bg-parchment px-2 py-0.5 text-[0.7rem] text-muted">{ texto }</span>
	}
}

// ---------------------------------------------------------------------------
// Charts
//
// SVG generated on the server, with no library. They are two simple shapes over
// data that is already in hand; pulling a charting library in for this would
// bring a bundle and a runtime dependency §15 avoids — and the SSR keeps working
// for whoever turned JavaScript off.
// ---------------------------------------------------------------------------

const (
	larguraGrafico = 980
	alturaGrafico  = 240
	margemEsq      = 34
	margemBaixo    = 26
)

// Execucoes draws one stacked column per hour, with the average-duration line on
// top — the two readings the Overview screen has to cross: "how many" and
// "quanto tempo".
templ Execucoes(baldes []postgres.Balde) {
	if len(baldes) == 0 {
		@Vazio("No run in the window.", "brevis scheduler")
	} else {
		<div class="overflow-x-auto">
			<svg
				viewBox={ fmt.Sprintf("0 0 %d %d", larguraGrafico, alturaGrafico) }
				class="h-[240px] w-full min-w-[560px]"
				role="img"
				aria-label="Runs per hour"
			>
				// A horizontal grid: four lines are enough to give scale without
				// virar papel milimetrado.
				for _, l := range linhasDeGrade(baldes) {
					<line x1={ fmt.Sprint(margemEsq) } y1={ fmt.Sprint(l.Y) } x2={ fmt.Sprint(larguraGrafico) } y2={ fmt.Sprint(l.Y) } stroke="var(--color-ink)" stroke-opacity="0.08"></line>
					<text x="0" y={ fmt.Sprint(l.Y + 4) } class="fill-muted text-[11px]">{ l.Rotulo }</text>
				}
				for _, b := range barras(baldes) {
					// The whole column is the target, not just the bar: with a
					// single run the bar is 2px tall, and demanding exact aim
					// tornaria o grafico decorativo.
					<a href={ templ.SafeURL(b.Link) } class="grafico-alvo" data-dica={ b.Dica }>
						<rect class="grafico-faixa" x={ fmt.Sprint(b.XFaixa) } y="0" width={ fmt.Sprint(b.LarguraFaixa) } height={ fmt.Sprint(alturaGrafico - margemBaixo) } rx="3"></rect>
						<rect x={ fmt.Sprint(b.X) } y={ fmt.Sprint(b.YSucesso) } width={ fmt.Sprint(b.Largura) } height={ fmt.Sprint(b.HSucesso) } rx="2" fill="var(--color-state-success)"></rect>
						<rect x={ fmt.Sprint(b.X) } y={ fmt.Sprint(b.YFalha) } width={ fmt.Sprint(b.Largura) } height={ fmt.Sprint(b.HFalha) } rx="2" fill="var(--color-state-failed)"></rect>
						<rect x={ fmt.Sprint(b.X) } y={ fmt.Sprint(b.YOutros) } width={ fmt.Sprint(b.Largura) } height={ fmt.Sprint(b.HOutros) } rx="2" fill="var(--color-state-running)"></rect>
						<title>{ b.Dica }</title>
					</a>
				}
				if d := linhaDuracao(baldes); d != "" {
					<path d={ d } fill="none" stroke="var(--color-gold)" stroke-width="1.5" stroke-linejoin="round" opacity="0.9"></path>
					// The duration curve has a scale of its own (see linhaDuracao),
					// so without this anchor it would be a line with no unit: the
					// peak says what the highest point corresponds to.
					<text x={ fmt.Sprint(larguraGrafico) } y="12" text-anchor="end" class="fill-gold-strong text-[11px]">
						{ "peak average duration: " + Duracao(picoDuracao(baldes)) }
					</text>
				}
				for _, m := range marcasDeHora(baldes) {
					<text x={ fmt.Sprint(m.X) } y={ fmt.Sprint(alturaGrafico - 6) } text-anchor="middle" class="fill-muted text-[11px]">{ m.Rotulo }</text>
				}
			</svg>
		</div>
		<div class="mt-3 flex flex-wrap gap-4 text-xs text-muted">
			@legenda("var(--color-state-success)", "success")
			@legenda("var(--color-state-failed)", "failed")
			@legenda("var(--color-state-running)", "em curso")
			@legenda("var(--color-gold)", "average duration")
		</div>
	}
}

templ legenda(cor, texto string) {
	<span class="inline-flex items-center gap-1.5">
		<span class="h-2 w-2 rounded-full" style={ "background:" + cor }></span>
		{ texto }
	</span>
}

// Rosca resume a mesma janela em proporcao. O total no centro evita a leitura
// only relative: 95% of twenty runs is not 95% of two thousand.
templ Rosca(i postgres.Indicadores) {
	<div class="flex flex-col items-center">
		<svg viewBox="0 0 120 120" class="h-[190px] w-[190px]" role="img" aria-label="Run distribution">
			<circle cx="60" cy="60" r="46" fill="none" stroke="var(--color-ink)" stroke-opacity="0.07" stroke-width="16"></circle>
			for _, a := range arcos(i) {
				<a href={ templ.SafeURL(a.Link) } class="grafico-alvo" data-dica={ a.Dica }>
					<circle
						cx="60"
						cy="60"
						r="46"
						fill="none"
						stroke={ a.Cor }
						stroke-width="16"
						stroke-dasharray={ a.Dash }
						stroke-dashoffset={ fmt.Sprint(a.Offset) }
						transform="rotate(-90 60 60)"
					><title>{ a.Dica }</title></circle>
				</a>
			}
			<text x="60" y="58" text-anchor="middle" class="fill-ink font-serif text-[26px] font-semibold">{ fmt.Sprint(i.Total) }</text>
			<text x="60" y="74" text-anchor="middle" class="fill-muted text-[9px] tracking-[0.14em]">RUNS</text>
		</svg>
	</div>
}

// ---------------------------------------------------------------------------
// The shapes' arithmetic. It stays in Go, and not in the template, because a
// template with
// aritmetica no meio do markup e ilegivel e impossivel de testar.
// ---------------------------------------------------------------------------

type Barra struct {
	X, Largura         int
	XFaixa, LarguraFaixa int
	YSucesso, HSucesso int
	YFalha, HFalha     int
	YOutros, HOutros   int
	Dica               string
	Link               string
}

type Grade struct {
	Y      int
	Rotulo string
}

type Marca struct {
	X      int
	Rotulo string
}

// teto rounds the maximum up to a value divisible by 4 in "round" steps, so the
// tallest column does not touch the top AND the axis labels land on readable
// numbers.
//
// The previous version divided the raw maximum by four and produced axes like
// 0/6/12/18/25 — every label a different interval from the one before it.
func teto(baldes []postgres.Balde) int {
	max := 0
	for _, b := range baldes {
		if t := b.Total(); t > max {
			max = t
		}
	}
	if max == 0 {
		return 4
	}
	for _, passo := range []int{1, 2, 5, 10, 25, 50, 100, 250, 500, 1000, 2500, 5000} {
		if passo*4 >= max {
			return passo * 4
		}
	}
	// Above twenty thousand, it rounds up to the next thousand divisible by 4.
	return ((max + 3999) / 4000) * 4000
}

func linhasDeGrade(baldes []postgres.Balde) []Grade {
	max := teto(baldes)
	util := alturaGrafico - margemBaixo
	var out []Grade
	for i := 0; i <= 4; i++ {
		valor := max * i / 4
		out = append(out, Grade{
			Y:      util - util*i/4,
			Rotulo: fmt.Sprint(valor),
		})
	}
	return out
}

func barras(baldes []postgres.Balde) []Barra {
	max := teto(baldes)
	util := alturaGrafico - margemBaixo
	area := larguraGrafico - margemEsq
	passo := float64(area) / float64(len(baldes))
	largura := int(passo * 0.62)
	if largura < 2 {
		largura = 2
	}

	alt := func(n int) int {
		if n == 0 {
			return 0
		}
		h := n * util / max
		// A minimum pixel: a single failure among hundreds of successes still
		// has to be visible — it is the case where the chart matters most.
		if h < 2 {
			h = 2
		}
		return h
	}

	var out []Barra
	for i, b := range baldes {
		inicioFaixa := margemEsq + int(float64(i)*passo)
		x := inicioFaixa + (int(passo)-largura)/2
		hs, hf := alt(b.Sucesso), alt(b.Falha)
		ho := alt(b.Executando + b.Fila)

		base := util
		barra := Barra{
			X: x, Largura: largura,
			XFaixa: inicioFaixa, LarguraFaixa: int(passo),
			Dica: dicaDoBalde(b), Link: linkDoBalde(b),
		}
		base -= hs
		barra.YSucesso, barra.HSucesso = base, hs
		base -= hf
		barra.YFalha, barra.HFalha = base, hf
		base -= ho
		barra.YOutros, barra.HOutros = base, ho
		out = append(out, barra)
	}
	return out
}

// linkDoBalde leads to that exact hour in the run list. It is what turns the
// grafico em ponto de partida de investigacao: ver o pico de falhas e clicar
// nele, em vez de reconstruir o filtro a mao.
func linkDoBalde(b postgres.Balde) string {
	de := b.Inicio.UTC().Format(time.RFC3339)
	ate := b.Inicio.Add(time.Hour).UTC().Format(time.RFC3339)
	return "/runs?de=" + url.QueryEscape(de) + "&ate=" + url.QueryEscape(ate)
}

func dicaDoBalde(b postgres.Balde) string {
	partes := []string{b.Inicio.Local().Format("02/01 15h")}
	if b.Sucesso > 0 {
		partes = append(partes, fmt.Sprintf("%d success", b.Sucesso))
	}
	if b.Falha > 0 {
		partes = append(partes, fmt.Sprintf("%d failed", b.Falha))
	}
	if n := b.Executando + b.Fila; n > 0 {
		partes = append(partes, fmt.Sprintf("%d em curso", n))
	}
	if b.DuracaoMedia > 0 {
		partes = append(partes, "avg "+Duracao(&b.DuracaoMedia))
	}
	if len(partes) == 1 {
		return partes[0] + " · no runs"
	}
	return strings.Join(partes, " · ")
}

// picoDuracao is the curve's largest value — the secondary scale's reference.
func picoDuracao(baldes []postgres.Balde) *time.Duration {
	var maior time.Duration
	for _, b := range baldes {
		if b.DuracaoMedia > maior {
			maior = b.DuracaoMedia
		}
	}
	if maior == 0 {
		return nil
	}
	return &maior
}

// linhaDuracao normalizes the average duration by its OWN scale, not by the
// count's: they are different magnitudes, and what matters here is the curve's
// shape.
func linhaDuracao(baldes []postgres.Balde) string {
	var maior time.Duration
	for _, b := range baldes {
		if b.DuracaoMedia > maior {
			maior = b.DuracaoMedia
		}
	}
	if maior == 0 {
		return ""
	}

	util := alturaGrafico - margemBaixo
	area := larguraGrafico - margemEsq
	passo := float64(area) / float64(len(baldes))

	var b strings.Builder
	comando := "M"
	for i, bl := range baldes {
		if bl.DuracaoMedia == 0 {
			// It cuts the line rather than joining two peaks over a gap, which
			// would invent a duration for an hour with no run at all.
			comando = "M"
			continue
		}
		x := margemEsq + int(float64(i)*passo+passo/2)
		y := util - int(float64(util)*0.86*float64(bl.DuracaoMedia)/float64(maior))
		fmt.Fprintf(&b, "%s%d %d ", comando, x, y)
		comando = "L"
	}
	return strings.TrimSpace(b.String())
}

func marcasDeHora(baldes []postgres.Balde) []Marca {
	area := larguraGrafico - margemEsq
	passo := float64(area) / float64(len(baldes))

	// It shows at most 8 labels: more than that becomes an illegible blur.
	salto := len(baldes)/8 + 1
	var out []Marca
	for i, b := range baldes {
		if i%salto != 0 {
			continue
		}
		out = append(out, Marca{
			X:      margemEsq + int(float64(i)*passo+passo/2),
			Rotulo: b.Inicio.Local().Format("15h"),
		})
	}
	return out
}

type Arco struct {
	Cor    string
	Dash   string
	Offset int
	Dica   string
	Link   string
}

// arcos builds the donut with a dasharray over a single circle. The perimeter is
// 2*pi*46 ≈ 289; each slice takes its piece and offsets the next.
func arcos(i postgres.Indicadores) []Arco {
	const perimetro = 289
	if i.Total == 0 {
		return nil
	}
	fatias := []struct {
		n      int
		cor    string
		nome   string
		estado string
	}{
		// A CSS variable, and not a hex value: the SVG is served inside the page,
		// so the donut follows the client's theme like any other element.
		{i.Sucesso, "var(--color-state-success)", "success", "success"},
		{i.Falha, "var(--color-state-failed)", "failed", "failed"},
		{i.EmExecucao, "var(--color-state-running)", "running", "running"},
		{i.Pendentes, "var(--color-state-queued)", "queued", "queued"},
	}

	var out []Arco
	acumulado := 0
	for _, f := range fatias {
		if f.n == 0 {
			continue
		}
		tamanho := f.n * perimetro / i.Total
		out = append(out, Arco{
			Cor:    f.cor,
			Dash:   fmt.Sprintf("%d %d", tamanho, perimetro-tamanho),
			Offset: -acumulado,
			Dica: fmt.Sprintf("%d %s (%.0f%%) — click to see the list",
				f.n, f.nome, float64(f.n)*100/float64(i.Total)),
			Link: "/runs?estado=" + f.estado,
		})
		acumulado += tamanho
	}
	return out
}

// ---------------------------------------------------------------------------
// Formatadores compartilhados
// ---------------------------------------------------------------------------

// Duracao picks the unit by order of magnitude. "0.4s" says more than "400ms" in
// a column whose neighbour takes minutes.
func Duracao(d *time.Duration) string {
	if d == nil {
		return "—"
	}
	switch {
	case *d < time.Second:
		return fmt.Sprintf("%dms", d.Milliseconds())
	case *d < time.Minute:
		return fmt.Sprintf("%.1fs", d.Seconds())
	case *d < time.Hour:
		return fmt.Sprintf("%dm %02ds", int(d.Minutes()), int(d.Seconds())%60)
	}
	return fmt.Sprintf("%dh %02dm", int(d.Hours()), int(d.Minutes())%60)
}

// Quando writes the instant relatively up to a day, and as an absolute date
// afterwards. "3 min ago" answers the operations question; "Mar 12 04:00"
// answers the audit one, and the boundary between the two sits around a day.
func Quando(t *time.Time) string {
	if t == nil {
		return "—"
	}
	d := time.Since(*t)
	switch {
	case d < 0:
		return "in " + curto(-d)
	case d < time.Minute:
		return "now"
	case d < 24*time.Hour:
		return curto(d) + " ago"
	}
	return t.Local().Format("Jan 02 15:04")
}

func curto(d time.Duration) string {
	switch {
	case d < time.Hour:
		return fmt.Sprintf("%d min", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh", int(d.Hours()))
	}
	return fmt.Sprintf("%dd", int(d.Hours()/24))
}

// Instante is the full date, for audit columns.
func Instante(t *time.Time) string {
	if t == nil {
		return "—"
	}
	return t.Local().Format("2006-01-02 15:04:05")
}

// ---------------------------------------------------------------------------
// Erro em dialogo
//
// The error used to occupy a whole row below the run, inside the table. With a
// real stack trace that pushed the rest of the list off the screen and mixed two
// things — the list and the detail. Now the row holds a button, and
// o texto vive num <dialog> nativo: ESC fecha, o backdrop escurece e o foco fica
// trapped inside it without a line of JavaScript of ours.
// ---------------------------------------------------------------------------

templ BotaoErro(runID string) {
	// An <a> and not a <button>: with the href, the error has an address of its
	// own — copying the link takes somebody else straight to it. The script
	// intercepts the click and opens the dialog; without JavaScript, the link
	// still navigates to the run.
	<a
		href={ templ.SafeURL("#erro-" + runID) }
		data-dialogo={ "erro-" + runID }
		title="Ver o erro"
		class="inline-flex items-center gap-1 rounded-full border border-state-failed/30 bg-state-failed/5 px-2.5 py-1 text-[0.7rem] font-medium text-state-failed transition-colors hover:bg-state-failed/10"
	>
		<svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6">
			<circle cx="6" cy="6" r="4.6"></circle>
			<path d="M6 3.4v3M6 8.4v.2" stroke-linecap="round"></path>
		</svg>
		erro
	</a>
}

templ DialogoErro(runID, workflow, status, mensagem string) {
	<dialog
		id={ "erro-" + runID }
		class="w-[min(680px,92vw)] rounded-[20px] border border-line bg-surface p-0 text-ink shadow-warm backdrop:bg-ink/40 backdrop:backdrop-blur-[2px]"
	>
		<div class="flex items-start justify-between gap-4 border-b border-line px-6 py-4">
			<div>
				<p class="kicker">Run failure</p>
				<p class="display mt-1 text-2xl">{ workflow }</p>
			</div>
			// `method="dialog"` closes without JavaScript: the browser itself is
			// what
			// trata o submit deste form.
			<form method="dialog">
				<button
					autofocus
					class="rounded-full border border-line px-3 py-1 text-xs text-muted transition-colors hover:border-gold hover:text-ink focus-visible:border-gold focus-visible:text-ink"
					aria-label="Fechar"
				>close</button>
			</form>
		</div>
		<div class="px-6 py-5">
			<div class="mb-4 flex flex-wrap items-center gap-3 text-xs">
				@Estado(status)
				<a href={ templ.SafeURL("/runs/" + runID) } class="text-gold-strong hover:underline">open the run</a>
				<span class="font-mono text-[0.7rem] text-muted/70">{ runID }</span>
			</div>
			<pre class="max-h-[50vh] overflow-auto rounded-[14px] border border-state-failed/20 bg-state-failed/5 px-4 py-3 font-mono text-xs leading-relaxed whitespace-pre-wrap text-state-failed">{ mensagem }</pre>
		</div>
	</dialog>
}
