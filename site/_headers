# Cloudflare Pages reads this file. One rule per path prefix, most specific last.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  # No inline script on this site except the one-liner that sets the .js class,
  # and no third-party anything but the Google Fonts stylesheet.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# The HTML is regenerated on every content change and its URL never carries a
# hash, so it must revalidate. must-revalidate, not no-store: a 304 is cheap.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# These do carry no hash either, but they change with the HTML.
/search-index.json
  Cache-Control: public, max-age=3600

# For agents. Served as text so a client reads them instead of downloading:
# without the explicit type, .md arrives as application/octet-stream.
/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
